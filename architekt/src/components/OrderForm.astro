---
/**
 * OrderForm: Formular-Standard (Kravets Webdesign). Immer so verwenden, nie ohne die drei Punkte:
 *  1. Jedes Feld hat label, Platzhalter-Beispiel, autocomplete, type/inputmode.
 *  2. Pflicht-Häkchen zur Einwilligung mit Zweck + Link auf datenschutz/ (base-Pfad), Fehlermeldung wenn nicht gesetzt.
 *  3. Preise/Auswahl: Summe läuft mit (mobil: klebende Leiste unten im Formular) und steht in der Bestätigung.
 *     Ohne Preise (items leer): keine Summe erfinden, die Bestätigung zeigt die Auswahl (Leistung, Datum/Zeit).
 * Es wird nichts gesendet (Demo). Beim echten Kunden: Backend/Mail-Weg anschließen und Datenschutz anpassen.
 *
 * Props:
 *   items   [{ id, name, cents }]  Positionen mit Preis (optional)
 *   options [string]               Auswahl ohne Preis, z. B. Leistungen oder Abholzeiten (optional)
 *   optionsLabel                   Überschrift der Auswahl, z. B. "Wann?"
 *   title, submitLabel, purpose    Texte; purpose = Zweck im Einwilligungssatz
 */
import site from '../data/site.json';
const {
  items = [],
  options = [],
  optionsLabel = 'Auswahl',
  title = 'Anfrage',
  submitLabel = 'Anfrage senden',
  purpose = 'meiner Anfrage',
  id = 'form',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const euro = (c: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(c / 100);
const hasPrices = items.length > 0;
---
<section class="of" aria-labelledby={`${id}-h`}>
  <h2 class="of__title" id={`${id}-h`}>{title}</h2>
  <form class="of__form" id={id} novalidate data-of data-has-prices={hasPrices ? '1' : '0'} data-options-label={optionsLabel}>
    {hasPrices && (
      <fieldset class="of__group">
        <legend>Was möchten Sie?</legend>
        <ul class="of__list">
          {items.map((it) => (
            <li class="of__row">
              <span class="of__name" id={`${id}-n-${it.id}`}>{it.name} <span class="of__unit">{euro(it.cents)}</span></span>
              <span class="of__qty" role="group" aria-labelledby={`${id}-n-${it.id}`}>
                <button type="button" data-step="-1" aria-label={`${it.name}: eins weniger`} disabled>−</button>
                <input type="number" name={it.id} value="0" min="0" max="20" inputmode="numeric" data-cents={it.cents} data-label={it.name} aria-label={`${it.name}: Anzahl`} />
                <button type="button" data-step="1" aria-label={`${it.name}: eins mehr`}>+</button>
              </span>
            </li>
          ))}
        </ul>
        <p class="of__err" data-empty role="alert" hidden>Bitte wählen Sie mindestens eine Position.</p>
      </fieldset>
    )}
    {options.length > 0 && (
      <fieldset class="of__group">
        <legend>{optionsLabel}</legend>
        <div class="of__chips">
          {options.map((o, i) => (
            <label class="of__chip"><input type="radio" name="option" value={o} checked={i === 0} /><span>{o}</span></label>
          ))}
        </div>
      </fieldset>
    )}

    <fieldset class="of__group">
      <legend>Ihre Angaben</legend>
      <div class="of__field">
        <label for={`${id}-name`}>Name</label>
        <input id={`${id}-name`} name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" required aria-describedby={`${id}-err-name`} />
        <p class="of__err" id={`${id}-err-name`} hidden>Bitte geben Sie Ihren Namen an.</p>
      </div>
      <div class="of__field">
        <label for={`${id}-tel`}>Telefon</label>
        <input id={`${id}-tel`} name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 030 23125 123" required aria-describedby={`${id}-err-tel`} />
        <p class="of__err" id={`${id}-err-tel`} hidden>Bitte geben Sie eine Telefonnummer an, unter der wir Sie erreichen.</p>
      </div>
      <div class="of__field">
        <label for={`${id}-mail`}>E-Mail <span class="of__opt">(optional)</span></label>
        <input id={`${id}-mail`} name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@example.com" aria-describedby={`${id}-err-mail`} />
        <p class="of__err" id={`${id}-err-mail`} hidden>Bitte prüfen Sie die E-Mail-Adresse, z. B. name@example.com.</p>
      </div>
      <div class="of__field">
        <label for={`${id}-note`}>Nachricht <span class="of__opt">(optional)</span></label>
        <textarea id={`${id}-note`} name="note" rows="3" autocomplete="off" placeholder="z. B. Wunschtermin, Hinweise, Fragen"></textarea>
      </div>
    </fieldset>

    <div class="of__consent">
      <label class="of__check">
        <input type="checkbox" name="privacy" required aria-describedby={`${id}-err-privacy`} />
        <span>Ich bin einverstanden, dass {site.name} meine Angaben (Name, Telefon, E-Mail, Nachricht) zur Bearbeitung {purpose} verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
      </label>
      <p class="of__err" id={`${id}-err-privacy`} hidden>Bitte stimmen Sie zu, sonst können wir Ihre Anfrage nicht bearbeiten.</p>
    </div>

    <div class="of__bar">
      {hasPrices ? (
        <p class="of__total"><span data-count>Noch nichts gewählt</span><span>Summe <strong data-total>{euro(0)}</strong></span></p>
      ) : (
        <p class="of__total of__total--plain"><span>Es wird nichts gesendet (Demo).</span></p>
      )}
      <button class="of__btn" type="submit">{submitLabel}</button>
    </div>
  </form>

  <div class="of__done" data-done tabindex="-1" hidden>
    <h3>Danke, Ihre Anfrage ist angekommen.</h3>
    <dl data-done-list></dl>
    <p class="of__demo">Demo: Dieses Formular ist eine Vorführung. Es wurde nichts gesendet oder gespeichert.</p>
  </div>
</section>

<style>
  .of { max-width: 40rem; margin: 0 auto; padding: var(--space-xl) var(--gutter); }
  .of__title { margin: 0 0 var(--space-lg); }
  .of__group { border: 0; padding: 0; margin: 0 0 var(--space-lg); min-width: 0; display: grid; gap: var(--space-md); }
  .of__group legend { padding: 0; margin-bottom: var(--space-sm); font-weight: 700; }
  .of__list { list-style: none; margin: 0; padding: 0; }
  .of__row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: 1px solid var(--rule); }
  .of__unit { color: var(--muted); font-variant-numeric: tabular-nums; margin-left: var(--space-xs); }
  .of__qty { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .of__qty button { width: 2.75rem; height: 2.75rem; border: 1px solid var(--ink); border-radius: var(--radius); background: var(--paper); color: var(--ink); font: inherit; font-size: 1.25rem; cursor: pointer; }
  .of__qty button:disabled { opacity: 0.4; cursor: not-allowed; }
  .of__qty input { width: 3rem; height: 2.75rem; text-align: center; border: 1px solid var(--rule); border-radius: var(--radius); font: inherit; -moz-appearance: textfield; appearance: textfield; }
  .of__qty input::-webkit-outer-spin-button, .of__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .of__chips { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .of__chip input { position: absolute; opacity: 0; }
  .of__chip span { display: inline-block; min-height: 2.75rem; padding: 0.65rem 1rem; border: 1px solid var(--ink); border-radius: 999px; cursor: pointer; }
  .of__chip input:checked + span { background: var(--ink); color: var(--paper); }
  .of__chip input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 2px; }
  .of__field { display: grid; gap: var(--space-xs); min-width: 0; }
  .of__field label { font-weight: 600; font-size: var(--text-sm); }
  .of__opt { font-weight: 400; color: var(--muted); }
  .of__field input, .of__field textarea { width: 100%; min-height: 2.75rem; padding: 0.65rem 0.85rem; border: 1px solid var(--ink); border-radius: var(--radius); background: var(--paper); color: var(--ink); font: inherit; }
  .of__field textarea { resize: vertical; }
  .of__field input::placeholder, .of__field textarea::placeholder { color: var(--muted); opacity: 1; }
  .of__field input:focus-visible, .of__field textarea:focus-visible, .of__qty button:focus-visible, .of__qty input:focus-visible, .of__btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .of__field input[aria-invalid='true'] { border-color: var(--alert); box-shadow: inset 0 0 0 1px var(--alert); }
  .of__err { margin: 0; font-size: var(--text-sm); font-weight: 600; color: var(--alert); }
  .of__err[hidden] { display: none; }
  .of__consent { display: grid; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .of__check { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-smd); align-items: start; font-size: var(--text-sm); line-height: 1.45; cursor: pointer; }
  .of__check input { width: 1.4rem; height: 1.4rem; margin: 0.1rem 0 0; accent-color: var(--accent); }
  .of__check input:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .of__check.is-invalid span { color: var(--alert); }
  .of__bar { position: sticky; bottom: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding: var(--space-smd) 0; padding-bottom: max(var(--space-smd), env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--ink); }
  .of__total { display: grid; gap: 0.125rem; margin: 0; min-width: 0; font-variant-numeric: tabular-nums; font-size: var(--text-sm); }
  .of__total strong { font-size: 1.5rem; margin-left: var(--space-xs); }
  .of__btn { min-height: 2.75rem; padding: 0.65rem 1.25rem; border: 0; border-radius: var(--radius); background: var(--accent); color: var(--ink); font-family: inherit; font-weight: 700; font-size: 1rem; cursor: pointer; }
  .of__btn[disabled] { opacity: 0.6; cursor: wait; }
  .of__done { padding: var(--space-lg); border: 1px solid var(--ink); border-radius: var(--radius); }
  .of__done:focus { outline: 3px solid var(--focus); outline-offset: 2px; }
  .of__done h3 { margin: 0 0 var(--space-md); }
  .of__done dl { margin: 0; display: grid; gap: 0; }
  .of__done dl > div { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: 1px solid var(--rule); font-variant-numeric: tabular-nums; }
  .of__done dt { color: var(--muted); }
  .of__done dd { margin: 0; text-align: right; }
  .of__sum { font-weight: 700; }
  .of__demo { margin: var(--space-md) 0 0; font-size: var(--text-sm); color: var(--muted); }
  @media (max-width: 30rem) { .of__bar { flex-wrap: wrap; } .of__btn { flex: 1 1 100%; } }
  @media (prefers-reduced-motion: no-preference) { .of__btn { transition: filter 0.15s; } .of__btn:hover { filter: brightness(0.95); } }
</style>

<script>
  // Demo-Logik: Summe, Prüfung, Bestätigung. Keine Anfragen, kein Speicher, keine Cookies.
  const eur = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });
  document.querySelectorAll<HTMLFormElement>('form[data-of]').forEach((form) => {
    const done = form.parentElement!.querySelector<HTMLElement>('[data-done]')!;
    const list = done.querySelector<HTMLElement>('[data-done-list]')!;
    const hasPrices = form.dataset.hasPrices === '1';
    const qty = [...form.querySelectorAll<HTMLInputElement>('input[type=number]')];
    const totalEl = form.querySelector<HTMLElement>('[data-total]');
    const countEl = form.querySelector<HTMLElement>('[data-count]');
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const err = (input: HTMLInputElement, show: boolean) => {
      const e = document.getElementById(input.getAttribute('aria-describedby') || '');
      if (e) e.hidden = !show;
      input.setAttribute('aria-invalid', show ? 'true' : 'false');
      input.closest('.of__check')?.classList.toggle('is-invalid', show);
    };
    const sum = () => qty.reduce((s, i) => s + (Number(i.value) || 0) * Number(i.dataset.cents), 0);
    const count = () => qty.reduce((s, i) => s + (Number(i.value) || 0), 0);
    const update = () => {
      if (!hasPrices) return;
      totalEl!.textContent = eur.format(sum() / 100);
      const n = count();
      countEl!.textContent = n ? `${n} ${n === 1 ? 'Position' : 'Positionen'}` : 'Noch nichts gewählt';
      qty.forEach((i) => {
        const minus = i.previousElementSibling as HTMLButtonElement;
        minus.disabled = Number(i.value) <= 0;
      });
    };
    form.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-step]');
      if (!b) return;
      const i = b.parentElement!.querySelector<HTMLInputElement>('input')!;
      form.querySelector<HTMLElement>('[data-empty]')?.setAttribute('hidden', '');
      i.value = String(Math.min(20, Math.max(0, (Number(i.value) || 0) + Number(b.dataset.step))));
      update();
    });
    qty.forEach((i) => i.addEventListener('input', update));
    ['name', 'tel', 'email'].forEach((n) => field(n).addEventListener('input', () => err(field(n), false)));
    field('privacy').addEventListener('change', () => err(field('privacy'), false));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = field('name'), tel = field('tel'), mail = field('email'), priv = field('privacy');
      const bad: HTMLInputElement[] = [];
      const check = (i: HTMLInputElement, ok: boolean) => { err(i, !ok); if (!ok) bad.push(i); };
      check(name, name.value.trim().length > 1);
      check(tel, tel.value.replace(/\D/g, '').length >= 6);
      check(mail, mail.value.trim() === '' || mail.checkValidity());
      check(priv, priv.checked);
      if (hasPrices && count() === 0) {
        // Keine leere Bestellung: Fokus auf die erste Position
        form.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
        qty[0].focus();
        return;
      }
      if (bad.length) { bad[0].focus(); return; }

      const rows: [string, string, boolean?][] = [];
      if (hasPrices) {
        qty.filter((i) => Number(i.value) > 0).forEach((i) => rows.push([`${i.value} × ${i.dataset.label}`, eur.format(Number(i.value) * Number(i.dataset.cents) / 100)]));
        rows.push(['Summe', eur.format(sum() / 100), true]);
      }
      const opt = form.querySelector<HTMLInputElement>('input[name=option]:checked');
      if (opt) rows.push([form.dataset.optionsLabel || 'Auswahl', opt.value]);
      rows.push(['Name', name.value.trim()], ['Telefon', tel.value.trim()]);
      list.replaceChildren(...rows.map(([k, v, strong]) => {
        const d = document.createElement('div');
        const dt = document.createElement('dt'); dt.textContent = k;
        const dd = document.createElement('dd'); dd.textContent = v;
        if (strong) { dt.className = 'of__sum'; dd.className = 'of__sum'; }
        d.append(dt, dd);
        return d;
      }));
      form.hidden = true;
      done.hidden = false;
      done.focus();
    });

    // Eingaben nie verlieren: Zwischenspeicher in sessionStorage (nur dieser Tab, nichts wird gesendet).
    // Das Einwilligungs-Häkchen wird bewusst nicht gespeichert und nicht wiederhergestellt.
    const KEY = `form:${location.pathname}:${form.id}`;
    const saved = () => [...form.elements].filter((el): el is HTMLInputElement => el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)
      .filter((el) => el.name && el.name !== 'privacy');
    const save = () => {
      try {
        const d: Record<string, string> = {};
        saved().forEach((el) => { if (el.type === 'radio') { if (el.checked) d[el.name] = el.value; } else d[el.name] = el.value; });
        const empty = Object.entries(d).every(([k, v]) => !v || v === '0' || k === 'option');
        if (empty) sessionStorage.removeItem(KEY); else sessionStorage.setItem(KEY, JSON.stringify(d));
      } catch {}
    };
    try {
      const raw = sessionStorage.getItem(KEY);
      if (raw) {
        const d = JSON.parse(raw);
        saved().forEach((el) => {
          if (!(el.name in d)) return;
          if (el.type === 'radio') el.checked = el.value === d[el.name]; else el.value = String(d[el.name]);
        });
      }
    } catch {}
    form.addEventListener('input', save);
    form.addEventListener('change', save);
    form.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('button[data-step]')) save(); });
    form.addEventListener('submit', () => { try { if (form.hidden) sessionStorage.removeItem(KEY); } catch {} });
    update();
  });
</script>
