---
/** Projekte: Foto sichtbar, Kosten Plan/Ist auf der Karte, Zahlen und Verlauf aufklappbar. Erstes Projekt breit; auf dem Handy wischt man durch die übrigen (Scroll-Snap), ab 48rem stehen sie in einer Reihe. */
import projekte from '../data/projekte.json';
import ProjektItem from './ProjektItem.astro';
const [lead, ...rest] = projekte;
---
<div class="proj">
  <ProjektItem p={lead} lead />
  <div class="proj__rest" tabindex="0" role="region" aria-label="Weitere Projekte, seitlich wischen">
    {rest.map((p) => <ProjektItem p={p} />)}
  </div>
</div>
