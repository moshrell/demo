---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/geist';
import '../styles/global.css';
import data from '../data/bakery.json';
const { title = `${data.name} | Croissants aus 48 Stunden Teigführung in Hannover`, description = 'Handwerkliche Croissants, Sauerteigbrot und Specialty Coffee in Hannover. Wochenende vorbestellen und abholen.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href={`${base}img/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" as="image" href={`${base}img/croissant-raw.webp`} />
  </head>
  <body>
    <slot />
  </body>
</html>
