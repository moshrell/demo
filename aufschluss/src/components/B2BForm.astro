---
// Anfrage Schließanlage für Hausverwaltungen. Richtwert läuft mit: Türen × Preis pro Tür + zusätzliche Schlüssel.
import '../styles/formular.css';
import site from '../data/site.json';
import preise from '../data/preise.json';
import vorsorge from '../data/vorsorge.json';
const base = import.meta.env.BASE_URL;
const b = vorsorge.b2b;
const steppers = [
  { name: 'wohnungen', label: 'Wohnungstüren', hint: 'je ein Zylinder', value: 24, max: 200 },
  { name: 'allgemein', label: 'Gemeinschaftstüren', hint: 'Haustür, Keller, Müllraum, Garage', value: 4, max: 40 },
  { name: 'schluessel', label: 'Schlüssel pro Wohnung', hint: `${b.inklSchluessel} sind im Türpreis enthalten`, value: 3, max: 10 },
];
---
<div class="fm-wrap">
  <form class="fm" id="b2b-form" novalidate data-b2b>
    <fieldset class="fm__group">
      <legend>Objekt</legend>
      <div class="fm__field">
        <label for="o-str">Straße und Hausnummer</label>
        <input id="o-str" name="strasse" type="text" autocomplete="street-address" placeholder="z. B. Lister Meile 0" data-check="text" aria-describedby="o-str-err" />
        <p class="fm__err" id="o-str-err" hidden>Bitte die Adresse des Objekts angeben.</p>
      </div>
      <div class="fm__row2">
        <div class="fm__field">
          <label for="o-plz">PLZ</label>
          <input id="o-plz" name="plz" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="30161" maxlength="5" data-check="plz" aria-describedby="o-plz-err" />
        </div>
        <div class="fm__field">
          <label for="o-ort">Ort</label>
          <input id="o-ort" name="ort" type="text" autocomplete="address-level2" placeholder="z. B. Hannover" data-check="text" aria-describedby="o-ort-err" />
        </div>
      </div>
      <p class="fm__hint" data-zone aria-live="polite">Wir arbeiten in Hannover und der Region.</p>
      <p class="fm__err" id="o-plz-err" hidden>Bitte eine Postleitzahl in unserem Gebiet angeben.</p>
      <p class="fm__err" id="o-ort-err" hidden>Bitte den Ort angeben.</p>
    </fieldset>

    <fieldset class="fm__group">
      <legend>Umfang</legend>
      {steppers.map((s) => (
        <div class="fm__stepper">
          <span class="fm__label" id={`o-${s.name}-l`}>{s.label}<small>{s.hint}</small></span>
          <span class="fm__qty" role="group" aria-labelledby={`o-${s.name}-l`}>
            <button type="button" data-step="-1" aria-label={`${s.label}: eins weniger`}>−</button>
            <input type="number" name={s.name} value={s.value} min="0" max={s.max} inputmode="numeric" aria-label={`${s.label}: Anzahl`} />
            <button type="button" data-step="1" aria-label={`${s.label}: eins mehr`}>+</button>
          </span>
        </div>
      ))}
      <label class="fm__check"><input type="checkbox" name="karte" value="ja" checked /><span><strong>Sicherungskarte</strong>: Nachschlüssel nur gegen Karte und nur bei uns. Im Preis enthalten.</span></label>
      <div class="fm__chips" role="radiogroup" aria-label="Wann soll eingebaut werden?">
        <label class="fm__chip"><input type="radio" name="termin" value="So bald wie möglich" checked /><span>So bald wie möglich</span></label>
        <label class="fm__chip"><input type="radio" name="termin" value="In 1–3 Monaten" /><span>In 1–3 Monaten</span></label>
        <label class="fm__chip"><input type="radio" name="termin" value="Später, erst Angebot" /><span>Später, erst Angebot</span></label>
      </div>
    </fieldset>

    <fieldset class="fm__group">
      <legend>Ansprechpartner</legend>
      <div class="fm__field">
        <label for="o-firma">Firma oder Eigentümergemeinschaft</label>
        <input id="o-firma" name="firma" type="text" autocomplete="organization" placeholder="z. B. Musterverwaltung GmbH" data-check="text" aria-describedby="o-firma-err" />
        <p class="fm__err" id="o-firma-err" hidden>Bitte die Firma oder WEG angeben.</p>
      </div>
      <div class="fm__field">
        <label for="o-name">Name</label>
        <input id="o-name" name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" data-check="name" aria-describedby="o-name-err" />
        <p class="fm__err" id="o-name-err" hidden>Bitte geben Sie Ihren Namen an.</p>
      </div>
      <div class="fm__field">
        <label for="o-tel">Telefon</label>
        <input id="o-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 030 23125 123" data-check="tel" aria-describedby="o-tel-err" />
        <p class="fm__err" id="o-tel-err" hidden>Bitte eine Telefonnummer, unter der wir Sie erreichen.</p>
      </div>
      <div class="fm__field">
        <label for="o-mail">E-Mail für das Angebot</label>
        <input id="o-mail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@example.com" data-check="mail" aria-describedby="o-mail-err" />
        <p class="fm__err" id="o-mail-err" hidden>Bitte eine gültige E-Mail-Adresse, z. B. name@example.com.</p>
      </div>
      <div class="fm__field">
        <label for="o-note">Nachricht <span class="fm__opt">(optional)</span></label>
        <textarea id="o-note" name="note" rows="3" autocomplete="off" placeholder="z. B. Altanlage von 1998, zwei Hauseingänge"></textarea>
      </div>
    </fieldset>

    <div class="fm__field">
      <label class="fm__check">
        <input type="checkbox" name="privacy" data-check="consent" aria-describedby="o-priv-err" />
        <span>Ich bin einverstanden, dass {site.name} meine Angaben (Objekt, Firma, Name, Telefon, E-Mail, Nachricht) zur Bearbeitung meiner Anfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
      </label>
      <p class="fm__err" id="o-priv-err" hidden>Bitte stimmen Sie zu, sonst können wir Ihre Anfrage nicht bearbeiten.</p>
    </div>

    <div class="fm__bar">
      <p class="fm__total" aria-live="polite"><span data-o-zeile>Richtwert, 28 Türen</span><strong data-o-summe>–</strong></p>
      <button class="fm__btn" type="submit">Anfrage senden</button>
    </div>
    <p class="fm__demo">Richtwert ab {b.proTuer} € pro Tür (Zylinder, Montage, {b.inklSchluessel} Schlüssel), weitere Schlüssel ab {b.extraSchluessel} €, {preise.mwst}. Kein Angebot: Das schriftliche Angebot kommt nach der Begehung. Demo: Es wird nichts gesendet.</p>
  </form>

  <div class="fm__done" data-done tabindex="-1" hidden>
    <h3>Danke. Wir melden uns für einen Begehungstermin.</h3>
    <dl data-done-list></dl>
    <p class="fm__demo">Demo: Dieses Formular ist eine Vorführung. Es wurde nichts gesendet oder gespeichert.</p>
  </div>
</div>

<script>
  import { pruefen, merken, fertig, wert } from '../scripts/formular';
  import { zoneFuer, euro } from '../scripts/zone';
  import vorsorge from '../data/vorsorge.json';
  const b = vorsorge.b2b;
  const form = document.querySelector<HTMLFormElement>('form[data-b2b]');
  if (form) {
    const n = (name: string) => form.querySelector<HTMLInputElement>(`input[name=${name}]`)!;
    const plz = n('plz'), ort = n('ort');
    const info = form.querySelector<HTMLElement>('[data-zone]')!;
    let richtwert = 0;
    const zahl = (name: string) => Math.max(0, Math.min(Number(n(name).max), Math.round(Number(n(name).value) || 0)));
    const update = () => {
      const w = zahl('wohnungen'), a = zahl('allgemein'), s = zahl('schluessel');
      const tueren = w + a;
      richtwert = tueren * b.proTuer + Math.max(0, s - b.inklSchluessel) * w * b.extraSchluessel;
      form.querySelector('[data-o-zeile]')!.textContent = `Richtwert: ${tueren} ${tueren === 1 ? 'Tür' : 'Türen'}, ${w * s} Schlüssel`;
      form.querySelector('[data-o-summe]')!.textContent = tueren ? `ab ${euro(richtwert)}` : '–';
      form.querySelectorAll<HTMLButtonElement>('button[data-step="-1"]').forEach((btn) => { btn.disabled = Number(btn.nextElementSibling && (btn.nextElementSibling as HTMLInputElement).value) <= 0; });
      plz.value = plz.value.replace(/\D/g, '').slice(0, 5);
      const z = zoneFuer(plz.value);
      info.classList.remove('is-ok', 'is-nein');
      if (!z) info.textContent = 'Wir arbeiten in Hannover und der Region.';
      else if (!z.ok) { info.textContent = 'Außerhalb unseres Gebiets, leider.'; info.classList.add('is-nein'); }
      else { info.textContent = `Ja, wir kommen: ${z.text}`; info.classList.add('is-ok'); if (!ort.value) ort.value = z.ort!; }
    };
    form.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-step]');
      if (!btn) return;
      const i = btn.parentElement!.querySelector<HTMLInputElement>('input')!;
      i.value = String(Math.min(Number(i.max), Math.max(0, (Number(i.value) || 0) + Number(btn.dataset.step))));
      update();
      i.dispatchEvent(new Event('change', { bubbles: true }));
    });
    form.addEventListener('input', update);
    const store = merken(form, update);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ok = pruefen(form, (bad) => { const z = zoneFuer(plz.value); if (z && !z.ok && !bad.includes(plz)) { plz.setAttribute('aria-invalid', 'true'); document.getElementById('o-plz-err')!.hidden = false; bad.unshift(plz); } });
      if (!ok) return;
      fertig(form, [
        ['Objekt', `${wert(form, 'strasse')}, ${plz.value} ${wert(form, 'ort')}`],
        ['Wohnungstüren', String(zahl('wohnungen'))],
        ['Gemeinschaftstüren', String(zahl('allgemein'))],
        ['Schlüssel pro Wohnung', String(zahl('schluessel'))],
        ['Sicherungskarte', n('karte').checked ? 'ja' : 'nein'],
        ['Zeitraum', form.querySelector<HTMLInputElement>('input[name=termin]:checked')?.value ?? ''],
        ['Richtwert (kein Angebot)', `ab ${euro(richtwert)}`, true],
        ['Firma', wert(form, 'firma')],
        ['Name', wert(form, 'name')],
        ['Telefon', wert(form, 'tel')],
        ['E-Mail', wert(form, 'email')],
      ]);
      store.clear();
    });
  }
</script>
