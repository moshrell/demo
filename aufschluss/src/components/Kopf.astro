---
// Kopf: Wortmarke, Status (Notdienst + Werkstatt), Schalter „Notfall ⟲ Vorsorge“ als Schließzylinder.
// Zylinder: Kern mit Schlüsselkanal dreht sich (0° = Notfall, 90° rechts = Vorsorge). Ziehen, tippen oder die Beschriftungen nutzen.
import site from '../data/site.json';
---
<header class="kopf">
  <div class="wrap kopf__row">
    <p class="kopf__mark">Aufschluss</p>
    <p class="kopf__status" data-status>
      <span class="kopf__dot" aria-hidden="true"></span>
      <span><strong>Notdienst 24 h</strong><span class="kopf__werk" data-werkstatt> · Werkstatt {site.werkstatt.label}</span></span>
    </p>
  </div>
  <div class="wrap">
    <div class="schalter" role="group" aria-label="Bereich wählen">
      <button type="button" class="schalter__btn" data-mode-btn="notfall" aria-pressed="true">Notfall</button>
      <div class="zyl" data-zyl aria-hidden="true">
        <svg viewBox="-30 -30 60 60" class="zyl__svg">
          <circle r="28" class="zyl__ring" />
          <circle r="21" class="zyl__housing" />
          <g class="zyl__kern" data-kern>
            <circle r="16" class="zyl__plug" />
            <path d="M-2.2,-12 h4.4 l1.1,4.2 -1.1,1.6 1.1,1.8 -1.1,2.2 1.1,2 -1.1,2.4 v9.8 h-4.4 z" class="zyl__kanal" />
          </g>
        </svg>
      </div>
      <button type="button" class="schalter__btn" data-mode-btn="vorsorge" aria-pressed="false">Vorsorge</button>
    </div>
    <p class="schalter__hint" data-hint hidden>Schlüssel nach rechts drehen: Vorsorge</p>
  </div>
</header>

<style>
  .kopf { padding-top: max(var(--space-sm), env(safe-area-inset-top)); }
  .kopf__row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); min-height: 2.75rem; }
  .kopf__mark { font-family: var(--font-display); font-size: 1rem; letter-spacing: 0.02em; text-transform: uppercase; }
  .kopf__status { display: flex; align-items: center; gap: var(--space-xs); font-size: 0.875rem; line-height: 1.25; text-align: right; color: var(--color-ink-2); min-width: 0; }
  .kopf__status strong { color: var(--color-ink); }
  .kopf__werk { display: none; }
  .kopf__dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--color-ok); flex: none; box-shadow: 0 0 0 3px oklch(52% 0.13 150 / 0.18); }
  @media (min-width: 36rem) { .kopf__werk { display: inline; } }

  .schalter { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-sm); margin-top: var(--space-xs); padding: var(--space-xs); border: var(--rule-ink); border-radius: 999px; background: var(--color-paper); }
  .schalter__btn { min-height: 2.75rem; border: 0; border-radius: 999px; background: transparent; font-family: var(--font-display); font-size: 0.95rem; letter-spacing: 0.01em; cursor: pointer; color: var(--color-ink-2); white-space: nowrap; }
  .schalter__btn[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .schalter__btn:focus-visible { outline-offset: 2px; }
  .zyl { width: 3.5rem; height: 3.5rem; touch-action: none; cursor: grab; -webkit-tap-highlight-color: transparent; user-select: none; }
  .zyl:active { cursor: grabbing; }
  .zyl__svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .zyl__ring { fill: var(--color-brass); }
  .zyl__housing { fill: var(--color-brass-deep); }
  .zyl__plug { fill: var(--color-ink); }
  .zyl__kanal { fill: var(--color-brass-light); }
  .zyl__kern { transform: rotate(var(--rot, 0deg)); transform-box: view-box; transform-origin: 0 0; }
  :global(html.drehen) .zyl__kern { transition: transform var(--dur-mid) var(--ease-out); }
  .schalter__hint { margin-top: var(--space-xs); text-align: center; font-size: 0.875rem; color: var(--color-ink-2); }
  /* Ohne JS: beide Bereiche stehen untereinander, Schalter wäre nutzlos */
  :global(html:not(.js)) .schalter, :global(html:not(.js)) .schalter__hint { display: none; }
</style>
