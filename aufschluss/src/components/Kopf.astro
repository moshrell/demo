---
// Kopf: eine Zeile. Links Wortmarke, rechts Schalter „Notfall ⟲ Vorsorge“ als Schließzylinder.
// Zylinder: Kern mit Schlüsselkanal dreht sich (0° = Notfall, 90° rechts = Vorsorge). Ziehen, tippen oder die Beschriftungen nutzen.
---
<header class="kopf">
  <div class="wrap wrap--hero kopf__row">
    <p class="kopf__mark">Aufschluss<span class="kopf__sub">Schlüsseldienst</span></p>
    <div class="schalter" role="group" aria-label="Bereich wählen">
      <button type="button" class="schalter__btn" data-mode-btn="notfall" aria-pressed="true">Notfall</button>
      <div class="zyl" data-zyl aria-hidden="true" title="Drehen: rechts Vorsorge, links Notfall">
        <svg viewBox="-30 -30 60 60" class="zyl__svg">
          <circle r="28" class="zyl__ring" />
          <circle r="21" class="zyl__housing" />
          <g class="zyl__kern" data-kern>
            <circle r="16" class="zyl__plug" />
            <path d="M-2.2,-12 h4.4 l1.1,4.2 -1.1,1.6 1.1,1.8 -1.1,2.2 1.1,2 -1.1,2.4 v9.8 h-4.4 z" class="zyl__kanal" />
          </g>
        </svg>
      </div>
      <button type="button" class="schalter__btn" data-mode-btn="vorsorge" aria-pressed="false">Vorsorge</button>
    </div>
  </div>
</header>

<style>
  .kopf { padding-top: max(var(--space-xs), env(safe-area-inset-top)); border-bottom: var(--rule); }
  .kopf__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0 var(--space-xs); min-height: 3.5rem; padding-block: var(--space-2xs); }
  .kopf__mark { flex: 0 0 auto; display: grid; font-family: var(--font-display); font-size: 0.9375rem; line-height: 1.05; letter-spacing: 0.02em; text-transform: uppercase; min-width: 0; }
  .kopf__sub { font-family: var(--font-body); font-weight: 700; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--color-ink-2); }

  .schalter { display: flex; align-items: center; gap: 0.125rem; flex: none; margin-left: auto; }
  .schalter__btn { min-height: 2.75rem; padding: 0 0.6rem; border: 0; border-radius: 999px; background: transparent; font: 700 0.9375rem/1 var(--font-body); cursor: pointer; color: var(--color-ink-2); white-space: nowrap; }
  .schalter__btn[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .schalter__btn:focus-visible { outline-offset: 2px; }
  .zyl { width: 2.75rem; height: 2.75rem; flex: none; touch-action: none; cursor: grab; -webkit-tap-highlight-color: transparent; user-select: none; }
  .zyl:active { cursor: grabbing; }
  .zyl__svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .zyl__ring { fill: var(--color-brass); }
  .zyl__housing { fill: var(--color-brass-deep); }
  .zyl__plug { fill: var(--color-ink); }
  .zyl__kanal { fill: var(--color-brass-light); }
  .zyl__kern { transform: rotate(var(--rot, 0deg)); transform-box: view-box; transform-origin: 0 0; }
  :global(html.drehen) .zyl__kern { transition: transform var(--dur-mid) var(--ease-out); }
  @media (max-width: 22.5rem) { .kopf__sub { display: none; } .schalter__btn { padding: 0 0.45rem; font-size: 0.875rem; } }
  @media (min-width: 40rem) { .kopf__mark { font-size: 1.125rem; } }
  /* Ohne JS: beide Bereiche stehen untereinander, Schalter wäre nutzlos */
  :global(html:not(.js)) .schalter { display: none; }
</style>
