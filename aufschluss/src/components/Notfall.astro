---
// Bereich NOTFALL: großer Text, Live-Festpreis nach Uhrzeit, Anrufen/WhatsApp, PLZ-Rechner, alle Preise,
// „Was Sie vorher wissen sollten“, Einsatz-Journal „Gesagt. Gezahlt.“, Fragen.
import site from '../data/site.json';
import preise from '../data/preise.json';
import einsaetze from '../data/einsaetze.json';
import faq from '../data/faq.json';
import Icon from './Icon.astro';
const min = (k: 'zugefallen' | 'abgeschlossen') => Math.min(...preise.tarife.map((t) => t[k]));
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich habe mich ausgesperrt. PLZ: , Adresse: ')}`;
const vz = 'https://www.verbraucherzentrale.de/wissen/vertraege-reklamation/abzocke/schluesseldienste-so-schuetzen-sie-sich-vor-ueberzogen-hohen-rechnungen-6687';
---
<section class="bereich notfall" id="notfall" data-mode-panel="notfall" aria-labelledby="nf-h">
  <div class="wrap wrap--hero hero">
    <p class="hero__live"><span class="hero__dot" aria-hidden="true"></span><span data-live-jetzt>Notdienst rund um die Uhr</span></p>
    <h1 id="nf-h" class="hero__h">Tür zu?<br />Wir öffnen.<span class="sr-only"> Schlüsseldienst in Hannover zum Festpreis.</span></h1>

    <div class="preis" data-rechner role="group" aria-label="Festpreis und Anruf">
      <fieldset class="preis__arten">
        <legend>Wie ist die Tür zu?</legend>
        <label class="kachel"><input type="radio" name="art" value="zugefallen" checked /><span class="kachel__in"><span class="kachel__name">Zugefallen</span><span class="kachel__preis num" data-live-zu>ab {min('zugefallen')} €</span></span></label>
        <label class="kachel"><input type="radio" name="art" value="abgeschlossen" /><span class="kachel__in"><span class="kachel__name">Abgeschlossen</span><span class="kachel__preis num" data-live-ab>ab {min('abgeschlossen')} €</span></span></label>
      </fieldset>
      <p class="preis__erkl" data-erkl>{preise.arten.zugefallen.kurz}</p>
      <div class="hero__cta">
        <a class="anruf" href={`tel:${site.phoneHref}`} data-call>
          <Icon name="phone" class="icon anruf__i" />
          <span class="anruf__t"><span>Jetzt anrufen</span><span class="anruf__nr num">{site.phone}</span></span>
        </a>
        <a class="wa" href={wa} target="_blank" rel="noopener" data-wa><Icon name="message-circle" /><span>oder per WhatsApp schreiben</span></a>
      </div>
      <div class="preis__plz">
        <div class="preis__feld">
          <label for="r-plz">Ihre PLZ: Preis mit Anfahrt</label>
          <input id="r-plz" name="plz" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="z. B. 30451" maxlength="5" aria-describedby="r-zone" />
        </div>
        <p class="preis__summe" aria-live="polite"><span class="preis__slabel">Summe</span><strong class="num" data-s-total>–</strong><span class="preis__ssub" data-s-sub>+ Anfahrt 0–25 €</span></p>
      </div>
      <p class="preis__zone" id="r-zone" data-zone>Stadt Hannover 0 €, Nachbarorte 15 €, Region 25 €.</p>
    </div>

    <p class="hero__note">Festpreise {preise.mwst}. Den Gesamtpreis sagen wir Ihnen am Telefon, bevor wir losfahren. Zahlung mit Karte oder bar, immer mit Rechnung.</p>
  </div>
  <script is:inline>window.AUF && window.AUF.fill();</script>

  <div class="block" id="preise">
    <div class="wrap">
      <h2>Alle Preise</h2>
      <p class="block__lead">Festpreise für die Türöffnung, {preise.mwst}. Markiert ist, was gerade gilt.</p>
      <ul class="tarife">
        {preise.tarife.map((t) => (
          <li class="tarif" data-tarif-row={t.id}>
            <p class="tarif__kopf"><strong>{t.name}</strong><span>{t.wann}</span><span class="tarif__jetzt">gilt jetzt</span></p>
            <dl class="tarif__preise num">
              <div><dt>zugefallen</dt><dd>{t.zugefallen} €</dd></div>
              <div><dt>abgeschlossen</dt><dd>{t.abgeschlossen} €</dd></div>
            </dl>
          </li>
        ))}
      </ul>
      <dl class="extras">
        <div><dt>Anfahrt</dt><dd>Stadt Hannover 0 € · Nachbarorte 15 € · Region 25 €</dd></div>
        {preise.extras.map((e) => <div><dt>{e.name}</dt><dd><strong class="num">{e.preis}</strong> {e.text}</dd></div>)}
      </dl>
      <dl class="extras extras--arten">
        <div><dt>Zugefallen</dt><dd>{preise.arten.zugefallen.erklaerung}</dd></div>
        <div><dt>Abgeschlossen</dt><dd>{preise.arten.abgeschlossen.erklaerung}</dd></div>
      </dl>
    </div>
  </div>
  <script is:inline>window.AUF && window.AUF.fill();</script>

  <div class="block block--ink" id="wissen">
    <div class="wrap">
      <h2>Was Sie vorher wissen sollten</h2>
      <ol class="wissen">
        <li><strong>Gesamtpreis vorher.</strong> Lassen Sie sich am Telefon den ganzen Preis sagen, mit Anfahrt und Zuschlägen. Bei uns steht er oben.</li>
        <li><strong>Ausweis zeigen.</strong> Wir öffnen nur, wenn klar ist, dass Sie dort wohnen. Das schützt Sie vor Einbrechern.</li>
        <li><strong>Karte statt Geldautomat.</strong> Zahlen Sie mit Karte oder bar, aber fahren Sie mit niemandem zum Geldautomaten.</li>
        <li><strong>Nur mit Rechnung.</strong> Zahlen Sie nur eine Rechnung, auf der jede Position steht und die zum Telefonpreis passt.</li>
      </ol>
      <a class="extern" href={vz} target="_blank" rel="noopener">Tipps der Verbraucherzentrale gegen überhöhte Rechnungen<Icon name="external-link" /></a>
    </div>
  </div>

  <div class="block" id="einsaetze">
    <div class="wrap">
      <h2>Gesagt. Gezahlt.</h2>
      <p class="block__lead">Was wir am Telefon gesagt haben und was danach auf der Rechnung stand.</p>
      <ul class="journal">
        {einsaetze.liste.map((e) => (
          <li class="journal__e">
            <p class="journal__wo"><span class="num">{e.wann}</span> · {e.wo} · {e.art}, {e.tarif}</p>
            <p class="journal__geld num"><span>Gesagt: {e.gesagt}</span><span class="journal__gezahlt">Gezahlt: {e.gezahlt}</span></p>
            <p class="journal__notiz">{e.notiz}</p>
          </li>
        ))}
      </ul>
      <p class="journal__hinweis">{einsaetze.hinweis}</p>
    </div>
  </div>

  <div class="block block--2" id="fragen">
    <div class="wrap">
      <h2>Häufige Fragen</h2>
      <div class="faq">
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </div>
</section>

<style>
  .bereich { padding-bottom: var(--space-md); }
  .hero { padding-top: var(--space-md); padding-bottom: var(--space-xl); display: grid; gap: var(--space-sm); }
  .hero__live { display: flex; align-items: center; gap: var(--space-xs); font-weight: 700; font-size: var(--text-sm); }
  .hero__dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--color-ok); box-shadow: 0 0 0 3px oklch(52% 0.13 150 / 0.2); flex: none; }
  .hero__h { font-size: clamp(2.5rem, min(12.5vw, 11svh), 5.5rem); line-height: 0.98; letter-spacing: -0.02em; margin-bottom: var(--space-xs); }
  .hero__note { font-size: var(--text-sm); color: var(--color-ink-2); }
  .hero__cta { display: grid; gap: 0; margin-top: var(--space-2xs); }
  .preis__plz { margin-top: var(--space-xs); }

  .preis { display: grid; gap: var(--space-xs); }
  .preis__arten { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-xs); }
  .preis__arten legend { padding: 0; margin-bottom: var(--space-xs); font-weight: 700; font-size: var(--text-sm); }
  .kachel { position: relative; min-width: 0; }
  .kachel input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .kachel__in { display: grid; gap: 0.15rem; height: 100%; padding: var(--space-sm) var(--space-sm) var(--space-xs); border: var(--rule-ink); border-radius: var(--radius); background: var(--color-paper); }
  .kachel__name { font-weight: 700; font-size: var(--text-sm); hyphens: auto; }
  .kachel__preis { font-family: var(--font-display); font-size: clamp(2rem, min(10vw, 8svh), 3.25rem); line-height: 1; white-space: nowrap; }
  .kachel input:checked + .kachel__in { background: var(--color-ink); color: var(--color-paper); box-shadow: inset 0 -4px 0 var(--color-brass); }
  .kachel input:checked + .kachel__in .kachel__preis { color: var(--color-brass-light); }
  .kachel input:focus-visible + .kachel__in { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .preis__erkl { font-size: var(--text-sm); min-height: 2lh; }
  .preis__plz { display: grid; grid-template-columns: minmax(0, 9rem) minmax(0, 1fr); gap: var(--space-sm); align-items: end; }
  .preis__feld { display: grid; gap: var(--space-2xs); min-width: 0; }
  .preis__feld label { font-weight: 700; font-size: var(--text-sm); line-height: 1.2; }
  .preis__feld input { width: 100%; min-width: 0; min-height: 3rem; padding: 0.5rem 0.75rem; border: var(--rule-ink); border-radius: var(--radius); background: var(--color-paper); color: var(--color-ink); font: 700 1.375rem/1 var(--font-body); letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }
  .preis__feld input::placeholder { color: var(--color-ink-2); opacity: 0.8; font-weight: 400; font-size: 1rem; letter-spacing: 0; }
  .preis__summe { display: grid; align-content: end; min-height: 3rem; padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius); background: var(--color-paper-2); min-width: 0; }
  .preis__slabel { font-size: 0.875rem; font-weight: 700; color: var(--color-ink-2); }
  .preis__summe strong { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.05; }
  .preis__ssub { font-size: 0.875rem; color: var(--color-ink-2); }
  .preis__zone { font-size: var(--text-sm); color: var(--color-ink-2); }
  .preis__zone.is-ok { color: var(--color-ink); font-weight: 700; }
  .preis__zone.is-nein { color: var(--color-alert); font-weight: 700; }
  :global(html:not(.js)) .preis__plz, :global(html:not(.js)) .preis__zone { display: none; }

  .anruf { display: flex; align-items: center; gap: var(--space-md); min-height: 4.25rem; padding: var(--space-sm) var(--space-lg); background: var(--color-ink); color: var(--color-paper); border-radius: var(--radius-lg); text-decoration: none; box-shadow: inset 0 -4px 0 var(--color-brass); }
  .anruf__i { width: 2rem; height: 2rem; color: var(--color-brass); }
  .anruf__t { display: grid; font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.1; min-width: 0; }
  .anruf__nr { font-family: var(--font-body); font-weight: 700; font-size: var(--text-md); color: var(--color-brass-light); white-space: nowrap; }
  .anruf:focus-visible { outline-offset: 3px; }
  .wa { display: flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 2.75rem; font-weight: 700; text-underline-offset: 0.2em; }
  .wa :global(.icon) { width: 1.2em; height: 1.2em; }

  @media (max-width: 22.5rem) { .kachel__in { padding-inline: var(--space-xs); } .hero__live { font-size: 0.875rem; } }
  /* Niedrige Telefone: enger, damit „Jetzt anrufen“ in den ersten Bildschirm passt (WhatsApp bleibt in der Leiste unten) */
  @media (max-height: 36rem) and (max-width: 40rem) { .hero { gap: var(--space-xs); padding-top: var(--space-sm); } .kachel__in { padding-block: var(--space-xs); } .preis__erkl { min-height: 0; } .hero__cta .wa { display: none; } }
  /* Telefon quer: zwei Spalten, damit Preis und „Jetzt anrufen“ ohne Scrollen sichtbar sind */
  @media (orientation: landscape) and (max-height: 30rem) and (min-width: 34rem) {
    .hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); grid-template-areas: 'live form' 'h form' 'note form'; column-gap: var(--space-lg); align-items: start; padding-top: var(--space-sm); }
    .hero__live { grid-area: live; } .hero__h { grid-area: h; font-size: clamp(2.2rem, 7vw, 3.5rem); } .preis { grid-area: form; } .hero__note { grid-area: note; }
    .preis__erkl { min-height: 0; } .kachel__in { padding-block: var(--space-xs); } .kachel__preis { font-size: 2rem; } .hero__cta .wa { display: none; } .preis__arten legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  @media (min-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-areas: 'live form' 'h form' 'note form'; column-gap: var(--space-2xl); align-items: start; padding-top: var(--space-xl); padding-bottom: var(--space-2xl); }
    .hero__live { grid-area: live; } .hero__h { grid-area: h; } .preis { grid-area: form; } .hero__note { grid-area: note; align-self: start; }
  }

  .tarife { list-style: none; margin: 0 0 var(--space-lg); padding: 0; border-top: var(--rule-ink); }
  .tarif { display: grid; gap: var(--space-xs); padding: var(--space-sm) var(--space-xs); border-bottom: var(--rule); }
  .tarif__kopf { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-sm); }
  .tarif__kopf span { color: var(--color-ink-2); font-size: var(--text-sm); }
  .tarif__kopf .tarif__jetzt { display: none; padding: 0 var(--space-xs); border-radius: var(--radius); background: var(--color-ink); color: var(--color-brass-light); font-weight: 700; }
  .tarif__preise { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-sm); margin: 0; }
  .tarif__preise dt { font-size: 0.875rem; color: var(--color-ink-2); }
  .tarif__preise dd { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); }
  .tarif.is-jetzt { background: var(--color-brass-light); box-shadow: inset 4px 0 0 var(--color-ink); padding-left: var(--space-md); }
  .tarif.is-jetzt .tarif__jetzt { display: inline-block; }
  .tarif.is-jetzt .tarif__kopf span:not(.tarif__jetzt), .tarif.is-jetzt dt { color: var(--color-ink); }
  .extras { margin: 0 0 var(--space-lg); display: grid; gap: var(--space-sm); }
  .extras div { display: grid; gap: var(--space-2xs); padding-bottom: var(--space-sm); border-bottom: var(--rule); }
  .extras dt { font-weight: 700; }
  .extras dd { margin: 0; color: var(--color-ink-2); }
  .extras dd strong { color: var(--color-ink); }

  .wissen { margin: 0 0 var(--space-lg); padding: 0; list-style: none; counter-reset: w; display: grid; gap: var(--space-md); }
  .wissen li { counter-increment: w; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-sm); }
  .wissen li::before { content: counter(w); font-family: var(--font-display); font-size: var(--text-xl); line-height: 1; color: var(--color-brass); }
  .wissen strong { display: block; color: var(--color-brass-light); }
  .extern { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-paper); font-weight: 700; }
  .extern :global(.icon) { width: 1.1em; height: 1.1em; }

  .journal { list-style: none; margin: 0; padding: 0; border-top: var(--rule-ink); }
  .journal__e { display: grid; gap: var(--space-2xs); padding: var(--space-md) 0; border-bottom: var(--rule); }
  .journal__wo { font-size: var(--text-sm); color: var(--color-ink-2); }
  .journal__geld { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2xs) var(--space-md); font-weight: 700; }
  .journal__gezahlt { background: var(--color-brass-light); padding: 0 var(--space-xs); border-radius: var(--radius); }
  .journal__notiz { font-size: var(--text-sm); }
  .journal__hinweis { margin-top: var(--space-md); font-size: var(--text-sm); color: var(--color-ink-2); }

  .faq { border-top: var(--rule-ink); }
  .faq details { border-bottom: var(--rule); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); min-height: 3.25rem; padding: var(--space-sm) 0; font-weight: 700; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-display); font-size: var(--text-lg); flex: none; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { padding-bottom: var(--space-md); color: var(--color-ink-2); }
</style>

<script>
  import { zoneFuer, euro } from '../scripts/zone';
  import preise from '../data/preise.json';
  import site from '../data/site.json';
  type Art = 'zugefallen' | 'abgeschlossen';
  const form = document.querySelector<HTMLElement>('[data-rechner]');
  if (form) {
    const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const plz = $<HTMLInputElement>('#r-plz');
    const KEY = 'rechner';
    try {
      const d = JSON.parse(sessionStorage.getItem(KEY) || '{}');
      if (d.plz) plz.value = d.plz;
      if (d.art) form.querySelector<HTMLInputElement>(`input[name=art][value=${d.art}]`)!.checked = true;
    } catch {}
    const update = () => {
      const art = form.querySelector<HTMLInputElement>('input[name=art]:checked')!.value as Art;
      const t = preise.tarife.find((x) => x.id === ((window as any).AUF?.now?.tarif ?? 'tag'))!;
      const z = zoneFuer(plz.value);
      const zone = $('[data-zone]');
      $('[data-erkl]').textContent = preise.arten[art].kurz;
      zone.classList.remove('is-ok', 'is-nein');
      plz.removeAttribute('aria-invalid');
      const total = $('[data-s-total]'), sub = $('[data-s-sub]');
      if (!z) {
        zone.textContent = plz.value ? 'Bitte fünf Ziffern eingeben.' : 'Stadt Hannover 0 €, Nachbarorte 15 €, Region 25 €.';
        total.textContent = euro(t[art]);
        sub.textContent = '+ Anfahrt 0–25 €';
      } else if (!z.ok) {
        zone.textContent = z.text;
        zone.classList.add('is-nein');
        plz.setAttribute('aria-invalid', 'true');
        total.textContent = '–';
        sub.textContent = 'nicht in unserem Gebiet';
      } else {
        zone.textContent = `Ja, wir kommen: ${z.text}`;
        zone.classList.add('is-ok');
        total.textContent = euro(t[art] + z.anfahrt!);
        sub.textContent = `inkl. Anfahrt ${euro(z.anfahrt!)}`;
      }
      // WhatsApp-Text mit Angaben füllen (überall auf der Seite)
      const txt = `Hallo, Tür ${art}${z?.ok ? `, PLZ ${plz.value}` : ''}. Adresse: `;
      document.querySelectorAll<HTMLAnchorElement>('a[data-wa]').forEach((a) => { a.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(txt)}`; });
      try { sessionStorage.setItem(KEY, JSON.stringify({ plz: plz.value, art })); } catch {}
    };
    plz.addEventListener('input', () => { plz.value = plz.value.replace(/\D/g, '').slice(0, 5); update(); if (plz.value.length === 5) plz.blur(); });
    form.addEventListener('change', update);
    plz.addEventListener('keydown', (e) => { if (e.key === 'Enter') plz.blur(); });
    document.addEventListener('auf:tick', update);
    update();
  }
  // Uhrzeit-Anzeige alle 30 s auffrischen
  setInterval(() => (window as any).AUF?.fill(), 30000);
</script>
