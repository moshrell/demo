---
// Bereich NOTFALL: großer Text, Live-Festpreis nach Uhrzeit, Anrufen/WhatsApp, PLZ-Rechner, alle Preise,
// „Was Sie vorher wissen sollten“, Einsatz-Journal „Gesagt. Gezahlt.“, Fragen.
import site from '../data/site.json';
import preise from '../data/preise.json';
import einsaetze from '../data/einsaetze.json';
import faq from '../data/faq.json';
import Icon from './Icon.astro';
const tag = preise.tarife[0];
const min = (k: 'zugefallen' | 'abgeschlossen') => Math.min(...preise.tarife.map((t) => t[k]));
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich habe mich ausgesperrt. PLZ: , Adresse: ')}`;
const vz = 'https://www.verbraucherzentrale.de/wissen/vertraege-reklamation/abzocke/schluesseldienste-so-schuetzen-sie-sich-vor-ueberzogen-hohen-rechnungen-6687';
---
<section class="bereich notfall" id="notfall" data-mode-panel="notfall" aria-labelledby="nf-h">
  <div class="wrap hero">
    <h1 id="nf-h" class="hero__h">Tür zu?<br />Wir machen auf.</h1>
    <p class="hero__sub">Schlüsseldienst in Hannover. Der Preis steht hier, bevor Sie anrufen.</p>

    <div class="live" aria-live="polite">
      <p class="live__jetzt" data-live-jetzt>Festpreise je nach Uhrzeit</p>
      <dl class="live__preise">
        <div><dt>Zugefallen</dt><dd class="num" data-live-zu>ab {min('zugefallen')} €</dd></div>
        <div><dt>Abgeschlossen</dt><dd class="num" data-live-ab>ab {min('abgeschlossen')} €</dd></div>
      </dl>
      <p class="live__plus">+ Anfahrt 0–25 € je nach PLZ · {preise.mwst}</p>
    </div>

    <a class="anruf" href={`tel:${site.phoneHref}`} data-call>
      <Icon name="phone" class="icon anruf__i" />
      <span class="anruf__t"><span>Jetzt anrufen</span><span class="anruf__nr num">{site.phone}</span></span>
    </a>
    <a class="wa" href={wa} target="_blank" rel="noopener" data-wa>
      <Icon name="message-circle" /><span>Lieber schreiben: WhatsApp</span>
    </a>
    <p class="hero__note">Wir nennen den Gesamtpreis am Telefon, bevor wir losfahren. Zahlung mit Karte oder bar, mit Rechnung.</p>
  </div>
  <script is:inline>window.AUF && window.AUF.fill();</script>

  <div class="block block--2" id="rechner">
    <div class="wrap">
      <h2>Was kostet es bei Ihnen?</h2>
      <form class="rechner" data-rechner novalidate>
        <div class="feld">
          <label for="r-plz">Ihre Postleitzahl</label>
          <input id="r-plz" name="plz" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="z. B. 30451" maxlength="5" pattern="[0-9]{5}" aria-describedby="r-zone" />
          <p class="feld__info" id="r-zone" data-zone aria-live="polite">Fünf Ziffern, dann sehen Sie die Anfahrt.</p>
        </div>
        <fieldset class="seg">
          <legend>Wie ist die Tür zu?</legend>
          <label><input type="radio" name="art" value="zugefallen" checked /><span>Zugefallen</span></label>
          <label><input type="radio" name="art" value="abgeschlossen" /><span>Abgeschlossen</span></label>
        </fieldset>
        <p class="rechner__erkl" data-erkl>{preise.arten.zugefallen.erklaerung}</p>
        <fieldset class="seg seg--klein">
          <legend>Wann?</legend>
          <label><input type="radio" name="wann" value="jetzt" checked /><span>Jetzt</span></label>
          {preise.tarife.map((t) => <label><input type="radio" name="wann" value={t.id} /><span>{t.name.replace(' und ', '/')}</span></label>)}
        </fieldset>
        <dl class="summe num" data-summe>
          <div><dt data-s-tarif>Festpreis Türöffnung</dt><dd data-s-preis>{tag.zugefallen} €</dd></div>
          <div><dt data-s-zone>Anfahrt (PLZ fehlt)</dt><dd data-s-anfahrt>0–25 €</dd></div>
          <div class="summe__total"><dt>Summe</dt><dd data-s-total>–</dd></div>
        </dl>
        <p class="rechner__out" data-ausserhalb hidden></p>
        <p class="rechner__note">{preise.mwst}. Diesen Preis nennen wir Ihnen auch am Telefon, bevor wir losfahren.</p>
        <a class="anruf anruf--klein" href={`tel:${site.phoneHref}`} data-call>
          <Icon name="phone" class="icon anruf__i" /><span class="anruf__t"><span data-call-label>Zu diesem Preis anrufen</span></span>
        </a>
      </form>
    </div>
  </div>

  <div class="block" id="preise">
    <div class="wrap">
      <h2>Alle Preise</h2>
      <p class="block__lead">Festpreise für die Türöffnung, {preise.mwst}. Die Zeile „jetzt“ gilt gerade.</p>
      <div class="tabelle" role="table" aria-label="Festpreise Türöffnung">
        <div class="tabelle__kopf" role="row"><span role="columnheader">Wann</span><span role="columnheader">Zugefallen</span><span role="columnheader">Abgeschl.</span></div>
        {preise.tarife.map((t) => (
          <div class="tabelle__zeile" role="row" data-tarif-row={t.id}>
            <span role="cell" class="tabelle__wann"><strong>{t.name}</strong><span>{t.wann}</span><span class="tabelle__jetzt">jetzt</span></span>
            <span role="cell" class="num">{t.zugefallen} €</span>
            <span role="cell" class="num">{t.abgeschlossen} €</span>
          </div>
        ))}
      </div>
      <dl class="extras">
        <div><dt>Anfahrt</dt><dd>Stadt Hannover 0 € · Nachbarorte 15 € · Region 25 €</dd></div>
        {preise.extras.map((e) => <div><dt>{e.name}</dt><dd><strong class="num">{e.preis}</strong> {e.text}</dd></div>)}
      </dl>
      <p class="block__lead">Zugefallen oder abgeschlossen? <strong>Zugefallen:</strong> {preise.arten.zugefallen.erklaerung} <strong>Abgeschlossen:</strong> {preise.arten.abgeschlossen.erklaerung}</p>
    </div>
  </div>
  <script is:inline>window.AUF && window.AUF.fill();</script>

  <div class="block block--ink" id="wissen">
    <div class="wrap">
      <h2>Was Sie vorher wissen sollten</h2>
      <ol class="wissen">
        <li><strong>Gesamtpreis vorher.</strong> Lassen Sie sich am Telefon den ganzen Preis sagen, mit Anfahrt und Zuschlägen. Bei uns steht er oben.</li>
        <li><strong>Ausweis zeigen.</strong> Wir öffnen nur, wenn klar ist, dass Sie dort wohnen. Das schützt Sie vor Einbrechern.</li>
        <li><strong>Karte statt Geldautomat.</strong> Zahlen Sie mit Karte oder bar, aber fahren Sie mit niemandem zum Geldautomaten.</li>
        <li><strong>Nur mit Rechnung.</strong> Zahlen Sie nur eine Rechnung, auf der jede Position steht und die zum Telefonpreis passt.</li>
      </ol>
      <a class="extern" href={vz} target="_blank" rel="noopener">Tipps der Verbraucherzentrale gegen überhöhte Rechnungen<Icon name="external-link" /></a>
    </div>
  </div>

  <div class="block" id="einsaetze">
    <div class="wrap">
      <h2>Gesagt. Gezahlt.</h2>
      <p class="block__lead">Was wir am Telefon gesagt haben und was danach auf der Rechnung stand.</p>
      <ul class="journal">
        {einsaetze.liste.map((e) => (
          <li class="journal__e">
            <p class="journal__wo"><span class="num">{e.wann}</span> · {e.wo} · {e.art}, {e.tarif}</p>
            <p class="journal__geld num"><span>Gesagt: {e.gesagt}</span><span class="journal__gezahlt">Gezahlt: {e.gezahlt}</span></p>
            <p class="journal__notiz">{e.notiz}</p>
          </li>
        ))}
      </ul>
      <p class="journal__hinweis">{einsaetze.hinweis}</p>
    </div>
  </div>

  <div class="block block--2" id="fragen">
    <div class="wrap">
      <h2>Häufige Fragen</h2>
      <div class="faq">
        {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </div>
</section>

<style>
  .bereich { padding-bottom: var(--space-md); }
  .hero { padding-top: var(--space-lg); padding-bottom: var(--space-xl); display: grid; gap: var(--space-md); }
  .hero__h { font-size: var(--text-display); line-height: 0.98; letter-spacing: -0.02em; }
  .hero__sub { font-size: var(--text-md); color: var(--color-ink-2); max-width: 32rem; }
  .live { border-top: var(--rule-ink); border-bottom: var(--rule-ink); padding: var(--space-sm) 0; display: grid; gap: var(--space-xs); }
  .live__jetzt { font-weight: 700; font-size: var(--text-sm); display: flex; align-items: center; gap: var(--space-xs); }
  .live__jetzt::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--color-brass); box-shadow: 0 0 0 3px var(--color-ink); flex: none; }
  .live__preise { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-md); margin: 0; }
  .live__preise dt { font-size: var(--text-sm); font-weight: 700; color: var(--color-ink-2); }
  .live__preise dd { margin: 0; font-family: var(--font-display); font-size: var(--text-price); line-height: 1; white-space: nowrap; }
  .live__plus { font-size: var(--text-sm); color: var(--color-ink-2); }
  .hero__note { font-size: var(--text-sm); color: var(--color-ink-2); }

  .anruf { display: flex; align-items: center; gap: var(--space-md); min-height: 4.5rem; padding: var(--space-sm) var(--space-lg); background: var(--color-ink); color: var(--color-paper); border-radius: var(--radius-lg); text-decoration: none; box-shadow: inset 0 -4px 0 var(--color-brass); }
  .anruf__i { width: 2rem; height: 2rem; color: var(--color-brass); }
  .anruf__t { display: grid; font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.1; min-width: 0; }
  .anruf__nr { font-family: var(--font-body); font-weight: 700; font-size: var(--text-md); color: var(--color-brass-light); white-space: nowrap; }
  .anruf:focus-visible { outline-offset: 3px; }
  .anruf--klein { min-height: 3.5rem; margin-top: var(--space-xs); }
  .anruf--klein .anruf__t { font-size: var(--text-md); }
  .wa { display: flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 3rem; border: var(--rule-ink); border-radius: var(--radius-lg); text-decoration: none; font-weight: 700; }


  .rechner { display: grid; gap: var(--space-md); }
  .feld { display: grid; gap: var(--space-2xs); }
  .feld label, .seg legend { font-weight: 700; font-size: var(--text-sm); }
  .feld input { width: 100%; min-height: 3.25rem; padding: 0.6rem 0.9rem; border: var(--rule-ink); border-radius: var(--radius); background: var(--color-paper); font: 700 1.5rem/1 var(--font-body); letter-spacing: 0.12em; font-variant-numeric: tabular-nums; }
  .feld input::placeholder { color: var(--color-ink-2); opacity: 0.75; letter-spacing: 0.02em; font-weight: 400; font-size: 1.125rem; }
  .feld__info { font-size: var(--text-sm); color: var(--color-ink-2); }
  .feld__info.is-ok { color: var(--color-ink); font-weight: 700; }
  .feld__info.is-nein { color: var(--color-alert); font-weight: 700; }
  .seg { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs); min-width: 0; }
  .seg legend { padding: 0; margin-bottom: var(--space-xs); }
  .seg--klein { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; }
  .seg span { display: flex; align-items: center; justify-content: center; min-height: 3rem; padding: var(--space-xs); border: var(--rule-ink); border-radius: var(--radius); text-align: center; font-weight: 700; line-height: 1.15; cursor: pointer; background: var(--color-paper); }
  .seg--klein span { min-height: 2.75rem; font-size: var(--text-sm); }
  .seg input:checked + span { background: var(--color-ink); color: var(--color-paper); }
  .seg input:focus-visible + span { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .rechner__erkl { font-size: var(--text-sm); }
  .summe { margin: 0; border: var(--rule-ink); border-radius: var(--radius); background: var(--color-paper); }
  .summe div { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) var(--space-md); border-bottom: var(--rule); }
  .summe dd { margin: 0; font-weight: 700; white-space: nowrap; }
  .summe__total { border-bottom: 0 !important; background: var(--color-ink); color: var(--color-paper); }
  .summe__total dt { font-weight: 700; }
  .summe__total dd { font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-brass-light); }
  .rechner__out { font-weight: 700; color: var(--color-alert); }
  .rechner__note { font-size: var(--text-sm); color: var(--color-ink-2); }

  .tabelle { border-top: var(--rule-ink); margin-bottom: var(--space-lg); }
  .tabelle__kopf, .tabelle__zeile { display: grid; grid-template-columns: minmax(0, 1fr) 5.2rem 5.2rem; gap: var(--space-xs); align-items: center; padding: var(--space-sm) var(--space-xs); border-bottom: var(--rule); }
  .tabelle__kopf { font-size: 0.875rem; font-weight: 700; color: var(--color-ink-2); }
  .tabelle__kopf span:not(:first-child), .tabelle__zeile .num { text-align: right; }
  .tabelle__zeile .num { font-family: var(--font-display); font-size: var(--text-lg); }
  .tabelle__wann { display: grid; font-size: var(--text-sm); line-height: 1.3; min-width: 0; }
  .tabelle__wann span { color: var(--color-ink-2); }
  .tabelle__jetzt { display: none; justify-self: start; margin-top: var(--space-2xs); padding: 0 var(--space-xs); border-radius: var(--radius); background: var(--color-ink); color: var(--color-brass-light) !important; font-weight: 700; }
  .tabelle__zeile.is-jetzt { background: var(--color-brass-light); box-shadow: inset 4px 0 0 var(--color-ink); }
  .tabelle__zeile.is-jetzt .tabelle__jetzt { display: inline-block; }
  .extras { margin: 0 0 var(--space-lg); display: grid; gap: var(--space-sm); }
  .extras div { display: grid; gap: var(--space-2xs); padding-bottom: var(--space-sm); border-bottom: var(--rule); }
  .extras dt { font-weight: 700; }
  .extras dd { margin: 0; color: var(--color-ink-2); }
  .extras dd strong { color: var(--color-ink); }

  .wissen { margin: 0 0 var(--space-lg); padding: 0; list-style: none; counter-reset: w; display: grid; gap: var(--space-md); }
  .wissen li { counter-increment: w; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-sm); }
  .wissen li::before { content: counter(w); font-family: var(--font-display); font-size: var(--text-xl); line-height: 1; color: var(--color-brass); }
  .wissen strong { display: block; color: var(--color-brass-light); }
  .extern { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-paper); font-weight: 700; }
  .extern :global(.icon) { width: 1.1em; height: 1.1em; }

  .journal { list-style: none; margin: 0; padding: 0; border-top: var(--rule-ink); }
  .journal__e { display: grid; gap: var(--space-2xs); padding: var(--space-md) 0; border-bottom: var(--rule); }
  .journal__wo { font-size: var(--text-sm); color: var(--color-ink-2); }
  .journal__geld { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2xs) var(--space-md); font-weight: 700; }
  .journal__gezahlt { background: var(--color-brass-light); padding: 0 var(--space-xs); border-radius: var(--radius); }
  .journal__notiz { font-size: var(--text-sm); }
  .journal__hinweis { margin-top: var(--space-md); font-size: var(--text-sm); color: var(--color-ink-2); }

  .faq { border-top: var(--rule-ink); }
  .faq details { border-bottom: var(--rule); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); min-height: 3.25rem; padding: var(--space-sm) 0; font-weight: 700; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--font-display); font-size: var(--text-lg); flex: none; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { padding-bottom: var(--space-md); color: var(--color-ink-2); }
  @media (min-width: 40rem) { .seg--klein { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  import { zoneFuer, euro } from '../scripts/zone';
  import preise from '../data/preise.json';
  import site from '../data/site.json';
  type Art = 'zugefallen' | 'abgeschlossen';
  const form = document.querySelector<HTMLFormElement>('[data-rechner]');
  if (form) {
    const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const plz = $<HTMLInputElement>('#r-plz');
    const KEY = 'rechner';
    const restore = () => {
      try {
        const d = JSON.parse(sessionStorage.getItem(KEY) || '{}');
        if (d.plz) plz.value = d.plz;
        if (d.art) (form.querySelector<HTMLInputElement>(`input[name=art][value=${d.art}]`)!).checked = true;
        if (d.wann) (form.querySelector<HTMLInputElement>(`input[name=wann][value=${d.wann}]`)!).checked = true;
      } catch {}
    };
    const update = () => {
      const art = (form.querySelector<HTMLInputElement>('input[name=art]:checked')!.value) as Art;
      const wann = form.querySelector<HTMLInputElement>('input[name=wann]:checked')!.value;
      const tid = wann === 'jetzt' ? (window as any).AUF?.now?.tarif ?? 'tag' : wann;
      const t = preise.tarife.find((x) => x.id === tid)!;
      const z = zoneFuer(plz.value);
      const zoneEl = $('[data-zone]');
      const aus = $('[data-ausserhalb]');
      $('[data-erkl]').textContent = preise.arten[art].erklaerung;
      $('[data-s-tarif]').textContent = `${preise.arten[art].label}, ${t.kurz}`;
      $('[data-s-preis]').textContent = euro(t[art]);
      zoneEl.classList.remove('is-ok', 'is-nein');
      aus.hidden = true;
      let total: number | null = null;
      if (!z) {
        zoneEl.textContent = plz.value ? 'Bitte fünf Ziffern eingeben.' : 'Fünf Ziffern, dann sehen Sie die Anfahrt.';
        $('[data-s-zone]').textContent = 'Anfahrt (PLZ fehlt)';
        $('[data-s-anfahrt]').textContent = '0–25 €';
      } else if (!z.ok) {
        zoneEl.textContent = 'Außerhalb unseres Gebiets.';
        zoneEl.classList.add('is-nein');
        aus.textContent = z.text;
        aus.hidden = false;
        $('[data-s-zone]').textContent = 'Anfahrt';
        $('[data-s-anfahrt]').textContent = '–';
      } else {
        zoneEl.textContent = `Ja, wir kommen: ${z.text}`;
        zoneEl.classList.add('is-ok');
        $('[data-s-zone]').textContent = `Anfahrt Zone ${z.zone} (${z.ort})`;
        $('[data-s-anfahrt]').textContent = euro(z.anfahrt!);
        total = t[art] + z.anfahrt!;
      }
      $('[data-s-total]').textContent = total === null ? (z && !z.ok ? '–' : `${euro(t[art])} + Anfahrt`) : euro(total);
      $('[data-call-label]').textContent = total === null ? 'Jetzt anrufen' : `Für ${euro(total)} anrufen`;
      // WhatsApp-Text mit Angaben füllen (überall auf der Seite)
      const txt = `Hallo, Tür ${art}${z?.ok ? `, PLZ ${plz.value.replace(/\D/g, '')}` : ''}. Adresse: `;
      document.querySelectorAll<HTMLAnchorElement>('a[data-wa]').forEach((a) => { a.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(txt)}`; });
      try { sessionStorage.setItem(KEY, JSON.stringify({ plz: plz.value, art, wann })); } catch {}
    };
    plz.addEventListener('input', () => { plz.value = plz.value.replace(/\D/g, '').slice(0, 5); update(); if (plz.value.length === 5) plz.blur(); });
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    document.addEventListener('auf:tick', update);
    restore();
    update();
  }
  // Uhrzeit-Anzeige alle 30 s auffrischen
  setInterval(() => (window as any).AUF?.fill(), 30000);
</script>
