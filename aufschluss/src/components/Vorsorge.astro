---
// Bereich VORSORGE: ruhig, mit Fotos (lazy, erst beim Öffnen geladen). Schlüsselbund-Karten (Swipe, scroll-snap),
// Beratung vor Ort, Hausverwaltungen mit Schließanlagen-Formular, Über uns und Ablauf.
import site from '../data/site.json';
import vorsorge from '../data/vorsorge.json';
import preise from '../data/preise.json';
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import BeratungForm from './BeratungForm.astro';
import B2BForm from './B2BForm.astro';
---
<section class="bereich vorsorge" id="vorsorge" data-mode-panel="vorsorge" aria-labelledby="vs-h">
  <div class="wrap vs-hero">
    <h2 id="vs-h" class="vs-hero__h">In Ruhe sicherer wohnen.</h2>
    <p class="vs-hero__lead">Nach einem Einbruch in der Nachbarschaft fragen sich viele: Was hilft wirklich? Wir kommen vorbei, zeigen es an Ihrer Tür und nennen den Preis schriftlich.</p>
    <Foto name="zylinder-nah" alt="Sicherheitszylinder aus Messing in einer hellen Wohnungstür" ratio="4 / 3" />
  </div>

  <div class="bund" aria-labelledby="bund-h">
    <div class="wrap">
      <h2 id="bund-h">Was wir einbauen</h2>
      <p class="bund__lead">Wischen Sie durch den Schlüsselbund. Preise {preise.mwst}, mit Montage, ohne Anfahrt. Der genaue Preis kommt nach der Besichtigung.</p>
    </div>
    <ul class="bund__liste" data-bund tabindex="0" aria-label="Leistungen, seitlich wischen">
      {vorsorge.karten.map((k, i) => (
        <li class="anh" data-anh={i} id={`karte-${k.id}`}>
          <article class="anh__in">
            <Foto name={k.img} alt={k.alt} ratio="4 / 3" sizes="(min-width: 46rem) 22rem, 78vw" widths={[320, 480, 700, 900]} />
            <h3>{k.titel}</h3>
            <p class="anh__text">{k.text}</p>
            <p class="anh__preis num">{k.preis}</p>
            {k.id === 'anlage'
              ? <a class="anh__btn" href="#b2b"><span>Für Hausverwaltungen</span><Icon name="arrow-right" /></a>
              : <a class="anh__btn" href="#beratung" data-thema={k.id}><span>Beratung vor Ort anfragen</span><Icon name="arrow-right" /></a>}
          </article>
        </li>
      ))}
    </ul>
    <p class="bund__dots" aria-hidden="true">{vorsorge.karten.map((_, i) => <span data-dot={i}></span>)}</p>
  </div>

  <div class="block block--2" id="beratung">
    <div class="wrap">
      <h2>Beratung vor Ort</h2>
      <p class="block__lead">{preise.beratung} € plus Anfahrt, bei Auftrag voll angerechnet. So kommen nur Termine zustande, die Ihnen wirklich etwas bringen.</p>
      <ol class="ablauf" aria-label="So läuft es ab">
        {vorsorge.ablauf.map((s) => <li><strong>{s.t}</strong><span>{s.d}</span></li>)}
      </ol>
      <BeratungForm />
    </div>
  </div>

  <div class="block" id="b2b">
    <div class="wrap">
      <h2>Für Hausverwaltungen</h2>
      <p class="block__lead">Schließanlagen für Mehrfamilienhäuser und Büros. Sie bekommen den Meister als festen Ansprechpartner.</p>
      <div class="b2b__grid">
        <Foto name="hauseingang-mfh" alt="Eingang eines hellen Mehrfamilienhauses mit dunkler Glastür und Briefkästen" ratio="4 / 3" sizes="(min-width: 40rem) 15rem, 100vw" widths={[360, 560, 800, 1100]} class="b2b__foto" />
        <ul class="haken">
          {vorsorge.b2b.punkte.map((p) => <li><Icon name="check" />{p}</li>)}
        </ul>
      </div>
      <p class="b2b__richt">Richtwert ab <strong class="num">{vorsorge.b2b.proTuer} € pro Tür</strong>: Zylinder, Montage und {vorsorge.b2b.inklSchluessel} Schlüssel, {preise.mwst}.</p>
      <details class="b2b__auf" id="b2b-anfrage" data-b2b-auf>
        <summary class="b2b__knopf">Objekt anfragen <Icon name="arrow-right" /></summary>
        <B2BForm />
      </details>
    </div>
  </div>

  <div class="block block--2" id="ueber">
    <div class="wrap">
      <h2>Wer kommt</h2>
      <div class="ueber">
        <Foto name="meister-werkzeug" alt="Hände eines Schlossers feilen einen Messingschlüssel im Schraubstock" ratio="4 / 3" />
        <p>{site.owner}, {site.beruf}. Seit neun Jahren mit eigener Werkstatt in {site.address.district}, zu zweit mit zwei Wagen. Wir öffnen Türen, bauen Schlösser ein und planen Schließanlagen. Autos öffnen wir nicht.</p>
      </div>
      <p class="werkstatt"><Icon name="map-pin" /><span>Werkstatt: {site.address.street}, {site.address.zip} {site.address.city}<br /><span data-werkstatt>{site.werkstatt.label}</span>. Notdienst rund um die Uhr per Telefon.<br /><a href={site.mapLink} target="_blank" rel="noopener">Auf der Karte zeigen</a></span></p>
    </div>
  </div>
</section>

<style>
  .vs-hero { padding-top: var(--space-lg); padding-bottom: var(--space-xl); display: grid; gap: var(--space-md); }
  .vs-hero__h { font-size: clamp(2.2rem, 10vw, 4.5rem); line-height: 1; }
  .vs-hero__lead { color: var(--color-ink-2); max-width: 34rem; }

  .bund { padding: var(--space-xl) 0 var(--space-2xl); background: var(--color-paper-2); }
  .bund h2 { margin-bottom: var(--space-sm); }
  .bund__lead { color: var(--color-ink-2); }
  .bund__liste { list-style: none; margin: 0; padding: var(--space-lg) var(--gutter) var(--space-md); display: grid; grid-auto-flow: column; grid-auto-columns: min(84%, 21rem); gap: var(--space-sm); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); overscroll-behavior-x: contain; scrollbar-width: none; }
  .bund__liste::-webkit-scrollbar { display: none; }
  .bund__liste:focus-visible { outline-offset: -3px; }
  .anh { scroll-snap-align: start; min-width: 0; }
  .anh__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr auto auto; gap: var(--space-sm); height: 100%; padding: 2.25rem var(--space-md) var(--space-md); border: var(--rule-ink); border-radius: 1.75rem var(--radius-lg) var(--radius) var(--radius); background: var(--color-paper); }
  /* Loch des Schlüsselanhängers: reine Geometrie */
  .anh__in::before { content: ''; position: absolute; top: 0.75rem; left: 1rem; width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--color-paper-2); box-shadow: inset 0 0 0 2px var(--color-ink); }
  .anh h3 { overflow-wrap: anywhere; hyphens: auto; }
  .anh__text { font-size: var(--text-sm); color: var(--color-ink-2); }
  .anh__preis { font-family: var(--font-display); font-size: var(--text-xl); align-self: end; }
  .anh__btn { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); min-height: 3rem; padding: var(--space-xs) var(--space-sm); border-radius: var(--radius); background: var(--color-ink); color: var(--color-paper); text-decoration: none; font-weight: 700; line-height: 1.2; }
  .anh__btn > span { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .anh__btn :global(.icon) { color: var(--color-brass); flex: none; }
  .anh__btn:focus-visible { outline-offset: 2px; }
  .bund__dots { display: flex; justify-content: center; gap: var(--space-xs); margin: 0; }
  .bund__dots span { width: 0.6rem; height: 0.6rem; border-radius: 50%; border: 2px solid var(--color-ink); }
  .bund__dots span.is-an { background: var(--color-ink); }
  /* Großer Bildschirm: kein Wischen mit der Maus, alle Karten als Raster */
  @media (min-width: 48rem) {
    .bund__liste { grid-auto-flow: row; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); overflow: visible; max-width: 72rem; margin-inline: auto; }
    .bund__dots { display: none; }
  }

  .b2b__richt { margin-bottom: var(--space-md); }
  .b2b__auf { border-top: var(--rule-ink); }
  .b2b__knopf { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); min-height: 3.25rem; margin: var(--space-md) 0; padding: var(--space-xs) var(--space-lg); border-radius: var(--radius-lg); background: var(--color-ink); color: var(--color-paper); font-weight: 700; cursor: pointer; list-style: none; box-shadow: inset 0 -4px 0 var(--color-brass); }
  .b2b__knopf::-webkit-details-marker { display: none; }
  .b2b__knopf :global(.icon) { color: var(--color-brass); transition: rotate var(--dur-fast) var(--ease-out); }
  .b2b__auf[open] .b2b__knopf :global(.icon) { rotate: 90deg; }
  .b2b__knopf:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .b2b__grid { display: grid; gap: var(--space-lg); margin-bottom: var(--space-lg); }
  .haken { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .haken li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-sm); }
  .haken :global(.icon) { width: 1.4rem; height: 1.4rem; color: var(--color-brass-deep); margin-top: 0.1rem; }
  /* Telefon: quer zugeschnitten (sonst ein bildschirmhohes Foto), ab Tablet hochkant neben der Liste */
  .b2b__grid :global(.b2b__foto) { object-position: 50% 35%; }
  @media (min-width: 40rem) { .b2b__grid :global(.b2b__foto) { aspect-ratio: 3 / 4 !important; } }
  @media (min-width: 40rem) { .b2b__grid:has(.foto) { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); align-items: start; } }

  .ueber { display: grid; gap: var(--space-md); margin-bottom: var(--space-xl); }
  .ablauf { list-style: none; margin: 0 0 var(--space-xl) 1rem; padding: 0; counter-reset: a; display: grid; gap: 0; border-left: 3px solid var(--color-brass); }
  .ablauf li { counter-increment: a; display: grid; gap: var(--space-2xs); padding: 0 0 var(--space-lg) var(--space-lg); position: relative; }
  .ablauf li::before { content: counter(a); position: absolute; left: -1.05rem; top: 0; width: 1.8rem; height: 1.8rem; display: grid; place-items: center; border-radius: 50%; background: var(--color-ink); color: var(--color-paper); font-family: var(--font-display); font-size: 0.875rem; }
  .ablauf span { color: var(--color-ink-2); }
  .werkstatt { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-sm); }
  .werkstatt a { display: inline-block; padding-block: var(--space-xs); }
  .werkstatt :global(.icon) { margin-top: 0.15rem; }
</style>

<script>
  // Schlüsselbund: aktive Karte erkennen (gerade hängen, Punkte), „Beratung anfragen“ wählt das Thema vor
  const liste = document.querySelector<HTMLElement>('[data-bund]');
  if (liste) {
    const karten = [...liste.querySelectorAll<HTMLElement>('[data-anh]')];
    const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
    const setAn = (i: number) => { karten.forEach((k, j) => k.classList.toggle('is-an', i === j)); dots.forEach((d, j) => d.classList.toggle('is-an', i === j)); };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting && e.intersectionRatio > 0.6) setAn(Number((e.target as HTMLElement).dataset.anh)); });
    }, { root: liste, threshold: [0.6] });
    karten.forEach((k) => io.observe(k));
    setAn(0);
  }
  // Hausverwaltung kommt per QR auf #b2b: Formular gleich offen. Gespeicherte Eingaben: auch offen.
  const auf = document.querySelector<HTMLDetailsElement>('[data-b2b-auf]');
  if (auf) {
    let saved = false;
    try { saved = !!sessionStorage.getItem(`form:${location.pathname}:b2b-form`); } catch {}
    if (saved || /^#b2b/.test(location.hash)) auf.open = true;
    addEventListener('hashchange', () => { if (/^#b2b/.test(location.hash)) auf.open = true; });
    document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href="#b2b"]')) auf.open = true; });
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-thema]');
    if (a) document.dispatchEvent(new CustomEvent('vorsorge:thema', { detail: a.dataset.thema }));
  });
</script>
