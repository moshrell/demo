---
import Base from '../layouts/Base.astro';
import bakery from '../data/bakery.json';
const base = import.meta.env.BASE_URL;
---
<Base title={`Impressum · ${bakery.name}`}>
  <main class="legal" id="inhalt">
    <div class="legal__in">
      <a class="back" href={base}>← Zurück zur Backstube</a>
      <h1>Impressum</h1>
      <p><strong>{bakery.name}</strong> ist eine fiktive Bäckerei. Diese Seite ist eine Demo-Website und zeigt, wie ein Internetauftritt für eine Bäckerei aussehen kann. Alle Namen, Adressen, Preise und Stimmen sind erfunden, die Bilder sind KI-generiert.</p>
      <h2>Verantwortlich für diese Website</h2>
      <p>Die Angaben nach § 5 DDG finden Sie im Impressum von <a href="https://kravets-webdesign.de/impressum/">Kravets Webdesign</a>.</p>
    </div>
  </main>
</Base>
