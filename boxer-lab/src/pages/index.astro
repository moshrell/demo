// Лабораторный тест: 3D-оппозитник, нарисованный кодом (three.js). Не демо клиента.
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Boxer-6 · 3D-Test</title>
    <link rel="icon" href="data:," />
    <style is:global>
      html,body{margin:0;height:100%;overflow:hidden;background:#e8e4da}
      body{background:radial-gradient(ellipse at 50% 40%,#f5f2ea 0%,#e7e3d9 62%,#d8d3c5 100%);font-family:system-ui,sans-serif;color:#1b1d21}
      canvas{display:block;position:fixed;inset:0;touch-action:none}
      #v{position:fixed;left:0;right:0;bottom:max(12px,env(safe-area-inset-bottom));display:flex;gap:6px;justify-content:center;flex-wrap:wrap;padding:0 12px}
      #v button{font:600 13px/1 system-ui,sans-serif;min-height:44px;padding:0 11px;border-radius:22px;border:1px solid #1b1d2133;background:#ffffffcc;color:#1b1d21;backdrop-filter:blur(6px);cursor:pointer}
      #v button.on{background:#1b1d21;color:#fff;border-color:#1b1d21}
      #tag{position:fixed;top:max(12px,env(safe-area-inset-top));left:16px;font:600 12px/1.3 system-ui;letter-spacing:.06em;text-transform:uppercase;opacity:.6}
    </style>
  </head>
  <body>
    <div id="tag">3D-Test · Boxer-6 aus Code</div>
    <canvas id="c"></canvas>
    <nav id="v" aria-label="Kameraansichten"></nav>
    <script>import '../lab/main.js';</script>
  </body>
</html>
