---
import Base from '../layouts/Base.astro';
import cafe from '../data/cafe.json';
const base = import.meta.env.BASE_URL;
---
<Base title={`Impressum · ${cafe.name}`}>
  <main class="legal" id="inhalt">
    <div class="legal__in">
      <a class="back" href={base}>← Zurück zum Café</a>
      <h1>Impressum</h1>
      <p><strong>{cafe.name}</strong> ist ein fiktives Café. Diese Seite ist eine Demo-Website und zeigt, wie ein Internetauftritt für ein Café aussehen kann. Alle Namen, Adressen, Preise und Geschichten sind erfunden, die Bilder sind KI-generiert.</p>
      <h2>Verantwortlich für diese Website</h2>
      <p>Die Angaben nach § 5 DDG finden Sie im Impressum von <a href="https://kravets-webdesign.de/impressum/">Kravets Webdesign</a>.</p>
    </div>
  </main>
</Base>
