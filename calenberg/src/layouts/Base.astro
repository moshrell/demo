---
// SEO + KI-Sichtbarkeit (AIO) by default. Demos: noindex (index = false). Beim Kundenstart: index = true setzen.
import '@fontsource/libre-caslon-display/400.css';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import site from '../data/site.json';
const {
  title = site.name,
  description = '',
  index = false,          // Demo = noindex. Echte Kundenseite: index
  type = 'LocalBusiness', // Schema.org-Typ, z. B. 'Hairdresser', 'Architect', 'Dentist'
  faq = [],               // [{ q, a }] -> sichtbarer FAQ-Block UND FAQPage-Markup (gleicher Text, sonst ignoriert Google es)
  image = '',             // OG-Bild, relativ zu public/
  prices = [],            // [{ name, price }] -> makesOffer
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(base + image.replace(/^\//, ''), Astro.site).href : undefined;
const graph = [
  ...(index ? [{
    '@type': type,
    '@id': new URL(base, Astro.site).href + '#business',
    name: site.name,
    url: new URL(base, Astro.site).href,
    description,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressCountry: 'DE' },
    ...(site.openingHours ? { openingHours: site.openingHours } : {}),
    ...(site.areaServed ? { areaServed: site.areaServed } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    ...(prices.length ? { makesOffer: prices.map((p) => ({ '@type': 'Offer', priceCurrency: 'EUR', price: p.price, itemOffered: { '@type': 'Service', name: p.name } })) } : {}),
  }] : []), // Demo (index = false): keine Geschäftsdaten-Markup mit erfundener Adresse/Telefon, nur FAQPage
  ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#ecedea" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
    <footer class="fuss">
      <div class="fuss__in">
        <div class="zeit" role="img" aria-label="Uhr: aktuelle Ortszeit in Hannover">
          <p class="zeit__ort"><span class="zeit__stunden" data-uhr>--:--</span><span class="zeit__sek" data-uhr-s>:--</span><span class="zeit__label">Ortszeit in Hannover</span></p>
          <div class="zeit__spur"><span class="zeit__zeiger" data-zeiger></span></div>
          <p class="zeit__skala"><span>0</span><span>15</span><span>30</span><span>45</span></p>
        </div>
        <p class="fuss__marke">Calenberg</p>
        <p class="fuss__zeile">Uhrenmanufaktur in Hannover. {site.address.street}, {site.address.zip} {site.address.city}.</p>
        <p class="fuss__unten"><a href={base}>Startseite</a><a href={`${base}impressum/`}>Impressum</a><a href={`${base}datenschutz/`}>Datenschutz</a></p>
        {!index && <p class="fuss__demo">Demo-Seite: Marke, Werk und alle Angaben sind erfunden, die Bilder sind am Computer gerendert. <a href="https://kravets-webdesign.de/kontakt/">Eine solche Website für Ihr Unternehmen? Jetzt anfragen</a></p>}
      </div>
    </footer>
    <script>
      // footer clock: Hannover time, the marker hops six times a second like a 21 600 vph escapement (the same beat as the movement above)
      const hm = document.querySelector<HTMLElement>('[data-uhr]'), sec = document.querySelector<HTMLElement>('[data-uhr-s]'), z = document.querySelector<HTMLElement>('[data-zeiger]');
      if (hm && sec && z) {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fmt = new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        let lastBeat = -1, lastText = '';
        const tick = () => {
          const now = Date.now(), beat = Math.floor((now % 60000) / (reduce ? 1000 : 1000 / 6)) ;
          if (beat !== lastBeat) {
            if (beat < lastBeat) { z.style.transition = 'none'; z.style.setProperty('--b', String(beat)); void z.offsetWidth; z.style.transition = ''; }
            z.style.setProperty('--b', String(beat)); lastBeat = beat;
            const t = fmt.format(now); if (t !== lastText) { lastText = t; hm.textContent = t.slice(0, 5); sec.textContent = t.slice(5); }
          }
        };
        z.style.setProperty('--n', reduce ? '60' : '360');
        tick(); setInterval(tick, 80);
      }
    </script>
  </body>
</html>
