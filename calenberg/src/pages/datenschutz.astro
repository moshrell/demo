---
import Base from '../layouts/Base.astro';
import DatenschutzForm from '../components/DatenschutzForm.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Datenschutz | Calenberg">
  <main class="legal">
    <h1>Datenschutz</h1>
    <p>Diese Seite lädt keine Inhalte von fremden Servern, setzt keine Cookies und verwendet keine Analyse-Werkzeuge. Schriften und Bilder liegen auf dem eigenen Server.</p>
    <DatenschutzForm formName="Anfrage-Formular" required="Ihren Namen und eine Telefonnummer oder E-Mail-Adresse" data="Name, Telefonnummer oder E-Mail-Adresse (eins von beiden genügt), Nachricht (freiwillig) und Ihre Konfiguration der Uhr" purpose="Wir bearbeiten Ihre Anfrage, reservieren Ihnen eine Nummer der Serie und melden uns für einen Termin im Atelier." />
    <p><a href={base}>← Zurück zur Startseite</a></p>
  </main>
</Base>
