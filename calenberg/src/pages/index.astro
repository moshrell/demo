  .f__senden { width: 100%; min-height: 58px; font-size: 1.05rem; white-space: normal; text-align: center; }
  .f__hin { margin-top: 0.8rem; color: var(--tinte-2); font-size: 0.95rem; }
  @media (min-width: 1000px) {
    .f { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
