---
import Base from '../layouts/Base.astro';
import werk from '../data/werk.json';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
const eur = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const start = werk.konfig.reduce((s, g) => s + g.options[0].eur, 0);
---
<Base title="Calenberg | Uhrenmanufaktur Hannover, Kaliber C 01" description="Calenberg baut in Hannover eine Uhr um ein eigenes Handaufzugswerk: Kaliber C 01. Stellen Sie sich Ihre Calenberg Eins zusammen, sehen Sie das Werk Schicht für Schicht und fragen Sie einen von 50 Plätzen der ersten Serie an." image="img/top-900.webp">
  <a class="skip" href="#uhr">Zum Inhalt</a>
  <header class="kz">
    <a class="kz__logo" href={base} aria-label="Calenberg, Startseite">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.5" />
        {Array.from({ length: 12 }, (_, i) => <line x1="24" y1="4.5" x2="24" y2={i % 3 === 0 ? 10 : 8} stroke="currentColor" stroke-width="1.5" transform={`rotate(${i * 30} 24 24)`} />)}
        <line class="krone__zeiger" x1="24" y1="29" x2="24" y2="8" stroke="var(--stahl)" stroke-width="2" stroke-linecap="round" />
        <circle cx="24" cy="24" r="2.2" fill="var(--stahl)" />
      </svg>
      <span>Calenberg</span>
    </a>
    <nav class="kz__nav" aria-label="Hauptmenü">
      <a href="#uhr">Die Uhr</a><a href="#werk">Das Werk</a><a href="#daten">Details</a><a href="#eins">Zusammenstellen</a><a href="#atelier">Atelier</a>
    </nav>
    <a class="knopf knopf--klein" href="#eins"><span class="nur-breit">Platz anfragen</span><span class="nur-schmal">Anfragen</span></a>
    <button class="kz__menue krone" type="button" aria-expanded="false" aria-controls="menue" aria-label="Menü öffnen">Menü</button>
  </header>
  <nav class="menue" id="menue" hidden aria-label="Menü">
    <a href="#uhr">Die Uhr</a><a href="#werk">Das Werk</a><a href="#daten">Details</a><a href="#eins">Eins zusammenstellen</a><a href="#atelier">Atelier und Besuch</a>
  </nav>

  <main>
    <section class="prod" id="uhr" aria-labelledby="prod-h">
      <div class="prod__bild">
        <img src={`${base}watch/hero.webp`} width="1200" height="1500" fetchpriority="high" alt="Calenberg Eins: Armbanduhr aus Edelstahl mit silbernem Zifferblatt, kleiner Sekunde und schwarzem Lederband" />
      </div>
      <div class="prod__text">
        <p class="prod__serie">Erste Serie, 50 Stück</p>
        <h1 id="prod-h">Calenberg Eins</h1>
        <p class="prod__lede">Eine flache Handaufzugsuhr mit eigenem Werk, gebaut von Hand in Hannover. 39 mm, Saphirglasboden, kleine Sekunde.</p>
        <p class="prod__preis"><span>ab</span> <strong>{eur(start)}</strong> <small>inkl. MwSt.</small></p>
        <div class="prod__tun">
          <a class="knopf" href="#eins">Eins zusammenstellen</a>
          <a class="knopf knopf--linie" href="#werk">Das Werk ansehen</a>
        </div>
        <dl class="prod__fakten">
          <div><dt>Werk</dt><dd>60 h Gangreserve, eigenes Kaliber</dd></div>
          <div><dt>Glas</dt><dd>Saphir, vorn und hinten</dd></div>
          <div><dt>Gravur</dt><dd>Neues Rathaus, von Hand</dd></div>
          <div><dt>Garantie</dt><dd>5 Jahre, Service im Atelier</dd></div>
        </dl>
      </div>
    </section>
    <section class="film" id="werk" aria-label="Kaliber C 01">
      <div class="buehne">
        <div class="bild">
          <picture><source media="(min-width: 700px) and (min-height: 880px)" srcset={`${base}seq/hd/explode_000.webp`} /><img class="poster" src={`${base}seq/explode_000.webp`} width="800" height="1000" alt="Das Handaufzugswerk Kaliber C 01 von Calenberg: rhodinierte Brücken mit Genfer Streifen, Räder aus Roségold, gebläute Schrauben" fetchpriority="high" /></picture>
          <canvas width="800" height="1000" aria-hidden="true"></canvas>
        </div>
        <div class="text">
          <div class="held" data-held>
            <h2>So tickt die Eins von innen.</h2>
            <p class="held__lede">Das Werk in der Eins: Kaliber C 01. Es läuft hier in Zeitlupe. Scrollen Sie, dann öffnet es sich Schicht für Schicht.</p>
            <p class="weiter" aria-hidden="true">Nach unten wischen: das Werk öffnet sich</p>
          </div>
          {werk.stations.map((s) => (
            <article class="station" data-station>
              <h2>{s.title}</h2>
              <p class="station__txt">{s.text}</p>
              <p class="station__fig"><strong>{s.fig}</strong> {s.figLabel}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="satz">
      <h2 class="satz__zeile">21 Steine. 16 Goldschrauben. Ein Rathaus.</h2>
      <div class="satz__text">
        <p>Auf dem Unruhkloben jedes C 01 sitzt, kaum größer als ein Reiskorn, das Neue Rathaus von Hannover. Von Hand graviert, mit Roségold ausgelegt.</p>
        <p>Wir sind eine kleine Werkstatt. Pro Jahr verlassen uns höchstens 50 Uhren, jede von einem Uhrmacher zusammengesetzt, reguliert und unterschrieben.</p>
        <a class="textlink" href="#eins">Zur Subskription der ersten Serie</a>
      </div>
    </section>


    <section class="spec" id="daten" aria-labelledby="spec-h">
      <header class="kopf"><h2 id="spec-h">Calenberg Eins im Detail</h2><p>Alle technischen Daten, nach Bauteil sortiert. Beim Scrollen wechselt das Bild.</p></header>
      <div class="spec__in">
        <div class="spec__bild" aria-hidden="true">
          {werk.specs.map((g, i) => <img class={i === 0 ? 'ist-da' : ''} data-spec-bild={g.id} src={g.img === 'top' ? `${base}img/top-900.webp` : `${base}watch/${g.img}.webp`} width={g.img === 'top' ? 1500 : g.img === 'side' ? 1400 : g.img === 'front' ? 1400 : 1200} height={g.img === 'top' ? 1500 : g.img === 'side' ? 1000 : g.img === 'front' ? 1400 : 1500} loading="lazy" decoding="async" alt="" />)}
        </div>
        <div class="spec__liste">
          {werk.specs.map((g) => (
            <article class="spec__gruppe" data-spec={g.id}>
              <h3>{g.title}</h3>
              <figure class="spec__mobil"><img src={g.img === 'top' ? `${base}img/top-900.webp` : `${base}watch/${g.img}.webp`} width="900" height="900" loading="lazy" decoding="async" alt={g.alt} /></figure>
              <dl>{g.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fin" id="finissage">
      <header class="kopf">
        <h2>Was man nur mit der Lupe sieht</h2>
        <p>Ein Uhrwerk muss nicht schön sein, um zu laufen. Unseres ist es trotzdem, auch dort, wo später nie jemand hinschaut. Probieren Sie die Lupe aus.</p>
      </header>
      {werk.finissage.map((f, i) => (
        <figure class={`tafel tafel--${i % 2 ? 'r' : 'l'}`}>
          <div class="lupe" data-lupe data-gross={`${base}img/${f.img}-3000.webp`}>
            <span class="lupe__bild"><img src={`${base}img/${f.img}-900.webp`} srcset={`${base}img/${f.img}-900.webp 900w, ${base}img/${f.img}-1800.webp 1800w`} sizes="(min-width: 900px) 62vw, 100vw" width="1800" height="1200" loading="lazy" decoding="async" alt={`Makroaufnahme des Kalibers C 01: ${f.title}`} /></span>
            <span class="lupe__glas" aria-hidden="true"></span>
            <span class="lupe__tipp" aria-hidden="true">Lupe: Finger auflegen und ziehen</span>
          </div>
          <figcaption><h3>{f.title}</h3><p>{f.text}</p></figcaption>
        </figure>
      ))}
    </section>
    <section class="sub" id="eins">
      <header class="kopf">
        <h2>Ihre Calenberg Eins zusammenstellen</h2>
        <p>Wählen Sie Gehäuse, Zifferblatt und Band. Das Bild zeigt Ihre Uhr, die Summe steht fest. Dann fragen Sie unverbindlich einen Platz an.</p>
      </header>
      <form class="f" id="sub-form" novalidate data-form>
        <div class="f__wahlen" id="subskription">
          {werk.konfig.map((g) => (
            <fieldset class={`f__gruppe${g.id === 'gravur' ? ' f__gruppe--text' : ''}`}>
              <legend><span>{g.label}</span><b data-gname={g.id}>{g.options[0].short}</b></legend>
              <div class="f__wahl">
                {g.options.map((o, i) => (
                  <label class="f__opt">
                    <input type="radio" name={g.id} value={o.id} data-eur={o.eur} data-name={o.name} data-short={o.short} checked={i === 0} />
                    <span class="f__opt-in">
                      <em class="f__farbe" style={`--sw:${o.sw}`} aria-hidden="true"></em>
                      <b>{o.short}</b>
                      <i>{g.id === 'gehaeuse' ? eur(o.eur) : o.eur ? `+ ${eur(o.eur)}` : 'inklusive'}</i>
                    </span>
                  </label>
                ))}
              </div>
              {g.id === 'gravur' && (
                <div class="f__ini" data-ini hidden>
                  <p class="f__feld">
                    <label for="f-ini">Initialen, 1 bis 3 Buchstaben</label>
                    <input id="f-ini" name="initialen" type="text" maxlength="3" placeholder="z. B. MK" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="ini-ok" />
                  </p>
                  <p class="f__ini-ok" id="ini-ok" role="status" data-ini-ok></p>
                </div>
              )}
            </fieldset>
          ))}
        </div>
        <div class="f__rechts">
          <figure class="f__vor">
            <img data-vorschau src={`${base}watch/cfg-stahl-silber-kalb.webp`} width="800" height="1000" alt="Ihre Calenberg Eins: Edelstahl, Zifferblatt Silber, Band Kalbsleder schwarz" />
          </figure>
          <aside class="f__summe" aria-live="polite">
            <img class="f__mini" data-vorschau src={`${base}watch/cfg-stahl-silber-kalb.webp`} width="800" height="1000" alt="" />
            <p class="f__kurz" data-kurz>Stahl · Silber · Schwarz</p>
            <p class="f__summe-titel">Ihre Calenberg Eins</p>
            <ul class="f__summe-liste" data-wahl></ul>
            <p class="f__summe-zeile"><span>Summe inkl. MwSt.</span><strong data-sum>{eur(start)}</strong></p>
          </aside>
        </div>
        <div class="f__kontakt">
          <fieldset class="f__gruppe">
            <legend>Ihre Kontaktdaten</legend>
            <p class="f__feld"><label for="f-name">Name</label><input id="f-name" name="name" type="text" placeholder="Vor- und Nachname" autocomplete="name" required aria-describedby="e-name" /><span class="f__err" id="e-name" hidden>Bitte geben Sie Ihren Namen an.</span></p>
            <p class="f__feld"><label for="f-tel">Telefon</label><input id="f-tel" name="tel" type="tel" inputmode="tel" placeholder="z. B. 0511 1234567" autocomplete="tel" required aria-describedby="e-tel" /><span class="f__err" id="e-tel" hidden>Bitte geben Sie eine Telefonnummer an, unter der wir Sie erreichen.</span></p>
            <p class="f__feld"><label for="f-mail">E-Mail <em>(freiwillig)</em></label><input id="f-mail" name="mail" type="email" inputmode="email" placeholder="name@example.com" autocomplete="email" aria-describedby="e-mail" /><span class="f__err" id="e-mail" hidden>Diese E-Mail-Adresse sieht unvollständig aus.</span></p>
            <p class="f__feld"><label for="f-msg">Nachricht <em>(freiwillig)</em></label><textarea id="f-msg" name="msg" rows="3" placeholder="z. B. Wunschtermin für einen Besuch im Atelier"></textarea></p>
          </fieldset>
          <p class="f__ok">
            <label><input type="checkbox" name="consent" required aria-describedby="e-consent" /><span>Ich bin einverstanden, dass Calenberg meine Angaben zur Bearbeitung meiner Subskriptions-Anfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a> (öffnet in neuem Tab).</span></label>
            <span class="f__err" id="e-consent" hidden>Bitte stimmen Sie der Verwendung Ihrer Angaben zu, sonst dürfen wir die Anfrage nicht bearbeiten.</span>
          </p>
          <button class="knopf f__senden" type="submit">Platz in der ersten Serie anfragen</button>
          <p class="f__hin">Unverbindlich. Wir rufen Sie zurück und vereinbaren einen Termin im Atelier.</p>
        </div>
      </form>
      <div class="schein" data-schein hidden tabindex="-1">
        <p class="schein__kopf">Subskriptionsschein</p>
        <h3>Vielen Dank, <span data-s-name></span>.</h3>
        <dl data-s-list></dl>
        <p class="schein__summe"><span>Summe inkl. MwSt.</span><strong data-s-sum></strong></p>
        <p>Wir melden uns unter <span data-s-tel></span> und vereinbaren einen Termin im Atelier.</p>
        <p class="schein__demo">Demo: Es wurde nichts gesendet und nichts gespeichert.</p>
        <button type="button" class="knopf knopf--linie schein__neu" data-neu>Neue Anfrage</button>
      </div>
    </section>

    <section class="erh" id="erhalten" aria-labelledby="erh-h">
      <div class="erh__in">
        <div class="erh__box">
          <h2 id="erh-h">Was Sie erhalten</h2>
          <ul>{werk.erhalten.map(([t, x]) => <li><strong>{t}</strong><span>{x}</span></li>)}</ul>
          <p class="erh__hin">Demo: Manufaktur, Preise und Konditionen sind erfunden.</p>
        </div>
        <div class="erh__faq">
          <h2>Häufige Fragen</h2>
          {werk.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="atelier" id="atelier">
      <div class="atelier__weg">
        <h2>Von der Anfrage bis zur Uhr</h2>
        <ol>
          <li><h3>Anfrage</h3><p>Sie stellen Ihre Eins zusammen und fragen einen Platz an. Das kostet nichts und verpflichtet zu nichts.</p></li>
          <li><h3>Besuch im Atelier</h3><p>Wir zeigen Ihnen Werk, Zifferblätter und Gehäuse im Original. Erst danach entscheiden Sie.</p></li>
          <li><h3>Fertigung</h3><p>Ihr Werk wird gebaut, in fünf Lagen reguliert und graviert. Nach etwa acht Monaten holen Sie Ihre Uhr ab.</p></li>
        </ol>
      </div>
      <address class="atelier__ort">
        <h2>Atelier</h2>
        <p>{site.address.street}<br />{site.address.zip} {site.address.city}</p>
        <p>Dienstag bis Freitag, 10 bis 18 Uhr<br />Besuch nach Anmeldung</p>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </address>
    </section>
  </main>
</Base>

<style is:global>
  /* Hallmark · macrostructure: Catalogue (dark film plate + paper sheets) · tone: Werkskatalog, sachlich · anchor hue: gebläuter Stahl 265
   * nav: N1b · footer: Ft5 statement · theme: custom (paper silver-grey · blued-steel accent · Libre Caslon Display + Schibsted Grotesk)
   * pre-emit critique: P4 H4 E4 S5 R4 V4 */
  .skip { position: absolute; left: 8px; top: 8px; z-index: 80; background: var(--tinte); color: var(--weiss); padding: 0.6rem 1rem; border-radius: var(--r); clip-path: inset(50%); }
  .skip:focus { clip-path: none; }
  .nur-schmal { display: none; }

  /* ---------- header ---------- */
  .kz { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--kh); display: flex; align-items: center; gap: 0.75rem; padding: 0 var(--gutter); background: var(--papier); border-bottom: 1px solid var(--linie); transition: background-color 0.25s, color 0.25s, border-color 0.25s; }
  @media (max-aspect-ratio: 1/1) {
    .kz.auf-film { background: transparent; color: var(--hell); border-bottom-color: transparent; }
    .kz.auf-film .kz__menue { border-color: var(--hell-2); }
    .kz.auf-film .krone__zeiger, .kz.auf-film .kz__logo circle:last-of-type { stroke: var(--rose-hell); }
    .kz.auf-film .kz__logo circle:last-of-type { fill: var(--rose-hell); stroke: none; }
    .kz.auf-film .kz__nav a:hover { border-bottom-color: var(--hell); }
    .kz.auf-film :focus-visible { outline-color: var(--hell); }
  }
  .kz__logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-family: var(--display); font-size: 1.55rem; line-height: 1; white-space: nowrap; margin-right: auto; padding: 0.5rem 0; }
  .kz__logo svg { width: 30px; height: 30px; flex: none; }
  .krone__zeiger { transform-origin: 24px 24px; }
  .kz__nav { display: none; }
  .kz__menue { min-height: 44px; padding: 0 0.9rem; border: 1px solid var(--tinte); border-radius: var(--r); background: transparent; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .menue { position: fixed; z-index: 49; inset: var(--kh) 0 auto 0; max-height: calc(100dvh - var(--kh)); overflow: auto; background: var(--papier); border-bottom: 1px solid var(--tinte); padding: 0.5rem var(--gutter) 1.5rem; box-shadow: 0 30px 60px -20px var(--schatten); }
  .menue[hidden] { display: none; }
  .menue a { display: block; padding: 1rem 0; border-bottom: 1px solid var(--linie); text-decoration: none; font-family: var(--display); font-size: 1.7rem; line-height: 1.15; }
  .knopf { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0.7rem 1.4rem; border: 1px solid var(--stahl); border-radius: var(--r); background: var(--stahl); color: var(--weiss); font-weight: 600; text-decoration: none; white-space: nowrap; cursor: pointer; transition: background-color 0.15s, border-color 0.15s; }
  .knopf:hover { background: var(--stahl-tief); border-color: var(--stahl-tief); }
  .knopf:active { transform: translateY(1px); }
  .knopf--klein { min-height: 44px; padding: 0.4rem 1rem; }
  .knopf--linie { background: transparent; color: var(--tinte); border-color: var(--tinte); }
  .knopf--linie:hover { background: var(--tinte); color: var(--weiss); border-color: var(--tinte); }
  .textlink { display: inline-block; max-width: 100%; padding: 0.6rem 0; color: var(--stahl); font-weight: 600; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1px; }
  @media (max-width: 420px) { .nur-breit { display: none; } .nur-schmal { display: inline; } }
  @media (max-width: 370px) { .kz { gap: 0.5rem; } .kz__logo svg { display: none; } .kz__logo { font-size: 1.4rem; } .kz .knopf--klein, .kz__menue { padding-inline: 0.7rem; } }
  @media (min-width: 960px) {
    .kz__nav { display: flex; gap: clamp(1rem, 2.4vw, 2.4rem); margin-right: clamp(1rem, 3vw, 3rem); }
    .kz__nav a { text-decoration: none; padding: 0.8rem 0; white-space: nowrap; border-bottom: 1px solid transparent; }
    .kz__nav a:hover { border-bottom-color: var(--tinte); }
    .kz__menue, .menue { display: none; }
  }

  /* ---------- film plate: hero + scroll explode on one sticky stage (dark) ---------- */
  /* the watch stays on a dark plate, everything that is read sits on paper */
  .film { height: 340svh; position: relative; background: var(--papier); color: var(--tinte); }
  .buehne { --bh: min(120vw, 48svh); position: sticky; top: 0; height: 100svh; padding-top: var(--kh); display: grid; grid-template-rows: auto minmax(0, 1fr); justify-items: center; overflow: hidden;
    background: linear-gradient(to bottom, var(--nacht) calc(var(--kh) + var(--bh) + 1svh), var(--papier) 0); }
  .bild { position: relative; height: var(--bh); aspect-ratio: 4 / 5; margin-top: 1svh;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 78%, transparent 100%), linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 78%, transparent 100%), linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%); mask-composite: intersect; }
  .bild picture { display: contents; }
  .bild img, .bild canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .text { position: relative; width: 100%; max-width: 580px; padding: 0 var(--gutter) max(16px, env(safe-area-inset-bottom)); display: grid; align-content: center; }
  .text > * { grid-area: 1 / 1; align-self: center; }
  .held h2 { font-size: clamp(1.75rem, 7.4vw, 3rem); }
  .held__lede { margin-top: 0.6rem; color: var(--tinte-2); max-width: 30em; }
  @keyframes puls { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(1.4); opacity: 0; } }
  @keyframes dreh { to { transform: rotate(1turn); } }
  .weiter { margin-top: clamp(0.5rem, 1.6svh, 1rem); color: var(--tinte-2); font-size: 0.92rem; }
  .weiter::before { content: '↓'; display: inline-block; margin-right: 0.5rem; color: var(--stahl); animation: runter 1.8s ease-in-out infinite; }
  @keyframes runter { 50% { transform: translateY(4px); } }
  .station h2 { font-size: clamp(1.75rem, 7.4vw, 3rem); }
  .station__txt { margin-top: 0.6rem; color: var(--tinte-2); max-width: 34em; }
  .station__fig { display: flex; align-items: baseline; gap: 0.9rem; margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px solid var(--linie); color: var(--tinte-2); font-size: 0.95rem; max-width: 30em; }
  .station__fig strong { flex: none; font-family: var(--display); font-weight: 300; font-stretch: 112%; letter-spacing: -0.03em; font-size: 2.3rem; line-height: 1; color: var(--tinte); font-variant-numeric: lining-nums; }
  .js .held, .js .station { transition: opacity 0.35s ease, transform 0.35s ease; }
  .js .held:not(.ist-da), .js .station:not(.ist-da) { opacity: 0; transform: translateY(14px); visibility: hidden; transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s 0.25s; }
  html:not(.js) .film { height: auto; }
  html:not(.js) .buehne { position: static; height: auto; }
  html:not(.js) .text > * { grid-area: auto; margin-bottom: 2rem; }
  html:not(.js) .bild canvas, html:not(.js) .aufzug, html:not(.js) .weiter { display: none; }
