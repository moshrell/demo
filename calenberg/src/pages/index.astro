  .sub { background: var(--papier-2); }
  .f, .schein { max-width: var(--breit); margin: auto; }
  .f { display: grid; gap: 0 4rem; }
  .f__gruppe { border: 0; padding: 0; margin: 0 0 2.2rem; min-width: 0; }
  .f__gruppe legend { font-family: var(--serif); font-size: 1.7rem; padding: 0; margin-bottom: 0.9rem; }
  .f__wahl { display: grid; gap: 0.6rem; }
  @media (min-width: 560px) { .f__wahl { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); } }
  .f__opt { position: relative; display: block; cursor: pointer; }
  .f__opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .f__opt span { position: relative; display: flex; flex-direction: column; gap: 0.1rem; min-height: 72px; justify-content: center; padding: 0.8rem 1rem 0.8rem 4.3rem; border: 1px solid var(--linie); border-radius: var(--r); background: var(--weiss); transition: border-color 0.15s, box-shadow 0.15s; }
  .f__farbe { position: absolute; left: 0.9rem; top: 50%; width: 44px; height: 44px; margin-top: -22px; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 1px var(--kante), inset -5px -7px 12px var(--kante), 0 4px 10px -4px var(--schatten); }
  .f__opt b { font-weight: 600; }
  .f__opt i { font-style: normal; color: var(--tinte-2); font-size: 0.95rem; }
  .f__opt:hover span { border-color: var(--tinte-2); }
  .f__opt input:checked + span { border-color: var(--stahl); box-shadow: inset 0 0 0 1px var(--stahl); }
  .f__opt input:focus-visible + span { outline: 2px solid var(--fokus); outline-offset: 3px; }
  .f__feld { display: grid; gap: 0.35rem; margin: 0 0 1rem; }
  .f__ini { margin-top: 0.9rem; max-width: 260px; }
  .f__feld label { font-weight: 600; }
  .f__feld label em { font-style: normal; font-weight: 400; color: var(--tinte-2); }
  .f input[type='text'], .f input[type='tel'], .f input[type='email'], .f textarea { width: 100%; font: inherit; color: var(--tinte); background: var(--weiss); border: 1px solid var(--tinte-2); border-radius: var(--r); padding: 0.8rem 0.9rem; min-height: 52px; }
  .f ::placeholder { color: var(--platzhalter); opacity: 1; }
