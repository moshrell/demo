    .f__summe { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: calc(var(--kh) + 2rem); bottom: auto; margin: 0; padding: 2rem; border-radius: var(--r); }
    .f__summe-titel { display: block; font-family: var(--serif); font-size: 1.9rem; margin-bottom: 1.2rem; }
    .f__summe-liste { display: block; list-style: none; margin: 0 0 1.2rem; padding: 0; }
    .f__summe-liste li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-top: 1px solid var(--tinte-linie); }
    .f__summe-liste li span:last-child { color: var(--hell-2); white-space: nowrap; }
    .f__summe-zeile { border-top: 1px solid var(--weiss); padding-top: 1rem; }
    .f__summe-zeile strong { font-size: 2.6rem; }
  }
  .schein { border: 1px solid var(--tinte); border-radius: var(--r); padding: clamp(22px, 5vw, 48px); max-width: 760px; background: var(--weiss); }
  .schein > * { margin-bottom: 0.9rem; }
  .schein[hidden] { display: none; }
  .schein__kopf { color: var(--stahl); font-weight: 600; }
  .schein h3 { font-size: clamp(1.9rem, 7vw, 2.8rem); overflow-wrap: anywhere; }
  .schein dl { margin: 1rem 0; }
  .schein dl div { display: grid; grid-template-columns: minmax(6rem, 12rem) minmax(0, 1fr); gap: 0.8rem; padding: 0.55rem 0; border-top: 1px solid var(--linie); }
  .schein dt { color: var(--tinte-2); } .schein dd { margin: 0; overflow-wrap: anywhere; }
  .schein__summe { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--tinte); padding-top: 0.8rem; }
  .schein__summe strong { font-family: var(--serif); font-weight: 400; font-size: 2rem; font-variant-numeric: lining-nums; }
  .schein__demo { color: var(--tinte-2); font-size: 0.95rem; }

  .atelier { display: grid; gap: 3.5rem; max-width: var(--breit); margin: auto; box-sizing: content-box; }
  .atelier h2 { font-size: clamp(2rem, 6vw, 3.2rem); margin-bottom: 1.5rem; }
  .atelier ol { list-style: none; margin: 0; padding: 0; counter-reset: weg; display: grid; gap: 0; }
  .atelier li { counter-increment: weg; display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); column-gap: 0.5rem; padding: 1.3rem 0; border-top: 1px solid var(--linie); }
  .atelier li:first-child { border-top-color: var(--tinte); }
  .atelier li::before { content: counter(weg); grid-row: 1 / span 2; font-family: var(--serif); font-size: 2.6rem; line-height: 1; color: var(--stahl); font-variant-numeric: lining-nums; }
  .atelier li h3 { font-size: 1.6rem; }
  .atelier li p { grid-column: 2; margin-top: 0.3rem; color: var(--tinte-2); max-width: 32em; }
  .atelier__ort { font-style: normal; display: grid; gap: 1rem; align-content: start; font-size: 1.1rem; }
  .atelier__ort a { color: var(--stahl); display: inline-block; padding: 0.3rem 0; overflow-wrap: anywhere; }
  @media (min-width: 960px) { .atelier { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 5rem; } }

  @media (prefers-reduced-motion: reduce) { .aufzug__knopf::after, .weiter::before { animation: none; } .js .held, .js .station { transition: none; } .lupe img, .daten__ring, .daten__bild img { transform: none; } }
</style>

<script>
  document.documentElement.classList.add('js');
  import seq from '../data/seq.json';
  const BASE = import.meta.env.BASE_URL;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- menu + running seconds hand ---------- */
  const kz = document.querySelector<HTMLElement>('.kz')!;
  const krone = document.querySelector<HTMLButtonElement>('.krone')!;
  const menue = document.getElementById('menue')!;
  const zeiger = document.querySelector<SVGLineElement>('.krone__zeiger')!;
  const setMenu = (open: boolean) => { menue.hidden = !open; krone.setAttribute('aria-expanded', String(open)); krone.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen'); krone.textContent = open ? 'Schließen' : 'Menü'; kz.classList.toggle('auf-film', !open && document.querySelector('.film')!.getBoundingClientRect().bottom > kz.offsetHeight); };
  krone.addEventListener('click', () => setMenu(menue.hidden));
  menue.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menue.hidden) { setMenu(false); krone.focus(); } });

  /* ---------- film: one still frame + moving layers (tools/seq.mjs writes the files and src/data/seq.json) ----------
     still        explode_000: the movement at rest. Every layer below is drawn on top of it.
     wind_NNN     rectangles around the winding works and the crown, one ratchet tooth per loop
     rs           sprite sheet: ratchet screw, 2 deg per cell (the slot keeps the angle the ratchet has been wound to)
     run_NNN      rectangles around balance and escapement, loop 1..72 = six beats; third and fourth wheel are missing in it
     t3, f4       sprite sheets: third wheel (0.4 deg per cell) and fourth wheel (1 deg per cell, one cell per beat)
     explode_NNN  full frames for the scroll */
  const canvas = document.querySelector<HTMLCanvasElement>('.bild canvas')!;
  const ctx = canvas.getContext('2d')!;
  const conn = (navigator as any).connection;
  const slow = !!conn && (conn.saveData || /2g|3g/.test(conn.effectiveType || ''));
  const HD = innerWidth >= 700 && canvas.clientWidth * devicePixelRatio > 880 && !slow;   // phones and slow lines get 800x1000, large screens 1200x1500
  const K = HD ? 1 : seq.small.w / seq.w, DIR = `${BASE}seq/${HD ? 'hd/' : ''}`;
  const CW = Math.round(seq.w * K), CH = Math.round(seq.h * K);
  canvas.width = CW; canvas.height = CH;
  const off = document.createElement('canvas'); off.width = CW; off.height = CH; const octx = off.getContext('2d')!;
  const RUN = seq.run.n - 1, WIND = seq.wind.n, EXP = seq.explode.n, BEAT = 12, PITCH = 360 / 58;

  const img: Record<string, HTMLImageElement> = {};
  const nm = (s: string, i: number) => `${s}_${String(i).padStart(3, '0')}`;
  let dirty = true;
  function load(name: string) {
    return new Promise<void>((res) => {
      if (img[name]) return res();
      const im = new Image(); im.decoding = 'async';
      im.onload = () => { img[name] = im; dirty = true; res(); };
      im.onerror = () => res();
      im.src = `${DIR}${name}.webp`;
    });
  }
  async function queue(names: string[], par: number) {
    let next = 0;
    await Promise.all(Array.from({ length: par }, async () => { while (next < names.length) await load(names[next++]); }));
  }
  const range = (s: string, a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => nm(s, a + i));
  const runNames = range('run', 1, RUN);
  const heroNames = [...range('wind', 1, WIND - 1), 'rs', ...runNames, 'f4', 't3'];
  let ready = false;
  const runReady = () => ready || (ready = !!img.f4 && !!img.t3 && runNames.every((n) => img[n]));

  type Rect = { x: number; y: number; w: number; h: number; sy: number };
  function patch(c: CanvasRenderingContext2D, s: 'wind' | 'run', i: number) {
    const im = img[nm(s, i)]; if (!im) return;
    for (const r of seq[s].rects as Rect[]) c.drawImage(im, 0, r.sy * K, r.w * K, r.h * K, r.x * K, r.y * K, r.w * K, r.h * K);
  }
  function sprite(c: CanvasRenderingContext2D, key: 'f4' | 't3' | 'rs', i: number) {
    const im = img[key], s = seq[key]; if (!im) return;
    const w = s.w * K, h = s.h * K;
    c.drawImage(im, (i % s.cols) * w, Math.floor(i / s.cols) * h, w, h, s.x * K, s.y * K, w, h);
  }
  // nearest loaded scroll frame at or below / at or above a position: the film is blended between the two,
  // so it stays continuous while frames are still arriving and between frames on a slow finger
  function below(i: number) { for (let k = Math.min(EXP - 1, i); k >= 0; k--) if (img[nm('explode', k)]) return k; return -1; }
  function above(i: number) { for (let k = Math.max(0, i); k < EXP; k++) if (img[nm('explode', k)]) return k; return -1; }
  // loader: coarse grid first (every 16th, 8th, ...), inside each level the frame closest to where the visitor is
  const pending = new Set<number>();
  function nextFrame() {
    for (const step of [16, 8, 4, 2, 1]) {
      let best = -1, bd = 1e9;
      for (let i = step; i < EXP; i += step) {
        if (img[nm('explode', i)] || pending.has(i)) continue;
        const d = Math.abs(i - target); if (d < bd) { bd = d; best = i; }
      }
      if (best >= 0) return best;
    }
    return -1;
  }
  async function filmLoader() { for (let i = nextFrame(); i >= 0; i = nextFrame()) { pending.add(i); await load(nm('explode', i)); pending.delete(i); } }

  /* ---------- state ---------- */
  const film = document.querySelector<HTMLElement>('.film')!;
  const buehne = document.querySelector<HTMLElement>('.buehne')!;
  const held = document.querySelector<HTMLElement>('[data-held]')!;
  const stations = [...document.querySelectorAll<HTMLElement>('[data-station]')];
  const knopf = document.querySelector<HTMLButtonElement>('[data-wind]')!;
  const lbl = document.querySelector<HTMLElement>('[data-wind-label]')!;
  const resEl = document.querySelector<HTMLElement>('[data-reserve]')!;
  const statEl = document.querySelector<HTMLElement>('[data-status]')!;
  const FULL = 60;
  let pressed = false, reserve = 0, cur = 0, target = 0, last = 0;
  let windF = 0, teeth = 0, accW = 0;          // winding: frame inside the tooth, teeth wound so far
  let runT = 0, accR = 0, runA = 0, heroA = 1;  // running: frames played in total, fade of the running layers, fade of all hero layers
  let shown = '';

  function ui() {
    knopf.style.setProperty('--r', String(reserve / FULL));
    resEl.textContent = `${Math.floor(reserve)} h`;
    const full = reserve >= FULL, runs = reserve > 0;
    statEl.textContent = full ? 'Voll aufgezogen · Gangreserve' : runs ? (reduce ? 'Das Werk läuft · Gangreserve' : 'Das Werk läuft, hier in Zeitlupe · Gangreserve') : 'Kaliber C 01 · Gangreserve';
    lbl.textContent = full ? 'Voll aufgezogen' : pressed ? 'Aufziehen …' : runs ? 'Weiter aufziehen' : 'Gedrückt halten';
    held.classList.toggle('laeuft', runs);
  }
  function press(on: boolean) {
    if (on === pressed) return;
    pressed = on; knopf.classList.toggle('ist-an', on); ui();
  }
  knopf.addEventListener('pointerdown', (e) => { e.preventDefault(); try { knopf.setPointerCapture(e.pointerId); } catch {} press(true); });
  for (const ev of ['pointerup', 'pointercancel', 'lostpointercapture']) knopf.addEventListener(ev, () => press(false));
  knopf.addEventListener('contextmenu', (e) => e.preventDefault());
  knopf.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); press(true); } });
  knopf.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') press(false); });
  knopf.addEventListener('blur', () => press(false));

  function onScroll() {
    // measured against the sticky stage (svh), not innerHeight: the phone's address bar sliding in and out must not move the film
    const span = Math.max(1, film.offsetHeight - buehne.offsetHeight);
    const prog = Math.min(1, Math.max(0, -film.getBoundingClientRect().top / span));
    const t = Math.min(1, Math.max(0, (prog - 0.012) / 0.9));
    target = t * (EXP - 1);
    const hero = prog < 0.03;
    held.classList.toggle('ist-da', hero);
    const cuts = [0, 0.25, 0.5, 0.75, 1.01];      // the same quarters the film is cut in (uhren/film.py)
    stations.forEach((el, i) => { const on = !hero && t >= cuts[i] && t < cuts[i + 1]; el.classList.toggle('ist-da', on); el.setAttribute('aria-hidden', String(!on)); });
    held.setAttribute('aria-hidden', String(!hero));
    if (!hero) press(false);
    kz.classList.toggle('auf-film', menue.hidden && film.getBoundingClientRect().bottom > kz.offsetHeight);
  }
  addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll);

  function drawHero() {
    const still = img[nm('explode', 0)]; if (!still) return;
    const j = 1 + (runT % RUN), beat = Math.floor(runT / BEAT) + (runT % BEAT >= 1 ? 1 : 0);
    const rs = Math.round((teeth + windF / WIND) * PITCH / 2) % seq.rs.n;
    const a = heroA * runA, key = `h${windF}|${rs}|${a > 0 ? j : 0}|${a.toFixed(2)}|${heroA.toFixed(2)}`;
    if (key === shown && !dirty) return;
    ctx.globalAlpha = 1; ctx.drawImage(still, 0, 0, CW, CH);
    if (heroA > 0 && (windF || rs)) { ctx.globalAlpha = heroA; if (windF) patch(ctx, 'wind', windF); if (rs) sprite(ctx, 'rs', rs); }
    if (a > 0) {
      patch(octx, 'run', j); sprite(octx, 't3', Math.floor(beat / 3) % seq.t3.n); sprite(octx, 'f4', beat % seq.f4.n);
      ctx.globalAlpha = a;
      for (const r of seq.run.rects as Rect[]) ctx.drawImage(off, r.x * K, r.y * K, r.w * K, r.h * K, r.x * K, r.y * K, r.w * K, r.h * K);
    }
    ctx.globalAlpha = 1; shown = key; dirty = false;
  }
  // whole frames only: blending two renders gives double contours, which reads as a cheap dissolve
  function drawExplode(x: number) {
    const i = Math.round(x); let k = below(i); if (k < 0) k = above(i); if (k < 0) return;
    const key = `e${k}`;
    if (key === shown && !dirty) return;
    ctx.globalAlpha = 1; ctx.drawImage(img[nm('explode', k)], 0, 0, CW, CH); shown = key; dirty = false;
  }

  function tick(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000 || 0); last = now;
    const s = new Date(); zeiger.style.transform = `rotate(${(s.getSeconds() + s.getMilliseconds() / 1000) * 6}deg)`;
    const exploding = cur > 0.04 || target > 0.04;
    // winding: one tooth per loop; after release the click still drops into the next tooth
    if (!exploding && pressed && reserve < FULL) {
      reserve = Math.min(FULL, reserve + dt * 7); ui();
      if (!reduce) { accW += dt * 18; while (accW >= 1) { accW -= 1; windF++; if (windF === WIND) { windF = 0; teeth++; if (navigator.vibrate) navigator.vibrate(6); } } }
    } else if (windF !== 0) { accW += dt * 18; while (accW >= 1 && windF !== 0) { accW -= 1; windF = (windF + 1) % WIND; if (windF === 0) teeth++; } }
    // running: starts with the first hour of reserve
    const runs = reserve > 0 && !reduce && runReady();
    runA = Math.min(1, Math.max(0, runA + (runs ? dt / 0.4 : -dt / 0.4)));
    if (runA > 0) { accR += dt * 24; while (accR >= 1) { accR -= 1; runT++; } }
    if (!exploding) {
      heroA = Math.min(1, heroA + dt / 0.2); cur = target;
      drawHero();
    } else if (heroA > 0 && cur < 0.04) {
      heroA = reduce ? 0 : Math.max(0, heroA - dt / 0.1);      // the moving layers fade into the still frame, then the scroll film takes over
      drawHero();
    } else {
      // glide towards the finger: time-based, so it feels the same at 60 and 120 Hz; a fast flick runs through the film without steps
      heroA = 0; cur += (target - cur) * (reduce ? 1 : 1 - Math.exp(-dt * 16));
      if (Math.abs(target - cur) < 0.05) cur = target;
      drawExplode(cur);
    }
    requestAnimationFrame(tick);
  }
  held.classList.add('ist-da'); ui(); onScroll();
  let filmOn = false;
  function startFilm() { if (filmOn) return; filmOn = true; for (let i = 0; i < 4; i++) filmLoader(); }
  // order matters on a phone line: the winding button must answer first, then the running works, the scroll film last;
  // a visitor who scrolls before that gets the film at once
  load(nm('explode', 0)).then(() => { requestAnimationFrame(tick); return queue([...range('wind', 1, WIND - 1), 'rs'], 6); })
    .then(() => queue(['f4', 't3', ...runNames], 5)).then(startFilm);
  addEventListener('scroll', () => { if (scrollY > 8) startFilm(); }, { passive: true, once: false });

  /* ---------- reveal, parallax, loupe ---------- */
  const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { e.target.classList.add('ist-da'); io.unobserve(e.target); } }, { rootMargin: '0px 0px -12% 0px' });
  document.querySelectorAll('.zeig').forEach((el) => io.observe(el));
  const movers = [...document.querySelectorAll<HTMLElement>('[data-lupe], [data-dreh]')];
  const near = new Set<HTMLElement>();
  const io2 = new IntersectionObserver((es) => { for (const e of es) e.isIntersecting ? near.add(e.target as HTMLElement) : near.delete(e.target as HTMLElement); par(); }, { rootMargin: '10% 0px' });
  movers.forEach((el) => io2.observe(el));
  let parQ = false;
  function par() {
    if (parQ || reduce) return; parQ = true;
    requestAnimationFrame(() => { parQ = false; const vh = innerHeight;
      for (const el of near) { const r = el.getBoundingClientRect(); el.style.setProperty('--p', Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height))).toFixed(4)); } });
  }
  addEventListener('scroll', par, { passive: true });
  for (const box of document.querySelectorAll<HTMLElement>('[data-lupe]')) {
    const glas = box.querySelector<HTMLElement>('.lupe__glas')!; const Z = 2.4; let got = false;
    const move = (e: PointerEvent) => {
      const r = box.getBoundingClientRect(), x = Math.min(r.width, Math.max(0, e.clientX - r.left)), y = Math.min(r.height, Math.max(0, e.clientY - r.top));
      const lift = e.pointerType === 'touch' ? 96 : 0;        // on a phone the glass sits above the finger
      box.style.setProperty('--x', `${x}px`); box.style.setProperty('--y', `${Math.max(40, y - lift)}px`);
      const g = glas.offsetWidth;
      glas.style.backgroundSize = `${r.width * Z}px ${r.height * Z}px`;
      glas.style.backgroundPosition = `${g / 2 - x * Z}px ${g / 2 - y * Z}px`;
    };
    const on = (e: PointerEvent) => {
      if (!got) { got = true; glas.style.backgroundImage = `url("${box.dataset.gross}")`; }
      move(e); box.classList.add('ist-an', 'war-an');
    };
    const offL = () => box.classList.remove('ist-an');
    box.addEventListener('pointerdown', on); box.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(e); });
    box.addEventListener('pointermove', (e) => { if (box.classList.contains('ist-an')) move(e); });
    for (const ev of ['pointerup', 'pointercancel', 'pointerleave']) box.addEventListener(ev, offL);
    box.addEventListener('contextmenu', (e) => e.preventDefault());
  }

  /* ---------- Subskription form ---------- */
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const schein = document.querySelector<HTMLElement>('[data-schein]')!;
  const sumEl = form.querySelector<HTMLElement>('[data-sum]')!;
  const ini = form.querySelector<HTMLElement>('[data-ini]')!;
  const KEY = 'calenberg-sub';
  const eur = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
  const picks = () => [...form.querySelectorAll<HTMLInputElement>('input[type=radio]:checked')];
  const total = () => picks().reduce((s, r) => s + Number(r.dataset.eur), 0);
  const wahl = form.querySelector<HTMLElement>('[data-wahl]')!;
  function refresh() {
    sumEl.textContent = eur(total());
    wahl.textContent = '';
    for (const r of picks()) { const li = document.createElement('li'), n = document.createElement('span'), e = document.createElement('span'); n.textContent = r.dataset.name!; const v = Number(r.dataset.eur); e.textContent = r.name === 'gehaeuse' ? eur(v) : v ? `+ ${eur(v)}` : 'inklusive'; li.append(n, e); wahl.append(li); }
    ini.hidden = (form.elements.namedItem('gravur') as RadioNodeList).value !== 'initialen';
  }
  function save() {
    const d: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { if (k !== 'consent') d[k] = String(v); });
    try { sessionStorage.setItem(KEY, JSON.stringify(d)); } catch {}
  }
  try {
    const d = JSON.parse(sessionStorage.getItem(KEY) || '{}');
    for (const [k, v] of Object.entries(d)) {
      const el = form.elements.namedItem(k);
      if (el instanceof RadioNodeList) el.value = String(v); else if (el && 'value' in el) (el as HTMLInputElement).value = String(v);
    }
  } catch {}
  refresh();
  form.addEventListener('input', () => { refresh(); save(); });
  const fields: [string, (v: string) => boolean][] = [
    ['name', (v) => v.trim().length >= 2],
    ['tel', (v) => v.replace(/\D/g, '').length >= 6],
    ['mail', (v) => v.trim() === '' || /^\S+@\S+\.\S+$/.test(v.trim())],
  ];
  function check(name: string, ok: boolean) {
    const el = form.elements.namedItem(name) as HTMLInputElement;
    const err = document.getElementById(`e-${name}`)!;
    el.setAttribute('aria-invalid', String(!ok)); err.hidden = ok;
    return ok ? null : el;
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let first: HTMLElement | null = null;
    for (const [n, fn] of fields) { const bad = check(n, fn((form.elements.namedItem(n) as HTMLInputElement).value)); first ||= bad; }
    const c = form.elements.namedItem('consent') as HTMLInputElement;
    first ||= check('consent', c.checked);
    if (first) { first.focus(); first.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' }); return; }
    const fd = new FormData(form);
    schein.querySelector('[data-s-name]')!.textContent = String(fd.get('name')).trim();
    schein.querySelector('[data-s-tel]')!.textContent = String(fd.get('tel')).trim();
    const list = schein.querySelector('[data-s-list]')!; list.textContent = '';
    for (const r of picks()) {
      const row = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
      dt.textContent = r.closest('fieldset')!.querySelector('legend')!.textContent;
      const iniV = String(fd.get('initialen') || '').trim().toUpperCase();
      dd.textContent = r.dataset.name + (r.value === 'initialen' && iniV ? `: ${iniV}` : '');
      row.append(dt, dd); list.append(row);
    }
    schein.querySelector('[data-s-sum]')!.textContent = eur(total());
    try { sessionStorage.removeItem(KEY); } catch {}
    form.hidden = true; schein.hidden = false; schein.focus(); schein.scrollIntoView({ block: 'center' });
  });
  form.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement; const f = fields.find(([n]) => n === t.name);
    if (f && t.getAttribute('aria-invalid') === 'true') check(f[0], f[1](t.value));
  });
  schein.querySelector('[data-neu]')!.addEventListener('click', () => { form.reset(); refresh(); schein.hidden = true; form.hidden = false; form.scrollIntoView({ block: 'start' }); });
</script>
