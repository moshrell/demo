  .lupe img { width: 100%; transform: scale(calc(1.1 - var(--p, 0.5) * 0.1)); will-change: transform; -webkit-user-drag: none; }
  .lupe__glas { position: absolute; z-index: 2; left: 0; top: 0; width: 168px; height: 168px; margin: -84px 0 0 -84px; border-radius: 50%; pointer-events: none; opacity: 0; transform: translate(var(--x, 50%), var(--y, 50%)); transition: opacity 0.18s ease; background-repeat: no-repeat;
    box-shadow: 0 0 0 2px var(--nacht-2), 0 0 0 5px var(--papier), 0 0 0 6px var(--nacht-2), 0 24px 50px var(--schatten), inset 0 0 26px var(--schatten); }
