  .daten__ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(calc(var(--p, 0.5) * -40deg)); will-change: transform; }
  .daten__bild img { width: 86%; border-radius: 50%; transform: rotate(calc((var(--p, 0.5) - 0.5) * 50deg)); will-change: transform; box-shadow: 0 30px 60px -20px var(--schatten); }
