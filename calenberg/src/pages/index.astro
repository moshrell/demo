  .f__err[hidden] { display: none; }
  .f__summe { position: sticky; bottom: 0; z-index: 5; margin: 0 calc(var(--gutter) * -1) 2.2rem; padding: 0.7rem var(--gutter) calc(0.7rem + env(safe-area-inset-bottom)); background: var(--tinte); color: var(--weiss); }
  .f__summe-titel, .f__summe-liste { display: none; }
  .f__summe-zeile { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .f__summe-zeile span { color: var(--hell-2); }
  .f__summe-zeile strong { font-family: var(--serif); font-weight: 400; font-size: 1.9rem; font-variant-numeric: lining-nums; white-space: nowrap; }
  .f__ok { margin: 0 0 1.4rem; }
