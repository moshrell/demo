  @media (hover: hover) and (pointer: fine) { .lupe__tipp { font-size: 0; } .lupe__tipp::after { content: 'Lupe: Maus über das Bild bewegen'; font-size: 0.88rem; } }
  .tafel h3 { font-size: clamp(1.8rem, 6vw, 2.7rem); }
