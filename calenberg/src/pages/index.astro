---
import Base from '../layouts/Base.astro';
import werk from '../data/werk.json';
const base = import.meta.env.BASE_URL;
const eur = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const start = werk.konfig.reduce((s, g) => s + g.options[0].eur, 0);
---
<Base title="Calenberg | Uhrenmanufaktur Hannover, Kaliber C 01" description="Calenberg baut in Hannover eine Uhr um ein eigenes Handaufzugswerk: Kaliber C 01. Ziehen Sie es auf, öffnen Sie es Schicht für Schicht und subskribieren Sie eine von 50 Uhren der ersten Serie." image="img/top-900.webp">
  <a class="skip" href="#finissage">Zum Inhalt</a>
  <button class="krone" type="button" aria-expanded="false" aria-controls="menue" aria-label="Menü öffnen">
    <svg viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="1" />
      {Array.from({ length: 12 }, (_, i) => <line x1="24" y1="4" x2="24" y2={i % 3 === 0 ? 9 : 7} stroke="currentColor" stroke-width="1" transform={`rotate(${i * 30} 24 24)`} />)}
      <line class="krone__zeiger" x1="24" y1="28" x2="24" y2="7.5" stroke="var(--rose)" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="24" cy="24" r="1.8" fill="var(--rose)" />
    </svg>
  </button>
  <nav class="menue" id="menue" hidden aria-label="Hauptmenü">
    <ol>
      <li><a href="#werk"><span>I</span>Das Werk aufziehen</a></li>
      <li><a href="#finissage"><span>II</span>Finissage</a></li>
      <li><a href="#daten"><span>III</span>Datenblatt C 01</a></li>
      <li><a href="#subskription"><span>IV</span>Subskription</a></li>
    </ol>
  </nav>

  <main>
    <section class="film" id="werk" aria-label="Kaliber C 01">
      <div class="buehne">
        <p class="marke">Calenberg<small>Uhrenmanufaktur Hannover</small></p>
        <div class="bild">
          <picture><source media="(min-width: 700px) and (min-height: 880px)" srcset={`${base}seq/hd/explode_000.webp`} /><img class="poster" src={`${base}seq/explode_000.webp`} width="800" height="1000" alt="Das Handaufzugswerk Kaliber C 01 von Calenberg: rhodinierte Brücken mit Genfer Streifen, Räder aus Roségold, gebläute Schrauben" fetchpriority="high" /></picture>
          <canvas width="800" height="1000" aria-hidden="true"></canvas>
        </div>
        <div class="text">
          <div class="held" data-held>
            <h1>Es steht still, bis Sie es aufziehen.</h1>
            <div class="aufzug">
              <button class="aufzug__knopf" type="button" data-wind aria-describedby="aufzug-status">
                <span class="aufzug__ring" aria-hidden="true"></span>
                <span class="aufzug__txt" data-wind-label>Gedrückt halten</span>
              </button>
              <p class="aufzug__status" id="aufzug-status" aria-live="polite"><span data-status>Kaliber C 01 · Gangreserve</span> <strong data-reserve>0 h</strong></p>
            </div>
            <p class="weiter" aria-hidden="true">Nach unten wischen: das Werk öffnet sich</p>
          </div>
          {werk.stations.map((s) => (
            <article class="station" data-station>
              <p class="station__nr">{s.nr} / 04</p>
              <h2>{s.title}</h2>
              <p class="station__txt">{s.text}</p>
              <p class="station__fig"><strong>{s.fig}</strong> {s.figLabel}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="satz" aria-label="Das Werk in Zahlen">
      <p class="satz__zeile"><span>21 Steine.</span> <span>16 Goldschrauben.</span> <span>Ein Rathaus.</span></p>
      <p class="satz__klein">Auf dem Unruhkloben jedes C 01 sitzt, kaum größer als ein Reiskorn, das Neue Rathaus von Hannover. Von Hand graviert, mit Roségold ausgelegt.</p>
    </section>

    <section class="fin stoff" id="finissage">
      <header class="kopf zeig">
        <p class="kopf__nr" aria-hidden="true">II</p>
        <h2>Was man nur mit der Lupe sieht</h2>
        <p>Ein Uhrwerk muss nicht schön sein, um zu laufen. Unseres ist es trotzdem, auch dort, wo später nie jemand hinschaut.</p>
      </header>
      {werk.finissage.map((f, i) => (
        <figure class={`fin__stueck fin__stueck--${i % 2 ? 'r' : 'l'} zeig`}>
          <div class="lupe" data-lupe data-gross={`${base}img/${f.img}-1800.webp`}>
            <img src={`${base}img/${f.img}-900.webp`} srcset={`${base}img/${f.img}-900.webp 900w, ${base}img/${f.img}-1800.webp 1800w`} sizes="(min-width: 900px) 62vw, 100vw" width="1800" height="1200" loading="lazy" decoding="async" alt={`Makroaufnahme des Kalibers C 01: ${f.title}`} />
            <span class="lupe__glas" aria-hidden="true"></span>
            <span class="lupe__tipp" aria-hidden="true">Lupe: Finger auflegen und ziehen</span>
          </div>
          <figcaption>
            <p class="fin__nr" aria-hidden="true">{['a', 'b', 'c'][i]}</p>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </figcaption>
        </figure>
      ))}
    </section>

    <section class="daten" id="daten">
      <div class="daten__bild zeig" data-dreh>
        <svg class="daten__ring" viewBox="0 0 400 400" aria-hidden="true">
          <circle cx="200" cy="200" r="197" fill="none" stroke="var(--rule)" />
          {Array.from({ length: 60 }, (_, i) => <line x1="200" y1="6" x2="200" y2={i % 5 === 0 ? 20 : 13} stroke={i % 5 === 0 ? 'var(--rose)' : '#5a5d61'} stroke-width={i % 5 === 0 ? 1.6 : 1} transform={`rotate(${i * 6} 200 200)`} />)}
        </svg>
        <img src={`${base}img/top-900.webp`} srcset={`${base}img/top-900.webp 900w, ${base}img/top-1500.webp 1500w`} sizes="(min-width: 900px) 40vw, 80vw" width="1500" height="1500" loading="lazy" decoding="async" alt="Kaliber C 01 in der Aufsicht" />
      </div>
      <div class="daten__blatt zeig">
        <p class="kopf__nr" aria-hidden="true">III</p>
        <h2>Datenblatt C 01</h2>
        <dl>{werk.daten.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
    </section>

    <section class="sub stoff" id="subskription">
      <header class="kopf zeig">
        <p class="kopf__nr" aria-hidden="true">IV</p>
        <h2>Calenberg Eins. Erste Serie: 50 Uhren.</h2>
        <p>Die Eins ist die Uhr zum Kaliber C 01: 39 mm, Saphirglasboden, kleine Sekunde. Stellen Sie Ihre zusammen und fragen Sie einen Platz in der ersten Serie an. Das Zifferblatt zeigen wir Subskribenten zuerst, persönlich im Atelier.</p>
      </header>
      <form class="f" id="sub-form" novalidate data-form>
        {werk.konfig.map((g) => (
          <fieldset class="f__gruppe">
            <legend>{g.label}</legend>
            <div class="f__wahl">
              {g.options.map((o, i) => (
                <label class="f__opt">
                  <input type="radio" name={g.id} value={o.id} data-eur={o.eur} data-name={o.name} checked={i === 0} />
                  <span><em class="f__farbe" style={`--sw:${o.sw}`} aria-hidden="true"></em><b>{o.name}</b><i>{g.id === 'gehaeuse' ? eur(o.eur) : o.eur ? `+ ${eur(o.eur)}` : 'inklusive'}</i></span>
                </label>
              ))}
            </div>
            {g.id === 'gravur' && (
              <p class="f__feld f__ini" data-ini hidden>
                <label for="f-ini">Initialen (bis 3 Buchstaben)</label>
                <input id="f-ini" name="initialen" type="text" maxlength="3" placeholder="z. B. MK" autocomplete="off" autocapitalize="characters" />
              </p>
            )}
          </fieldset>
        ))}
        <div class="f__summe" aria-live="polite"><span>Summe inkl. MwSt.</span><strong data-sum>{eur(start)}</strong></div>

        <fieldset class="f__gruppe">
          <legend>Ihre Kontaktdaten</legend>
          <p class="f__feld"><label for="f-name">Name</label><input id="f-name" name="name" type="text" placeholder="Vor- und Nachname" autocomplete="name" required aria-describedby="e-name" /><span class="f__err" id="e-name" hidden>Bitte geben Sie Ihren Namen an.</span></p>
          <p class="f__feld"><label for="f-tel">Telefon</label><input id="f-tel" name="tel" type="tel" inputmode="tel" placeholder="z. B. 0511 1234567" autocomplete="tel" required aria-describedby="e-tel" /><span class="f__err" id="e-tel" hidden>Bitte geben Sie eine Telefonnummer an, unter der wir Sie erreichen.</span></p>
          <p class="f__feld"><label for="f-mail">E-Mail <em>(freiwillig)</em></label><input id="f-mail" name="mail" type="email" inputmode="email" placeholder="name@example.com" autocomplete="email" aria-describedby="e-mail" /><span class="f__err" id="e-mail" hidden>Diese E-Mail-Adresse sieht unvollständig aus.</span></p>
          <p class="f__feld"><label for="f-msg">Nachricht <em>(freiwillig)</em></label><textarea id="f-msg" name="msg" rows="3" placeholder="z. B. Wunschtermin für einen Besuch im Atelier"></textarea></p>
        </fieldset>
        <p class="f__ok">
          <label><input type="checkbox" name="consent" required aria-describedby="e-consent" /><span>Ich bin einverstanden, dass Calenberg meine Angaben zur Bearbeitung meiner Subskriptions-Anfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a> (öffnet in neuem Tab).</span></label>
          <span class="f__err" id="e-consent" hidden>Bitte stimmen Sie der Verwendung Ihrer Angaben zu, sonst dürfen wir die Anfrage nicht bearbeiten.</span>
        </p>
        <button class="f__senden" type="submit">Platz in der ersten Serie anfragen</button>
        <p class="f__hin">Unverbindlich. Wir rufen Sie zurück und vereinbaren einen Termin im Atelier.</p>
      </form>
      <div class="schein" data-schein hidden tabindex="-1">
        <p class="schein__kopf">Subskriptionsschein</p>
        <h3>Vielen Dank, <span data-s-name></span>.</h3>
        <dl data-s-list></dl>
        <p class="schein__summe"><span>Summe inkl. MwSt.</span><strong data-s-sum></strong></p>
        <p>Wir melden uns unter <span data-s-tel></span> und vereinbaren einen Termin im Atelier.</p>
        <p class="schein__demo">Demo: Es wurde nichts gesendet und nichts gespeichert.</p>
        <button type="button" class="schein__neu" data-neu>Neue Anfrage</button>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .skip { position: absolute; left: 8px; top: 8px; clip-path: inset(50%); background: var(--ink); color: var(--bg); padding: 0.6rem 1rem; z-index: 60; border-radius: 6px; }
  .skip:focus { clip-path: none; }
  .krone { position: fixed; top: max(12px, env(safe-area-inset-top)); right: 12px; z-index: 50; width: 52px; height: 52px; padding: 4px; border: 0; border-radius: 50%; background: rgba(8, 9, 10, 0.72); color: var(--ink); cursor: pointer; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .krone svg { display: block; width: 100%; height: 100%; }
  .krone__zeiger { transform-origin: 24px 24px; }
  .menue { position: fixed; inset: 0; z-index: 45; background: rgba(8, 9, 10, 0.96); display: grid; place-items: center; padding: 80px var(--gutter) 40px; overflow: auto; }
  .menue[hidden] { display: none; }
  .menue ol { list-style: none; margin: 0; padding: 0; width: min(100%, 520px); }
  .menue a { display: grid; grid-template-columns: 3rem 1fr; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; font-family: var(--serif); font-size: clamp(1.7rem, 7vw, 2.6rem); line-height: 1.1; }
  .menue a span { font-family: var(--sans); font-size: 0.95rem; color: var(--rose); }

  /* ---------- film: hero + scroll explode on one sticky stage ---------- */
  .film { height: 470svh; position: relative; }
  .buehne { position: sticky; top: 0; height: 100svh; display: grid; grid-template-rows: auto minmax(0, 1fr); justify-items: center; overflow: hidden; }
  .marke { position: absolute; z-index: 3; top: max(18px, env(safe-area-inset-top)); left: var(--gutter); font-family: var(--serif); font-size: 1.75rem; line-height: 1; letter-spacing: 0.01em; }
  .marke small { display: block; font-family: var(--sans); font-size: 0.8rem; color: var(--muted); margin-top: 0.35rem; letter-spacing: 0.02em; }
  .bild { position: relative; height: min(125vw, 60svh); aspect-ratio: 4 / 5; margin-top: clamp(0px, 4svh, 40px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 78%, transparent 100%), linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 78%, transparent 100%), linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%); mask-composite: intersect; }
  .bild picture { display: contents; }
  .bild img, .bild canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .text { position: relative; width: 100%; max-width: 560px; padding: 0 var(--gutter) max(16px, env(safe-area-inset-bottom)); display: grid; align-content: center; }
  .text > * { grid-area: 1 / 1; align-self: center; }
  .held h1 { font-size: clamp(1.9rem, 8.2vw, 3.4rem); }
  .aufzug { display: flex; align-items: center; gap: 1.2rem; padding-left: 8px; margin-top: clamp(0.8rem, 2.4svh, 1.6rem); }
  .aufzug__knopf { position: relative; flex: none; width: 92px; height: 92px; border-radius: 50%; border: 0; background: radial-gradient(circle at 35% 30%, #2a2d31, #121416 70%); cursor: pointer; touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; display: grid; place-items: center; }
  .aufzug__ring { position: absolute; inset: -5px; border-radius: 50%; background: conic-gradient(var(--rose) calc(var(--r, 0) * 1turn), #2b2d30 0); -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 4px), #000 calc(100% - 3px)); mask: radial-gradient(closest-side, transparent calc(100% - 4px), #000 calc(100% - 3px)); }
  .aufzug__txt { font-size: 0.86rem; line-height: 1.15; font-weight: 600; max-width: 76px; text-align: center; }
  .aufzug__knopf::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--rose); opacity: 0; animation: puls 2.2s ease-out infinite; }
  .aufzug__knopf.ist-an::after, .laeuft .aufzug__knopf::after { animation: none; }
  .aufzug__knopf.ist-an { transform: scale(0.96); }
  @keyframes puls { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(1.45); opacity: 0; } }
  .aufzug__status { color: var(--muted); font-size: 0.98rem; line-height: 1.35; }
  .aufzug__status strong { display: block; color: var(--ink); font-family: var(--serif); font-weight: 400; font-size: 1.9rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .weiter { margin-top: clamp(0.6rem, 2svh, 1.2rem); color: var(--muted); font-size: 0.95rem; }
  .weiter::before { content: '↓'; display: inline-block; margin-right: 0.5rem; color: var(--rose); animation: runter 1.8s ease-in-out infinite; }
  @keyframes runter { 50% { transform: translateY(4px); } }
  .station__nr { color: var(--rose); font-size: 0.95rem; font-variant-numeric: tabular-nums; margin-bottom: 0.4rem; }
  .station h2 { font-size: clamp(1.9rem, 8vw, 3rem); }
  .station__txt { margin-top: 0.7rem; color: #d6d2c9; max-width: 34em; }
  .station__fig { margin-top: 0.8rem; color: var(--muted); font-size: 0.95rem; }
  .station__fig strong { font-family: var(--serif); font-weight: 400; font-size: 1.7rem; color: var(--ink); margin-right: 0.5rem; font-variant-numeric: tabular-nums; }
  .js .held, .js .station { transition: opacity 0.35s ease, transform 0.35s ease; }
  .js .held:not(.ist-da), .js .station:not(.ist-da) { opacity: 0; transform: translateY(14px); visibility: hidden; transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s 0.25s; }
  html:not(.js) .film { height: auto; }
  html:not(.js) .buehne { position: static; height: auto; }
  html:not(.js) .text > * { grid-area: auto; margin-bottom: 2rem; }
  html:not(.js) .bild canvas, html:not(.js) .aufzug, html:not(.js) .weiter { display: none; }
  @media (min-aspect-ratio: 1/1) {
    .buehne { grid-template-rows: 1fr; grid-template-columns: auto minmax(280px, 560px); justify-content: center; align-items: center; column-gap: clamp(8px, 3vw, 56px); }
    .bild { height: min(100svh, 78vw); margin-top: 0; }
    .text { padding-left: 0; }
  }
  @media (min-width: 1100px) and (min-height: 700px) {
    .text { max-width: 640px; font-size: 1.15rem; }
    .held h1, .station h2 { font-size: clamp(3rem, 4.4vw, 4.6rem); }
    .aufzug__knopf { width: 108px; height: 108px; } .aufzug__txt { font-size: 0.95rem; }
    .marke { font-size: 2.1rem; }
  }
  @media (min-aspect-ratio: 1/1) and (max-height: 520px) {
    .held h1, .station h2 { font-size: clamp(1.5rem, 7svh, 2.2rem); }
    .aufzug__knopf { width: 72px; height: 72px; } .aufzug__txt { font-size: 0.75rem; }
    .station__txt { font-size: 0.95rem; margin-top: 0.4rem; } .marke small { display: none; }
    .marke { font-size: 1.3rem; }
  }

  /* ---------- sections ---------- */
  .stoff { position: relative; isolation: isolate; }
  .stoff::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0.55;
    background-image: radial-gradient(circle at 50% 50%, transparent 0 9px, rgba(255, 255, 255, 0.05) 9.5px 10px, transparent 10.5px), radial-gradient(circle at 50% 50%, transparent 0 9px, rgba(255, 255, 255, 0.05) 9.5px 10px, transparent 10.5px);
    background-size: 26px 26px; background-position: 0 0, 13px 13px;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent); }
  .zeig { opacity: 1; }
  .js .zeig { opacity: 0; transform: translateY(28px); transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .js .zeig.ist-da { opacity: 1; transform: none; }
  .kopf { padding: 0 var(--gutter); max-width: 900px; margin: 0 auto clamp(2rem, 6vw, 4rem); }
  .kopf__nr { font-family: var(--serif); font-size: 1.5rem; color: var(--rose); display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.9rem; }
  .kopf__nr::after { content: ''; height: 1px; flex: 0 1 140px; background: linear-gradient(to right, var(--rose), transparent); }
  .kopf h2 { font-size: clamp(2.3rem, 9vw, 4.6rem); }
  .kopf p:not(.kopf__nr) { margin-top: 1.1rem; color: #d6d2c9; max-width: 38em; font-size: 1.08rem; }

  .satz { padding: clamp(3rem, 10vw, 7rem) var(--gutter) clamp(1rem, 4vw, 3rem); max-width: 1180px; margin: auto; }
  .satz__zeile { font-family: var(--serif); font-size: clamp(2.6rem, 11.5vw, 7.2rem); line-height: 1.02; letter-spacing: -0.01em; }
  .satz__zeile span { display: block; background: linear-gradient(100deg, #f4eee2 0%, #c9c4b8 38%, #7d7a73 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .satz__zeile span:last-child { background-image: linear-gradient(100deg, #f1c3a1 0%, #d39a74 45%, #8a5a3d 100%); }
  .satz__klein { margin-top: 1.4rem; max-width: 32em; color: #d6d2c9; font-size: 1.08rem; }
  @media (min-width: 900px) { .satz__zeile span { display: inline; } .satz__zeile { max-width: 12em; } }

  .fin { padding: clamp(4rem, 12vw, 9rem) 0 0; }
  .fin__stueck { margin: 0 0 clamp(3.5rem, 10vw, 8rem); display: grid; }
  .lupe { position: relative; overflow: hidden; touch-action: pan-y; cursor: zoom-in; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
    box-shadow: 0 40px 80px -30px #000, inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .lupe img { width: 100%; transform: scale(calc(1.14 - var(--p, 0.5) * 0.14)) translateY(calc((var(--p, 0.5) - 0.5) * -5%)); will-change: transform; -webkit-user-drag: none; }
  .lupe::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to bottom, rgba(8, 9, 10, 0.5), transparent 22%, transparent 70%, rgba(8, 9, 10, 0.75)); }
  .lupe__glas { position: absolute; z-index: 2; left: 0; top: 0; width: 168px; height: 168px; margin: -84px 0 0 -84px; border-radius: 50%; pointer-events: none; opacity: 0; transform: translate(var(--x, 50%), var(--y, 50%)); transition: opacity 0.18s ease;
    background-repeat: no-repeat; box-shadow: 0 0 0 2px #1b1d20, 0 0 0 4px #d39a74, 0 0 0 5px #1b1d20, 0 24px 50px rgba(0, 0, 0, 0.7), inset 0 0 26px rgba(0, 0, 0, 0.55), inset 6px 8px 18px rgba(255, 255, 255, 0.12); }
  .lupe.ist-an .lupe__glas { opacity: 1; }
  .lupe__tipp { position: absolute; z-index: 1; left: var(--gutter); bottom: 14px; font-size: 0.88rem; color: #d6d2c9; padding-left: 26px; transition: opacity 0.3s; }
  .lupe__tipp::before { content: ''; position: absolute; left: 0; top: 50%; width: 16px; height: 16px; margin-top: -9px; border: 1.5px solid var(--rose); border-radius: 50%; box-shadow: 7px 7px 0 -6.2px var(--rose); }
  .lupe.war-an .lupe__tipp { opacity: 0; }
  @media (hover: hover) and (pointer: fine) { .lupe__tipp { font-size: 0; } .lupe__tipp::after { content: 'Lupe: Maus über das Bild bewegen'; font-size: 0.88rem; } }
