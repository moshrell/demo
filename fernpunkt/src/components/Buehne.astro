---
// Примерка: фото-модель (точки лица посчитаны заранее, грузится мгновенно) и, в режиме studio, живая камера.
import { FRAMES, svg, size } from '../lib/frames';
import models from '../data/models.json';
const base = import.meta.env.BASE_URL;
const eur = (n: number) => `${n} €`;
---
<div class="bn" data-buehne data-base={base}>
  <div class="bn__bild">
    <canvas class="bn__canvas" data-canvas width={models[0].w} height={models[0].h} role="img" aria-label="Anprobe: Modell mit der gewählten Fassung"></canvas>
    <div class="bn__modelle" data-modelle role="group" aria-label="Modell wählen">
      {models.map((m, i) => (
        <button type="button" data-modell={m.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Modell ${i + 1}`}>
          <img src={base + m.src} alt="" width="56" height="70" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </div>

  <div class="bn__wahl">
    <div class="bn__kopf">
      <p class="bn__name"><strong data-name>{FRAMES[0].name}</strong> <span data-form>{FRAMES[0].form}, {FRAMES[0].material}</span></p>
      <p class="bn__preis zahl"><span data-groesse>{size(FRAMES[0])}</span> <strong data-preis>{eur(FRAMES[0].price)}</strong></p>
    </div>
    <div class="bn__rail" data-rail role="group" aria-label="Fassung wählen">
      {FRAMES.map((f, i) => (
        <button type="button" class="bn__fassung" data-fassung={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="bn__zeichnung" set:html={svg(f, f.paints[0], { title: false })} />
          <span class="bn__fname">{f.name}</span>
        </button>
      ))}
    </div>
    <div class="bn__zeile">
      <div class="bn__farben" data-farben role="group" aria-label="Farbe wählen"></div>
      <p class="bn__notiz" data-notiz>{FRAMES[0].note}</p>
    </div>
    <div class="bn__tun">
      <button class="knopf knopf--hell knopf--voll" type="button" data-kamera-auf>An mir selbst anprobieren</button>
      <button class="knopf knopf--hell" type="button" data-merken aria-pressed="false">Merken</button>
    </div>
    <p class="bn__hinweis">Das Kamerabild bleibt auf Ihrem Gerät, es wird nichts übertragen oder gespeichert. Beim ersten Mal lädt die Anprobe einmalig etwa 8 MB. Sie zeigt Form, Farbe und Proportion; ob eine Fassung wirklich sitzt, messen wir im Laden nach.</p>
    <div class="bn__merk" data-merk hidden>
      <p><span data-merk-text></span> <a href={`${base}termin/`}>Mit dieser Auswahl Termin anfragen</a></p>
    </div>
  </div>
</div>

<style>
  .bn { display: grid; gap: var(--space-md); color: var(--hell); }
  .bn__bild { position: relative; overflow: hidden; border-radius: 1.25rem; background: #17101b; aspect-ratio: 4 / 5; max-height: 78svh; margin-inline: auto; width: 100%; max-width: 34rem; }
  .bn__canvas { width: 100%; height: 100%; object-fit: cover; }
  .bn__modelle { position: absolute; left: 0.75rem; bottom: 0.75rem; display: flex; gap: 0.5rem; }
  .bn__modelle button { width: 3rem; height: 3.6rem; padding: 0; border: 2px solid rgb(255 255 255 / 0.55); border-radius: 0.6rem; overflow: hidden; background: none; cursor: pointer; }
  .bn__modelle button[aria-pressed='true'] { border-color: #fff; box-shadow: 0 0 0 2px var(--reflex-b); }
  .bn__modelle img { width: 100%; height: 100%; object-fit: cover; }
  .bn__wahl { display: grid; gap: var(--space-smd); min-width: 0; align-content: start; }
  .bn__kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; }
  .bn__name { font-size: var(--text-sm); color: var(--hell-2); }
  .bn__name strong { font-family: var(--font-display); font-weight: 700; font-variation-settings: 'opsz' 8; font-size: 2.1rem; line-height: 1; color: var(--hell); margin-right: 0.4rem; }
  .bn__preis { font-size: var(--text-sm); color: var(--hell-2); }
  .bn__preis strong { font-size: var(--text-lg); color: var(--hell); margin-left: 0.5rem; }
  .bn__rail { display: flex; gap: 0.6rem; overflow-x: auto; scroll-snap-type: x proximity; margin-inline: calc(var(--gutter) * -1); padding: 0.4rem var(--gutter) 0.6rem; scrollbar-width: none; }
  .bn__rail::-webkit-scrollbar { display: none; }
  .bn__fassung { flex: 0 0 auto; width: 8.6rem; scroll-snap-align: center; display: grid; gap: 0.3rem; justify-items: center; padding: 0.9rem 0.7rem 0.6rem; border: 1.5px solid transparent; border-radius: 1rem; background: var(--hell); color: var(--tinte); cursor: pointer; }
  .bn__fassung[aria-pressed='true'] { border-color: var(--reflex-b); box-shadow: 0 0 0 3px var(--reflex-b); }
  .bn__zeichnung { display: block; width: 100%; }
  .bn__zeichnung :global(svg) { width: 100%; height: auto; }
  .bn__fname { font-size: var(--text-xs); font-weight: 600; }
  .bn__zeile { display: grid; gap: var(--space-sm); }
  .bn__farben { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .bn__farben :global(button) { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.3rem 0.9rem 0.3rem 0.4rem; border: 1.5px solid rgb(255 255 255 / 0.3); border-radius: 999px; background: none; color: var(--hell); font-size: var(--text-sm); font-weight: 500; cursor: pointer; }
  .bn__farben :global(button[aria-pressed='true']) { border-color: var(--hell); background: rgb(255 255 255 / 0.1); }
  .bn__farben :global(i) { width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.5); }
  .bn__notiz { color: var(--hell-2); font-size: var(--text-sm); min-height: 2.9em; }
  .bn__tun { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .bn__tun .knopf { flex: 1 1 auto; }
  .bn__hinweis { font-size: var(--text-xs); color: var(--hell-2); }
  .bn__merk { padding: 0.8rem 1rem; border-radius: 0.8rem; background: rgb(255 255 255 / 0.08); font-size: var(--text-sm); }
  .bn__merk a { font-weight: 600; display: inline-block; padding-block: 0.35rem; }
  @media (min-width: 56rem) {
    .bn { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
    .bn__bild { max-width: none; }
    .bn__rail { margin-inline: 0; padding-inline: 0.25rem; flex-wrap: wrap; overflow: visible; }
    .bn__fassung { width: calc((100% - 1.2rem) / 3); }
  }
  @media (max-height: 34rem) and (orientation: landscape) {
    .bn { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr); align-items: start; }
    .bn__bild { max-height: none; }
  }
</style>

<script>
  import '../scripts/buehne';
</script>
