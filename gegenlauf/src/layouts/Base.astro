---
// SEO + KI-Sichtbarkeit (AIO). Demos: noindex (index = false). Beim Kundenstart: index = true setzen.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import site from '../data/betrieb.json';
const {
  title = site.name,
  description = '',
  index = false,
  type = 'AutoRepair',
  faq = [],
  image = '',
  prices = [],
  leiste = true,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(base + image.replace(/^\//, ''), Astro.site).href : undefined;
const graph = [
  ...(index ? [{
    '@type': type,
    '@id': new URL(base, Astro.site).href + '#business',
    name: site.name,
    url: new URL(base, Astro.site).href,
    description,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressCountry: 'DE' },
    ...(site.openingHours ? { openingHours: site.openingHours } : {}),
    ...(site.areaServed ? { areaServed: site.areaServed } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    ...(prices.length ? { makesOffer: prices.map((p) => ({ '@type': 'Offer', priceCurrency: 'EUR', price: p.price, itemOffered: { '@type': 'Service', name: p.name } })) } : {}),
  }] : []), // Demo (index = false): keine Geschäftsdaten-Markup mit erfundener Adresse/Telefon, nur FAQPage
  ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#131416" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <footer class="fuss">
      <section class="heft" aria-label="Kontakt und Öffnungszeiten">
        <div class="heft__kopf">
          <div>
            <p class="heft__label">Serviceheft</p>
            <p class="fuss__marke">{site.kurz}</p>
          </div>
          <svg class="heft__stempel" viewBox="0 0 160 160" role="img" aria-label="Stempel: Gegenlauf Sportwagenservice, Hannover, Demo">
            <defs><path id="stempel-kreis" d="M80 80 m-58 0 a58 58 0 1 1 116 0 a58 58 0 1 1 -116 0" /></defs>
            <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="3" />
            <circle cx="80" cy="80" r="40" fill="none" stroke="currentColor" stroke-width="1.5" />
            <text class="heft__kreis" font-size="11.5"><textPath href="#stempel-kreis" startOffset="0" textLength="358" lengthAdjust="spacing">GEGENLAUF · SPORTWAGENSERVICE · HANNOVER ·</textPath></text>
            <text x="80" y="87" text-anchor="middle" class="heft__demo" font-size="21">DEMO</text>
          </svg>
        </div>
        <dl class="heft__zeilen">
          <div><dt>Werkstatt</dt><dd>{site.name}<br />{site.address.street}, {site.address.zip} {site.address.city}</dd></div>
          <div><dt>Telefon</dt><dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd></div>
          <div><dt>Annahme</dt><dd>{site.hours.map((h) => `${h.label} ${h.open}–${h.close} Uhr`).join(', ')}<br />{site.hoursNote}</dd></div>
          <div><dt>E-Mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
      </section>
      <p>{site.markenhinweis} „Porsche“, „911“, „Boxster“ und „Cayman“ sind Marken der Dr. Ing. h.c. F. Porsche AG und werden hier nur zur Beschreibung der betreuten Fahrzeuge genannt.</p>
      <nav aria-label="Rechtliches">
        <a href={`${base}impressum/`}>Impressum</a>
        <a href={`${base}datenschutz/`}>Datenschutz</a>
        <a href={base}>Startseite</a>
      </nav>
      {!index && <p>Demo-Seite: Betrieb, Personen, Adresse und Preise sind erfunden. <a href="https://kravets-webdesign.de/kontakt/">Eine solche Website für Ihre Werkstatt? Jetzt anfragen</a></p>}
    </footer>
    {leiste && (
      <div class="leiste" role="region" aria-label="Schnellkontakt">
        <a class="btn leiste__tel" href={`tel:${site.phoneHref}`}>Anrufen</a>
        <a class="btn btn--amber leiste__ziel" href={`${base}#termin`} data-ziel><span class="leiste__summe" data-leiste-summe></span><span class="leiste__text" data-leiste-text>Diagnose-Termin</span></a>
      </div>
    )}
  </body>
</html>
