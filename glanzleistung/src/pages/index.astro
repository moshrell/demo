---
import Base from '../layouts/Base.astro';
import Neon from '../components/Neon.astro';
import site from '../data/site.json';
import data from '../data/services.json';
import content from '../data/content.json';
import media from '../data/media.json';
const base = import.meta.env.BASE_URL;
const m = `${base}media/`;
const { W, H } = media.mobile; // Box-Bild Handy aus Blender: 1440 × 2560 (Desktop: 2560 × 1440, siehe media.json)
const euro = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const priceFor = (b: number, mult: number) => Math.ceil((b * mult) / 10) * 10 - 1;
const fromPrice = (s: any) => Math.min(...s.levels.map((l: any) => l.base));
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}`)}`;
const days = site.hours;
const icon = {
  lack: 'M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8ZM19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8Z',
  felgen: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM12 4v5.5m0 5V20M4.6 8.2l4.7 2.7m5.4 2.2 4.7 2.7M4.6 15.8l4.7-2.7m5.4-2.2 4.7-2.7',
  innenraum: 'M8 4h3l1 8h5a2 2 0 0 1 2 2v3H7ZM7 17v3m11-3v3',
  folie: 'M4 8c0-1.1 1.8-2 4-2h8v10H8c-2.2 0-4-.9-4-2Zm4-2c-2.2 0-4 .9-4 2s1.8 2 4 2h8',
  ozon: 'M4 9h9a2.5 2.5 0 1 0-2.5-2.5M4 13h13a2.5 2.5 0 1 1-2.5 2.5M4 17h6',
  dachhimmel: 'M3 14c1.5-5 5-8 9-8s7.5 3 9 8ZM5 18h14',
  zeiten: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4v4.5l3 1.8',
  anfahrt: 'M12 21s-6-5.6-6-10.5a6 6 0 1 1 12 0C18 15.4 12 21 12 21Zm0-8a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8Z',
  funk: 'M5 9h14a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5v-7A1.5 1.5 0 0 1 5 9Zm3.5-4.5L16 9M8 14h.01M12 14h4',
  gaestebuch: 'M6 4h11a1 1 0 0 1 1 1v14H7a1 1 0 0 1-1-1ZM6 18a1 1 0 0 1 1-1h11M9.5 8h5',
  recht: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6ZM9 12l2 2 4-4',
  termin: 'M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm3-2v4m8-4v4M4 11h16',
};
const cards = [['lack', 'Lack'], ['felgen', 'Felgen'], ['innenraum', 'Innenraum'], ['folie', 'Folie'], ['ozon', 'Ozon'], ['dachhimmel', 'Dachhimmel']];
const dockItems = [['zeiten', 'Zeiten'], ['anfahrt', 'Anfahrt'], ['funk', 'Boxenfunk'], ['gaestebuch', 'Gästebuch']];
const stations = ['zeiten', 'anfahrt', 'funk', 'auftrag', 'gaestebuch', 'recht'];
---
<Base game>
<div class="app" data-app>

  <!-- ============ INTRO ============ -->
  <div class="intro" data-intro>
    <video class="intro__video" data-intro-video muted playsinline preload="auto" aria-hidden="true"></video>
    <div class="intro__ui">
      <button class="btn btn--ghost intro__play" type="button" data-intro-play hidden>Intro abspielen</button>
      <button class="btn btn--ghost intro__skip" type="button" data-intro-skip>Überspringen<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5v13a.8.8 0 0 0 1.2.7l9-6.5a.8.8 0 0 0 0-1.4l-9-6.5A.8.8 0 0 0 3 5.5Zm9 0v13a.8.8 0 0 0 1.2.7l9-6.5a.8.8 0 0 0 0-1.4l-9-6.5A.8.8 0 0 0 12 5.5Z" /></svg></button>
    </div>
  </div>

  <!-- ============ BOX ============ -->
  <main class="stage" data-stage aria-label="Die Box: dein Auto in der Werkstatt">
    <img class="stage__bg" src={`${m}bg-blur.webp`} width="90" height="160" alt="" aria-hidden="true" />


    <div class="stage__frame" data-frame>
      <!-- Ebene 1: die Box (Kamera fährt per transform) -->
      <canvas class="stage__cv" data-bgcv role="img" aria-label="Ein BMW-Cabrio steht in einer Werkstatt-Box mit Waben-Licht an der Decke und Neon an den Wänden."></canvas>
      <div class="world" data-world style={`width:${W}px;height:${H}px`}>
        <div class="surf" data-surf="neon_panel" data-cw="800" data-ch="600"><Neon /></div>
        <div class="surf" data-surf="poster_map" data-cw="620" data-ch="980"><img class="karte" src={`${m}karte.webp`} width="620" height="980" alt="" decoding="async" /></div>
        <div class="hotspots" data-hotspots>
          {data.services.map((sv) => (
            <button class={`hs hs--svc${(sv as any).hotspot ? '' : ' hs--dk'}`} type="button" data-hs={sv.id} data-pin={sv.id} data-hs-key={(sv as any).hotspot ?? ''} aria-label={sv.name}>
              <span class="hs__dot" aria-hidden="true"></span><span class="hs__lbl" aria-hidden="true"><b>{sv.name}</b><i data-from={sv.id}>ab {euro(fromPrice(sv))}</i></span>
            </button>
          ))}
          {dockItems.concat([['auftrag', 'Auftrag'], ['recht', 'Recht']]).map(([id, label]) => (
            <button class="hs hs--stn hs--dk" type="button" data-pin-open={id} data-pin={id} aria-label={label}>
              <span class="hs__dot" aria-hidden="true"></span><span class="hs__lbl" aria-hidden="true"><b>{label}</b></span>
            </button>
          ))}
        </div>
      </div>

      <!-- Ebene 2: Nahaufnahmen der Stationen (gleiche Kamera, schärfer) -->
      <div class="world world--st" data-stworld style={`width:${W}px;height:${H}px`} aria-hidden="true">
        {stations.map((id) => (
          <div class="st" data-st={id} hidden>
            <img class="src-img" data-st-img width={W} height={H} alt="" decoding="async" />
            {id === 'zeiten' && <div class="ov" data-ov="zeiten" style="width:800px;height:600px"><Neon /></div>}
            {id === 'anfahrt' && (
              <div class="ov" data-ov="anfahrt" style="width:620px;height:980px">
                <img class="karte" src={`${m}karte.webp`} width="620" height="980" alt="" decoding="async" />
                <button class="qs-hook" type="button" data-qs-hook aria-label="Geparktes Auto im Hinterhof. Gedrückt halten, um die Handbremse zu ziehen.">
                  <svg viewBox="0 0 24 44" width="24" height="44" aria-hidden="true" focusable="false">
                    <circle class="qs-hook__ring" cx="12" cy="22" r="30" />
                    <rect class="qs-hook__body" x="3" y="2" width="18" height="40" rx="7" />
                    <rect class="qs-hook__glass" x="6" y="9" width="12" height="7" rx="2.5" />
                    <rect class="qs-hook__glass" x="6" y="28" width="12" height="6" rx="2.5" />
                    <circle class="qs-hook__lamp" cx="7" cy="4.5" r="1.8" /><circle class="qs-hook__lamp" cx="17" cy="4.5" r="1.8" />
                  </svg>
                </button>
              </div>
            )}
            {id === 'funk' && (
              <div class="ov ov--funk" data-ov="funk" style="width:440px;height:400px">
                <p class="led__h">Boxenfunk · Kanal 7</p>
                <p class="led__t" data-led>Frag die Box.</p>
              </div>
            )}
            {id === 'auftrag' && (
              <div class="ov ov--bon" data-ov="auftrag" style="width:330px;height:600px">
                <p class="bon__h">{site.name}</p>
                <p class="bon__s">Auftrag</p>
                <ul class="bon__l" data-bon-list></ul>
                <p class="bon__sum"><span>Summe</span><b data-bon-sum>0 €</b></p>
              </div>
            )}
            {id === 'gaestebuch' && (
              <div class="ov ov--page" data-ov="gaestebuch" style="width:540px;height:366px">
                <p class="page__n" data-page-n>1 / {content.reviews.length}</p>
                <blockquote class="page__q" data-page-q>{content.reviews[0].text}</blockquote>
                <p class="page__w" data-page-w>{content.reviews[0].who}</p>
                <p class="page__demo">Beispiel-Eintrag</p>
              </div>
            )}
            {id === 'recht' && (
              <div class="ov ov--fuse" data-ov="recht" style="width:640px;height:1410px">
                <p class="fuse__h">Rechtliches</p>
                <p class="fuse__t">Sicherungen</p>
                <a class="fuse__f" href={`${base}impressum/`} target="_blank" rel="noopener" tabindex="-1"><i>F1</i><span>Impressum</span><b>›</b></a>
                <a class="fuse__f" href={`${base}datenschutz/`} target="_blank" rel="noopener" tabindex="-1"><i>F2</i><span>Datenschutz</span><b>›</b></a>
                <a class="fuse__f" href={`${base}impressum/#credits`} target="_blank" rel="noopener" tabindex="-1"><i>F3</i><span>Lizenzen</span><b>›</b></a>
                <p class="fuse__n">Demo · erfundener Betrieb</p>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Ebene 3: Kamerafahrt (Clip) + Standbild zum Polieren -->
      <div class="world world--clip" data-clipworld style="width:720px;height:1280px" hidden>
        <img class="world__img" data-clip-still alt="" />
        <canvas class="world__canvas clip__tint" data-clip-tint width="720" height="1280" aria-hidden="true" hidden></canvas>
        <img class="world__img clip__lamp" data-clip-lamp alt="" hidden />
        <canvas class="world__canvas" data-clip-canvas width="720" height="1280" aria-hidden="true"></canvas>
        <video class="world__img clip__video" data-clip-video muted playsinline preload="metadata" aria-hidden="true"></video>
      </div>
    </div>

    <header class="hud">
      <div class="hud__left">
        <button class="hud__icon" type="button" data-open="menu" data-menu-btn aria-label="Menü">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
        </button>
        <button class="hud__icon" type="button" data-back aria-label="Zurück zur Box" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
        </button>
        <p class="hud__brand" aria-hidden="true">{site.name}</p>
      </div>
      <button class="hud__car" type="button" data-open="fahrzeug" aria-label="Fahrzeug und Klasse wählen">
        <span data-car-label>Klasse?</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
      </button>
      <button class="hud__sum" type="button" data-open="auftrag" aria-label="Termin anfragen und Auftrag ansehen">
        <span class="hud__eur" data-sum>0 €</span>
        <span class="hud__glanz" data-glanz-text>Termin anfragen ›</span>
      </button>
    </header>

    <div class="wall" data-wall>
    <nav class="svcs" aria-label="Leistungen" data-svcs>
      {cards.map(([id, label], i) => {
        const sv = data.services.find((x) => x.id === id)!;
        return <button type="button" class="svc" style={`--i:${i}`} data-station={id} data-rail={id}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={(icon as any)[id]} /></svg><span class="svc__n">{label}</span><span class="svc__p" data-from={id}>ab {euro(fromPrice(sv))}</span><i class="tick" aria-hidden="true">✓</i></button>;
      })}
    </nav>

    <nav class="dock" aria-label="Werkstatt und Termin" data-dock>
      {dockItems.map(([id, label]) => (
        <button type="button" data-open={id}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={(icon as any)[id]} /></svg><span>{label}</span></button>
      ))}
      <button type="button" class="dock__rd" data-open="recht"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.recht} /></svg><span>Recht</span></button>
      <button type="button" class="dock__cta" data-open="auftrag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.termin} /></svg><span>Termin</span><i class="badge" data-count hidden></i></button>
    </nav>
    </div>

    <p class="toast" data-toast role="status" aria-live="polite"></p>
  </main>

  <!-- ============ SHEETS ============ -->
  <dialog class="sheet" id="sheet-klasse" aria-labelledby="h-klasse">
    <div class="sheet__head"><h2 id="h-klasse">Was fährst du?</h2><button class="sheet__x" type="button" data-close aria-label="Schließen">✕</button></div>
    <p class="muted small klasse__sub">Damit zeigen wir dir gleich den richtigen Preis. Ändern kannst du das oben jederzeit.</p>
    <div data-kl-body></div>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="m" id="sheet-station" aria-labelledby="h-station">
    <div class="sheet__head"><h2 id="h-station" data-st-title>Lack</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <div data-st-body></div>
  </dialog>

  <dialog class="sheet" id="sheet-fahrzeug" aria-labelledby="h-fahrzeug">
    <div class="sheet__head"><h2 id="h-fahrzeug">Was fährst du?</h2><button class="sheet__x" type="button" data-close aria-label="Schließen">✕</button></div>
    <div data-fz-body></div>
    <button class="btn btn--primary fz__done" type="button" data-close>Fertig</button>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="m" id="sheet-zeiten" aria-labelledby="h-zeiten">
    <div class="sheet__head"><h2 id="h-zeiten">Öffnungszeiten</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <p class="status" data-status>—</p>
    <table class="hours">
      <tbody>
        {days.map((d, i) => (
          <tr data-day={i}><th scope="row">{d.day}</th><td>{d.open ? `${d.open} – ${d.close}` : 'geschlossen'}</td></tr>
        ))}
      </tbody>
    </table>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="m" id="sheet-anfahrt" aria-labelledby="h-anfahrt">
    <div class="sheet__head"><h2 id="h-anfahrt">So findest du uns</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <address class="addr">{site.address.street}, {site.address.zip} {site.address.city}</address>
    <p class="muted small">{site.holBring}.</p>
    <div class="row">
      <a class="btn" href={mapsUrl} target="_blank" rel="noopener">Route in Google Maps</a>
      <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Anrufen</a>
    </div>
    <p class="muted small">Die Karte am Poster ist vereinfacht. Die Route öffnet Google Maps in einem neuen Tab, auf dieser Seite ist keine Karte eingebettet.</p>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="m" id="sheet-funk" aria-labelledby="h-funk">
    <div class="sheet__head"><h2 id="h-funk">Boxenfunk</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <p class="muted">Frag die Box. Tipp auf eine Frage.</p>
    <div class="chat" data-chat aria-live="polite"></div>
    <div class="chips" data-chat-q>
      {content.faq.map((f, i) => <button class="chip" type="button" data-q={i}>{f.q}</button>)}
    </div>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="s" id="sheet-gaestebuch" aria-labelledby="h-gb">
    <div class="sheet__head"><h2 id="h-gb">Gästebuch</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <div class="pager">
      <button class="btn btn--ghost" type="button" data-page="-1" aria-label="Vorheriger Eintrag">←</button>
      <p class="pager__n muted small" data-pager-n aria-live="polite">Eintrag 1 von {content.reviews.length}</p>
      <button class="btn btn--ghost" type="button" data-page="1" aria-label="Nächster Eintrag">→</button>
    </div>
    <p class="muted small">Beispiel-Einträge: Betrieb und Personen sind erfunden.</p>
    <ul class="book sr-only">
      {content.reviews.map((r) => <li><blockquote>{r.text}</blockquote><p>{r.who}</p></li>)}
    </ul>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="s" id="sheet-recht" aria-labelledby="h-recht">
    <div class="sheet__head"><h2 id="h-recht">Sicherungskasten</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <ul class="links links--row">
      <li><a href={`${base}impressum/`} target="_blank" rel="noopener">Impressum</a></li>
      <li><a href={`${base}datenschutz/`} target="_blank" rel="noopener">Datenschutz</a></li>
      <li><a href={`${base}impressum/#credits`} target="_blank" rel="noopener">Lizenzen</a></li>
    </ul>
    <p class="muted small">Demo-Seite von Kravets Webdesign: Betrieb und Personen sind erfunden. Öffnet in einem neuen Tab, dein Auftrag bleibt erhalten.</p>
  </dialog>

  <dialog class="sheet" id="sheet-preise" aria-labelledby="h-preise">
    <div class="sheet__head"><h2 id="h-preise">Alle Preise</h2><button class="sheet__x" type="button" data-close aria-label="Schließen">✕</button></div>
    <p class="muted small">Ab-Preise je Fahrzeugklasse. Den Festpreis gibt es nach einem kurzen Blick aufs Auto.</p>
    <div class="scroll-x">
      <table class="prices">
        <thead><tr><th scope="col">Leistung</th>{data.classes.map((c) => <th scope="col">{c.short}</th>)}</tr></thead>
        <tbody>
          {data.services.flatMap((s) => [
            ...s.levels.map((l) => (
              <tr><th scope="row">{s.levels.length > 1 ? `${s.name}: ${l.name}` : s.name}</th>{data.classes.map((c) => <td>{euro(priceFor(l.base, c.mult))}</td>)}</tr>
            )),
            ...((s as any).addons ?? []).map((a: any) => (
              <tr><th scope="row">+ {a.name}</th>{data.classes.map((c) => <td>{euro(priceFor(a.base, c.mult))}</td>)}</tr>
            )),
          ])}
        </tbody>
      </table>
    </div>
    <p class="muted small">Sonderfolien (Chamäleon, Chrom, Perlmutt): plus 30 %.</p>
  </dialog>

  <dialog class="sheet" id="sheet-menu" aria-labelledby="h-menu">
    <div class="sheet__head"><div><p class="menu__brand">{site.name}</p><h2 id="h-menu">Menü</h2></div><button class="sheet__x" type="button" data-close aria-label="Schließen">✕</button></div>
    <ul class="links">
      <li><button type="button" data-open="preise">Alle Preise</button></li>
      <li><button type="button" data-open="recht">Impressum, Datenschutz, Lizenzen</button></li>
      <li><button type="button" data-classic-on>Klassische Ansicht</button></li>
      <li><button type="button" data-replay>Intro nochmal ansehen</button></li>
    </ul>
  </dialog>

  <dialog class="sheet sheet--cam" data-size="l" id="sheet-auftrag" aria-labelledby="h-auftrag">
    <div class="sheet__head"><h2 id="h-auftrag">Dein Auftrag</h2><button class="sheet__x" type="button" data-close aria-label="Zurück zur Box">✕</button></div>
    <div class="slot"><div class="slot__win"><div class="ticket" data-ticket></div></div></div>

    <form class="order" id="auftrag" novalidate data-order>
      <fieldset>
        <legend>Deine Angaben</legend>
        <div class="field">
          <label for="o-name">Name</label>
          <input id="o-name" name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" required aria-describedby="e-name" />
          <p class="err" id="e-name" hidden>Bitte gib deinen Namen an.</p>
        </div>
        <div class="field">
          <label for="o-tel">Telefon</label>
          <input id="o-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 0511 1234567" required aria-describedby="e-tel" />
          <p class="err" id="e-tel" hidden>Bitte gib eine Nummer an, unter der wir dich erreichen.</p>
        </div>
        <div class="field">
          <label for="o-mail">E-Mail <span class="opt">(optional)</span></label>
          <input id="o-mail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@beispiel.de" aria-describedby="e-mail" />
          <p class="err" id="e-mail" hidden>Bitte prüfe die E-Mail-Adresse, z. B. name@beispiel.de.</p>
        </div>
        <div class="field">
          <label for="o-date">Wunschtermin</label>
          <input id="o-date" name="date" type="date" required aria-describedby="e-date h-date" />
          <p class="hint" id="h-date">Montag bis Samstag. Wir bestätigen den Termin telefonisch.</p>
          <p class="err" id="e-date" hidden>Bitte wähle einen Tag von Montag bis Samstag, frühestens morgen.</p>
        </div>
        <label class="check">
          <input type="checkbox" name="holbring" />
          <span>Hol- und Bringservice <span class="opt">(bis 10 km kostenlos)</span></span>
        </label>
        <div class="field field--code">
          <label for="o-code">Aktionscode <span class="opt">(optional)</span></label>
          <input id="o-code" name="code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" enterkeyhint="done" maxlength="24" placeholder="z. B. QS-2987-K4" aria-describedby="h-code" />
          <p class="hint" id="h-code" data-code-msg aria-live="polite">Hast du einen Code, etwa von einer Aktion oder aus dem Spiel? Hier eintragen, der Rabatt erscheint in der Summe.</p>
        </div>
        <div class="field">
          <label for="o-note">Nachricht <span class="opt">(optional)</span></label>
          <textarea id="o-note" name="note" rows="3" placeholder="z. B. Kaffeefleck auf dem Beifahrersitz, Hund fährt oft mit"></textarea>
        </div>
      </fieldset>
      <div class="consent">
        <label class="check">
          <input type="checkbox" name="privacy" required aria-describedby="e-privacy" />
          <span>Ich bin einverstanden, dass {site.name} meine Angaben (Name, Telefon, E-Mail, Termin, Nachricht und Auswahl) zur Bearbeitung meines Auftrags verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
        </label>
        <p class="err" id="e-privacy" hidden>Bitte stimm zu, sonst können wir deinen Auftrag nicht bearbeiten.</p>
      </div>
      <div class="order__bar">
        <p class="order__total"><span data-o-count>Noch nichts gewählt</span><span>Summe <strong data-o-sum>0 €</strong></span></p>
        <button class="btn" type="submit">Auftrag senden</button>
      </div>
    </form>

    <div class="done" data-done tabindex="-1" hidden>
      <p class="stamp" aria-hidden="true">Angenommen</p>
      <h3>Danke! Dein Auftrag ist angekommen.</h3>
      <div data-done-list></div>
      <p class="muted small">Demo: Dieses Formular ist eine Vorführung. Es wurde nichts gesendet oder gespeichert.</p>
      <button class="btn btn--ghost" type="button" data-new-order>Neuer Auftrag</button>
    </div>
  </dialog>

  <!-- ============ KLASSISCHE ANSICHT (auch ohne JavaScript) ============ -->
  <div class="classic" data-classic>
    <div class="classic__in">
      <header class="classic__head">
        <p class="classic__logo">{site.name}</p>
        <p>{site.tagline}</p>
        <button class="btn btn--ghost js-only" type="button" data-classic-off>Zurück in die Box</button>
      </header>
      <section aria-labelledby="c-leist">
        <h2 id="c-leist">Leistungen</h2>
        <ul class="c-svc">
          {data.services.map((s) => (
            <li><h3>{s.name}</h3><p>{s.sub}</p>
              <ul>{s.levels.map((l) => <li>{s.levels.length > 1 ? `${l.name}: ` : ''}{l.desc} · {l.dur} · ab {euro(l.base)}</li>)}</ul>
            </li>
          ))}
        </ul>
        <p class="muted small">Ab-Preise für Kleinwagen. Größere Autos: Kompakt +15 %, Limousine/Kombi +30 %, SUV/Van +50 %.</p>
      </section>
      <section aria-labelledby="c-zeiten">
        <h2 id="c-zeiten">Öffnungszeiten</h2>
        <table class="hours"><tbody>{days.map((d) => <tr><th scope="row">{d.day}</th><td>{d.open ? `${d.open} – ${d.close}` : 'geschlossen'}</td></tr>)}</tbody></table>
      </section>
      <section aria-labelledby="c-anf">
        <h2 id="c-anf">Anfahrt</h2>
        <address class="addr">{site.address.street}<br />{site.address.zip} {site.address.city}</address>
        <p><a href={mapsUrl} target="_blank" rel="noopener">Route in Google Maps</a> · <a href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </section>
      <section aria-labelledby="c-faq">
        <h2 id="c-faq">Fragen</h2>
        <dl class="c-faq">{content.faq.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl>
      </section>
      <section aria-labelledby="c-gb">
        <h2 id="c-gb">Gästebuch</h2>
        <p class="muted small">Beispiel-Einträge: Betrieb und Personen sind erfunden.</p>
        <ul class="book">{content.reviews.map((r) => <li><blockquote>{r.text}</blockquote><p>{r.who}</p></li>)}</ul>
      </section>
    </div>
    <footer class="doc-foot">
      <a href={`${base}impressum/`} target="_blank" rel="noopener">Impressum</a>
      <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Datenschutz</a>
      <p>Demo-Seite von Kravets Webdesign: Betrieb und Personen sind erfunden. 3D-Modell: „BMW M6 E64 Cabrio (WIP)“ von obviously.csmx, CC BY 4.0.</p>
    </footer>
  </div>
</div>

<script>
  import { start } from '../scripts/app.js';
  start();
</script>
</Base>
