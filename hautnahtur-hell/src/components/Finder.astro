---
/** Подбор ухода за лицом: мастер по шагам. Один вопрос на экране, ответы строками с кружком, прогресс тремя точками,
 *  после третьего ответа — 1–2 процедуры с ценой и кнопкой «в заявку». */
import data from '../data/behandlungen.json';
import site from '../data/site.json';
import Foto from './Foto.astro';
const { id = 'finder', titel = 'Welche Gesichtsbehandlung passt zu mir?', mehr = true, foto = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const fragen = [
  { key: 'haut', text: 'Was wünscht sich Ihre Haut?' },
  { key: 'zeit', text: 'Wie viel Zeit möchten Sie sich nehmen?' },
  { key: 'art', text: 'Was mögen Sie lieber?' },
];
---
<section class="fi section" id={id} aria-labelledby={`${id}-h`} data-finder>
  <div class={`wrap fi__wrap ${foto ? 'fi__wrap--foto' : ''}`}>
    {foto && <div class="fi__foto"><Foto name={typeof foto === 'string' ? foto : 'gesicht-3x4'} alt="Kundin mit Handtuch im Haar bei einer ruhigen Gesichtsbehandlung" sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 40vw, 92vw" /></div>}
    <div class="fi__karte">
      <h2 id={`${id}-h`}>{titel.replace("Gesichtsbehandlung", "Gesichts\u00ADbehandlung")}</h2>
      <div class="fi__kopf">
        <p class="fi__zaehler" data-zaehler aria-live="polite">Frage 1 von 3</p>
        <div class="fi__faden" aria-hidden="true"><i data-fuell></i><b></b><b></b><b></b></div>
      </div>
      <div class="fi__buehne">
        {fragen.map((f, n) => (
          <fieldset class="fi__frage" data-schritt={n} hidden={n > 0}>
            <legend>{f.text}</legend>
            <div class={`fi__opt fi__opt--${f.key}`}>
              {data.fragen[f.key].map((o) => (
                <label class="fi__karteopt"><input type="radio" name={`${id}-${f.key}`} value={o.id} data-key={f.key} /><span>{o.label}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="fi__ergebnis" data-ergebnis hidden tabindex="-1" aria-live="polite">
          <p class="fi__titel" data-ergebnis-titel></p>
          <ul class="fi__liste" data-ergebnis-liste></ul>
          <p class="fi__tel" data-ergebnis-tel hidden>Am besten besprechen wir das kurz am Telefon: <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        </div>
      </div>
      <div class="fi__nav">
        <button type="button" class="fi__link" data-zurueck hidden>Zurück</button>
        <button type="button" class="fi__link" data-neu hidden>Noch einmal von vorn</button>
      </div>
      {mehr && <p class="fi__mehr"><a href={`${base}gesicht/`}>Alle Gesichtsbehandlungen und Preise</a></p>}
    </div>
  </div>
</section>

<style>
  /* Вариант A: подбор на песке, ответы — белые строки с кружком, прогресс — три точки из отточия «карты» */
  .fi { background: var(--sand); }
  .fi__wrap { display: grid; gap: var(--space-lg); }
  .fi__karte { min-width: 0; }
  .fi__karte h2 { font-size: clamp(1.8rem, 1.3rem + 2.2vw, 3rem); max-width: 18ch; }
  .fi__kopf { display: flex; align-items: center; gap: 1rem; margin-top: var(--space-lg); }
  .fi__zaehler { font-size: var(--text-sm); color: var(--tinte-2); font-weight: 600; white-space: nowrap; }
  .fi__faden { position: relative; flex: 1; height: 12px; display: flex; justify-content: space-between; align-items: center; }
  .fi__faden::before { content: ''; position: absolute; left: 6px; right: 6px; top: 50%; border-top: 2px dotted #D3C2B2; }
  .fi__faden i { position: absolute; left: 6px; top: 50%; height: 2px; margin-top: -1px; width: 0; max-width: calc(100% - 12px); background: var(--orange); transition: width 0.4s cubic-bezier(0.3, 0.9, 0.3, 1); }
  .fi__faden b { position: relative; width: 12px; height: 12px; border-radius: 50%; background: var(--sand); border: 2px solid #CDBBA9; transition: background 0.25s, border-color 0.25s; }
  .fi__faden b.an { background: var(--orange); border-color: var(--orange); }
  .fi__buehne { margin-top: var(--space-lg); }
  .fi__frage { border: 0; padding: 0; margin: 0; min-width: 0; animation: schritt 0.3s cubic-bezier(0.2, 0.9, 0.3, 1); }
  .fi__frage[hidden], .fi__ergebnis[hidden] { display: none; }
  .fi__rueck .fi__frage { animation-name: schrittzu; }
  @keyframes schritt { from { opacity: 0; transform: translateX(24px); } }
  @keyframes schrittzu { from { opacity: 0; transform: translateX(-24px); } }
  .fi__frage legend { padding: 0; margin-bottom: 0.9rem; font-weight: 680; font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.75rem); letter-spacing: -0.02em; line-height: 1.2; }
  .fi__opt { display: grid; gap: 0.5rem; }
  .fi__karteopt { position: relative; display: block; }
  .fi__karteopt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .fi__karteopt span { display: flex; align-items: center; gap: 0.75rem; min-height: 3.4rem; padding: 0.65rem 1.1rem; border-radius: 16px; background: var(--papier); border: 1.5px solid transparent; font-weight: 550; line-height: 1.3; cursor: pointer; transition: border-color 0.15s; }
  .fi__karteopt span::before { content: ''; flex: none; width: 1.25rem; height: 1.25rem; border-radius: 50%; border: 1.5px solid #CDBFB2; transition: border-color 0.15s, box-shadow 0.15s; }
  .fi__karteopt:hover span { border-color: var(--sand-2); }
  .fi__karteopt input:checked + span { border-color: var(--orange); }
  .fi__karteopt input:checked + span::before { border-color: var(--orange); box-shadow: inset 0 0 0 4px var(--papier), inset 0 0 0 10px var(--orange); }
  .fi__karteopt input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 2px; }
  .fi__nav { display: flex; justify-content: space-between; gap: 1rem; min-height: 2.75rem; margin-top: var(--space-md); }
  .fi__link { min-height: 2.75rem; padding: 0 0.2rem; border: 0; background: none; font: inherit; font-weight: var(--strong-weight); color: var(--tinte); text-decoration: underline; text-underline-offset: 0.25em; cursor: pointer; }
  .fi__link[hidden] { display: none; }
  .fi__nav:not(:has(.fi__link:not([hidden]))) { display: none; }
  .fi__ergebnis { outline: none; animation: schritt 0.3s cubic-bezier(0.2, 0.9, 0.3, 1); }
  .fi__titel { font-weight: 680; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); letter-spacing: -0.02em; line-height: 1.15; }
  .fi__liste { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.7rem; }
  .fi__liste :global(li) { display: grid; gap: 0.45rem; overflow-wrap: anywhere; padding: 1.1rem 1.2rem; background: var(--papier); border-radius: 18px; }
  .fi__liste :global(li:first-child) { box-shadow: inset 0 0 0 2px var(--orange); }
  .fi__liste :global(.fi__kopf2) { display: flex; justify-content: space-between; gap: 0.3rem 1rem; align-items: baseline; flex-wrap: wrap; }
  .fi__liste :global(h3) { font-size: 1.15rem; }
  .fi__liste :global(.fi__preis) { font-weight: var(--strong-weight); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .fi__liste :global(.fi__linie) { font-size: var(--text-sm); color: var(--orange-text); font-weight: 600; }
  .fi__liste :global(.btn) { justify-self: start; margin-top: 0.3rem; }
  .fi__tel { margin-top: 1rem; }
  .fi__tel[hidden] { display: none; }
  .fi__mehr { margin-top: var(--space-md); }
  .fi__foto :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: 50% 30%; border-radius: var(--radius); }
  @media (min-width: 64rem) { .fi__opt--haut { grid-template-columns: 1fr 1fr; } .fi__opt--haut .fi__karteopt:last-child { grid-column: 1 / -1; } }
  /* Tablet und Querformat: Foto links schmal, Fragen rechts (Datei 896 px reicht so auch auf 2×) */
  @media (min-width: 48rem) {
    .fi__wrap--foto { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: var(--space-xl); }
    .fi__foto { position: sticky; top: 7rem; }
    .fi__foto :global(img) { aspect-ratio: 4 / 5; border-radius: 28px; }
  }
  @media (min-width: 48rem) and (max-height: 32rem) { .fi__foto { position: static; } .fi__foto :global(img) { aspect-ratio: 1; } }
</style>

<script>
  import data from '../data/behandlungen.json';
  import * as cart from '../lib/cart';
  const linie = Object.fromEntries(data.linien.map((l) => [l.id, l.name]));
  const zeitOk = (min: number, z: string) => (z === 'kurz' ? min <= 45 : z === 'mittel' ? min === 60 : min >= 90);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-finder]').forEach((root) => {
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-schritt]')];
    const erg = q('[data-ergebnis]'), liste = q('[data-ergebnis-liste]'), buehne = q('.fi__buehne');
    const dots = [...root.querySelectorAll<HTMLElement>('.fi__faden b')];
    let cur = 0, timer = 0;
    const wahl = () => { const v: Record<string, string> = {}; root.querySelectorAll<HTMLInputElement>('input[data-key]:checked').forEach((i) => (v[i.dataset.key!] = i.value)); return v; };

    function show(n: number, rueck = false) {
      cur = n; const fertig = n >= steps.length;
      buehne.classList.toggle('fi__rueck', rueck);
      steps.forEach((s, i) => (s.hidden = i !== n));
      erg.hidden = !fertig;
      q('[data-zaehler]').textContent = fertig ? 'Ihr Ergebnis' : `Frage ${n + 1} von ${steps.length}`;
      q('[data-fuell]').style.width = `calc(${Math.min(n, steps.length) / steps.length * 100}% - 14px)`;
      dots.forEach((d, i) => d.classList.toggle('an', i < n || (fertig && i < steps.length)));
      q('[data-zurueck]').hidden = n === 0;
      q('[data-neu]').hidden = !fertig;
    }
    function rechnen() {
      const v = wahl();
      const ranked = data.behandlungen
        .filter((b) => b.id !== 'z-mann' || v.haut === 'entspannen' || v.haut === 'frische')
        .map((b) => ({ b, p: (b.haut.includes(v.haut) ? 3 : 0) + (zeitOk(b.min, v.zeit) ? 2 : 0) + (v.art === 'egal' ? 1 : b.art === v.art ? 2 : 0), d: Math.abs(b.min - (v.zeit === 'kurz' ? 40 : v.zeit === 'mittel' ? 60 : 95)) }))
        .sort((a, b) => b.p - a.p || a.d - b.d);
      const best = ranked.filter((r) => r.p >= 5).slice(0, 2);
      const zeige = best.length ? best : ranked.slice(0, 1);
      q('[data-ergebnis-titel]').textContent = best.length ? (zeige.length > 1 ? 'Das passt zu Ihnen' : 'Das passt am besten') : 'Am nächsten kommt das';
      q('[data-ergebnis-tel]').hidden = best.length > 0;
      liste.replaceChildren(...zeige.map(({ b }) => {
        const li = document.createElement('li');
        const kopf = document.createElement('div'); kopf.className = 'fi__kopf2';
        const h = document.createElement('h3'); h.textContent = b.name;
        const p = document.createElement('span'); p.className = 'fi__preis'; p.textContent = `${cart.dauer(b.min)} · ${cart.euro(b.preis)}`;
        kopf.append(h, p);
        const l = document.createElement('p'); l.className = 'fi__linie'; l.textContent = linie[b.linie];
        const t = document.createElement('p'); t.textContent = b.text;
        const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn btn--ghost';
        const upd = () => { btn.textContent = cart.has(b.id) ? 'In der Anfrage ✓' : 'In die Anfrage übernehmen'; btn.setAttribute('aria-pressed', String(cart.has(b.id))); };
        btn.addEventListener('click', () => { cart.toggle(b.id); upd(); });
        addEventListener('zf:cart', upd); upd();
        li.append(kopf, l, t, btn); return li;
      }));
    }
    root.addEventListener('change', (e) => {
      if (!(e.target as HTMLElement).matches('input[data-key]')) return;
      clearTimeout(timer);
      const next = cur + 1;
      timer = window.setTimeout(() => {
        if (next >= steps.length) rechnen();
        show(next);
        if (next >= steps.length) erg.focus({ preventScroll: true });
      }, reduce.matches ? 0 : 260);
    });
    q('[data-zurueck]').addEventListener('click', () => { clearTimeout(timer); show(Math.max(0, cur - 1), true); });
    q('[data-neu]').addEventListener('click', () => {
      root.querySelectorAll<HTMLInputElement>('input[data-key]').forEach((i) => (i.checked = false));
      show(0, true);
    });
    show(0);
  });
</script>
