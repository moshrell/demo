---
/** Герой варианта A: видео пасты в скруглённом окне (zuckerpaste/, бесшовная петля 7,5 с), заголовок, кнопка к калькулятору
 *  и три строки «карты процедур» с ценами «ab». Телефон стоя: окно сверху, высота подстраивается под экран, чтобы кнопка
 *  была над панелью. ПК: текст слева, окно справа. Пока видео грузится (и при reduced-motion / энергосбережении iOS) виден первый кадр. */
import site from '../data/site.json';
import zonen from '../data/zonen.json';
import beh from '../data/behandlungen.json';
import zusatz from '../data/zusatz.json';
import { euro } from '../lib/fmt.mjs';
const base = import.meta.env.BASE_URL;
const min = (a) => Math.min(...a.map((x) => x.preis));
const zeilen = [
  { name: 'Sugaring', preis: min(zonen.zonen), href: 'sugaring/' },
  { name: 'Gesichtsbehandlung', preis: min(beh.behandlungen), href: 'gesicht/' },
  { name: 'Hände, Füße, Make-up', preis: min(zusatz.gruppen.flatMap((g) => g.items)), href: 'preise/' },
];
---
<section class="held" aria-labelledby="held-h">
  <div class="held__film">
    <picture>
      <source media="(orientation: portrait) and (max-width: 47.99rem)" srcset={`${base}video/paste-tel.jpg`} />
      <img class="held__poster" src={`${base}video/paste-pc.jpg`} alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <video class="held__video" muted loop playsinline preload="none" aria-hidden="true" data-film data-pc={`${base}video/paste-pc.mp4`} data-tel={`${base}video/paste-tel.mp4`}></video>
  </div>
  <div class="held__text">
    <h1 id="held-h">Sugaring und Kosmetik in&nbsp;{site.address.city}</h1>
    <p class="held__lede">Haarentfernung mit reiner Zuckerpaste und Gesichtsbehandlungen ganz ohne Apparate. Seit {site.since}, bei {site.owner.split(' ')[0]} in der {site.address.street}.</p>
    <div class="held__btns">
      <a class="btn" href={`${base}sugaring/#zonen`}>Preis für meine Zonen</a>
      <a class="btn btn--ghost held__zweit" href={`${base}termin/`}>Termin anfragen</a>
    </div>
    <ul class="held__karte" aria-label="Preise ab">
      {zeilen.map((z) => (
        <li><a class="karte-zeile" href={base + z.href}><span class="name">{z.name}</span><span class="punkte" aria-hidden="true"></span><span class="preis"><span class="ab">ab</span>{euro(z.preis)}</span></a></li>
      ))}
    </ul>
  </div>
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-film]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const mq = matchMedia('(orientation: portrait) and (max-width: 47.99rem)');
    const set = () => {
      const src = mq.matches ? v.dataset.tel! : v.dataset.pc!;
      if (v.getAttribute('src') === src) return;
      v.classList.remove('is-on'); v.src = src;
      v.play().catch((e) => console.info('held: Autoplay blockiert, Standbild bleibt', e?.name));
    };
    v.addEventListener('playing', () => v.classList.add('is-on'));
    set(); mq.addEventListener('change', set);
  }
</script>

<style>
  .held { display: grid; gap: 1.4rem; padding: 0.25rem var(--gutter) var(--space-xl); max-width: var(--maxw); margin-inline: auto; }
  .held__film { position: relative; overflow: hidden; border-radius: var(--radius); height: clamp(11rem, 100svh - 35rem, 30rem); background: #0b0705; }
  .held__film picture, .held__poster, .held__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 100%; }
  .held__video { opacity: 0; transition: opacity 0.6s; }
  .held__video:global(.is-on) { opacity: 1; }
  .held__text { display: grid; gap: 0.9rem; align-content: start; min-width: 0; }
  .held h1 { font-size: clamp(2.35rem, 1.4rem + 4.4vw, 5rem); max-width: 12ch; }
  .held__lede { color: var(--tinte-2); font-size: var(--text-lg); max-width: 34rem; }
  .held__btns { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.3rem; }
  .held__btns .btn { flex: 1 1 auto; }
  .held__zweit { display: none; }
  .held__karte { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; border-top: 1px solid var(--linie); }
  .held__karte li { border-bottom: 1px solid var(--linie); }
  .held__karte a { min-height: 3.4rem; text-decoration: none; font-size: var(--text-lg); }
  .held__karte a:hover .name { text-decoration: underline; text-underline-offset: 0.22em; }
  @media (max-height: 700px) and (orientation: portrait) and (max-width: 47.99rem) {
    .held__film { height: clamp(10rem, 100svh - 28rem, 30rem); }
    .held__lede { display: none; }
  }
  /* планшет стоя: окно шире и ниже, видео 16:9 */
  /* планшет стоя: две колонки, окно справа, цены под текстом */
  @media (orientation: portrait) and (min-width: 48rem) and (max-width: 63.99rem) {
    .held { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 2rem; padding-block: 1.5rem var(--space-2xl); }
    .held__film { order: 2; height: auto; aspect-ratio: 4 / 5; border-radius: 24px; }
    .held__film picture, .held__poster, .held__video { object-position: 50% 60%; }
    .held h1 { font-size: 3.1rem; }
    .held__zweit { display: inline-flex; }
    .held__btns .btn { flex: 0 1 auto; }
  }
  /* телефон боком: текст слева, окно справа */
  @media (orientation: landscape) and (max-height: 500px) and (max-width: 63.99rem) {
    .held { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); align-items: start; gap: 1.4rem; padding-bottom: 5rem; }
    .held__film { order: 2; height: calc(100svh - 6rem); position: sticky; top: 5rem; }
    .held__film picture, .held__poster, .held__video { object-position: 62% 60%; }
    .held h1 { font-size: 2.3rem; }
    .held__lede { font-size: 1rem; }
  }
  @media (min-width: 64rem) {
    .held { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2.5rem, 5vw, 5.5rem); padding-block: 2rem var(--space-3xl); min-height: min(calc(100svh - 4.75rem), 54rem); }
    .held__film { order: 2; height: auto; aspect-ratio: 5 / 6; max-height: calc(100svh - 8rem); border-radius: 28px; }
    .held__film picture, .held__poster, .held__video { object-position: 64% 60%; }
    .held__zweit { display: inline-flex; }
    .held__btns .btn { flex: 0 1 auto; }
  }
</style>
