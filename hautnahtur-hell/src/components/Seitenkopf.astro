---
/** Шапка подстраницы варианта A: белая, крупный заголовок, пояснение и (по желанию) строка фактов-«жетонов». */
interface Props { titel: string; lede?: string; fakten?: string[] }
const { titel, lede = '', fakten = [] } = Astro.props;
---
<section class="seitenkopf">
  <div class="wrap">
    <h1 set:html={titel} />
    {lede && <p class="lede">{lede}</p>}
    {fakten.length > 0 && <ul class="fakten-reihe">{fakten.map((f) => <li>{f}</li>)}</ul>}
    <slot />
  </div>
</section>
