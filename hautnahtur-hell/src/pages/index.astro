---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Held from '../components/Held.astro';
import site from '../data/site.json';
import zonen from '../data/zonen.json';
import beh from '../data/behandlungen.json';
import zusatz from '../data/zusatz.json';
import { euro } from '../lib/fmt.mjs';
const base = import.meta.env.BASE_URL;
const jahre = new Date().getFullYear() - site.since;
const min = (a) => Math.min(...a.map((x) => x.preis));
const z = (id) => zonen.zonen.find((x) => x.id === id);
// Schnellpreis: die häufigsten Damen-Zonen, sofort antippbar (gleiche Auswahl wie im Rechner auf /sugaring/)
const schnell = ['d-oberlippe', 'd-brauen', 'd-achseln', 'd-arme', 'd-bikini', 'd-unterschenkel', 'd-oberschenkel', 'd-intim'].map(z);
const grp = (id) => zusatz.gruppen.find((g) => g.id === id);
const leistungen = [
  { titel: 'Sugaring', text: 'Haarentfernung mit körperwarmer Zuckerpaste, für Damen und Herren.', preis: min(zonen.zonen), href: 'sugaring/', bild: 'leistung-lippe', alt: 'Sugaring an der Oberlippe' },
  { titel: 'Gesichtsbehandlungen', text: 'Mit Zucker, atamé Kräuter-Tonics oder klassisch mit Mary Kay. Ohne Apparate.', preis: min(beh.behandlungen), href: 'gesicht/', bild: 'leistung-massage', alt: 'Sanfte Gesichtsmassage' },
  { titel: 'Wimpern und Augenbrauen', text: 'Färben und Zupfen, auch als Ergänzung zur Behandlung.', preis: min(grp('farbe').items), href: 'preise/#farbe', bild: 'leistung-wimpern', alt: 'Wimpern werden gefärbt' },
  { titel: 'Hände und Füße', text: 'Maniküre, Naturnagelpflege und Wellness-Fußpflege.', preis: min(grp('haende').items), href: 'preise/#haende' },
  { titel: 'Make-up', text: 'Für den Tag, den Abend und die Hochzeit, mit Beratung.', preis: min(grp('makeup').items), href: 'preise/#makeup' },
];
const studio = [
  ['studio-kabine', 'Behandlungsliege mit orangefarbenen Handtüchern und einer weißen Lilie'],
  ['studio-empfang', 'Empfangstresen im orangefarbenen Eingangsbereich'],
  ['studio-pandys', 'Pflegeprodukte von Pandy’s im Regal'],
  ['studio-lampe', 'Lampe in Form einer Pusteblume'],
  ['studio-regale', 'Orangefarbene Regale mit Pflegeprodukten'],
  ['studio-lilie', 'Weiße Lilie auf orangefarbenen Handtüchern'],
];
---
<Base title="Hautnahtur Kosmetikstudio Gehrden: Sugaring und Kosmetik" description={`Kosmetikstudio in Gehrden seit ${site.since}: Sugaring mit reiner Zuckerpaste ab ${euro(min(zonen.zonen))}, Gesichtsbehandlungen ohne Apparate, Maniküre, Fußpflege, Make-up. Preis für Ihre Zonen sofort sehen.`} aktiv="start">
  <Held />

  <section class="schnell sand" aria-labelledby="schnell-h">
    <div class="wrap schnell__in">
      <div class="kopfzeile">
        <h2 id="schnell-h">Was kostet Sugaring bei mir?</h2>
        <p class="lede">Tippen Sie an, was glatt werden soll. Die Summe rechnet sofort mit, Herren-Zonen und alle Einzelheiten finden Sie im Rechner.</p>
      </div>
      <ul class="schnell__liste" data-schnell>
        {schnell.map((x) => (
          <li><button type="button" class="schnell__zone" data-zone={x.id} aria-pressed="false"><span class="schnell__haken" aria-hidden="true"></span><span class="schnell__name">{x.kurz}</span><span class="preis"><span class="ab">ab</span>{euro(x.preis)}</span></button></li>
        ))}
      </ul>
      <div class="schnell__summe" data-pille-weg>
        <p><span class="muted" data-schnell-n>Noch nichts gewählt</span><strong class="num" data-schnell-summe></strong></p>
        <div class="btn-row">
          <a class="btn" href={`${base}termin/`}>Termin anfragen</a>
          <a class="btn btn--ghost" href={`${base}sugaring/#zonen`}>Alle Zonen am Körper</a>
        </div>
      </div>
      <p class="small muted schnell__hinweis">{zonen.hinweis}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="leist-h">
    <div class="wrap">
      <div class="kopfzeile">
        <h2 id="leist-h">Meine Behandlungen</h2>
        <p class="lede">Alles mit den Händen, mit natürlichen Produkten und so viel Zeit, wie Ihre Haut braucht.</p>
      </div>
      <ul class="leist">
        {leistungen.map((l) => (
          <li>
            <a class="leist__karte" href={base + l.href}>
              {l.bild && <Foto name={l.bild} alt={l.alt} sizes="(min-width: 64rem) 22rem, 92vw" class="leist__bild" />}
              <span class="leist__text">
                <span class="karte-zeile"><span class="name leist__titel">{l.titel}</span><span class="punkte" aria-hidden="true"></span><span class="preis"><span class="ab">ab</span>{euro(l.preis)}</span></span>
                <span class="muted">{l.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="pfeil" href={`${base}preise/`}>Alle Preise auf einen Blick</a></p>
    </div>
  </section>

  <section class="ich sand" aria-labelledby="ich-h">
    <div class="wrap ich__in">
      <Foto name="michaela" alt={`${site.owner}, Inhaberin von Hautnahtur`} sizes="11rem" class="ich__foto" />
      <div class="ich__text">
        <h2 id="ich-h">Ich bin {site.owner.split(' ')[0]}</h2>
        <p class="lede">Kosmetikerin und Fußpflegerin, seit {jahre} Jahren selbstständig in Gehrden. Ihre Wünsche entscheiden, deshalb gibt es bei mir Zucker, Kräuter-Tonics und die klassische Behandlung.</p>
        <blockquote class="ich__satz">„Behandele andere so, wie auch du behandelt werden möchtest.“</blockquote>
        <p><a class="pfeil" href={`${base}ueber-mich/`}>Ausbildung und Arbeitsweise</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="raum-h">
    <div class="wrap">
      <div class="kopfzeile raum__kopf">
        <h2 id="raum-h">Das Studio in der {site.address.street}</h2>
        <p class="lede">Dienstag und Donnerstag bis 22 Uhr geöffnet, samstags nach Absprache.</p>
      </div>
      <ul class="raum" aria-label="Bilder aus dem Studio">
        {studio.map(([n, alt]) => <li><Foto name={n} alt={alt} sizes="(min-width: 48rem) 16vw, 45vw" class="raum__foto" /></li>)}
      </ul>
    </div>
  </section>
</Base>

<script>
  import * as cart from '../lib/cart';
  const root = document.querySelector<HTMLElement>('[data-schnell]');
  if (root) {
    const ids = [...root.querySelectorAll<HTMLButtonElement>('[data-zone]')].map((b) => b.dataset.zone!);
    const render = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-zone]').forEach((b) => b.setAttribute('aria-pressed', String(cart.active(b.dataset.zone!))));
      const c = cart.get();
      const n = c.lines.length;
      document.querySelector('[data-schnell-n]')!.textContent = n ? `Ihre Auswahl: ${cart.anzahl(n)}` : 'Noch nichts gewählt';
      document.querySelector('[data-schnell-summe]')!.textContent = n ? (c.ab ? 'ab ' : '') + cart.euro(c.summe) : '';
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-zone]');
      if (b && ids.includes(b.dataset.zone!)) cart.toggle(b.dataset.zone!);
    });
    window.addEventListener('zf:cart', render);
    render();
  }
</script>

<style>
  /* ---------- Schnellpreis ---------- */
  .schnell { padding-block: var(--space-2xl); }
  .schnell__liste { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .schnell__zone { width: 100%; min-height: 3.5rem; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 0.6rem; align-items: center; padding: 0.55rem 0.8rem; text-align: left; border: 1.5px solid var(--sand-2); border-radius: 16px; background: var(--papier); color: var(--tinte); font: inherit; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .schnell__zone:hover { border-color: var(--tinte-2); }
  .schnell__haken { grid-row: span 2; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 1.5px solid #CDBFB2; display: grid; place-items: center; }
  .schnell__name { font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; }
  .schnell__zone .preis { font-size: var(--text-sm); font-weight: 500; color: var(--tinte-2); }
  .schnell__zone[aria-pressed='true'] { border-color: var(--orange); background: #FFF7EE; }
  .schnell__zone[aria-pressed='true'] .schnell__haken { background: var(--orange); border-color: var(--orange); }
  .schnell__zone[aria-pressed='true'] .schnell__haken::after { content: ''; width: 0.5rem; height: 0.28rem; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
  .schnell__summe { margin-top: var(--space-lg); padding: 1.1rem 1.2rem; border-radius: var(--radius); background: var(--papier); display: grid; gap: 0.9rem; }
  .schnell__summe p { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.3rem 1rem; }
  .schnell__summe strong { font-size: 1.8rem; letter-spacing: -0.02em; }
  .schnell__hinweis { margin-top: 1rem; max-width: 44rem; }
  @media (min-width: 48rem) { .schnell__liste { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .schnell__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); column-gap: var(--space-2xl); align-items: start; }
    .schnell__in .kopfzeile { grid-row: span 3; position: sticky; top: 7rem; }
    .schnell__liste { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ---------- Leistungen: Karte mit Bildstreifen ---------- */
  .leist { list-style: none; padding: 0; margin: 0 0 var(--space-lg); display: grid; gap: var(--space-lg); }
  .leist__karte { display: grid; gap: 0.8rem; text-decoration: none; }
  .leist__karte :global(.leist__bild) { aspect-ratio: 757 / 220; border-radius: 14px; }
  .leist__text { display: grid; gap: 0.3rem; min-width: 0; }
  .leist__titel { font-weight: 680; font-size: 1.35rem; letter-spacing: -0.02em; }
  .leist__karte .preis { font-size: 1.1rem; }
  .leist__karte:hover .leist__titel { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  @media (min-width: 48rem) {
    .leist { gap: 0; border-top: 1px solid var(--linie); }
    .leist li { border-bottom: 1px solid var(--linie); }
    .leist__karte { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: var(--space-xl); align-items: center; padding-block: 1.2rem; }
    .leist__karte :global(.leist__bild) { aspect-ratio: 16 / 7; }
    .leist__text { grid-column: 2; }
  }
  @media (min-width: 64rem) { .leist__karte { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); } }

  /* ---------- Michaela ---------- */
  .ich { padding-block: var(--space-2xl); }
  .ich__in { display: grid; gap: var(--space-lg); }
  .ich__in :global(.ich__foto) { width: 9.5rem; aspect-ratio: 263 / 339; border-radius: 999px 999px 18px 18px; }
  .ich__text { display: grid; gap: 1rem; max-width: 40rem; }
  .ich__satz { margin: 0.2rem 0 0; padding-left: 1rem; border-left: 3px solid var(--orange); font-size: 1.3rem; font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; }
  @media (min-width: 48rem) { .ich__in { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-2xl); } .ich__in :global(.ich__foto) { width: 11rem; } }

  /* ---------- Studio: Raster aus kleinen Bildern (Originale nur 356 px breit) ---------- */
  .raum { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .raum :global(.raum__foto) { aspect-ratio: 356 / 276; border-radius: 12px; }
  /* Originale 356 px: ab Tablet eine Reihe à 6, so bleiben sie auf 2× scharf */
  @media (min-width: 48rem) { .raum { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.6rem; } }
  @media (min-width: 64rem) { .raum { gap: 0.75rem; } }
</style>
