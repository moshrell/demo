---
import Base from '../layouts/Base.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import zonen from '../data/zonen.json';
import beh from '../data/behandlungen.json';
import zusatz from '../data/zusatz.json';
import site from '../data/site.json';
import { euro, dauer } from '../lib/fmt.mjs';
const kapitel = [
  { id: 'sugaring', name: 'Sugaring', gruppen: [
    { id: 'sugaring-damen', name: 'Damen', items: zonen.zonen.filter((z) => z.g === 'damen') },
    { id: 'sugaring-herren', name: 'Herren', items: zonen.zonen.filter((z) => z.g === 'herren') },
  ] },
  { id: 'gesicht', name: 'Gesichtsbehandlungen', gruppen: beh.linien.map((l) => ({ id: l.id, name: l.name, items: beh.behandlungen.filter((b) => b.linie === l.id) })) },
  ...zusatz.gruppen.map((g) => ({ id: g.id, name: g.name, gruppen: [{ id: `${g.id}-liste`, name: '', items: g.items }] })),
];
const alle = kapitel.flatMap((k) => k.gruppen.flatMap((g) => g.items));
---
<Base title="Preisliste | Hautnahtur Kosmetikstudio Gehrden" description="Alle Preise für Sugaring, Gesichtsbehandlungen, Maniküre, Fußpflege, Wimpern- und Brauenfärben und Make-up." aktiv="preise" prices={alle.map((i) => ({ name: i.name, price: i.preis }))}>
  <Seitenkopf titel="Preisliste" lede="Alle Leistungen auf einer Karte. Sugaring-Preise sind Ab-Preise, den genauen Preis besprechen wir beim Termin.">
    <button type="button" class="btn btn--ghost preise__druck" data-druck>Preisliste drucken</button>
  </Seitenkopf>

  <nav class="sprung" aria-label="Zu einem Kapitel springen">
    <div class="wrap sprung__in">
      {kapitel.map((k) => <a href={`#${k.id}`}>{k.name}</a>)}
    </div>
  </nav>

  <div class="wrap preise">
    {kapitel.map((k) => (
      <section class="kap" id={k.id} aria-labelledby={`${k.id}-h`}>
        <h2 id={`${k.id}-h`}>{k.name}</h2>
        <div class="kap__gruppen">
          {k.gruppen.map((g) => (
            <div class="gr" id={g.id}>
              {g.name && <h3>{g.name}</h3>}
              <ul>
                {g.items.map((i) => (
                  <li>
                    <span class="karte-zeile"><span class="name">{i.name}</span><span class="punkte" aria-hidden="true"></span><span class="preis">{i.ab ? <span class="ab">ab</span> : ''}{euro(i.preis)}</span></span>
                    {i.min > 0 && <span class="gr__dauer num">{dauer(i.min)}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}
    <p class="small muted preise__fuss">{zonen.hinweis} Bei einer Kosmetikbehandlung ist eine gewünschte Haarentfernung im Gesicht im Behandlungspreis inbegriffen. Bei der Make-up-Beratung mit Produkten von Mary Kay Cosmetics ist die Beratung beim Kauf der Produkte kostenfrei.</p>
    <p class="preise__adresse">{site.name} · {site.address.street} · {site.address.zip} {site.address.city} · {site.phone}</p>
  </div>
</Base>

<script>
  document.querySelector('[data-druck]')?.addEventListener('click', () => window.print());
</script>

<style>
  .preise__druck { justify-self: start; }
  .sprung { position: sticky; top: 4.25rem; z-index: 20; background: rgba(255, 255, 255, 0.96); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 1px solid var(--linie); }
  .sprung__in { display: flex; gap: 0.35rem; overflow-x: auto; scrollbar-width: none; padding-block: 0.5rem; }
  .sprung__in::-webkit-scrollbar { display: none; }
  .sprung a { flex: none; display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border-radius: 999px; background: var(--sand); text-decoration: none; font-weight: 600; font-size: var(--text-sm); }
  .preise { padding-block: var(--space-xl) var(--space-2xl); }
  .kap { scroll-margin-top: 8.5rem; padding-block: var(--space-lg) var(--space-xl); border-bottom: 1px solid var(--linie); }
  .kap h2 { font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.4rem); margin-bottom: var(--space-md); hyphens: auto; -webkit-hyphens: auto; }
  .kap__gruppen { display: grid; gap: var(--space-lg); }
  .gr { scroll-margin-top: 8.5rem; }
  .gr h3 { font-size: 1.1rem; color: var(--orange-text); margin-bottom: 0.3rem; }
  .gr ul { list-style: none; padding: 0; margin: 0; }
  .gr li { display: grid; gap: 0.1rem; padding-block: 0.6rem; border-bottom: 1px dashed var(--linie); }
  .gr li:last-child { border-bottom: 0; }
  .gr .name { overflow-wrap: anywhere; }
  .gr__dauer { font-size: var(--text-sm); color: var(--tinte-2); }
  .preise__fuss { margin-top: var(--space-lg); max-width: 48rem; }
  .preise__adresse { display: none; }
  @media (min-width: 64rem) {
    .kap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: var(--space-2xl); }
    .kap h2 { position: sticky; top: 9rem; align-self: start; }
    .kap__gruppen { grid-template-columns: 1fr 1fr; column-gap: var(--space-xl); }
    .kap__gruppen:has(> .gr:only-child) { grid-template-columns: 1fr; max-width: 34rem; }
    .sprung { top: 4.75rem; }
  }
  @media print {
    .sprung, .preise__druck { display: none !important; }
    .kap { break-inside: avoid; padding-block: 0.6rem; }
    .preise__adresse { display: block; margin-top: 1rem; font-weight: 600; }
  }
</style>
