---
import Base from '../layouts/Base.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Foto from '../components/Foto.astro';
import Zonenrechner from '../components/Zonenrechner.astro';
import zonen from '../data/zonen.json';
import { euro } from '../lib/fmt.mjs';
const base = import.meta.env.BASE_URL;
const vorteile = [
  ['In Wuchsrichtung', 'Das vermindert den Schmerz und vermeidet Haarbruch.'],
  ['Vollständig', 'Die Haare werden feiner und wachsen langsamer nach.'],
  ['Langfristig', 'Die Haarbildungsstrukturen werden langfristig zerstört, das führt zu einem permanenten Resultat.'],
  ['Sauber und hygienisch', 'Ich arbeite absolut sauber und hygienisch.'],
  ['Schöneres Hautbild', 'Überverhornungen werden sanft abgetragen, ohne lebende Hautzellen zu verletzen.'],
  ['Natürlich', 'Bei der Haarentfernung und in der Vor- und Nachbehandlung nur natürliche Inhaltsstoffe.'],
  ['Hautschonend', 'Keine hohen Temperaturen, keine mechanischen oder chemischen Reize.'],
];
const ab = Math.min(...zonen.zonen.map((z) => z.preis));
const gruppe = (g) => zonen.zonen.filter((z) => z.g === g && z.seite !== 'kombi');
const kombi = zonen.zonen.filter((z) => z.seite === 'kombi');
---
<Base title="Sugaring in Gehrden: Preise pro Zone berechnen | Hautnahtur Kosmetikstudio" description={`Pandy’s Comfort Sugaring in Gehrden: Haarentfernung mit reiner Zuckerpaste für Damen und Herren, ab ${euro(ab)}. Zonen antippen, Preis sofort sehen, Termin anfragen.`} aktiv="sugaring">
  <Seitenkopf titel="Sugaring in Gehrden" lede="Körperwarme Zuckerpaste löst die Haare sanft in Wuchsrichtung, von Kopf bis Fuß. Tippen Sie die Zonen an, der Preis rechnet sofort mit." fakten={[`ab ${euro(ab)} pro Zone`, 'Damen und Herren', 'nach Zeit und Material, ca. 50 € pro Stunde']} />

  <Zonenrechner titel="Ihre Zonen, Ihr Preis" mehr={false} />

  <section class="section" aria-labelledby="vb-h">
    <div class="wrap methode">
      <div class="methode__text">
        <h2 id="vb-h">So arbeite ich mit Zucker</h2>
        <p class="lede">Ist die Haut gut durchfeuchtet und entspannt, wird professionelles Sugaring mehr und mehr wie eine Massage.</p>
        <p>Deshalb behandle ich Ihre Haut vorher und nachher passend zu Ihrem Hauttyp. Alle Zuckerprodukte sind ohne Beimengungen, Substanzen ohne Langzeitstudien verwende ich bewusst nicht. Danach können Sie sofort wieder unter die Leute gehen.</p>
      </div>
      <Foto name="leistung-lippe" alt="Sugaring an der Oberlippe mit Zuckerpaste" sizes="(min-width: 26rem) 23.5rem, 92vw" class="methode__foto" />
    </div>
  </section>

  <section class="section sand" aria-labelledby="vort-h">
    <div class="wrap">
      <div class="kopfzeile"><h2 id="vort-h">Alle Vorteile des Zuckerns auf einen Blick</h2></div>
      <ul class="vort">
        {vorteile.map(([t, d]) => <li><h3>{t}</h3><p class="muted">{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="preisliste" aria-labelledby="pl-h">
    <div class="wrap">
      <div class="kopfzeile">
        <h2 id="pl-h">Preisliste Sugaring</h2>
        <p class="lede">{zonen.hinweis}</p>
      </div>
      <div class="pl">
        <div class="pl__spalte">
          <h3>Damen</h3>
          <ul class="pl__liste">
            {gruppe('damen').map((z) => <li class="karte-zeile"><span class="name">{z.name}</span><span class="punkte" aria-hidden="true"></span><span class="preis"><span class="ab">ab</span>{euro(z.preis)}</span></li>)}
            {kombi.map((z) => <li class="karte-zeile pl__kombi"><span class="name">{z.name}</span><span class="punkte" aria-hidden="true"></span><span class="preis"><span class="ab">ab</span>{euro(z.preis)}</span></li>)}
          </ul>
        </div>
        <div class="pl__spalte" id="herren">
          <h3>Herren</h3>
          <ul class="pl__liste">
            {gruppe('herren').map((z) => <li class="karte-zeile"><span class="name">{z.name}</span><span class="punkte" aria-hidden="true"></span><span class="preis"><span class="ab">ab</span>{euro(z.preis)}</span></li>)}
          </ul>
          <a class="btn btn--ghost pl__herren" href="#zonen" data-herren>Herren-Zonen im Rechner wählen</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // «Herren-Zonen im Rechner wählen»: Rechner auf Herren umschalten, dann hinscrollen
  document.querySelector('[data-herren]')?.addEventListener('click', () => {
    const r = document.querySelector<HTMLInputElement>('#zonen input[value="herren"]');
    if (r && !r.checked) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); }
  });
</script>

<style>
  .methode { display: grid; gap: var(--space-lg); }
  .methode__text { display: grid; gap: 1rem; max-width: 40rem; }
  /* Originalfoto ist ein Streifen 757×216: immer im eigenen Format und höchstens halb so breit wie die Datei, sonst unscharf */
  .methode :global(.methode__foto) { aspect-ratio: 757 / 216; border-radius: 16px; width: 100%; max-width: 23.5rem; }
  @media (min-width: 64rem) { .methode { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: center; } }

  .vort { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; border-top: 1px solid var(--sand-2); }
  .vort li { display: grid; gap: 0.2rem; padding: 1rem 0 1rem 1.6rem; border-bottom: 1px solid var(--sand-2); position: relative; }
  .vort li::before { content: ''; position: absolute; left: 0; top: 1.45rem; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--orange); }
  @media (min-width: 48rem) { .vort { grid-template-columns: 1fr 1fr; column-gap: var(--space-xl); } }
  @media (min-width: 64rem) { .vort { grid-template-columns: repeat(3, 1fr); } }

  .pl { display: grid; gap: var(--space-xl); }
  .pl__spalte { display: grid; gap: 0.6rem; align-content: start; }
  .pl__spalte h3 { font-size: 1.4rem; font-weight: 680; letter-spacing: -0.02em; }
  .pl__liste { list-style: none; padding: 0; margin: 0; display: grid; }
  .pl__liste li { min-height: 2.9rem; padding-block: 0.5rem; border-bottom: 1px solid var(--linie); }
  .pl__liste .name { overflow-wrap: anywhere; }
  .pl__kombi { font-weight: 600; }
  .pl__herren { justify-self: start; margin-top: 0.8rem; }
  @media (min-width: 48rem) { .pl { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); } }
</style>
