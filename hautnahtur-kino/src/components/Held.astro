---
/** Главный экран: фоновое видео (паста стекает кольцами, Blender, папка zuckerpaste/), бесшовная петля 7,5 с.
 *  Телефон стоя: видео 9:16 (720×1280). Планшет стоя: видео 16:9, кучка по центру, текст ниже. в верхних ~60 % экрана, текст под ним на чёрном. ПК, планшет боком, телефон боком: видео 16:9 на весь экран, кучка справа, текст слева.
 *  Пока видео грузится (и при prefers-reduced-motion, и в энергосбережении iOS) виден первый кадр картинкой. */
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<section class="held nacht" data-held>
  <div class="held__film" aria-hidden="true">
    <picture>
      <source media="(orientation: portrait) and (max-width: 47.99rem)" srcset={`${base}video/paste-tel.jpg`} />
      <img class="held__poster" src={`${base}video/paste-pc.jpg`} alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <video class="held__video" muted loop playsinline preload="none" data-film data-pc={`${base}video/paste-pc.mp4`} data-tel={`${base}video/paste-tel.mp4`}></video>
  </div>
  <div class="wrap held__in">
    <div class="held__text">
      <p class="held__ort">Hautnahtur Kosmetikstudio · selbstständig seit {site.since}</p>
      <h1 class="held__h1">Sugaring und Kosmetik in {site.address.city}</h1>
      <p class="lede held__lede">Die zuckersüße Methode zur perfekten Haarentfernung und Gesichtsbehandlungen ganz ohne Apparate, individuell auf Sie abgestimmt.</p>
      <div class="btn-row held__btns">
        <a class="btn" href="#zonen"><span class="nur-pc">Preis für meine Zonen berechnen</span><span class="nur-tel">Preis für meine Zonen</span></a>
        <a class="btn btn--ghost" href={`${base}termin/`}>Termin anfragen</a>
      </div>
      <p class="held__abend">Dienstag und Donnerstag bis 22 Uhr geöffnet</p>
    </div>
  </div>
</section>

<style is:global define:vars={{ bandBild: `url(${import.meta.env.BASE_URL}img/honig-band.webp)`, tropfenBild: `url(${import.meta.env.BASE_URL}img/honig-tropfen.webp)` }}>
  .held { --nacht: #0E0906; --licht: #F4EEE8; --licht-2: #BDAFA3; color: var(--licht); --bs: 0.56; position: relative; overflow: hidden; min-height: calc(100svh - 4.6rem); display: grid; align-items: end; isolation: isolate; background: var(--nacht); }
  .held__band, .tr, .held__bild { display: none !important; }
  .held__film { position: absolute; inset: 0 0 auto 0; height: 47svh; z-index: -1; overflow: hidden; }
  .held__film picture, .held__poster, .held__video { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; object-position: 50% 100%; }
  /* планшет стоя: чёткое видео 16:9, кучка в центре кадра, текст ниже */
  @media (orientation: portrait) and (min-width: 48rem) and (max-width: 63.99rem) {
    .held__film { height: 50svh; }
    .held__film picture, .held__poster, .held__video { object-position: 64% 75%; }
  }
  .held__video { opacity: 0; transition: opacity 0.6s ease; }
  .held__video.is-on { opacity: 1; }
  .held__film::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 6, 4, 0.35) 0%, transparent 18%, transparent 70%, var(--nacht) 100%); }
  .held__bild picture, .held__bild img { width: 100%; height: 100%; }
  .held__band { position: absolute; left: 0; top: 0; width: calc(100% / var(--bs)); height: 320px; transform: scale(var(--bs)); transform-origin: 0 0; z-index: -1; background: var(--bandBild) 0 0 / 1600px 320px repeat-x; pointer-events: none; filter: drop-shadow(0 10px 12px rgba(0, 0, 0, 0.45)); }
  .tr { position: absolute; left: var(--x); top: var(--y); width: 30px; height: 46px; margin-left: -15px; background: var(--tropfenBild) center / 100% 100% no-repeat; opacity: 0; transform-origin: 50% 0; animation: tropf var(--d) cubic-bezier(0.55, 0, 0.9, 0.6) var(--w) 2 both; }
  @keyframes tropf {
    0%, 12% { opacity: 0; transform: translateY(0) scale(0.25); }
    22% { opacity: 1; transform: translateY(0) scale(1); animation-timing-function: ease-in; }
    34% { opacity: 1; transform: translateY(2px) scale(0.95, 1.12); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5); }
    80% { opacity: 1; transform: translateY(min(66svh, 560px)) scale(0.9, 1.25); }
    86%, 100% { opacity: 0; transform: translateY(min(68svh, 580px)) scale(0.9, 1.25); }
  }
  @media (prefers-reduced-motion: reduce) { .tr { display: none; } }
  .held__in { position: relative; display: grid; width: 100%; min-width: 0; padding-top: 30svh; padding-bottom: calc(var(--bar-h) + var(--bar-gap) + 1.6rem + env(safe-area-inset-bottom)); }
  .held__ort, .held__abend, .held__btns .btn--ghost { display: none; }
  .held h1 { font-size: clamp(2.3rem, 1.2rem + 5vw, 6.2rem); }
  .held__lede { font-size: 1.05rem; }
  .nur-pc { display: none; }
  @media (max-height: 700px) and (orientation: portrait) and (max-width: 63.99rem) { .held__lede { display: none; } .held .held__in { padding-bottom: calc(var(--bar-h) + var(--bar-gap) + 2.2rem + env(safe-area-inset-bottom)); } }
  @media (max-height: 700px) and (max-width: 63.99rem) { .held h1.held__h1 { font-size: 2.15rem; } .held__lede { font-size: 0.98rem; line-height: 1.5; } .held__text { gap: 0.75rem; } }
  .held { min-height: min(calc(100svh - 5.8rem), 46rem); }
  /* Телефон боком: заголовок в две строки, текст слева, панель уходит вправо — ничего не прячется под ней */
  @media (orientation: landscape) and (max-height: 500px) and (max-width: 63.99rem) {
    .held { --bs: 0.5; }
    .held__in { padding-bottom: 1.6rem; padding-top: 4.5rem; }
    .held__film { height: 100%; }
    .held__film picture, .held__poster, .held__video { object-position: 65% 60%; }
    .held__film::after { background: linear-gradient(90deg, var(--nacht) 0%, rgba(10, 6, 4, 0.7) 38%, transparent 70%); }
    .held h1.held__h1 { font-size: 2rem; max-width: 24ch; }
    .held .held__text { max-width: min(30rem, 50vw); gap: 0.6rem; }
    .held__lede { font-size: 0.95rem; }
  }
  .held__text { min-width: 0; display: grid; gap: var(--space-md); max-width: 40rem; }
  .held__ort { color: var(--licht-2); font-size: var(--text-sm); }
  .held h1 { font-size: clamp(2.6rem, 1.2rem + 6vw, 6.2rem); line-height: 1; max-width: 13ch; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5); }
  .held__lede { color: var(--licht); max-width: 34rem; }
  .held__btns { margin-top: 0.6rem; }
  .held__abend { color: var(--licht); font-size: var(--text-sm); margin-top: 0.4rem; }
  @media (min-width: 64rem) {
    .held { min-height: min(90svh, 58rem); align-items: center; }
    .held { --bs: 0.66; }
    .held__ort, .held__abend { display: block; }
    .held__btns .btn--ghost { display: inline-flex; }
    .held__lede { font-size: var(--text-lg); }
    .nur-pc { display: inline; } .nur-tel { display: none; }
    .held__bild { display: block; position: absolute; left: auto; right: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); width: min(24rem, 26vw); inset-block: 13.5rem 4.5rem; border-radius: 999px 999px 28px 28px; overflow: hidden; box-shadow: 0 30px 60px -30px #000, 0 0 0 1px rgba(255, 210, 122, 0.25); z-index: -1; }
    .held__foto { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; opacity: 1; filter: none; }
    .held__bild picture { display: block; height: 100%; }
    .held__bild::after { content: none; }
    .held__in { padding-bottom: 4rem; padding-top: 7rem; }
    .held__film { height: 100%; }
    .held__film picture, .held__poster, .held__video { object-position: 60% 55%; }
    .held__film::after { background: linear-gradient(90deg, var(--nacht) 0%, rgba(10, 6, 4, 0.82) 30%, rgba(10, 6, 4, 0.2) 58%, transparent 75%), linear-gradient(0deg, var(--nacht) 0%, transparent 18%); }
    .held h1 { max-width: 12ch; font-size: clamp(3.4rem, 1rem + 4.2vw, 5.4rem); }
    .held__text { max-width: 36rem; }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-film]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const mq = matchMedia('(orientation: portrait) and (max-width: 47.99rem)');
    const set = () => {
      const src = mq.matches ? v.dataset.tel! : v.dataset.pc!;
      if (v.getAttribute('src') === src) return;
      v.classList.remove('is-on'); v.src = src;
      v.play().catch(() => {}); // энергосбережение iOS запрещает автозапуск: остаётся картинка
    };
    v.addEventListener('playing', () => v.classList.add('is-on'));
    set(); mq.addEventListener('change', set);
  }
</script>
