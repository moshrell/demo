---
/**
 * Bad-Baukasten. Zwei Varianten:
 *  mode="full"  – /bad/: 3D-Bühne + alle Auswahlfelder + Zusammenfassung (sendet «kl:summary» an das Anfrageformular)
 *  mode="hero"  – Startseite: 3D-Bühne mit Größe S/M/L und Richtpreis; Tipp auf ein Teil wechselt die Ausführung
 * Die Auswahl liegt in sessionStorage («kl:bad»), damit sie beim Wechsel Startseite → /bad/ nicht verloren geht.
 * Ohne WebGL / ohne JS: Foto statt 3D, die Auswahlfelder funktionieren (mit JS) trotzdem.
 */
import data from '../data/bad.json';
const { mode = 'full', id = 'bk' } = Astro.props;
const base = import.meta.env.BASE_URL;
const full = mode === 'full';
const eur = (c: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(c / 100);
const d = data.defaults;
const startCents = data.sizes.find((s) => s.id === d.size)!.cents;
---
<section class={`bk bk--${mode}`} data-bk={mode} id={id} aria-labelledby={`${id}-h`}>
  {full && <h2 class="sr-only" id={`${id}-h`}>Bad zusammenstellen</h2>}
  <div class="bk__stage" data-bk-stage>
    <picture>
      <source media="(min-width: 64rem)" srcset={`${base}img/bad-poster-tall.webp`} />
      <img class="bk__poster" src={`${base}img/bad-poster-wide.webp`} alt="" width="712" height="588" decoding="async" fetchpriority={mode === 'hero' ? 'high' : 'auto'} />
    </picture>
    <canvas class="bk__canvas" data-bk-canvas aria-hidden="true"></canvas>
    <button type="button" class="bk__ring" data-bk-ring hidden aria-label="Tippen Sie auf ein Teil, um es zu ändern"><span class="bk__ring-dot"></span><span class="bk__ring-txt">Tippen Sie auf ein Teil</span></button>
    <p class="bk__nogl" data-bk-nogl hidden>3D-Ansicht nicht verfügbar. Die Auswahl funktioniert trotzdem.</p>
  </div>

  {!full && (
    <div class="bk__hero">
      <p class="bk__price"><span class="bk__price-l">Ihr Bad ab</span> <strong data-bk-total>{eur(startCents)}</strong></p>
      <fieldset class="bk__sizes bk__sizes--sm">
        <legend class="sr-only">Größe</legend>
        {data.sizes.map((s) => (
          <label class="bk__size"><input type="radio" name={`${id}-size`} value={s.id} checked={s.id === d.size} data-bk-size /><span><strong>{s.id}</strong><small>{s.area}</small></span></label>
        ))}
      </fieldset>
      <p class="bk__cap" data-bk-cap aria-live="polite"></p>
    </div>
  )}

  {full && (
    <div class="bk__panel">
      <fieldset class="bk__sizes">
        <legend class="bk__legend">Größe</legend>
        {data.sizes.map((s) => (
          <label class="bk__size"><input type="radio" name={`${id}-size`} value={s.id} checked={s.id === d.size} data-bk-size /><span><strong>{s.id}</strong><small>{s.area}</small></span></label>
        ))}
      </fieldset>

      <div class="bk__bf">
        <div>
          <p class="bk__bf-t">{data.barrierefrei.label}</p>
          <p class="bk__bf-n">{data.barrierefrei.note}</p>
        </div>
        <button type="button" class="bk__switch" role="switch" aria-checked="false" data-bk-bf aria-label="Barrierefrei umbauen"><span></span></button>
      </div>

      <div class="bk__tabs" role="group" aria-label="Teil wählen">
        {data.zones.map((z, i) => (
          <button type="button" class="bk__tab" data-bk-tab={z.id} aria-pressed={i === 0 ? 'true' : 'false'}>{z.label}</button>
        ))}
      </div>

      {data.zones.map((z, i) => (
        <fieldset class="bk__zone" data-bk-zone={z.id} hidden={i !== 0}>
          <legend class="sr-only">{z.label}</legend>
          {z.variants.map((v: any) => (
            <label class="bk__opt">
              <input type="radio" name={`${id}-${z.id}`} value={v.id} checked={v.id === (d as any)[z.id]} data-bk-opt={z.id} data-only={v.only ? v.only.join(',') : ''} />
              <span class="bk__optin">
                <strong>{v.label}</strong>
                <small>{v.note}</small>
                <span class="bk__delta">{v.cents ? `+ ${eur(v.cents)}` : 'inklusive'}</span>
              </span>
            </label>
          ))}
        </fieldset>
      ))}

      <div class="bk__sum" aria-live="polite">
        <h3 class="bk__sum-h">Ihre Zusammenstellung</h3>
        <dl class="bk__rows" data-bk-rows></dl>
        <p class="bk__total"><span>Summe ab</span> <strong data-bk-total>{eur(startCents)}</strong></p>
        <p class="bk__note">{data.hinweis}</p>
        <a class="btn btn--copper bk__go" href="#anfrage-bad">Zur Anfrage</a>
      </div>
    </div>
  )}
</section>

<script>
  import '../scripts/baukasten';
</script>

<style>
  .bk { display: grid; gap: var(--space-lg); min-width: 0; }
  .bk > * { min-width: 0; }

  .bk__stage { position: relative; overflow: hidden; border-radius: var(--radius); background: linear-gradient(180deg, oklch(97% 0.012 210), oklch(91.5% 0.04 205)); aspect-ratio: 1 / 1.02; min-height: 15rem; max-height: 62svh; isolation: isolate; }
  .bk__stage :global(.bk__poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; z-index: 0; transition: opacity 500ms var(--ease-out); }
  .bk__stage:global(.is-3d) :global(.bk__poster) { opacity: 0; }
  .bk__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 1; opacity: 0; transition: opacity 500ms var(--ease-out); touch-action: pan-y; }
  .bk__stage:global(.is-3d) .bk__canvas { opacity: 1; }
  .bk__nogl { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; margin: 0; padding: var(--space-xs) var(--space-md); font-size: var(--text-xs); background: color-mix(in oklch, var(--color-paper) 88%, transparent); color: var(--color-ink-2); }

  .bk__ring { position: absolute; z-index: 2; left: 50%; top: 50%; width: 0; height: 0; padding: 0; border: 0; background: none; cursor: pointer; transform: translate(0, 0); }
  .bk__ring-dot { position: absolute; left: -26px; top: -26px; width: 52px; height: 52px; border-radius: 50%; border: 3px solid var(--color-copper); background: color-mix(in oklch, var(--color-copper) 18%, transparent); }
  .bk__ring-txt { position: absolute; left: 0; top: 36px; transform: translateX(-50%); white-space: nowrap; font: 600 var(--text-xs)/1 var(--font-body); color: var(--color-ink); background: var(--color-paper); padding: 7px 10px; border-radius: var(--radius-pill); box-shadow: 0 2px 10px oklch(30% 0.05 225 / 0.18); }
  @media (prefers-reduced-motion: no-preference) {
    .bk__ring-dot { animation: bk-pulse 1.8s var(--ease-out) infinite; }
    @keyframes bk-pulse { 0% { transform: scale(0.7); opacity: 1; } 80%, 100% { transform: scale(1.45); opacity: 0; } }
  }

  /* Größe */
  .bk__sizes { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xs); min-width: 0; }
  .bk__legend { font: 600 var(--text-sm)/1.2 var(--font-body); color: var(--color-ink-2); padding: 0; margin-bottom: var(--space-xs); }
  .bk__size input { position: absolute; opacity: 0; pointer-events: none; }
  .bk__size span { display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 56px; padding: var(--space-xs); border: 1.5px solid var(--color-rule); border-radius: var(--radius); cursor: pointer; text-align: center; background: var(--color-paper); }
  .bk__size strong { font: 500 var(--text-lg)/1 var(--font-display); }
  .bk__size small { font-size: var(--text-xs); color: var(--color-ink-2); }
  .bk__size input:checked + span { border-color: var(--color-copper); background: var(--color-copper-soft); box-shadow: inset 0 0 0 1px var(--color-copper); }
  .bk__size input:focus-visible + span { outline: 3px solid var(--color-focus); outline-offset: 2px; }

  /* Barrierefrei */
  .bk__bf { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) var(--space-md); border: 1.5px solid var(--color-rule); border-radius: var(--radius); }
  .bk__bf-t { margin: 0; font-weight: 600; }
  .bk__bf-n { margin: 2px 0 0; font-size: var(--text-xs); color: var(--color-ink-2); }
  .bk__switch { flex: none; width: 56px; height: 32px; border-radius: 999px; border: 0; padding: 3px; background: var(--color-track); cursor: pointer; transition: background 200ms; display: block; position: relative; }
  .bk__switch span { display: block; width: 26px; height: 26px; border-radius: 50%; background: var(--color-paper); box-shadow: 0 1px 3px oklch(30% 0.05 225 / 0.35); transition: transform 220ms var(--ease-out); }
  .bk__switch[aria-checked='true'] { background: var(--color-copper); }
  .bk__switch[aria-checked='true'] span { transform: translateX(24px); }
  .bk__switch:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }

  /* Teile */
  .bk__tabs { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .bk__tab { min-height: 44px; padding: 0 var(--space-md); border-radius: var(--radius-pill); border: 1.5px solid var(--color-ink-2); background: transparent; color: var(--color-ink); font: 600 var(--text-sm)/1 var(--font-body); cursor: pointer; }
  .bk__tab[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .bk__tab:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .bk__zone { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); min-width: 0; }
  .bk__zone[hidden] { display: none; }
  .bk__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .bk__optin { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-md); row-gap: 2px; padding: var(--space-sm) var(--space-md); min-height: 64px; border: 1.5px solid var(--color-rule); border-radius: var(--radius); cursor: pointer; background: var(--color-paper); align-items: center; }
  .bk__optin strong { grid-column: 1; font-weight: 600; overflow-wrap: anywhere; }
  .bk__optin small { grid-column: 1; color: var(--color-ink-2); font-size: var(--text-xs); }
  .bk__delta { grid-column: 2; grid-row: 1 / span 2; font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--text-sm); text-align: right; white-space: nowrap; }
  .bk__opt input:checked + .bk__optin { border-color: var(--color-copper); background: var(--color-copper-soft); box-shadow: inset 0 0 0 1px var(--color-copper); }
  .bk__opt input:focus-visible + .bk__optin { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .bk__opt input:disabled + .bk__optin { opacity: 0.45; cursor: not-allowed; }

  /* Summe */
  .bk__sum { padding: var(--space-md); border-radius: var(--radius); background: var(--color-paper-2); display: grid; gap: var(--space-sm); }
  .bk__sum-h { font: 500 var(--text-lg)/1.2 var(--font-display); }
  .bk__rows { margin: 0; border-top: 1px solid var(--color-rule); }
  .bk__rows > div { display: flex; justify-content: space-between; gap: var(--space-md); padding: 6px 0; border-bottom: 1px solid var(--color-rule); font-size: var(--text-sm); }
  .bk__rows dt { color: var(--color-ink-2); }
  .bk__rows dd { margin: 0; text-align: right; }
  .bk__total { display: flex; justify-content: space-between; align-items: baseline; margin: 0; font-size: var(--text-md); }
  .bk__total strong { font: 500 var(--text-2xl)/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .bk__note { margin: 0; font-size: var(--text-xs); color: var(--color-ink-2); }
  .bk__go { justify-self: stretch; text-align: center; }

  /* Hero-Variante */
  .bk__hero { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-sm) var(--space-md); }
  .bk__price { margin: 0; display: grid; line-height: 1.05; }
  .bk__price-l { font-size: var(--text-xs); color: var(--color-ink-2); font-weight: 600; letter-spacing: 0.02em; }
  .bk--hero .bk__stage { width: 100%; aspect-ratio: auto; height: min(75vw, 40svh); max-height: none; }
  @media (min-width: 64rem) { .bk--hero .bk__stage { height: auto; aspect-ratio: 1 / 1.02; max-height: 62svh; } }
  .bk--hero .bk__price strong { font-size: var(--text-xl); white-space: nowrap; }
  .bk__price strong { font: 500 var(--text-2xl)/1.05 var(--font-display); font-variant-numeric: tabular-nums; }
  .bk__sizes--sm { width: 13.5rem; max-width: 100%; }
  .bk__sizes--sm .bk__size span { min-height: 48px; padding: 4px; }
  .bk__sizes--sm .bk__size small { display: none; }
  .bk__cap { grid-column: 1 / -1; margin: 0; font-size: var(--text-sm); color: var(--color-ink-2); min-height: 1.4em; overflow-wrap: anywhere; }

  @media (min-width: 64rem) {
    .bk--full { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); column-gap: var(--space-xl); align-items: start; }
    .bk--full .bk__stage { position: sticky; top: 84px; aspect-ratio: 4 / 3.4; max-height: calc(100svh - 120px); }
  }
  @media (max-width: 63.99rem) {
    .bk--full .bk__stage { position: sticky; top: 60px; z-index: 6; aspect-ratio: auto; height: min(40svh, 24rem); min-height: 14rem; box-shadow: 0 8px 18px -10px oklch(30% 0.05 225 / 0.35); }
  }
</style>
