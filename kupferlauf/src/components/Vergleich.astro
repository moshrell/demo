---
// Vorher/Nachher-Schieber. Fehlt das Vorher-Foto (noch nicht von Степан geliefert), steht nur das Nachher-Foto da.
import { existsSync } from 'node:fs';
import Photo from './Photo.astro';
const { nachher, vorher, alt, altVorher = 'Das Bad vor dem Umbau', ort, sizes = '100vw' } = Astro.props;
const has = !!vorher && existsSync(`public/img/${vorher}`);
---
<div class:list={['ba', { 'ba--solo': !has }]} data-ba>
  <Photo class="ba__img" name={nachher} alt={alt} sizes={sizes} />
  {has && (
    <>
      <div class="ba__clip"><Photo class="ba__img" name={vorher} alt={altVorher} sizes={sizes} /></div>
      <span class="ba__tag ba__tag--l" aria-hidden="true">Vorher</span>
      <span class="ba__tag ba__tag--r" aria-hidden="true">Nachher</span>
      <span class="ba__knob" aria-hidden="true"><i></i></span>
      <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`Vorher und Nachher vergleichen, ${ort}`} />
    </>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const r = el.querySelector<HTMLInputElement>('.ba__range');
    if (!r) return;
    const set = () => el.style.setProperty('--p', `${r.value}%`);
    r.addEventListener('input', set);
    set();
  });
</script>

<style>
  .ba { --p: 50%; position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--color-water-soft); touch-action: pan-y; }
  .ba :global(.ba__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: auto; border-radius: 0; }
  .ba__clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .ba__knob { position: absolute; top: 0; bottom: 0; left: var(--p); width: 3px; margin-left: -1.5px; background: var(--color-paper); box-shadow: 0 0 0 1px oklch(30% 0.05 225 / 0.25); pointer-events: none; }
  /* Ventilrad als Griff */
  .ba__knob i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; translate: -50% -50%; border-radius: 50%; border: 3px solid var(--color-copper); background:
    linear-gradient(var(--color-copper), var(--color-copper)) center / 100% 3px no-repeat,
    linear-gradient(var(--color-copper), var(--color-copper)) center / 3px 100% no-repeat,
    radial-gradient(circle, var(--color-copper) 0 14%, var(--color-paper) 16%); box-shadow: 0 2px 10px oklch(30% 0.05 225 / 0.3); }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .ba__range:focus-visible ~ .ba__knob i { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .ba__tag { position: absolute; top: var(--space-xs); padding: 4px 12px; border-radius: 999px; background: oklch(25% 0.05 225 / 0.78); color: #fff; font: 600 var(--text-xs)/1.3 var(--font-body); pointer-events: none; }
  .ba__tag--l { left: var(--space-xs); }
  .ba__tag--r { right: var(--space-xs); }
</style>
