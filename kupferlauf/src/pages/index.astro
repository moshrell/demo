---
import Base from '../layouts/Base.astro';
import Anfrage from '../components/Anfrage.astro';
import PlzCheck from '../components/PlzCheck.astro';
import Photo from '../components/Photo.astro';
import Vergleich from '../components/Vergleich.astro';
import Baukasten from '../components/Baukasten.astro';
import site from '../data/site.json';
import stations from '../data/stations.json';
import wartung from '../data/wartung.json';
import faq from '../data/faq.json';
import ablauf from '../data/ablauf.json';
const base = import.meta.env.BASE_URL;
const prices = stations.flatMap((s: any) => (s.services || []).map((x: any) => ({ name: x.name, price: x.price.replace(/[^\d]/g, '') })));
const mini = ['warmwasser', 'abfluss'];
const main = stations.filter((s: any) => !mini.includes(s.id));
const kleine = stations.filter((s: any) => mini.includes(s.id));
const photos: Record<string, { name: string; alt: string }> = {
  hausanschluss: { name: 'hauptwasserhahn.jpg', alt: 'Hand dreht den roten Hebel des Hauptwasserhahns vor der Wasseruhr zu' },
};
---
<Base
  title="Kehlenbrink Bad & Wärme · Sanitär und Heizung in Garbsen und der Region Hannover (Demo)"
  description="Meisterbetrieb für Bad, Heizung und Wasser im Westen der Region Hannover: Ab-Preise, PLZ-Check, Bad-Baukasten, Heizungs-Check und Erste Hilfe bei Wasserschaden. Demo-Seite."
  faq={faq}
  prices={prices}
  current="home"
>
  <main id="inhalt">
    <section class="hero in" aria-labelledby="hero-h">
      <div class="hero__head">
        <a class="hero__sos" href={`${base}notfall/`}><span class="hero__sos-dot" aria-hidden="true"></span>Wasser läuft? Erste Hilfe in 4 Schritten</a>
        <h1 id="hero-h">Bad und Heizung <span class="gold">aus einer Hand.</span></h1>
        <p class="hero__lead">Meisterbetrieb in Garbsen. Ab-Preise auf der Seite, ein fester Ansprechpartner, Notdienst bei Wasserschaden.</p>
      </div>
      <Baukasten mode="hero" id="bk-hero" />
      <div class="hero__cta">
        <a class="btn btn--copper" href={`${base}bad/`}>Bad planen</a>
        <a class="btn btn--ghost" href={`${base}heizung/`}>Heizung prüfen</a>
      </div>
    </section>

    <nav class="chips in" aria-label="Leistungen auf dieser Seite">
      <ul>
        {stations.map((s: any) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
      </ul>
    </nav>

    {main.map((s: any) => (
      <Fragment>
      <article class={`st st--${s.id}`} id={s.id} aria-labelledby={`${s.id}-h`}>
        {s.id === 'heizung' && <Photo class="st__bg" name="hero-kupfer-breit.jpg" alt="" sizes="100vw" />}
        <div class="in st__in">
          <header class="st__head">
            <p class="st__label">{s.label}</p>
            <h2 id={`${s.id}-h`}>{s.title}</h2>
            <p class="st__lead">{s.lead}</p>
            {s.cta && (
              <div class="st__ctas">
                <a class={`btn ${s.id === 'heizung' ? 'btn--copper' : ''}`} href={`${base}${s.cta.href}`}>{s.cta.label}</a>
                {s.cta2 && <a class="btn btn--ghost-light" href={`${base}${s.cta2.href}`}>{s.cta2.label}</a>}
              </div>
            )}
          </header>

          <div class="st__main">
            {photos[s.id] && <Photo class="st__photo" name={photos[s.id].name} alt={photos[s.id].alt} sizes="(min-width: 64rem) 34rem, 92vw" />}
            {s.referenz && (
              <figure class="ref">
                <Photo class="st__photo" name={s.referenz.img} alt={s.referenz.alt} sizes="(min-width: 64rem) 34rem, 92vw" />
                <figcaption><strong>Referenz {s.referenz.ort}</strong><ul>{s.referenz.facts.map((f: string) => <li>{f}</li>)}</ul></figcaption>
              </figure>
            )}
            {s.paar && (
              <figure class="st__paar">
                <Photo class="st__photo st__photo--tall" name={s.paar.img} alt={s.paar.alt} sizes="(min-width: 64rem) 24rem, 80vw" />
                <figcaption>Barrierefrei: bodengleiche Dusche, Haltegriffe, WC auf Sitzhöhe. Ob es dafür Förderung gibt, <a href={`${base}bad/#foerderung`}>prüfen wir gemeinsam</a>.</figcaption>
              </figure>
            )}

            {s.services && (
              <div class="st__prices">
                <ul>
                  {s.services.map((x: any) => (
                    <li><span>{x.name}{x.note && <small> · {x.note}</small>}</span><span class="price">{x.price}</span></li>
                  ))}
                </ul>
                <p class="mwst">Richtpreise inkl. 19 % MwSt. Den genauen Preis nennen wir nach der Besichtigung schriftlich.</p>
              </div>
            )}

            {s.tool === 'plz' && (
              <div class="st__tool">
                <h3>Liegt Ihr Haus an unserer Leitung?</h3>
                <PlzCheck id="plz-home" />
              </div>
            )}
          </div>

          {s.referenzen && (
            <div class="refs">
              <h3>Drei Bäder aus der Region</h3>
              <ul class="refs__list">
                {s.referenzen.map((r: any) => (
                  <li class="ref">
                    <Vergleich nachher={r.img} vorher={r.img.replace('.jpg', '-vorher.jpg')} alt={r.alt} ort={r.ort} sizes="(min-width: 64rem) 22rem, 92vw" />
                    <p><strong>{r.ort}</strong></p>
                    <ul>{r.facts.map((f: string) => <li>{f}</li>)}</ul>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {s.tool === 'wartung' && (
            <div class="st__wartung">
              {s.img && <Photo class="st__photo" name={s.img.img} alt={s.img.alt} sizes="(min-width: 64rem) 30rem, 92vw" />}
              <ul class="checks">{wartung.includes.map((x: string) => <li>{x}</li>)}</ul>
              <div class="wp">
                <h3>Wartungsvertrag pro Jahr</h3>
                <ul>
                  {wartung.plans.map((x: any) => <li><span>{x.name}</span><span class="price">{new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(x.cents / 100)}</span></li>)}
                </ul>
                <p class="mwst">{wartung.hint}</p>
                <a class="btn btn--copper" href="#anfrage" data-topic="Wartungsvertrag">Wartung anfragen</a>
              </div>
            </div>
          )}
        </div>
      </article>

      {s.id === 'heizung' && (
        <section class="kleine in" aria-label="Warmwasser und Abfluss">
          {kleine.map((k: any) => (
            <article class="kl" id={k.id} aria-labelledby={`${k.id}-h`}>
              <p class="st__label">{k.label}</p>
              <h2 id={`${k.id}-h`}>{k.title}</h2>
              <p class="st__lead">{k.lead}</p>
              <div class="st__prices">
                <ul>{k.services.map((x: any) => <li><span>{x.name}</span><span class="price">{x.price}</span></li>)}</ul>
              </div>
            </article>
          ))}
        </section>
      )}
      </Fragment>
    ))}

    <section class="ablauf in" aria-labelledby="ablauf-h">
      <div class="ablauf__in">
        <h2 id="ablauf-h">So läuft es nach Ihrer Anfrage</h2>
        <ol class="ablauf__list">
          {ablauf.map((a: any) => <li><h3>{a.t}</h3><p>{a.d}</p></li>)}
        </ol>
        <Photo class="ablauf__img" name="monteur.jpg" alt="Hände eines Installateurs beim Verpressen eines Kupferfittings" sizes="(min-width: 64rem) 30rem, 92vw" />
        <p class="ablauf__note">{site.besichtigung} Was wir nicht machen: Material montieren, das Sie selbst gekauft haben, und Klimaanlagen reparieren.</p>
      </div>
    </section>

    <section class="faq in" aria-labelledby="faq-h">
      <div class="faq__in">
        <h2 id="faq-h">Was uns fast jeder fragt</h2>
        {faq.map((f: any) => (
          <details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </section>

    <div class="in anfrage-wrap">
      <Anfrage
        id="anfrage"
        title="Anfrage mit Foto"
        intro="Ein Foto und Ihre PLZ sparen uns beiden einen Termin: Wir sehen vorab, worum es geht, und rufen Sie einmal an – mit konkreten Antworten."
        topics={['Bad', 'Heizung', 'Wartungsvertrag', 'Leitung oder Abfluss', 'Sonstiges']}
        mail={false}
        note={false}
        topicsLabel="Worum geht es?"
        windows={['Vormittags', 'Nachmittags', 'Egal']}
      />
    </div>
  </main>
</Base>

<style>
  .in { width: 100%; max-width: 72rem; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .gold { color: var(--color-copper-ink); }

  /* Erster Bildschirm: Überschrift, 3D-Bad, Aktionen */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); padding-top: var(--space-md); padding-bottom: var(--space-lg); }
  .hero > * { min-width: 0; }
  .hero__sos { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 44px; font-weight: 700; font-size: var(--text-sm); color: var(--color-alert); text-decoration: none; }
  .hero__sos-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-alert); box-shadow: 0 0 0 4px oklch(50% 0.17 28 / 0.18); }
  .hero__head h1 { font-size: clamp(1.75rem, 7.6vw, 3.2rem); line-height: 1.04; }
  .hero__lead { margin-top: var(--space-xs); color: var(--color-ink-2); max-width: 34rem; display: none; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .hero__cta .btn { flex: 1 1 10rem; justify-content: center; }
  @media (min-width: 40rem) { .hero__lead { display: block; } }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-areas: 'head bk' 'cta bk'; column-gap: var(--space-2xl); align-items: center; padding-top: var(--space-xl); padding-bottom: var(--space-2xl); }
    .hero__head { grid-area: head; align-self: end; }
    .hero > :global(.bk) { grid-area: bk; }
    .hero__cta { grid-area: cta; align-self: start; margin-top: var(--space-md); }
    .hero__cta .btn { flex: 0 0 auto; }
  }

  .chips { padding-bottom: var(--space-lg); }
  .chips ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .chips a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 var(--space-md); border-radius: var(--radius-pill); border: 1.5px solid var(--color-ink-2); color: var(--color-ink); text-decoration: none; font-weight: 600; font-size: var(--text-sm); white-space: nowrap; }

  /* Stationen als Farbblöcke */
  .st { position: relative; overflow: hidden; scroll-margin-top: 64px; padding: var(--space-2xl) 0; }
  .st__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  .st__in > *, .st__main > * { min-width: 0; }
  .st__main { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); align-content: start; }
  .st__label { margin: 0 0 var(--space-xs); font: 700 var(--text-sm)/1.2 var(--font-body); color: var(--color-copper-ink); }
  .st__lead { margin-top: var(--space-md); max-width: var(--measure); }
  .st__ctas { margin-top: var(--space-lg); display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .btn--ghost-light { background: transparent; border: 1.5px solid currentColor; color: inherit; }
  .st :global(.st__photo) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  .st :global(.st__photo--tall) { aspect-ratio: 3 / 4; }
  .st__paar { margin: 0; display: grid; gap: var(--space-sm); max-width: 24rem; }
  .st__paar figcaption, .ref ul { font-size: var(--text-sm); }
  .ref { margin: 0; }
  .ref ul { list-style: none; padding: 0; margin: var(--space-2xs) 0 0; }
  .ref p, .ref figcaption strong { display: block; margin-top: var(--space-sm); }
  .st__prices ul { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid currentColor; }
  .st__prices li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: var(--rule-w) solid color-mix(in oklch, currentColor 22%, transparent); }
  .st__prices small { font-size: var(--text-xs); }
  .st__prices .price { font-weight: 700; white-space: nowrap; }
  .st__prices .mwst { margin-top: var(--space-xs); font-size: var(--text-xs); }
  .st__tool h3 { margin-bottom: var(--space-md); }

  .st--hausanschluss { background: var(--color-water-soft); }
  .st--hausanschluss .st__label { color: var(--color-deep-2); }
  .st--heizung { background: var(--color-deep); color: var(--color-on-deep); }
  .st--heizung .st__label { color: var(--color-copper-glow); }
  .st--heizung .st__lead, .st--heizung .ref ul, .st--heizung .mwst { color: var(--color-on-deep); }
  .st--heizung .btn--copper { border-color: var(--color-copper-glow); }
  .st--heizung .st__prices small { opacity: 1; color: var(--color-on-deep-2); }
  .st--heizung :global(.st__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; z-index: 0; }
  .st--heizung::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to bottom, oklch(30% 0.06 225 / 0.7), oklch(30% 0.06 225 / 0.92)); }
  .st--heizung .st__in { z-index: 2; }
  .st--bad { background: var(--color-copper-soft); }
  .st--wartung { background: var(--color-paper-2); }
  .st--wartung .st__head h2 { max-width: 30ch; }

  .kleine { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); padding-top: var(--space-2xl); padding-bottom: var(--space-2xl); }
  .kl { min-width: 0; scroll-margin-top: 64px; }
  .kl .st__prices { margin-top: var(--space-md); }

  .refs h3 { margin-bottom: var(--space-md); }
  .refs__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .refs__list > li { min-width: 0; }
  .st__wartung { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
  .st__wartung > * { min-width: 0; }
  .wp ul { list-style: none; margin: var(--space-sm) 0 0; padding: 0; border-top: 1.5px solid currentColor; }
  .wp li { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) 0; border-bottom: var(--rule-w) solid var(--color-rule); }
  .wp .price { font-weight: 700; white-space: nowrap; }
  .wp .mwst { margin: var(--space-xs) 0 var(--space-md); font-size: var(--text-xs); }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xs); }
  .checks li { padding-left: 1.6rem; position: relative; }
  .checks li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.9rem; height: 0.5rem; border-left: 2.5px solid var(--color-copper); border-bottom: 2.5px solid var(--color-copper); transform: rotate(-45deg); }
  @media (min-width: 64rem) {
    .st__in { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--space-2xl); align-items: start; }
    .refs, .st__wartung { grid-column: 1 / -1; }
    .refs__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .st__wartung { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-2xl); align-items: start; }
    .st__wartung > :global(.st__photo) { grid-column: 1; grid-row: 1 / span 2; }
    .st__wartung > .checks, .st__wartung > .wp { grid-column: 2; }
    .kleine { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-2xl); }
  }

  .ablauf, .faq, .anfrage-wrap { padding-left: var(--gutter); }
  .ablauf { margin-top: var(--space-2xl); }
  .ablauf__in, .faq__in { max-width: 48rem; }
  .ablauf__list { list-style: none; margin: var(--space-lg) 0; padding: 0; counter-reset: s; display: grid; gap: var(--space-lg); }
  .ablauf__list li { counter-increment: s; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: var(--space-sm); }
  .ablauf__list li::before { content: counter(s); grid-row: span 2; font: 500 var(--text-xl)/1 var(--font-display); color: var(--color-copper-ink); }
  .ablauf__list p { color: var(--color-ink-2); margin-top: var(--space-2xs); }
  .ablauf :global(.ablauf__img) { display: block; width: 100%; border-radius: var(--radius); object-fit: cover; aspect-ratio: 4 / 3; max-width: 34rem; }
  .ablauf__note { margin-top: var(--space-md); font-size: var(--text-sm); color: var(--color-ink-2); }
  .faq { margin-top: var(--space-3xl); }
  .faq h2 { margin-bottom: var(--space-lg); }
  .faq__item { border-top: var(--rule-w) solid var(--color-rule); }
  .faq__item:last-child { border-bottom: var(--rule-w) solid var(--color-rule); }
  .faq__item summary { cursor: pointer; padding: var(--space-md) 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: var(--space-md); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; font: 500 1.4rem/1 var(--font-display); color: var(--color-copper-ink); }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { padding-bottom: var(--space-md); color: var(--color-ink-2); }
  .anfrage-wrap { margin-top: var(--space-3xl); scroll-margin-top: 64px; }

  /* Einblenden beim Scrollen: nur CSS (Chrome, Edge, Safari 26+); sonst steht alles sofort da. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .st__head, .st :global(.st__photo), .st .ref, .st__prices, .st__tool, .kl, .ablauf__list li {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
      @keyframes rise { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-topic]').forEach((a) => a.addEventListener('click', () => {
    const r = document.querySelector<HTMLInputElement>(`#anfrage input[name="topic"][value="${a.dataset.topic}"]`);
    if (r) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); }
  }));
</script>
