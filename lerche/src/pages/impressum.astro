---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<Base title="Impressum · Lerche Aerostat" plain>
  <main>
    <h1>Impressum</h1>
    <p><strong>Beispielseite von Kravets Webdesign:</strong> Betrieb und Personen sind erfunden. Die Darstellungen (Himmel, Ballon, Kapsel) werden per Code im Browser gezeichnet; es gibt keine Fotos und keine KI-Bilder.</p>
    <h2>Angaben gemäß § 5 DDG</h2>
    <p>{site.legalName}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</p>
    <p>Telefon: {site.phone} (fiktive Rufnummer)<br />E-Mail: {site.email}</p>
    <p><a class="back" href={base}>← Zurück zur Startseite</a> · <a class="back" href={`${base}en/`} lang="en">Back to the English site</a></p>
  </main>
</Base>
