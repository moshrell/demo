---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import salon from '../data/site.json';
const base = import.meta.env.BASE_URL;

// Fotos liegen in src/assets/img/<name>.jpg|png|webp (Namen: GEMINI-PROMPTS.txt). Fehlt eine Datei,
// zeigt die Seite eine Farbkarte statt des Fotos; sobald die Datei da ist, erscheint sie von selbst.
const files = import.meta.glob('../assets/img/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }) as Record<string, any>;
const img = (name: string) => Object.entries(files).find(([k]) => k.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1];
const priceOf = (n: string) => Number(salon.services.find((s) => s.name === n)?.price.match(/\d+/)?.[0] ?? 0);
const looks = salon.looks.map((l) => ({ ...l, preis: 'ab ' + l.services.reduce((a, n) => a + priceOf(n), 0) + ' €' }));
---
<Base>
  <div class="bg" aria-hidden="true">
    <video autoplay muted loop playsinline preload="metadata" poster={`${base}paint-poster.webp`}>
      <source src={`${base}paint.webm`} type="video/webm" />
    </video>
  </div>

  <header class="nav glass">
    <a class="brand" href="#top">{salon.name}</a>
    <nav>
      <a href="#looks">Looks</a>
      <a href="#leistungen">Leistungen</a>
      <a href="#team">Team</a>
      <a href="#termin" class="pill">Termin anfragen</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero wrap">
      <div class="hero-text glass">
        <p class="eyebrow">{salon.tagline} · {salon.city}</p>
        <h1>Farbe, die <em>zu dir</em> gehört.</h1>
        <p class="lead">Balayage, Blond und Glanz – individuell gemischt und schonend aufgetragen.</p>
        <div class="cta">
          <a href="#termin" class="btn">Termin anfragen</a>
          <a href="#looks" class="link">Looks ansehen →</a>
        </div>
      </div>
    </section>


    <section id="looks" class="block wrap">
      <div class="head reveal">
        <h2>Sechs Töne, sechs Formeln</h2>
        <p class="lead">Tipp auf eine Farbe. Wir zeigen den Look und die Rezeptur dahinter.</p>
      </div>
      <div class="looks" data-looks>
        <div class="tones" role="tablist" aria-label="Farbton wählen">
          {looks.map((l, i) => (
            <button type="button" class="tone" role="tab" id={`tab-${l.id}`} aria-controls={`panel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--c:${l.swatch}`}>
              <span class="tone__ball" aria-hidden="true"></span>
              <span class="tone__name">{l.name}</span>
            </button>
          ))}
        </div>
        {looks.map((l, i) => {
          const im = img(`look-${l.id}`);
          return (
            <div class="look" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} hidden={false} data-i={i} style={`--c:${l.swatch}`}>
              <figure class="arch">
                {im ? <Image src={im} alt={l.alt} widths={[360, 560, 760]} sizes="(min-width: 900px) 420px, 80vw" quality={74} format="webp" loading="lazy" /> : <div class="ph" role="img" aria-label={`Foto folgt: ${l.alt}`}><span class="ph__ball"></span><small>Foto folgt</small></div>}
              </figure>
              <div class="recipe glass">
                <h3>{l.name}</h3>
                <p class="recipe__kurz">{l.kurz}</p>
                <dl class="recipe__rows">
                  <div><dt>Technik</dt><dd>{l.technik}</dd></div>
                  <div><dt>Ausgangsbasis</dt><dd>{l.basis}</dd></div>
                  <div><dt>Dauer</dt><dd>{l.dauer}</dd></div>
                  <div><dt>Haltbarkeit</dt><dd>{l.halt}</dd></div>
                  <div><dt>Passt zu</dt><dd>{l.passt}</dd></div>
                  <div><dt>Pflege</dt><dd>{l.pflege}</dd></div>
                </dl>
                <div class="recipe__foot">
                  <p class="recipe__price"><span>Preis</span><strong>{l.preis}</strong></p>
                  <button type="button" class="btn" data-take={l.services.join('|')}>Diesen Look anfragen</button>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section id="vorher-nachher" class="block wrap">
      <div class="head reveal">
        <h2>Vorher, <em>nachher</em></h2>
        <p class="lead">Schieb den Regler und sieh, was in einer Sitzung passiert.</p>
      </div>
      <div class="bas">
        {salon.ba.map((b) => {
          const v = img(`${b.id}-vorher`), n = img(`${b.id}-nachher`);
          return (
            <figure class="ba reveal" data-ba>
              <div class="ba__stage" style="--p:50%">
                <div class="ba__img ba__img--before">
                  {v ? <Image src={v} alt={`${b.alt}: vorher`} widths={[360, 560, 760]} sizes="(min-width: 900px) 440px, 90vw" quality={74} format="webp" loading="lazy" /> : <div class="ph ph--flat" aria-hidden="true"></div>}
                </div>
                <div class="ba__img ba__img--after">
                  {n ? <Image src={n} alt={`${b.alt}: nachher`} widths={[360, 560, 760]} sizes="(min-width: 900px) 440px, 90vw" quality={74} format="webp" loading="lazy" /> : <div class="ph ph--after" aria-hidden="true"><small>Foto folgt</small></div>}
                </div>
                <span class="ba__tag ba__tag--l glass">Vorher</span>
                <span class="ba__tag ba__tag--r glass">Nachher</span>
                <span class="ba__line" aria-hidden="true"><span class="ba__knob"></span></span>
                <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`Vorher-Nachher-Regler: ${b.titel}`} />
              </div>
              <figcaption><strong>{b.titel}</strong><span>{b.meta}</span></figcaption>
            </figure>
          );
        })}
      </div>
    </section>

    <section id="leistungen" class="block wrap">
      <div class="head reveal">
        <h2>Alles rund um Haarfarbe</h2>
      </div>
      <ul class="services glass">
        {salon.services.map((s) => (
          <li class="reveal">
            <span class="dot" style={`--c:${s.swatch}`}></span>
            <div>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
            </div>
            <span class="price">{s.price}</span>
          </li>
        ))}
      </ul>
      <p class="fine reveal">Endpreis nach Haarlänge und -dichte, wir nennen ihn dir vor dem Start.</p>
    </section>

    <section id="ablauf" class="block soft">
      <div class="wrap">
        <div class="head reveal">
          <h2>Drei Schritte zu deinem Ton</h2>
        </div>
        <ol class="steps">
          {salon.steps.map((s, i) => (
            <li class="reveal glass">
              <span class="num">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>


    <section id="team" class="block wrap">
      <div class="head reveal">
        <h2>Wer deine Farbe mischt</h2>
        <p class="lead">Drei Coloristinnen, ein Atelier. Jede Formel entsteht von Hand.</p>
      </div>
      {img('atelier') ? (
        <figure class="atelier reveal"><Image src={img('atelier')} alt="Das Atelier in Hannover: heller Raum mit Farbstation und Waschplätzen" widths={[640, 960, 1280]} sizes="(min-width: 1320px) 1176px, 90vw" quality={72} format="webp" loading="lazy" /></figure>
      ) : (
        <div class="atelier atelier--ph reveal" role="img" aria-label="Foto folgt: das Atelier"><span class="ph__ball"></span><small>Foto folgt</small></div>
      )}
      <ul class="team">
        {salon.team.map((m) => {
          const im = img(`team-${m.id}`);
          return (
            <li class="member glass reveal">
              <div class="member__pic">
                {im ? <Image src={im} alt={`${m.name}, ${m.rolle}`} widths={[240, 400, 560]} sizes="(min-width: 900px) 240px, 60vw" quality={74} format="webp" loading="lazy" /> : <div class="ph ph--blob" role="img" aria-label={`Foto folgt: ${m.name}`}><small>Foto folgt</small></div>}
              </div>
              <h3>{m.name}</h3>
              <p class="member__role">{m.rolle} · {m.spez}</p>
              <p>{m.text}</p>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="stimmen" class="block wrap">
      <div class="head reveal"><h2>Was Kundinnen sagen</h2></div>
      <ul class="quotes">
        {salon.reviews.map((r) => (
          <li class="glass reveal">
            <blockquote>„{r.text}“</blockquote>
            <p class="quotes__who"><strong>{r.wer}</strong> · {r.was}</p>
          </li>
        ))}
      </ul>
      <p class="fine reveal">Beispieltexte für diese Demo.</p>
    </section>

    <section id="faq" class="block wrap">
      <div class="head reveal"><h2>Gut zu wissen</h2></div>
      <div class="faq">
        {salon.faq.map((f) => (
          <details class="glass reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="termin" class="block wrap booking">
      <div class="head reveal glass hours-card">
        <p class="eyebrow">Termin</p>
        <h2>Wann dürfen wir <em>loslegen</em>?</h2>
        <p class="lead">Schreib uns kurz, wir melden uns innerhalb eines Werktags.</p>
        <dl class="hours">
          {salon.hours.map((h) => (<div><dt>{h.days}</dt><dd>{h.time}</dd></div>))}
        </dl>
      </div>
      <div class="bookwrap reveal">
      <form id="booking" class="glass" novalidate>
        <label class="field" for="f-name">Name
          <input id="f-name" name="name" type="text" required autocomplete="name" placeholder="Vor- und Nachname" aria-describedby="e-name" />
          <span class="err" id="e-name" data-err hidden>Bitte geben Sie Ihren Namen an.</span>
        </label>
        <div class="two">
          <label class="field" for="f-tel">Telefon
            <input id="f-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 0511 1234567" aria-describedby="e-contact" />
          </label>
          <label class="field" for="f-mail">E-Mail
            <input id="f-mail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@beispiel.de" aria-describedby="e-contact" />
          </label>
        </div>
        <p class="err" id="e-contact" data-err hidden>Bitte geben Sie eine Telefonnummer oder eine gültige E-Mail-Adresse an, damit wir uns melden können.</p>

        <fieldset class="svc" aria-describedby="svc-hint">
          <legend>Leistung (Mehrfachauswahl möglich)</legend>
          <ul class="svc__list">
            {salon.services.map((s, i) => (
              <li>
                <label class="opt" for={`f-svc-${i}`}>
                  <input id={`f-svc-${i}`} type="checkbox" name="service" value={s.name} data-amount={s.price.match(/\d+/)?.[0] ?? ''} data-price={s.price} />
                  <span class="dot" style={`--c:${s.swatch}`}></span>
                  <span class="opt__name">{s.name}</span>
                  <span class="opt__price">{s.price}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="fine" id="svc-hint">Endpreis nach Haarlänge und -dichte, wir nennen ihn dir vor dem Start.</p>
        </fieldset>

        <label class="field" for="f-when">Wunschtermin
          <input id="f-when" name="when" type="text" autocomplete="off" placeholder="z. B. Samstag Vormittag" />
        </label>

        <div class="consent">
          <label class="check" for="f-consent">
            <input id="f-consent" name="consent" type="checkbox" required aria-describedby="e-consent" />
            <span>Ich bin einverstanden, dass {salon.name} meinen Namen und meine Kontaktdaten zur Bearbeitung meiner Terminanfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
          </label>
          <p class="err" id="e-consent" data-err hidden>Bitte stimmen Sie zu, sonst können wir Ihre Anfrage nicht bearbeiten.</p>
        </div>

        <div class="bar glass">
          <p class="sum" aria-live="polite"><span class="sum__label">Summe</span> <strong data-total>–</strong><span class="sum__note" data-note>Noch keine Leistung gewählt</span></p>
          <button class="btn" type="submit">Anfrage senden</button>
        </div>
        <p class="fine">Demo: Die Anfrage wird nicht verschickt. Mehr unter <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Datenschutz</a>.</p>
      </form>

      <div class="done glass" id="booking-done" tabindex="-1" hidden>
        <h3>Danke, <span data-d-name></span>.</h3>
        <p>Das ist eine Demo, es wurde nichts verschickt. So würde Ihre Anfrage bei uns ankommen:</p>
        <dl class="recap">
          <div><dt>Leistung</dt><dd data-d-svc></dd></div>
          <div><dt>Wunschtermin</dt><dd data-d-when></dd></div>
          <div><dt>Kontakt</dt><dd data-d-contact></dd></div>
          <div class="recap__sum"><dt>Summe</dt><dd><strong data-d-total></strong> <span data-d-note></span></dd></div>
        </dl>
        <button class="btn" type="button" data-reset>Neue Anfrage</button>
      </div>
      </div>
    </section>
  </main>

  <footer class="foot glass">
    <span>{salon.name} · {salon.address}</span>
    <span><a href={`tel:${salon.phone.replace(/\s/g, '')}`}>{salon.phone}</a> · <a href={`${base}impressum/`} target="_blank" rel="noopener">Impressum</a> · <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Datenschutz</a></span>
  </footer>

  <script is:inline>
    // Reveal on scroll
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), {threshold: 0.15});
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Soft pointer parallax on the paint video
    const vis = document.querySelector('.bg');
    if (vis && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches) {
      addEventListener('pointermove', (e) => {
        const x = (e.clientX / innerWidth - 0.5) * -26;
        const y = (e.clientY / innerHeight - 0.5) * -18;
        vis.style.transform = `translate(${x}px, ${y}px)`;
      });
    }


    // Looks: Tabs mit Kugeln; „Diesen Look anfragen“ füllt das Formular vor
    (() => {
      const root = document.querySelector('[data-looks]');
      if (!root) return;
      document.documentElement.classList.add('js');
      const tabs = [...root.querySelectorAll('[role="tab"]')];
      const panels = [...root.querySelectorAll('[role="tabpanel"]')];
      const show = (i, focus) => {
        tabs.forEach((t, k) => { t.setAttribute('aria-selected', k === i ? 'true' : 'false'); t.tabIndex = k === i ? 0 : -1; });
        panels.forEach((p, k) => { p.hidden = k !== i; });
        if (focus) tabs[i].focus();
      };
      show(0);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(i));
        t.addEventListener('keydown', (e) => {
          const k = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (k) { e.preventDefault(); show((i + k + tabs.length) % tabs.length, true); }
          else if (e.key === 'Home') { e.preventDefault(); show(0, true); }
          else if (e.key === 'End') { e.preventDefault(); show(tabs.length - 1, true); }
        });
      });
      root.querySelectorAll('[data-take]').forEach((b) => b.addEventListener('click', () => {
        const want = b.dataset.take.split('|');
        const form = document.getElementById('booking');
        const done = document.getElementById('booking-done');
        if (done && !done.hidden) done.querySelector('[data-reset]')?.click();
        form.querySelectorAll('input[name="service"]').forEach((c) => { c.checked = want.includes(c.value); });
        form.dispatchEvent(new Event('change', { bubbles: true }));
        document.getElementById('termin').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }));
    })();

    // Vorher/Nachher-Regler
    document.querySelectorAll('[data-ba]').forEach((el) => {
      const stage = el.querySelector('.ba__stage'), r = el.querySelector('.ba__range');
      const set = () => stage.style.setProperty('--p', r.value + '%');
      r.addEventListener('input', set); set();
    });

    // Booking form: demo only, nothing is sent
    (() => {
      const form = document.getElementById('booking');
      const done = document.getElementById('booking-done');
      const $ = (sel, r = form) => r.querySelector(sel);
      const fmt = (n) => n.toLocaleString('de-DE') + ' €';
      const checks = () => [...form.querySelectorAll('input[name="service"]')];
      const calc = () => {
        const on = checks().filter((c) => c.checked);
        const fixed = on.filter((c) => c.dataset.amount);
        const open = on.filter((c) => !c.dataset.amount);
        const sum = fixed.reduce((a, c) => a + Number(c.dataset.amount), 0);
        let total = '–', note = 'Noch keine Leistung gewählt';
        if (on.length) {
          total = fixed.length ? 'ab ' + fmt(sum) : 'auf Anfrage';
          note = open.length && fixed.length ? '+ ' + open.map((c) => c.value).join(', ') + ' auf Anfrage' : 'Endpreis nach Beratung';
        }
        return { on, total, note };
      };
      const showTotal = () => { const r = calc(); $('[data-total]').textContent = r.total; $('[data-note]').textContent = r.note; };
      const setErr = (id, bad, input) => {
        const e = document.getElementById(id); e.hidden = !bad;
        (Array.isArray(input) ? input : [input]).forEach((i) => i.setAttribute('aria-invalid', bad ? 'true' : 'false'));
      };
      const validate = () => {
        const name = $('#f-name'), tel = $('#f-tel'), mail = $('#f-mail'), cons = $('#f-consent');
        const mailOk = mail.value.trim() !== '' && mail.checkValidity();
        const telOk = tel.value.replace(/\D/g, '').length >= 5;
        const bad = [];
        const n = name.value.trim() === ''; setErr('e-name', n, name); if (n) bad.push(name);
        const c = !(mailOk || telOk) || (mail.value.trim() !== '' && !mailOk); setErr('e-contact', c, [tel, mail]); if (c) bad.push(tel);
        const k = !cons.checked; setErr('e-consent', k, cons); if (k) bad.push(cons);
        return bad;
      };
      // Eingaben im Tab zwischenspeichern (sessionStorage), Einwilligung bewusst nicht
      const KEY = 'nuance-form:' + location.pathname;
      const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify({ name: $('#f-name').value, tel: $('#f-tel').value, email: $('#f-mail').value, when: $('#f-when').value, svc: checks().filter((c) => c.checked).map((c) => c.value) })); } catch (e) {} };
      const clearSaved = () => { try { sessionStorage.removeItem(KEY); } catch (e) {} };
      const restore = () => {
        try {
          const d = JSON.parse(sessionStorage.getItem(KEY) || 'null');
          if (!d) return;
          $('#f-name').value = d.name || ''; $('#f-tel').value = d.tel || ''; $('#f-mail').value = d.email || ''; $('#f-when').value = d.when || '';
          checks().forEach((c) => { c.checked = (d.svc || []).includes(c.value); });
        } catch (e) {}
      };
      restore();
      $('#f-consent').checked = false;
      addEventListener('pageshow', () => { $('#f-consent').checked = false; });
      form.addEventListener('input', save);
      form.addEventListener('change', () => { showTotal(); save(); });
      showTotal();
      form.addEventListener('input', (ev) => { if (ev.target.getAttribute('aria-invalid') === 'true') validate(); });
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const bad = validate();
        if (bad.length) { bad[0].focus(); return; }
        const r = calc();
        const contact = [$('#f-tel').value.trim(), $('#f-mail').value.trim()].filter(Boolean).join(' · ');
        done.querySelector('[data-d-name]').textContent = $('#f-name').value.trim();
        done.querySelector('[data-d-svc]').textContent = r.on.length ? r.on.map((c) => c.value + ' (' + c.dataset.price + ')').join(', ') : 'noch offen, wir beraten Sie';
        done.querySelector('[data-d-when]').textContent = $('#f-when').value.trim() || 'nach Absprache';
        done.querySelector('[data-d-contact]').textContent = contact;
        done.querySelector('[data-d-total]').textContent = r.total === '–' ? 'wird nach Beratung genannt' : r.total;
        done.querySelector('[data-d-note]').textContent = r.on.length ? r.note : '';
        clearSaved();
        form.hidden = true; done.hidden = false; done.focus();
      });
      done.querySelector('[data-reset]').addEventListener('click', () => {
        clearSaved();
        form.reset(); form.querySelectorAll('[data-err]').forEach((e) => (e.hidden = true));
        form.querySelectorAll('[aria-invalid]').forEach((i) => i.removeAttribute('aria-invalid'));
        showTotal(); done.hidden = true; form.hidden = false; $('#f-name').focus();
      });
    })();
  </script>
</Base>

<style>
  .nav { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px 10px 28px; border-radius: 999px; position: sticky; top: 14px; z-index: 5; width: min(1320px, calc(100% - 2 * var(--gutter))); margin: 18px auto 0; }
  .brand { white-space: nowrap; font-family: var(--serif); font-size: 28px; text-decoration: none; letter-spacing: 0.02em; }
  .nav nav { display: flex; gap: 28px; align-items: center; font-size: 14px; }
  .nav nav a { text-decoration: none; color: var(--ink-soft); }
  .nav nav a:hover { color: var(--ink); }
  .pill { white-space: nowrap; background: var(--ink); color: var(--bg) !important; padding: 9px 20px; border-radius: 999px; }

  .hero { display: flex; align-items: center; min-height: min(78vh, 760px); position: relative; padding-block: 40px 64px; }
  .hero-text { position: relative; z-index: 2; padding: clamp(28px, 4vw, 56px); max-width: 680px; border-radius: 40px; }
  h1 { font-size: clamp(48px, 7vw, 104px); margin: 22px 0 24px; letter-spacing: -0.01em; }
  h1 em, h2 em { font-style: italic; color: var(--rose-ink); white-space: nowrap; }
  .lead { font-size: 18px; color: var(--ink-soft); max-width: 30em; margin: 0; }
  .cta { display: flex; gap: 28px; align-items: center; margin-top: 36px; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--ink); color: var(--bg); padding: 15px 30px; border-radius: 999px; text-decoration: none; border: 0; font: inherit; font-size: 15px; cursor: pointer; transition: transform .3s, background-color .3s; white-space: nowrap; }
  .btn:hover { background: var(--ink-hover); }
  @media (prefers-reduced-motion: no-preference) { .btn:hover { transform: translateY(-2px); } }
  .link { white-space: nowrap; text-decoration: none; font-size: 15px; color: var(--ink-soft); }
