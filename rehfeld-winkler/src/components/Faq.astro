---
// Sichtbarer FAQ-Block. Dieselben Fragen/Antworten gehen als `faq`-Prop an Base (FAQPage-Markup).
const { items = [], name = 'faq' } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details name={name}>
      <summary>{f.q}</summary>
      <p class="faq__a">{f.a}</p>
    </details>
  ))}
</div>
