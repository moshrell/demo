---
/**
 * Bauablauf: Haus entsteht beim Scrollen (GSAP ScrollTrigger, pin + scrub + snap).
 * Ohne JS / reduced-motion: dieselben Phasen als Liste (progressive enhancement).
 * Bilder 3:4 aus PROMPTS.txt Block A, Notizen in % des Bildes (phasen.json → notes).
 */
import data from '../data/phasen.json';
const base = import.meta.env.BASE_URL;
const img = (f: string) => `${base}img/${f}`;
const { intro, phasen, payDisclaimer } = data;
let cum = 0;
const steps = phasen.map((p) => ({ ...p, cum: (cum += p.pay) }));
---
<section class="ba" id="bauablauf" aria-labelledby="ba-title" data-ba>
  <div class="ba__pin" data-pin>
    <div class="ba__stage" data-stage aria-hidden="true">
      <figure class="ba__frame ba__frame--hero" data-frame="hero" data-file={intro.img}>
        <img src={img(intro.img)} alt="" width="1200" height="1600" fetchpriority="high" />
      </figure>
      {steps.map((p) => (
        <figure class={`ba__frame${p.nr === 4 ? ' ba__frame--top' : ''}`} data-frame={p.nr} data-file={p.img}>
          <img src={img(p.img)} alt="" width="1200" height="1600" loading="lazy" decoding="async" />
          {p.notes.map((n) => (
            <span class="ba__note" data-note style={`--x:${n.x};--y:${n.y}`}>
              <span class="ba__dot"></span><span class="ba__line"></span><span class="ba__label mono">{n.label}</span>
            </span>
          ))}
        </figure>
      ))}
      <ol class="ba__dots" data-dots aria-hidden="false" aria-label="Bauabschnitt wählen">
        {steps.map((p) => <li><button type="button" data-go={p.nr} aria-label={`Phase ${p.nr}: ${p.title}`}><span class="mono">{p.nr}</span></button></li>)}
      </ol>
    </div>

    <div class="ba__panel" data-panel>
      <div class="ba__intro" data-intro>
        <p class="mono ba__kicker">{intro.kicker}</p>
        <h1 id="ba-title" data-split>{intro.title}</h1>
        <p class="ba__lead">{intro.lead}</p>
        <div class="ba__cta">
          <a class="btn btn--primary" href={`${base}anfrage/`}>Projekt anfragen</a>
          <a class="btn" href="#planen" data-skip>Direkt zur Auswahl</a>
        </div>
        <p class="ba__hint mono" data-hint><span aria-hidden="true">↓</span> Scrollen, um zu bauen</p>
      </div>

      {steps.map((p) => (
        <article class="ba__step" data-step={p.nr} aria-labelledby={`ba-s${p.nr}`}>
          <figure class="ba__thumb" data-file={p.img}>
            <img src={img(p.img)} alt={p.alt} width="1200" height="1600" loading="lazy" decoding="async" />
          </figure>
          <div class="ba__txt">
            <p class="mono ba__meta"><span>Phase {p.nr} / 6</span><span>{p.weeks}</span></p>
            <h2 id={`ba-s${p.nr}`}>{p.title}</h2>
            <p>{p.text}</p>
            <p class="ba__who mono">Verantwortlich: {p.who}</p>
            <div class="ba__pay">
              <p class="ba__payrow"><span>{p.pay ? `+ ${p.pay} % der Bausumme` : 'Keine Zahlung'}</span><strong class="mono">{p.cum} %</strong></p>
              <div class="ba__paybar" role="img" aria-label={`Bis hier bezahlt: ${p.cum} Prozent`}><span style={`--p:${p.cum / 100}`}></span></div>
              <p class="ba__paynote">{p.payNote}</p>
            </div>
          </div>
        </article>
      ))}
      <p class="ba__disclaimer" data-disclaimer>{payDisclaimer}</p>
      <a class="ba__skip mono" href="#planen" data-skip-live>Überspringen</a>
    </div>
  </div>
</section>

<style>
  /* Basis: Liste (ohne JS / reduced-motion) */
  .ba { background: var(--color-paper); }
  .ba__stage { display: none; }
  .ba__panel { max-width: 76rem; margin-inline: auto; padding: var(--space-xl) var(--gutter) var(--space-lg); display: grid; gap: var(--space-xl); }
  .ba__kicker { color: var(--color-accent); margin-bottom: var(--space-md); }
  .ba__lead { font-size: var(--text-lg); margin-top: var(--space-md); max-width: var(--measure); }
  .ba__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }
  .ba__hint, .ba__skip { display: none; }
  .ba__step { display: grid; gap: var(--space-md); grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--color-rule); padding-top: var(--space-lg); }
  @media (min-width: 48rem) { .ba__step { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); align-items: start; } }
  .ba__thumb { margin: 0; aspect-ratio: 3 / 4; background: var(--color-paper-3); overflow: hidden; border-radius: var(--radius); max-height: 70svh; }
  .ba__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ba__txt { display: grid; gap: var(--space-sm); align-content: start; }
  .ba__meta { display: flex; justify-content: space-between; gap: var(--space-md); color: var(--color-ink-2); }
  .ba__step h2 { font-size: var(--text-xl); }
  .ba__who { color: var(--color-ink-2); }
  .ba__pay { margin-top: var(--space-sm); padding: var(--space-smd) var(--space-md); background: var(--color-chalk); border: 1px solid var(--color-rule); border-radius: var(--radius); display: grid; gap: var(--space-xs); }
  .ba__payrow { display: flex; justify-content: space-between; gap: var(--space-md); font-weight: 600; font-size: var(--text-sm); }
  .ba__payrow strong { color: var(--color-accent); font-size: 0.95rem; }
  .ba__paybar { height: 6px; background: var(--color-paper-3); border-radius: 3px; overflow: hidden; }
  .ba__paybar span { display: block; height: 100%; background: var(--color-accent); transform-origin: left; transform: scaleX(var(--p)); }
  .ba__paynote { font-size: var(--text-sm); color: var(--color-ink-2); }
  .ba__disclaimer { font-size: var(--text-sm); color: var(--color-ink-2); }

  /* Live-Szene (JS + Bewegung erlaubt) */
  :global(.ba-live) .ba__pin {
    height: calc(100svh - var(--header-h));
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    background: var(--color-paper);
  }
  :global(.ba-live) .ba__stage { display: block; position: relative; overflow: hidden; background: var(--color-night); }
  :global(.ba-live) .ba__frame { position: absolute; inset: 0; margin: 0; background: var(--color-night-2); will-change: clip-path, opacity; }
  :global(.ba-live) .ba__frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; }
  :global(.ba-live) .ba__frame.is-missing::after { content: attr(data-file); position: absolute; left: var(--space-md); bottom: var(--space-md); font-family: var(--font-mono); font-size: 0.75rem; color: oklch(80% 0.02 262); }
  :global(.ba-live) .ba__frame.is-missing img { visibility: hidden; }
  :global(.ba-live) .ba__note { position: absolute; left: calc(var(--px, 50) * 1px); top: calc(var(--py, 50) * 1px); width: 0; height: 0; opacity: 0; }
  :global(.ba-live) .ba__dot { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-chalk); box-shadow: 0 0 0 4px oklch(98% 0.003 90 / 0.35); }
  :global(.ba-live) .ba__line { position: absolute; left: -1px; bottom: 6px; width: 2px; height: 3.2rem; background: var(--color-chalk); transform-origin: bottom; }
  :global(.ba-live) .ba__label { position: absolute; bottom: calc(3.2rem + 6px); left: var(--lx, -0.5rem); white-space: nowrap; padding: 0.35rem 0.55rem; background: var(--color-chalk); color: var(--color-ink); border-radius: 2px; font-size: 0.7rem; }
  :global(.ba-live) .ba__dots { position: absolute; right: var(--space-sm); top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; z-index: 3; }
  :global(.ba-live) .ba__dots button { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; padding: 0; }
  :global(.ba-live) .ba__dots button span { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: oklch(19% 0.045 265 / 0.55); color: var(--color-chalk); font-size: 0.62rem; border: 1px solid oklch(98% 0.003 90 / 0.5); }
  :global(.ba-live) .ba__dots button[aria-current='step'] span { background: var(--color-accent); border-color: var(--color-accent); }
  :global(.ba-live) .ba__dots[data-hidden] { opacity: 0; pointer-events: none; }

  :global(.ba-live) .ba__panel {
    position: relative; display: grid; grid-template-areas: 'p'; gap: 0;
    padding: var(--space-md) var(--gutter) var(--space-md); max-width: none; margin: 0;
    background: var(--color-paper); border-top: 1px solid var(--color-rule);
    min-height: 15.5rem;
  }
  :global(.ba-live) .ba__intro, :global(.ba-live) .ba__step { grid-area: p; align-self: start; }
  :global(.ba-live) .ba__step { border-top: 0; padding-top: 0; display: block; visibility: hidden; }
  :global(.ba-live) .ba__thumb { display: none; }
  :global(.ba-live) .ba__step .ba__txt { gap: var(--space-xs); }
  :global(.ba-live) .ba__step h2 { font-size: clamp(1.35rem, 1rem + 1.6vw, 2.2rem); }
  :global(.ba-live) .ba__step p:not(.ba__meta):not(.ba__payrow):not(.ba__paynote):not(.ba__who) { font-size: 0.98rem; line-height: 1.5; }
  :global(.ba-live) .ba__disclaimer { display: none; }
  :global(.ba-live) .ba__intro h1 { font-size: clamp(1.75rem, 1.1rem + 3.4vw, 4rem); }
  :global(.ba-live) .ba__intro .ba__lead { font-size: 1rem; margin-top: var(--space-sm); }
  :global(.ba-live) .ba__intro .ba__cta { margin-top: var(--space-md); }
  :global(.ba-live) .ba__hint { display: block; }
  :global(.ba-live) .ba__skip { display: block; position: absolute; right: var(--gutter); top: -2.75rem; padding: 0 0.75rem; line-height: 2.1rem; background: oklch(19% 0.045 265 / 0.72); color: var(--color-chalk); border-radius: 2px; text-decoration: none; z-index: 2; }
  :global(.ba-live) .ba__skip[hidden] { display: none; }

  /* Telefon: Bild dominiert, Panel kompakt */
  :global(.ba-live) .ba__hint { position: absolute; left: var(--gutter); top: -2.75rem; margin: 0; padding: 0.4rem 0.75rem; background: oklch(19% 0.045 265 / 0.72); color: var(--color-chalk); border-radius: 2px; white-space: nowrap; z-index: 2; }
  @media (max-width: 63.99rem) and (min-height: 501px) {
    :global(.ba-live) .ba__pin { height: calc(100svh - var(--header-h) - var(--bar-h) - env(safe-area-inset-bottom)); }
  }
  @media (max-width: 47.99rem) {
    :global(.ba-live) .ba__pin { grid-template-rows: minmax(52%, 1fr) auto; }
    :global(.ba-live) .ba__panel { min-height: 0; padding-top: var(--space-smd); padding-bottom: var(--space-smd); }
    :global(.ba-live) .ba__kicker { display: none; }
    :global(.ba-live) .ba__intro h1 { font-size: clamp(1.45rem, 0.9rem + 3.4vw, 2rem); }
    :global(.ba-live) .ba__intro .ba__lead { display: none; }
    :global(.ba-live) .ba__intro .ba__cta { margin-top: var(--space-smd); flex-wrap: nowrap; }
    :global(.ba-live) .ba__intro .ba__cta .btn { flex: 1 1 auto; min-height: 2.75rem; padding-inline: 0.75rem; font-size: 0.92rem; }
    :global(.ba-live) .ba__step .ba__who, :global(.ba-live) .ba__step .ba__paynote { display: none; }
    :global(.ba-live) .ba__step h2 { font-size: 1.3rem; }
    :global(.ba-live) .ba__step p:not(.ba__meta):not(.ba__payrow):not(.ba__paynote):not(.ba__who) { font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    :global(.ba-live) .ba__pay { margin-top: var(--space-xs); padding: var(--space-sm) var(--space-smd); }
  }
  @media (max-width: 47.99rem) and (min-height: 800px) {
    :global(.ba-live) .ba__intro .ba__lead { display: block; font-size: 0.95rem; }
    :global(.ba-live) .ba__step .ba__paynote { display: block; }
  }
  @media (max-width: 47.99rem) and (max-height: 600px) {
    :global(.ba-live) .ba__step p:not(.ba__meta):not(.ba__payrow):not(.ba__paynote):not(.ba__who) { -webkit-line-clamp: 2; }
    :global(.ba-live) .ba__intro .ba__cta .btn:last-child { display: none; }
  }

  /* Tablet/PC: Bild links, Text rechts */
  @media (min-width: 48rem) {
    :global(.ba-live) .ba__pin { grid-template-rows: 1fr; grid-template-columns: minmax(0, 1fr) minmax(20rem, 1fr); }
    :global(.ba-live) .ba__panel { border-top: 0; border-left: 1px solid var(--color-rule); padding: var(--space-xl) var(--gutter); align-content: center; }
    :global(.ba-live) .ba__intro, :global(.ba-live) .ba__step { align-self: center; max-width: 34rem; }
    :global(.ba-live) .ba__step .ba__txt { gap: var(--space-sm); }
    :global(.ba-live) .ba__skip { top: var(--space-lg); background: none; color: var(--color-ink-2); text-decoration: underline; padding: 0; line-height: 2.75rem; }
    :global(.ba-live) .ba__hint { position: static; transform: none; margin-top: var(--space-lg); padding: 0; background: none; color: var(--color-ink-2); }
  }
  @media (min-width: 48rem) and (orientation: landscape) and (max-height: 560px) {
    :global(.ba-live) .ba__panel { padding-block: var(--space-md); }
    :global(.ba-live) .ba__intro .ba__lead, :global(.ba-live) .ba__step .ba__paynote, :global(.ba-live) .ba__hint { display: none; }
    :global(.ba-live) .ba__intro h1 { font-size: 1.9rem; }
  }
  @media (min-width: 80rem) {
    :global(.ba-live) .ba__pin { grid-template-columns: minmax(0, 1.15fr) minmax(24rem, 1fr); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';
  import { SplitText } from 'gsap/SplitText';

  const root = document.querySelector<HTMLElement>('[data-ba]');
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (root && motionOK) {
    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin, SplitText);
    root.classList.add('ba-live');

    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
    const hero = frames[0];
    const phase = frames.slice(1); // 0..6
    const intro = root.querySelector<HTMLElement>('[data-intro]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const dotList = root.querySelector<HTMLElement>('[data-dots]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const skip = root.querySelector<HTMLElement>('[data-skip-live]')!;
    const N = phase.length;

    // Fehlende Bilder (noch nicht generiert): Dateiname statt leerem Rahmen
    frames.forEach((f) => {
      const im = f.querySelector('img')!;
      const miss = () => f.classList.add('is-missing');
      if (im.complete && im.naturalWidth === 0) miss();
      im.addEventListener('error', miss);
      im.addEventListener('load', () => f.classList.remove('is-missing'));
    });
    // Bilder der Szene früh laden (sie liegen übereinander, lazy würde sie nie laden)
    phase.forEach((f) => { const im = f.querySelector('img')!; im.loading = 'eager'; });

    // Notizen auf das Bild legen: object-fit: cover nachrechnen (Bild 3:4)
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const placeNotes = () => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const rw = Math.max(W, H * 0.75), rh = rw / 0.75;
      const ox = (W - rw) / 2, oy = (H - rh) * 0.55;
      notes.forEach((n) => {
        const x = Number(n.style.getPropertyValue('--x')), y = Number(n.style.getPropertyValue('--y'));
        const px = ox + (x / 100) * rw, py = oy + (y / 100) * rh;
        n.style.setProperty('--px', String(Math.round(px)));
        n.style.setProperty('--py', String(Math.round(py)));
        // Beschriftung innerhalb der Bühne halten
        const lab = n.querySelector<HTMLElement>('.ba__label')!;
        const lw = lab.offsetWidth;
        const left = Math.min(Math.max(px - lw / 2, 10), W - lw - 10);
        n.style.setProperty('--lx', `${Math.round(left - px)}px`);
      });
    };
    placeNotes();

    // Ausgangszustand
    gsap.set(phase, { clipPath: 'inset(100% 0% 0% 0%)' });
    gsap.set(phase[0], { clipPath: 'inset(0% 0% 0% 0%)', autoAlpha: 0 });
    gsap.set(phase[4], { clipPath: 'inset(0% 0% 100% 0%)' }); // Dachstuhl kommt von oben
    gsap.set(phase[N - 1], { clipPath: 'inset(0% 0% 0% 0%)', autoAlpha: 0 }); // Abend blendet über
    gsap.set(steps, { autoAlpha: 0, y: 14 });
    gsap.set(root.querySelectorAll('.ba__line'), { scaleY: 0 });

    // Überschrift wortweise
    const h1 = intro.querySelector<HTMLElement>('[data-split]');
    if (h1) {
      document.fonts.ready.then(() => {
        const split = SplitText.create(h1, { type: 'words', mask: 'words', aria: 'auto' });
        gsap.from(split.words, { yPercent: 105, duration: 0.7, ease: 'power3.out', stagger: 0.045 });
      });
    }

    const noteIn = (f: HTMLElement, tl: gsap.core.Timeline, at: string) => {
      const ns = f.querySelectorAll('[data-note]');
      if (!ns.length) return;
      tl.to(ns, { autoAlpha: 1, duration: 0.15 }, at);
      tl.fromTo(f.querySelectorAll('.ba__line'), { scaleY: 0 }, { scaleY: 1, duration: 0.25, ease: 'none' }, at);
    };
    const noteOut = (f: HTMLElement, tl: gsap.core.Timeline, at: string) => {
      const ns = f.querySelectorAll('[data-note]');
      if (ns.length) tl.to(ns, { autoAlpha: 0, duration: 0.12 }, at);
    };

    const tl = gsap.timeline({ defaults: { ease: 'none' } });
    tl.addLabel('s0', 0);
    // 0 → Phase 0: "zurückspulen" auf das leere Grundstück
    tl.to(intro, { autoAlpha: 0, y: -16, duration: 0.35 }, 's0')
      .to(phase[0], { autoAlpha: 1, duration: 0.5 }, 's0')
      .fromTo(hero, { scale: 1 }, { scale: 1.06, duration: 0.5 }, 's0')
      .to(steps[0], { autoAlpha: 1, y: 0, duration: 0.3 }, 's0+=0.45');
    noteIn(phase[0], tl, 's0+=0.6');
    tl.addLabel('p0', 1);

    for (let i = 1; i < N; i++) {
      const at = `p${i - 1}`;
      const f = phase[i];
      noteOut(phase[i - 1], tl, at);
      tl.to(steps[i - 1], { autoAlpha: 0, y: -14, duration: 0.25 }, at);
      if (i === N - 1) {
        tl.to(f, { autoAlpha: 1, duration: 0.7 }, at); // Abend
      } else {
        tl.to(f, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.7, ease: 'power1.inOut' }, at);
      }
      tl.fromTo(f.querySelector('img'), { scale: 1.05 }, { scale: 1, duration: 0.9, ease: 'power1.out' }, at);
      tl.to(steps[i], { autoAlpha: 1, y: 0, duration: 0.3 }, `${at}+=0.45`);
      noteIn(f, tl, `${at}+=0.65`);
      tl.addLabel(`p${i}`, i + 1);
    }
    tl.to({}, { duration: 0.3 }); // kurze Ruhe am Ende

    const labels = ['s0', ...phase.map((_, i) => `p${i}`)];
    let current = -1;
    const setActive = (idx: number) => {
      if (idx === current) return;
      current = idx;
      dots.forEach((d, i) => { if (i === idx - 1) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current'); });
      dotList.toggleAttribute('data-hidden', idx === 0);
      skip.hidden = idx === 0;
      steps.forEach((s, i) => s.setAttribute('aria-hidden', String(i !== idx - 1)));
    };
    setActive(0);

    const headerH = () => (document.querySelector('.hd') as HTMLElement)?.offsetHeight || 0;
    const mm = gsap.matchMedia();
    let st: ScrollTrigger | undefined;
    mm.add({ phone: '(max-width: 47.99rem)', wide: '(min-width: 48rem)' }, (ctx) => {
      const per = ctx.conditions!.phone ? 0.62 : 0.8; // Scroll-Länge pro Phase (× Höhe)
      st = ScrollTrigger.create({
        trigger: root,
        pin: root.querySelector<HTMLElement>('[data-pin]')!,
        start: () => `top top+=${headerH()}`,
        end: () => '+=' + Math.round(window.innerHeight * per * (N + 0.3)),
        scrub: 0.6,
        animation: tl,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        snap: { snapTo: 'labels', inertia: false, duration: { min: 0.25, max: 0.7 }, delay: 0.12, ease: 'power1.inOut' },
        onUpdate: (self) => {
          const t = self.animation!.time();
          let idx = 0;
          labels.forEach((l, i) => { if (t >= tl.labels[l] - 0.35) idx = i; });
          setActive(idx);
          if (hint && self.progress > 0.01) hint.style.visibility = 'hidden';
        },
        onRefresh: placeNotes,
      });
    });
    // Bilder ändern nichts an der Höhe (feste Rahmen), Schriften schon: danach neu messen
    document.fonts.ready.then(() => ScrollTrigger.refresh());

    const goTo = (label: string) => {
      if (!st) return;
      gsap.to(window, { scrollTo: st.labelToScroll(label), duration: 0.9, ease: 'power2.inOut' });
    };
    dots.forEach((d) => d.addEventListener('click', () => goTo(`p${d.dataset.go}`)));
    window.addEventListener('resize', placeNotes);
  }
</script>
