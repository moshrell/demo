---
/**
 * Start der Seite: wer wir sind und was wir bauen. Foto fertiges Haus (Tag), H1, drei Fakten.
 * Kein Formular hier: der Grundstücks-Check folgt als eigener Block (#check).
 * GSAP einmalig beim Laden: H1 zeilenweise (SplitText), Foto wächst von unten (clip-path). Ohne JS / reduced-motion alles sofort sichtbar.
 */
import site from '../data/site.json';
import { has, src, srcset } from '../lib/img';
const base = import.meta.env.BASE_URL;
const img = 'phase-6-tag';
---
<section class="hf" aria-labelledby="hf-h" data-hf>
  <div class="hf__txt">
    <p class="mono hf__k">Bauunternehmen · {site.address.city} · seit {site.founded}</p>
    <h1 id="hf-h" data-hf-h>Wir bauen Ihr Haus im Calenberger Land.</h1>
    <p class="hf__lead">Neubau, Anbau und Sanierung mit eigenen Maurerkolonnen. Ein Ansprechpartner bis zum Schlüssel, Zahlung nur nach erledigtem Bauabschnitt.</p>
    <p class="hf__cta">
      <a class="btn btn--primary" href={`${base}anfrage/`}>Projekt anfragen</a>
      <a class="btn" href={`${base}leistungen/`}>Leistungen &amp; Preise</a>
    </p>
    <ul class="hf__facts mono" aria-label="Fakten zur Firma">
      <li><b>{site.founded}</b><span>gegründet</span></li>
      <li><b>{site.team}</b><span>Mitarbeiter</span></li>
      <li><b>{site.crews}</b><span>eigene Kolonnen</span></li>
    </ul>
    <p class="hf__check"><a class="link-arrow" href="#check">Passt Ihr Haus auf Ihr Grundstück? Jetzt prüfen</a></p>
  </div>
  {has(img) && (
    <figure class="hf__fig" data-hf-fig>
      <img src={src(img)} srcset={srcset(img)} sizes="(min-width: 60rem) 50vw, 100vw" alt="Einfamilienhaus mit rotem Klinker und Satteldach, fertig gebaut, am Tag" width="896" height="1200" fetchpriority="high" decoding="async" />
    </figure>
  )}
</section>

<style>
  .hf { display: grid; grid-template-columns: minmax(0, 1fr); background: var(--color-paper); }
  .hf__fig { margin: 0; order: -1; height: clamp(15rem, 44svh, 28rem); background: var(--color-paper-3); overflow: hidden; }
  .hf__fig img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; display: block; }
  .hf__txt { padding: var(--space-lg) var(--gutter) var(--space-xl); display: grid; gap: var(--space-md); align-content: start; min-width: 0; }
  .hf__k { color: var(--color-accent); }
  .hf h1 { font-size: clamp(1.85rem, 1.2rem + 3.4vw, 3.4rem); line-height: 1.03; }
  .hf__lead { font-size: var(--text-base); max-width: var(--measure); color: var(--color-ink-2); }
  .hf__cta { display: none; gap: var(--space-sm); flex-wrap: wrap; margin: var(--space-xs) 0 0; }
  .hf__facts { list-style: none; margin: var(--space-xs) 0 0; padding: var(--space-md) 0 0; border-top: 1px solid var(--color-rule); display: flex; gap: var(--space-lg); flex-wrap: wrap; }
  .hf__facts li { display: grid; gap: 2px; }
  .hf__facts b { font-size: 1.5rem; line-height: 1; font-weight: 700; color: var(--color-ink); }
  .hf__facts span { color: var(--color-ink-2); font-size: 0.7rem; }
  .hf__check { margin: 0; }

  @media (min-width: 64rem) { .hf__cta { display: flex; } }
  @media (min-width: 60rem) {
    .hf { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: min(calc(100svh - var(--header-h)), 47.5rem); }
    .hf__fig { order: 0; height: auto; }
    .hf__txt { align-content: center; padding-block: var(--space-xl); padding-left: max(var(--gutter), calc((100vw - 76rem) / 2 + var(--gutter))); padding-right: var(--space-xl); gap: var(--space-lg); }
    .hf__lead { font-size: var(--text-lg); }
  }
  /* Telefon quer: Platz knapp, Text links, Foto rechts */
  @media (max-width: 59.99rem) and (orientation: landscape) and (max-height: 520px) {
    .hf { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); min-height: calc(100svh - var(--header-h)); }
    .hf__fig { order: 0; height: auto; }
    .hf__txt { align-content: center; padding-block: var(--space-md); gap: var(--space-sm); }
    .hf h1 { font-size: 1.7rem; }
    .hf__lead, .hf__k { display: none; }
    .hf__cta { display: flex; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  const root = document.querySelector<HTMLElement>('[data-hf]');
  if (root && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    gsap.registerPlugin(SplitText);
    const fig = root.querySelector<HTMLElement>('[data-hf-fig]');
    const h = root.querySelector<HTMLElement>('[data-hf-h]');
    if (fig) gsap.fromTo(fig, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.9, ease: 'power2.out', clearProps: 'clipPath' });
    if (h) {
      const wait = Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 800))]);
      wait.then(() => {
        const split = SplitText.create(h, { type: 'lines', mask: 'lines', aria: 'auto' });
        gsap.from(split.lines, { yPercent: 105, duration: 0.6, ease: 'power3.out', stagger: 0.08, onComplete: () => split.revert() });
      });
    }
  }
</script>
