---
import Base from '../layouts/Base.astro';
import typen from '../data/haustypen.json';
const base = import.meta.env.BASE_URL;
---
<Base title="Grundstücks-Check · Passt Ihr Haus auf Ihr Grundstück? · Thielking Bau" description="Adresse eingeben, Flurstück aus dem Liegenschaftskataster Niedersachsen laden und prüfen, ob Ihr Haus mit Grenzabstand passt. Mit Kostenrahmen." current="grundstueck">
  <section class="gc" data-gc>
    <div class="wrap gc__head" data-head>
      <h1>Grundstücks-Check</h1>
      <p class="lead" data-lead>Orientierung in zwei Minuten. Keine Baugenehmigung.</p>
    </div>

    <!-- Schritt 1: Grundstück -->
    <div class="wrap gc__find" data-find>
      <form class="sheet gc__form" data-search novalidate>
        <p class="sheet__hd mono"><span>1 · Grundstück</span><span>Niedersachsen</span></p>
        <div class="sheet__bd stack">
          <div class="field">
            <label for="gc-addr">Adresse des Grundstücks</label>
            <input id="gc-addr" name="addr" type="text" autocomplete="street-address" placeholder="z. B. Musterstraße 12, 30989 Gehrden" />
          </div>
          <button class="btn btn--primary gc__go" type="submit">Grundstück suchen</button>
          <p class="gc__privacy">Beim Suchen geht die Adresse an die OpenStreetMap-Suche (Photon, ersatzweise Nominatim) und die Koordinaten an das Landesamt LGLN. Wir speichern nichts. <a href={`${base}datenschutz/#grundstueck`} target="_blank" rel="noopener">Datenschutz</a></p>
          <p class="gc__msg" data-msg role="status" aria-live="polite"></p>
          <ul class="gc__hits" data-hits hidden></ul>
          <div class="gc__alt">
            <button class="btn" type="button" data-manual-open>Maße selbst eingeben</button>
            <button class="btn" type="button" data-example>Beispielgrundstück</button>
          </div>
          <div class="gc__manual" data-manual hidden>
            <div class="field"><label for="gc-w">Breite an der Straße (m)</label><input id="gc-w" type="number" inputmode="decimal" min="8" max="80" step="0.5" placeholder="z. B. 20" /></div>
            <div class="field"><label for="gc-d">Tiefe (m)</label><input id="gc-d" type="number" inputmode="decimal" min="8" max="120" step="0.5" placeholder="z. B. 32" /></div>
            <button class="btn btn--ink" type="button" data-manual-go>Grundstück zeichnen</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Bestand: nur wenn auf dem Flurstück schon Gebäude stehen -->
    <div class="wrap gc__bestand" data-bestand-ask hidden>
      <fieldset class="sheet gc__ask">
        <legend class="sheet__hd mono"><span>Auf dem Grundstück steht schon ein Gebäude</span></legend>
        <div class="sheet__bd stack">
          <p>Was haben Sie vor?</p>
          <div class="gc__asks">
            <label class="gc__askcard"><input type="radio" name="bestand-ask" value="bleibt" /><span><b>Bestand bleibt</b><small>Ich plane einen Anbau (Bestand: bleibt stehen).</small></span></label>
            <label class="gc__askcard"><input type="radio" name="bestand-ask" value="abriss" /><span><b>Abriss und Neubau</b><small>Das Gebäude wird abgerissen, ein neues Haus entsteht.</small></span></label>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="gc__work" data-work hidden>
      <div class="wrap">
        <nav class="gc__steps mono" aria-label="Schritte">
          <span class="is-done">✓ 1 Grundstück</span>
          <button type="button" data-goto="2">2 Haus</button>
          <button type="button" data-goto="3">3 Ergebnis</button>
        </nav>
      </div>
      <div class="wrap gc__grid">
        <div class="gc__planwrap">
          <figure class="gc__plan">
            <p class="gc__badge mono" data-badge aria-hidden="true"></p>
            <svg data-svg role="img" aria-labelledby="gc-svg-t">
              <title id="gc-svg-t">Lageplan des Grundstücks mit Haus und Grenzabstand</title>
              <g data-neighbors></g>
              <polygon class="gc__parcel" data-parcel />
              <g data-buildings></g>
              <g data-dims></g>
              <path class="gc__zone" data-zone />
              <g class="gc__house" data-house tabindex="0" role="button" aria-label="Haus verschieben: ziehen oder Pfeiltasten">
                <polygon data-house-poly />
                <line class="gc__ridge" data-ridge />
              </g>
              <line class="gc__gap" data-gap />
              <g data-handles></g>
              <g class="gc__north" data-north><path d="M0,-9 L5,6 L0,3 L-5,6 Z" /><text y="-12" text-anchor="middle">N</text></g>
            </svg>
            <div class="gc__tools" role="toolbar" aria-label="Werkzeuge" aria-orientation="vertical">
              <button class="gc__tool" type="button" data-rot="-15" aria-label="Haus 15 Grad nach links drehen" title="Haus 15 Grad nach links drehen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.6-5.9M4 4v5h5"/></svg></button>
              <button class="gc__tool" type="button" data-rot="15" aria-label="Haus 15 Grad nach rechts drehen" title="Haus 15 Grad nach rechts drehen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"/></svg></button>
              <button class="gc__tool" type="button" data-align aria-label="An Grenze ausrichten" title="An Grenze ausrichten"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17 17 3M7 21 21 7M3 9 9 3"/></svg></button>
              <button class="gc__tool" type="button" data-edit aria-pressed="false" aria-label="Ecken der Grenze anpassen" title="Ecken der Grenze anpassen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7l12 3-2 9H7z"/><circle cx="6" cy="7" r="2" class="f"/><circle cx="18" cy="10" r="2" class="f"/><circle cx="16" cy="19" r="2" class="f"/><circle cx="7" cy="19" r="2" class="f"/></svg></button>
              <button class="gc__tool" type="button" data-reset hidden aria-label="Grenze zurücksetzen" title="Grenze zurücksetzen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3"/></svg></button>
            </div>
            <p class="gc__hint mono" data-hint>Haus ziehen</p>
          </figure>
        </div>

        <div class="gc__side">
          <p class="gc__meta"><span class="mono" data-meta></span><button class="gc__link" type="button" data-new>Anderes Grundstück</button></p>

          <div data-step="2" class="gc__step">
            <fieldset class="gc__size">
              <legend>2 · Haus</legend>
              <div class="gc__sl"><label for="gc-bw">Breite</label><input id="gc-bw" type="range" min="3" max="30" step="0.5" data-bw /><output class="mono" data-bw-o for="gc-bw"></output></div>
              <div class="gc__sl"><label for="gc-bd">Tiefe</label><input id="gc-bd" type="range" min="3" max="30" step="0.5" data-bd /><output class="mono" data-bd-o for="gc-bd"></output></div>
              <div class="gc__fl" role="radiogroup" aria-label="Geschosse">
                <span class="gc__fl-l">Geschosse</span>
                <div class="chips">
                  {[['1', '1'], ['1.5', '1,5'], ['2', '2'], ['3', '3']].map(([v, l]) => <label class="chip"><input type="radio" name="fl" value={v} /><span>{l}</span></label>)}
                </div>
              </div>
              <p class="gc__wohn-o mono" data-wohn-o></p>
            </fieldset>

            <fieldset class="gc__types">
              <legend>Bauart</legend>
              <div class="chips">
                {typen.typen.map((t, i) => (
                  <label class="chip"><input type="radio" name="typ" value={t.id} checked={i === 1} /><span>{t.name}</span></label>
                ))}
              </div>
              <p class="gc__typenote muted" data-typenote></p>
            </fieldset>

            <fieldset class="gc__types" data-bestand-switch hidden>
              <legend>Bestand</legend>
              <div class="chips">
                <label class="chip"><input type="radio" name="bestand" value="bleibt" /><span>Bleibt stehen</span></label>
                <label class="chip"><input type="radio" name="bestand" value="abriss" /><span>Abriss</span></label>
              </div>
            </fieldset>
          </div>

          <div data-step="3" class="gc__step">
            <div class="gc__result sheet" data-result>
              <p class="sheet__hd mono"><span>3 · Ergebnis</span><span data-verdict-short>—</span></p>
              <div class="sheet__bd">
                <p class="gc__verdict" data-verdict></p>
                <dl class="gc__facts">
                  <div><dt>Grundstück</dt><dd data-f-area>—</dd></div>
                  <div><dt>Haus (Grundfläche)</dt><dd data-f-house>—</dd></div>
                  <div><dt>Bebauung (GRZ)</dt><dd data-f-grz>—</dd></div>
                  <div><dt>Kleinster Abstand zur Grenze</dt><dd data-f-gap>—</dd></div>
                </dl>
              </div>
            </div>

            <div class="gc__cost sheet" data-cost>
              <p class="sheet__hd mono"><span>Kostenrahmen</span><span>Richtwert</span></p>
              <div class="sheet__bd stack">
                <div class="chips" role="radiogroup" aria-label="Leistung">
                  <label class="chip"><input type="radio" name="art" value="schluesselfertig" checked /><span>Schlüsselfertig</span></label>
                  <label class="chip"><input type="radio" name="art" value="rohbau" /><span>Nur Rohbau</span></label>
                </div>
                <div class="gc__row">
                  <div class="field"><label for="gc-wohn">Wohnfläche (m²)</label><input id="gc-wohn" type="number" inputmode="numeric" min="20" max="900" step="5" data-wohn /></div>
                  <div class="field"><label for="gc-aus">Ausstattung</label>
                    <select id="gc-aus" data-aus>{typen.ausstattung.map((a) => <option value={a.id}>{a.name}</option>)}</select>
                  </div>
                </div>
                <p class="gc__fine muted">Wohnfläche aus Ihrer Größe geschätzt, anpassbar.</p>
                <label class="gc__check"><input type="checkbox" data-keller /> <span>mit Keller</span></label>
                <p class="gc__sum"><span>Summe</span><strong data-sum>—</strong></p>
                <p class="gc__fine muted">Richtwert inkl. 19 % MwSt., ohne Grundstück, Baunebenkosten und Außenanlagen. Verbindlich ist nur unser schriftliches Angebot.</p>
              </div>
            </div>
            <div class="gc__cost gc__noprice sheet" data-noprice hidden>
              <p class="sheet__hd mono"><span>Kostenrahmen</span><span>nach Anfrage</span></p>
              <div class="sheet__bd"><p>Kostenrahmen nach Ihrer Anfrage: schriftlich, innerhalb von zwei Werktagen.</p></div>
            </div>

            <div class="gc__send" data-send-box>
              <a class="btn btn--primary" href={`${base}anfrage/?von=grundstueck`} data-send>Mit diesem Grundstück anfragen</a>
            </div>
            <p class="gc__law">Orientierung, keine Baugenehmigung. Was gebaut werden darf, regelt der Bebauungsplan Ihrer Gemeinde. Grenzabstand nach § 5 Abs. 2 NBauO: 0,4 × Wandhöhe, mindestens 3 m (vereinfacht gerechnet). Den Bebauungsplan prüfen wir gern mit Ihnen.</p>
            <p class="mono gc__src" data-src hidden>Quelle Flurstücke und Gebäude: LGLN, Liegenschaftskataster, CC BY 4.0 · Adresssuche: © OpenStreetMap-Mitwirkende (ODbL) via Photon / Nominatim</p>
          </div>
        </div>
      </div>
    </div>

    <nav class="bar gc__bar" data-gcbar aria-label="Check-Ergebnis" hidden>
      <span class="gc__bar-v" data-bar-v role="status"></span>
      <a class="btn btn--primary" href="#" data-bar-go>Weiter: Kosten</a>
    </nav>
    <div class="gc__proxy" data-proxy aria-hidden="true"></div>
    <script type="application/json" data-typen set:html={JSON.stringify(typen)} />
  </section>
</Base>

<style>
  .gc { padding-block: var(--space-xl) var(--space-2xl); }
  .gc__head { display: grid; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .gc__form { max-width: 40rem; }
  .gc__go { width: 100%; }
  @media (min-width: 40rem) { .gc__go { width: auto; } }
  .gc__privacy { font-size: var(--text-sm); color: var(--color-ink-2); }
  .gc__msg:empty { display: none; }
  .gc__msg { font-weight: 600; }
  .gc__msg[data-state='err'] { color: var(--color-bad); }
  .gc__hits { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xs); }
  .gc__hits button { width: 100%; text-align: left; min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border: 1px solid var(--color-rule); border-radius: var(--radius); background: var(--color-paper); cursor: pointer; }
  .gc__alt { display: flex; flex-wrap: wrap; gap: var(--space-sm); padding-top: var(--space-sm); border-top: 1px solid var(--color-rule); }
  .gc__manual { display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
  .gc__manual[hidden] { display: none; }
  .gc__manual .btn { grid-column: 1 / -1; }

  .gc__head h1 { font-size: var(--text-2xl); }
  .gc__head .lead { margin: 0; }
  .gc.is-work .gc__head { margin-bottom: var(--space-sm); }
  .gc.is-work .gc__head h1 { font-size: var(--text-xl); }
  .gc.is-work .gc__head .lead { display: none; }

  .gc__ask { border: 1px solid var(--color-rule); margin: 0; padding: 0; min-width: 0; max-width: 40rem; }
  .gc__ask legend { padding: var(--space-sm) var(--space-md); }
  .gc__asks { display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40rem) { .gc__asks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gc__askcard { display: block; cursor: pointer; }
  .gc__askcard input { position: absolute; opacity: 0; pointer-events: none; }
  .gc__askcard span { display: grid; gap: var(--space-xs); min-height: 4.5rem; padding: var(--space-md); border: 2px solid var(--color-ink); border-radius: var(--radius); background: var(--color-chalk); }
  .gc__askcard small { color: var(--color-ink-2); font-size: var(--text-sm); }
  .gc__askcard input:checked + span, .gc__askcard:hover span { background: var(--color-ink); color: var(--color-chalk); }
  .gc__askcard input:checked + span small, .gc__askcard:hover span small { color: oklch(86% 0.02 262); }
  .gc__askcard input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 2px; }

  .gc__steps { display: flex; gap: var(--space-sm) var(--space-md); flex-wrap: nowrap; align-items: center; margin-bottom: var(--space-xs); font-size: var(--text-sm); }
  .gc__steps > * { white-space: nowrap; }
  @media (min-width: 30rem) { .gc__steps { font-size: inherit; } }
  .gc__steps > * { min-height: 2.75rem; display: inline-flex; align-items: center; padding: 0; background: none; border: 0; border-bottom: 2px solid transparent; font: inherit; color: var(--color-ink-2); }
  .gc__steps button { cursor: pointer; }
  .gc__steps .is-done { color: var(--color-ok); }
  .gc__steps .is-active { color: var(--color-ink); border-bottom-color: var(--color-accent); font-weight: 700; }

  .gc__grid { display: grid; gap: var(--space-md); grid-template-columns: minmax(0, 1fr); }
  .gc__planwrap { position: sticky; top: calc(var(--header-h) + 2px); z-index: 3; margin-inline: calc(var(--gutter) * -1); }
  .gc__plan { margin: 0; position: relative; background: var(--color-night); overflow: hidden; height: clamp(14rem, 44svh, 30rem); width: 100%; box-shadow: 0 8px 14px -10px oklch(19% 0.045 265 / 0.6); }
  @media (min-width: 60rem) {
    .gc__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: start; gap: var(--space-lg); }
    .gc__planwrap { top: calc(var(--header-h) + var(--space-md)); margin-inline: 0; }
    .gc__plan { height: auto; aspect-ratio: 5 / 4; max-height: calc(100svh - var(--header-h) - var(--space-xl)); border-radius: var(--radius); box-shadow: none; }
  }
  /* Telefon quer: Plan links, Bedienung rechts */
  @media (max-width: 59.99rem) and (orientation: landscape) and (max-height: 520px) {
    .gc__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; }
    .gc__planwrap { top: calc(var(--header-h) + var(--space-xs)); margin-inline: 0; }
    .gc__plan { height: calc(100svh - var(--header-h) - var(--space-md)); border-radius: var(--radius); }
  }
  .gc__badge { position: absolute; left: var(--space-sm); top: var(--space-sm); z-index: 2; margin: 0; padding: 0.35rem 0.6rem; border-radius: 2px; background: var(--color-chalk); color: var(--color-ink); font-size: 0.72rem; pointer-events: none; }
  .gc__badge:empty { display: none; }
  .gc__badge[data-state='ok'] { background: oklch(40% 0.1 150); color: var(--color-chalk); }
  .gc__badge[data-state='bad'] { background: var(--color-bad); color: var(--color-chalk); }
  .gc__plan svg { width: 100%; height: 100%; display: block; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .gc__parcel { fill: oklch(28% 0.045 265); stroke: var(--color-chalk); stroke-width: 0.25; stroke-dasharray: 1 0.6; vector-effect: non-scaling-stroke; }
  :global(.gc__nb) { fill: transparent; stroke: oklch(55% 0.03 262); stroke-width: 1; vector-effect: non-scaling-stroke; cursor: pointer; }
  :global(.gc__nb:hover) { fill: oklch(30% 0.04 265); }
  :global(.gc__bld) { fill: oklch(50% 0.02 262); stroke: none; }
  :global(.gc__bld--abriss) { fill: oklch(50% 0.02 262 / 0.18); stroke: oklch(70% 0.02 262); stroke-width: 1; stroke-dasharray: 4 3; vector-effect: non-scaling-stroke; }
  :global(.gc__bldlbl) { fill: oklch(80% 0.02 262); font-family: var(--font-mono); }
  .gc__zone { fill: oklch(52% 0.11 150 / 0.2); stroke: oklch(72% 0.12 150); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .gc__zone.is-bad { fill: oklch(50% 0.17 28 / 0.25); stroke: oklch(65% 0.17 28); }
  .gc__house { cursor: grab; outline: none; }
  .gc__house polygon { fill: var(--color-accent); stroke: var(--color-chalk); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .gc__house:focus-visible polygon { stroke: var(--focus); stroke-width: 3; }
  .gc__house.is-overlap polygon { fill: oklch(55% 0.17 28); }
  .gc__ridge { stroke: var(--color-chalk); stroke-width: 1; stroke-dasharray: 4 3; vector-effect: non-scaling-stroke; }
  .gc__gap { stroke: var(--color-lamp); stroke-width: 2; vector-effect: non-scaling-stroke; }
  :global(.gc__dim) { fill: oklch(85% 0.015 262); font-family: var(--font-mono); }
  :global(.gc__handle) { fill: var(--color-chalk); stroke: var(--color-accent); stroke-width: 2; vector-effect: non-scaling-stroke; cursor: move; }
  .gc__north path { fill: var(--color-chalk); }
  .gc__north text { fill: var(--color-chalk); font-family: var(--font-mono); font-size: 7px; }

  .gc__tools { position: absolute; right: var(--space-sm); bottom: var(--space-sm); z-index: 2; display: grid; gap: 6px; }
  .gc__tool { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; padding: 0; border: 1px solid oklch(98% 0.003 90 / 0.45); border-radius: var(--radius); background: oklch(19% 0.045 265 / 0.78); color: var(--color-chalk); cursor: pointer; }
  .gc__tool[hidden] { display: none; }
  .gc__tool svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .gc__tool svg .f { fill: currentColor; stroke: none; }
  .gc__tool[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); }
  .gc__tool:focus-visible { outline: 3px solid var(--color-lamp); outline-offset: 2px; }
  @media (hover: hover) { .gc__tool:hover { background: var(--color-chalk); color: var(--color-ink); } }
  .gc__hint { position: absolute; left: var(--space-sm); bottom: var(--space-sm); z-index: 2; margin: 0; max-width: calc(100% - 4.5rem); padding: 0.3rem 0.55rem; border-radius: 2px; background: oklch(19% 0.045 265 / 0.78); color: var(--color-chalk); font-size: 0.7rem; pointer-events: none; }
  .gc__meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin: 0; color: var(--color-ink-2); flex-wrap: wrap; }
  .gc__link { background: none; border: 0; padding: 0; min-height: 2.75rem; font: inherit; font-weight: 650; color: var(--color-ink); text-decoration: underline; cursor: pointer; }
  .gc__step { display: grid; gap: var(--space-md); scroll-margin-top: calc(var(--header-h) + 52svh); }
  .gc__bar { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .gc__bar-v { color: var(--color-chalk); font-weight: 650; min-width: 0; }
  .gc__bar .btn { width: auto; }

  .gc__size { border: 1px solid var(--color-rule); border-radius: var(--radius); background: var(--color-chalk); margin: var(--space-md) 0 0; padding: var(--space-sm) var(--space-md) var(--space-md); min-width: 0; display: grid; gap: var(--space-xs); }
  .gc__size legend { font-weight: 700; padding: 0 var(--space-xs); }
    .gc__sl { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr) 4rem; align-items: center; gap: var(--space-sm); min-height: 2.75rem; }
  .gc__sl input[type='range'] { width: 100%; min-width: 0; height: 2.75rem; accent-color: var(--color-accent); touch-action: pan-y; margin: 0; }
  .gc__sl output { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .gc__fl { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-sm); }
  .gc__fl-l { flex: none; min-width: 5.25rem; }
  .gc__fl .chip span { padding: 0.4rem 0.85rem; min-width: 2.75rem; justify-content: center; }
  .gc__wohn-o { color: var(--color-ink-2); }
  .gc__side { display: grid; gap: var(--space-md); min-width: 0; }
  .gc__types { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: var(--space-sm); }
  .gc__types legend { font-weight: 700; margin-bottom: var(--space-sm); padding: 0; }
  .gc__types[hidden] { display: none; }
  .gc__typenote { font-size: var(--text-sm); }
  .gc__verdict { font-weight: 650; margin-bottom: var(--space-sm); }
  .gc__verdict[data-state='ok'] { color: var(--color-ok); }
  .gc__verdict[data-state='bad'] { color: var(--color-bad); }
  .gc__facts { margin: 0; display: grid; }
  .gc__facts div { display: flex; justify-content: space-between; gap: var(--space-md); padding: var(--space-xs) 0; border-top: 1px solid var(--color-rule); font-size: 0.95rem; }
  .gc__facts dt { color: var(--color-ink-2); }
  .gc__facts dd { margin: 0; font-variant-numeric: tabular-nums; text-align: right; font-weight: 600; }
  .gc__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-sm); }
  .gc__check { display: inline-flex; align-items: center; gap: var(--space-sm); min-height: 2.75rem; cursor: pointer; }
  .gc__check input { width: 1.3rem; height: 1.3rem; accent-color: var(--color-accent); }
  .gc__sum { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); padding-top: var(--space-sm); border-top: 1.5px solid var(--color-ink); }
  .gc__sum strong { font-size: clamp(1.15rem, 0.9rem + 1.2vw, 1.5rem); font-variant-numeric: tabular-nums; text-align: right; }
  .gc__fine, .gc__law { font-size: var(--text-sm); }
  .gc__law { color: var(--color-ink-2); }
  .gc__send { display: grid; gap: var(--space-sm); }
  .gc__src { color: var(--color-ink-2); font-size: 0.68rem; }
  .gc__proxy { position: fixed; left: 0; top: 0; width: 1px; height: 1px; pointer-events: none; visibility: hidden; }
</style>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';
  import { InertiaPlugin } from 'gsap/InertiaPlugin';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import * as G from '../scripts/geo';
  import type { Pt, Parcel, Place } from '../scripts/geo';
  gsap.registerPlugin(Draggable, InertiaPlugin, DrawSVGPlugin);

  const root = document.querySelector<HTMLElement>('[data-gc]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const T = JSON.parse($('[data-typen]').textContent || '{}');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmtM = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' m';
  const fmtA = (n: number) => Math.round(n).toLocaleString('de-DE') + ' m²';
  const eur = (n: number) => (Math.round(n / 1000) * 1000).toLocaleString('de-DE') + ' €';
  const SVGNS = 'http://www.w3.org/2000/svg';
  const KEY = 'rf:grundstueck';

  interface State {
    source: 'kataster' | 'manuell' | 'beispiel';
    place?: string; parcel: Parcel; original: Pt[]; buildings: Pt[][]; neighbors: Parcel[];
    typ: string; w: number; d: number; fl: number; sized: boolean; wohnManual: boolean; cx: number; cy: number; deg: number;
    art: string; wohn: number; aus: string; keller: boolean;
    hasBestand?: boolean; bestand?: 'bleibt' | 'abriss' | null;
  }
  let S: State | null = null;

  /* ---------- Speicher ---------- */
  const save = () => { try { if (S) sessionStorage.setItem(KEY, JSON.stringify(S)); } catch {} };
  const restore = (): State | null => { try { const r = sessionStorage.getItem(KEY); return r ? JSON.parse(r) : null; } catch { return null; } };

  /* ---------- Schritt 1 ---------- */
  const form = $<HTMLFormElement>('[data-search]');
  const msg = $('[data-msg]');
  const hits = $('[data-hits]');
  const say = (t: string, err = false) => { msg.textContent = t; msg.dataset.state = err ? 'err' : ''; };
  let ctrl: AbortController | null = null;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = (form.elements.namedItem('addr') as HTMLInputElement).value.trim();
    if (q.length < 5) { say('Bitte Straße, Hausnummer und Ort eingeben.', true); return; }
    ctrl?.abort(); ctrl = new AbortController();
    hits.hidden = true; say('Suche Adresse …');
    try {
      const list = await G.geocode(q, ctrl.signal);
      if (!list.length) { say('Adresse in Niedersachsen nicht gefunden. Prüfen Sie die Schreibweise oder geben Sie die Maße selbst ein.', true); return; }
      if (list.length === 1) return pick(list[0]);
      say('Welche Adresse meinen Sie?');
      hits.replaceChildren(...list.map((p) => { const li = document.createElement('li'); const b = document.createElement('button'); b.type = 'button'; b.textContent = p.label; b.addEventListener('click', () => pick(p)); li.append(b); return li; }));
      hits.hidden = false;
    } catch (err) {
      if ((err as Error).name !== 'AbortError') say('Die Suche ist gerade nicht erreichbar. Geben Sie die Maße selbst ein.', true);
    }
  });

  async function pick(p: Place) {
    hits.hidden = true;
    say(`Lade Flurstück für ${p.label} …`);
    ctrl?.abort(); ctrl = new AbortController();
    try {
      const [{ parcels, main }, bld] = await Promise.all([G.loadParcels(p, ctrl.signal), G.loadBuildings(p, ctrl.signal).catch(() => [])]);
      if (!main) { say('Für diese Adresse liegt kein Flurstück vor. Geben Sie die Maße selbst ein.', true); return; }
      say('');
      start({ source: 'kataster', place: p.label, parcel: main, neighbors: parcels.filter((x) => x.id !== main.id), buildings: bld });
    } catch (err) {
      if ((err as Error).name !== 'AbortError') say('Das Kataster antwortet gerade nicht. Versuchen Sie es gleich noch einmal oder geben Sie die Maße selbst ein.', true);
    }
  }

  $('[data-manual-open]').addEventListener('click', () => { const m = $('[data-manual]'); m.hidden = !m.hidden; if (!m.hidden) $<HTMLInputElement>('#gc-w').focus(); });
  $('[data-manual-go]').addEventListener('click', () => {
    const w = Number($<HTMLInputElement>('#gc-w').value.replace(',', '.')), d = Number($<HTMLInputElement>('#gc-d').value.replace(',', '.'));
    if (!(w >= 8 && w <= 80 && d >= 8 && d <= 120)) { say('Bitte Breite (8–80 m) und Tiefe (8–120 m) eingeben.', true); return; }
    say('');
    const ring: Pt[] = [[-w / 2, -d / 2], [w / 2, -d / 2], [w / 2, d / 2], [-w / 2, d / 2]];
    start({ source: 'manuell', parcel: { id: 'manuell', ring, area: w * d, label: '', gemarkung: '', flur: '', nr: '', use: '' }, neighbors: [], buildings: [] });
  });
  $('[data-example]').addEventListener('click', () => {
    // Erfundenes Grundstück (keine echte Adresse), leicht schief wie im Neubaugebiet
    const ring: Pt[] = [[-11.5, -17], [10.8, -18.6], [12.6, 16.9], [-1.5, 18.2], [-12.4, 17.4]];
    start({ source: 'beispiel', place: 'Beispielgrundstück (erfunden)', parcel: { id: 'beispiel', ring, area: G.area(ring), label: 'Beispielgrundstück', gemarkung: 'Beispiel', flur: '1', nr: '42/7', use: 'Wohnbaufläche' }, neighbors: [], buildings: [] });
  });
  $('[data-new]').addEventListener('click', () => {
    try { sessionStorage.removeItem(KEY); } catch {}
    S = null; work.hidden = true; askBox.hidden = true; root.classList.remove('is-work'); setBars(false); $('[data-find]').hidden = false; $<HTMLInputElement>('#gc-addr').focus();
  });

  /* ---------- Schritt 2 ---------- */
  const work = $('[data-work]');
  const svg = $<SVGSVGElement>('[data-svg]');
  const parcelEl = $<SVGPolygonElement>('[data-parcel]');
  const zoneEl = $<SVGPathElement>('[data-zone]');
  const houseG = $<SVGGElement>('[data-house]');
  const housePoly = $<SVGPolygonElement>('[data-house-poly]');
  const ridge = $<SVGLineElement>('[data-ridge]');
  const gapEl = $<SVGLineElement>('[data-gap]');
  const dimsG = $<SVGGElement>('[data-dims]');
  const bldG = $<SVGGElement>('[data-buildings]');
  const nbG = $<SVGGElement>('[data-neighbors]');
  const handlesG = $<SVGGElement>('[data-handles]');
  const north = $<SVGGElement>('[data-north]');
  const proxy = $('[data-proxy]');
  const pts = (r: Pt[]) => r.map((p) => `${p[0].toFixed(2)},${p[1].toFixed(2)}`).join(' ');
  const typ = () => T.typen.find((t: any) => t.id === S!.typ) || T.typen[1];
  // Maße kommen vom Nutzer (Schieberegler), die Bauart liefert Regeln und Startwerte
  const hh = () => (typ().id === 'anbau' ? typ().h : T.hoehe[String(S!.fl)] || typ().h);
  const wohnEst = () => Math.max(20, Math.round((S!.w * S!.d * S!.fl * T.wohnFaktor) / 5) * 5);
  const setback = () => Math.max(T.abstand.min, T.abstand.faktor * hh());
  let vb = { x: 0, y: 0, w: 100, h: 100 };
  let editing = false;

  function start(p: Pick<State, 'source' | 'place' | 'parcel' | 'neighbors' | 'buildings'>) {
    const c = G.centroid(p.parcel.ring);
    // Ursprung auf den Schwerpunkt legen
    const sh = (r: Pt[]) => r.map(([x, y]) => [x - c[0], y - c[1]] as Pt);
    const parcel = { ...p.parcel, ring: sh(p.parcel.ring) };
    const pre = new URLSearchParams(location.search).get('typ');
    const t = T.typen.find((x: any) => x.id === pre) || T.typen.find((x: any) => x.id === (S?.typ || 'efh'));
    S = {
      source: p.source, place: p.place, parcel, original: parcel.ring.map((q) => [...q] as Pt),
      neighbors: p.neighbors.map((n) => ({ ...n, ring: sh(n.ring) })), buildings: p.buildings.map(sh),
      typ: t.id, w: t.w, d: t.d, fl: t.fl, sized: false, wohnManual: false, cx: 0, cy: 0, deg: alignDeg(parcel.ring),
      art: 'schluesselfertig', wohn: t.wohn, aus: 'solide', keller: false,
    };
    S.wohn = wohnEst();
    S.hasBestand = p.source === 'kataster' && S.buildings.some(isIn);
    S.bestand = null;
    if (S.hasBestand) { showAsk(); return; }
    placeFree();
    open(true);
  }

  /* ---------- Bestand: steht schon ein Gebäude auf dem Flurstück? ---------- */
  const askBox = $('[data-bestand-ask]');
  const isIn = (b: Pt[]) => G.inside(G.centroid(b), S!.parcel.ring);
  const bl = () => (S!.bestand === 'abriss' ? S!.buildings.filter((b) => !isIn(b)) : S!.buildings);
  function showAsk() {
    $('[data-find]').hidden = true; work.hidden = true; askBox.hidden = false;
    root.querySelectorAll<HTMLInputElement>('input[name=bestand-ask]').forEach((r) => (r.checked = false));
    askBox.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }
  function applyBestand() {
    const t0 = typ();
    if (S!.bestand === 'bleibt' && t0.id !== 'anbau') S!.typ = 'anbau';
    else if (S!.bestand === 'abriss' && t0.id === 'anbau') S!.typ = 'efh';
    const t = typ();
    S!.fl = t.fl; if (!S!.sized) { S!.w = t.w; S!.d = t.d; }
    if (!S!.wohnManual) S!.wohn = wohnEst();
  }
  root.querySelectorAll<HTMLInputElement>('input[name=bestand-ask]').forEach((r) => r.addEventListener('change', () => {
    S!.bestand = r.value as 'bleibt' | 'abriss';
    askBox.hidden = true;
    applyBestand(); placeFree(); open(true);
  }));
  root.querySelectorAll<HTMLInputElement>('input[name=bestand]').forEach((r) => r.addEventListener('change', () => {
    S!.bestand = r.value as 'bleibt' | 'abriss';
    applyBestand(); drawStatic();
    const tr = root.querySelector<HTMLInputElement>(`input[name=typ][value="${S!.typ}"]`); if (tr) tr.checked = true;
    placeFree(); render();
  }));

  // Haus parallel zur längsten Grenze (|Winkel| ≤ 45°)
  function alignDeg(r: Pt[]) {
    const a = G.longestEdgeAngle(r);
    return [a, a - 90, a - 180].reduce((b, c) => (Math.abs(c) < Math.abs(b) ? c : b));
  }

  // Haus an eine freie Stelle setzen: Schwerpunkt, sonst Raster absuchen
  function placeFree() {
    if (!S) return;
    const fits = (cx: number, cy: number) => {
      const h = G.rect(cx, cy, S!.w, S!.d, S!.deg);
      return h.every((q) => G.inside(q, S!.parcel.ring)) && !bl().some((b) => G.overlaps(h, b));
    };
    const keep = S.bestand === 'bleibt' ? S.buildings.find(isIn) : undefined;
    const bc = keep ? G.centroid(keep) : null;
    if (!bc && fits(S.cx, S.cy)) return;
    const r = Math.sqrt(G.area(S.parcel.ring));
    let best: Pt | null = null, bestScore = -Infinity;
    for (let x = -r; x <= r; x += 1.5) for (let y = -r; y <= r; y += 1.5) {
      if (!fits(x, y)) continue;
      const h = G.rect(x, y, S.w, S.d, S.deg);
      const score = G.minGap(h, S.parcel.ring).d - Math.hypot(x, y) * 0.05 - (bc ? Math.hypot(x - bc[0], y - bc[1]) * 0.4 : 0);
      if (score > bestScore) { bestScore = score; best = [x, y]; }
    }
    if (best) { S.cx = best[0]; S.cy = best[1]; }
  }

  function open(fresh: boolean) {
    $('[data-find]').hidden = true;
    askBox.hidden = true;
    work.hidden = false;
    root.classList.add('is-work');
    setBars(true);
    const sw = $('[data-bestand-switch]'); sw.hidden = !S!.hasBestand;
    const br = root.querySelector<HTMLInputElement>(`input[name=bestand][value="${S!.bestand}"]`); if (br) br.checked = true;
    $('[data-cost]').hidden = !T.preiseZeigen; $('[data-noprice]').hidden = !!T.preiseZeigen;
    $('[data-src]').hidden = S!.source !== 'kataster';
    const tr = root.querySelector<HTMLInputElement>(`input[name=typ][value="${S!.typ}"]`); if (tr) tr.checked = true;
    (root.querySelector<HTMLInputElement>(`input[name=art][value="${S!.art}"]`)!).checked = true;
    $<HTMLInputElement>('[data-wohn]').value = String(S!.wohn);
    syncSize();
    $<HTMLSelectElement>('[data-aus]').value = S!.aus;
    $<HTMLInputElement>('[data-keller]').checked = S!.keller;
    fitView();
    drawStatic();
    render();
    if (fresh) {
      $('[data-head]').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (!reduce) {
        gsap.fromTo(parcelEl, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.1, ease: 'power2.inOut' });
        gsap.from(houseG, { opacity: 0, duration: 0.4, delay: 0.7 });
      }
    }
  }

  function fitView() {
    const r = S!.parcel.ring;
    const xs = r.map((p) => p[0]), ys = r.map((p) => p[1]);
    const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys);
    const w = maxX - minX, h = maxY - minY;
    const box = svg.getBoundingClientRect();
    const asp = box.width && box.height ? box.width / box.height : 1;
    const fill = 0.84; // Grundstück füllt ca. 85 % der kleineren Seite
    let W = w / fill, H = h / fill;
    if (W / H < asp) W = H * asp; else H = W / asp;
    vb = { x: (minX + maxX) / 2 - W / 2, y: (minY + maxY) / 2 - H / 2, w: W, h: H };
    svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
    const u = vb.w / 300; // Einheit für Text etc.
    north.setAttribute('transform', `translate(${vb.x + vb.w - 14 * u} ${vb.y + 18 * u}) scale(${u})`);
  }
  const unit = () => vb.w / 300;

  function drawStatic() {
    nbG.replaceChildren(...S!.neighbors.map((n) => {
      const el = document.createElementNS(SVGNS, 'polygon');
      el.setAttribute('points', pts(n.ring)); el.setAttribute('class', 'gc__nb');
      el.setAttribute('role', 'button'); el.setAttribute('aria-label', `Nachbar-Flurstück ${n.nr} wählen`);
      el.addEventListener('click', () => { if (!editing) switchParcel(n); });
      return el;
    }));
    const gone = S!.bestand === 'abriss';
    const els: SVGElement[] = S!.buildings.map((b) => { const el = document.createElementNS(SVGNS, 'polygon'); el.setAttribute('points', pts(b)); el.setAttribute('class', gone && isIn(b) ? 'gc__bld--abriss' : 'gc__bld'); return el; });
    if (gone) {
      const b = S!.buildings.find(isIn);
      if (b) { const c = G.centroid(b), t = document.createElementNS(SVGNS, 'text'); t.setAttribute('x', String(c[0])); t.setAttribute('y', String(c[1])); t.setAttribute('text-anchor', 'middle'); t.setAttribute('class', 'gc__bldlbl'); t.setAttribute('font-size', String(7 * unit())); t.textContent = 'Bestand (Abriss)'; els.push(t); }
    }
    bldG.replaceChildren(...els);
  }

  function switchParcel(n: Parcel) {
    const all = [S!.parcel, ...S!.neighbors].filter((x) => x.id !== n.id);
    S!.parcel = n; S!.original = n.ring.map((q) => [...q] as Pt); S!.neighbors = all;
    S!.cx = G.centroid(n.ring)[0]; S!.cy = G.centroid(n.ring)[1];
    placeFree(); fitView(); drawStatic(); render();
  }

  function render() {
    if (!S) return;
    const t = typ(), sb = setback();
    const ring = S.parcel.ring;
    parcelEl.setAttribute('points', pts(ring));
    const house = G.rect(S.cx, S.cy, S.w, S.d, S.deg);
    housePoly.setAttribute('points', pts(house));
    const r = (S.deg * Math.PI) / 180;
    ridge.setAttribute('x1', String(S.cx - Math.cos(r) * S.w * 0.38)); ridge.setAttribute('y1', String(S.cy - Math.sin(r) * S.w * 0.38));
    ridge.setAttribute('x2', String(S.cx + Math.cos(r) * S.w * 0.38)); ridge.setAttribute('y2', String(S.cy + Math.sin(r) * S.w * 0.38));
    const z = G.zone(S.cx, S.cy, S.w, S.d, S.deg, sb);
    zoneEl.setAttribute('d', 'M' + z.map((p) => p.join(',')).join('L') + 'Z');

    const inParcel = house.every((q) => G.inside(q, ring));
    const gap = inParcel ? G.minGap(house, ring) : { d: 0, at: [house[0], house[0]] as [Pt, Pt] };
    const overlap = bl().some((b) => G.overlaps(house, b));
    const area = S.parcel.area || G.area(ring);
    const grz = (S.w * S.d) / area;
    const okGap = gap.d + 0.01 >= sb;
    const dhh = t.id === 'dhh', anbau = t.id === 'anbau';
    const good = inParcel && (okGap || dhh) && (!overlap || anbau) && grz <= T.grzMax + 1e-9;
    zoneEl.classList.toggle('is-bad', !okGap && !dhh);
    houseG.classList.toggle('is-overlap', overlap && !anbau);
    gapEl.setAttribute('x1', String(gap.at[0][0])); gapEl.setAttribute('y1', String(gap.at[0][1]));
    gapEl.setAttribute('x2', String(gap.at[1][0])); gapEl.setAttribute('y2', String(gap.at[1][1]));
    gapEl.style.display = inParcel ? '' : 'none';

    // Kantenlängen
    const u = unit();
    const edges = G.edgeLengths(ring);
    const longest = Math.max(...edges.map((e) => e.L));
    const keepL = [...edges].sort((x, y) => y.L - x.L)[Math.min(5, edges.length - 1)].L;
    dimsG.replaceChildren(...edges.filter((e) => e.L > Math.max(3, longest * 0.18) && e.L >= keepL).map((e) => {
      const tx = document.createElementNS(SVGNS, 'text');
      const mx = (e.a[0] + e.b[0]) / 2, my = (e.a[1] + e.b[1]) / 2;
      const c = G.centroid(ring); const ox = mx - c[0], oy = my - c[1]; const L = Math.hypot(ox, oy) || 1;
      tx.setAttribute('x', String(mx + (ox / L) * 7 * u)); tx.setAttribute('y', String(my + (oy / L) * 7 * u + 3 * u));
      tx.setAttribute('text-anchor', 'middle'); tx.setAttribute('class', 'gc__dim'); tx.setAttribute('font-size', String(8.5 * u));
      tx.textContent = e.L.toFixed(1).replace('.', ',') + ' m';
      return tx;
    }));

    // Ergebnis
    const v = $('[data-verdict]');
    let text = '';
    if (!inParcel) text = 'Das Haus ragt über die Grundstücksgrenze. Verschieben oder drehen Sie es.';
    else if (overlap && !anbau) text = 'Das Haus überschneidet ein bestehendes Gebäude.';
    else if (!okGap && !dhh) text = `Zu eng: an der engsten Stelle ${fmtM(gap.d)} statt ${fmtM(sb)} Abstand.`;
    else if (grz > T.grzMax) text = `Abstände passen, aber die Bebauung (GRZ ${grz.toFixed(2).replace('.', ',')}) liegt über dem üblichen Höchstwert ${String(T.grzMax).replace('.', ',')} in Wohngebieten.`;
    else if (dhh) text = 'Möglich: Die Doppelhaushälfte steht an einer Seite auf der Grenze. Ob das hier zulässig ist, regelt der Bebauungsplan.';
    else if (anbau) text = 'Passt mit Abstand. Ein Anbau wird direkt an den Bestand gesetzt; schieben Sie ihn an das graue Gebäude.';
    else text = `Passt. Überall mindestens ${fmtM(sb)} Abstand zur Grenze.`;
    v.textContent = text; v.dataset.state = good ? 'ok' : 'bad';
    $('[data-verdict-short]').textContent = good ? 'passt' : 'prüfen';
    $('[data-bar-v]').textContent = good ? `✓ passt · ${fmtM(gap.d)}` : !inParcel ? '✕ über der Grenze' : overlap && !anbau ? '✕ Gebäude im Weg' : !okGap && !dhh ? `✕ zu eng · ${fmtM(gap.d)}` : '! prüfen';
    const badge = $('[data-badge]');
    badge.textContent = good ? `✓ passt · ${fmtM(gap.d)} Abstand` : !inParcel ? '✕ über der Grenze' : overlap && !anbau ? '✕ Gebäude im Weg' : !okGap && !dhh ? `✕ zu eng · ${fmtM(gap.d)}` : '! prüfen';
    badge.dataset.state = good ? 'ok' : 'bad';
    $('[data-f-area]').textContent = fmtA(area) + (S.source === 'kataster' && S.parcel.area ? ' (amtlich)' : '');
    $('[data-f-house]').textContent = `${fmtA(S.w * S.d)} · ${String(S.w).replace('.', ',')} × ${String(S.d).replace('.', ',')} m`;
    $('[data-f-grz]').textContent = grz.toFixed(2).replace('.', ',');
    $('[data-f-gap]').textContent = inParcel ? `${fmtM(gap.d)} (nötig ${fmtM(sb)})` : '—';
    $('[data-typenote]').textContent = `${t.note} · Wandhöhe ca. ${String(hh()).replace('.', ',')} m → Abstand ${fmtM(sb)}`;
    const meta = S.source === 'kataster'
      ? `${S.place} · Gemarkung ${S.parcel.gemarkung}, Flur ${S.parcel.flur}, Flurstück ${S.parcel.nr}`
      : S.source === 'beispiel' ? 'Beispielgrundstück (erfunden)' : 'Grundstück nach Ihren Maßen';
    $('[data-meta]').textContent = meta;
    costs();
    save();
  }

  const nf = (n: number) => String(n).replace('.', ',');
  function syncSize() {
    $<HTMLInputElement>('[data-bw]').value = String(S!.w); $<HTMLInputElement>('[data-bd]').value = String(S!.d);
    $('[data-bw-o]').textContent = nf(S!.w) + ' m'; $('[data-bd-o]').textContent = nf(S!.d) + ' m';
    const fr = root.querySelector<HTMLInputElement>(`input[name=fl][value="${S!.fl}"]`); if (fr) fr.checked = true;
    $('[data-wohn-o]').textContent = `Grundfläche ${fmtA(S!.w * S!.d)} · ca. ${S!.wohn} m² Wohnfläche`;
  }
  function sizeChanged() {
    S!.sized = true;
    if (!S!.wohnManual) { S!.wohn = wohnEst(); $<HTMLInputElement>('[data-wohn]').value = String(S!.wohn); }
    syncSize(); render();
  }

  /* ---------- untere Leiste (Telefon) und Schritt-Navigation ---------- */
  const baseBar = document.querySelector<HTMLElement>('nav.bar[aria-label="Schnellkontakt"]');
  const gcBar = $('[data-gcbar]');
  const barGo = $<HTMLAnchorElement>('[data-bar-go]');
  const stepEl = (n: string) => root.querySelector<HTMLElement>(`[data-step="${n}"]`)!;
  const stickyH = () => { const hd = document.querySelector('.hd') as HTMLElement | null; const pl = root.querySelector<HTMLElement>('.gc__planwrap'); const sticky = pl && getComputedStyle(pl).position === 'sticky'; return (hd?.offsetHeight || 0) + (sticky && window.matchMedia('(max-width: 59.99rem)').matches && !window.matchMedia('(orientation: landscape) and (max-height: 520px)').matches ? pl!.offsetHeight : 0) + 8; };
  function setBars(on: boolean) { if (baseBar) baseBar.hidden = on; gcBar.hidden = !on; }
  function toStep(n: string) { const y = stepEl(n).getBoundingClientRect().top + scrollY - stickyH(); window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' }); }
  root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => toStep(b.dataset.goto!)));
  let onStep3 = false;
  function syncSteps() {
    if (work.hidden) return;
    const t3 = stepEl('3').getBoundingClientRect().top;
    const at3 = t3 < window.innerHeight * 0.62;
    root.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => b.classList.toggle('is-active', (b.dataset.goto === '3') === at3));
    if (at3 !== onStep3) { onStep3 = at3; barGo.textContent = at3 ? 'Anfragen' : 'Weiter: Kosten'; }
  }
  barGo.addEventListener('click', (e) => { e.preventDefault(); if (onStep3) $<HTMLAnchorElement>('[data-send]').click(); else toStep('3'); });
  let tick = false;
  window.addEventListener('scroll', () => { if (tick) return; tick = true; requestAnimationFrame(() => { tick = false; syncSteps(); }); }, { passive: true });

  function costs() {
    const t = typ();
    syncSize();
    const art = S!.art, base = t.id === 'anbau' ? T.preise.anbau : art === 'rohbau' ? T.preise.rohbau : T.preise.schluesselfertig;
    const f = (T.ausstattung.find((a: any) => a.id === S!.aus) || { f: 1 }).f;
    const fa = art === 'rohbau' ? 1 : f;
    let lo = S!.wohn * base[0] * fa, hi = S!.wohn * base[1] * fa;
    if (S!.keller && t.id !== 'anbau') { lo += T.preise.keller[0]; hi += T.preise.keller[1]; }
    $('[data-sum]').textContent = T.preiseZeigen ? `${eur(lo)} – ${eur(hi)}` : 'nach Anfrage';
  }

  /* ---------- Bedienung ---------- */
  // Pixel → Meter
  const k = () => vb.w / svg.getBoundingClientRect().width;
  let start0: Pt = [0, 0];
  Draggable.create(proxy, {
    trigger: houseG, type: 'x,y', inertia: !reduce, minimumMovement: 3,
    onPress() { gsap.set(proxy, { x: 0, y: 0 }); this.update(); start0 = [S!.cx, S!.cy]; },
    onDrag() { S!.cx = start0[0] + this.x * k(); S!.cy = start0[1] + this.y * k(); render(); },
    onThrowUpdate() { S!.cx = start0[0] + this.x * k(); S!.cy = start0[1] + this.y * k(); render(); },
  });
  houseG.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 2 : 0.5;
    const m: Record<string, Pt> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
    if (m[e.key]) { e.preventDefault(); S!.cx += m[e.key][0]; S!.cy += m[e.key][1]; render(); }
  });

  root.querySelectorAll<HTMLButtonElement>('[data-rot]').forEach((b) => b.addEventListener('click', () => {
    const to = S!.deg + Number(b.dataset.rot);
    if (reduce) { S!.deg = to; render(); return; }
    gsap.to(S!, { deg: to, duration: 0.3, ease: 'power2.out', onUpdate: render });
  }));
  $('[data-align]').addEventListener('click', () => {
    const a = G.longestEdgeAngle(S!.parcel.ring);
    // nächstliegende Ausrichtung (parallel oder quer)
    const cands = [a, a + 90, a - 90, a + 180, a - 180];
    const to = cands.reduce((b, c) => (Math.abs(((c - S!.deg + 540) % 360) - 180) < Math.abs(((b - S!.deg + 540) % 360) - 180) ? c : b));
    const delta = ((to - S!.deg + 540) % 360) - 180;
    gsap.to(S!, { deg: S!.deg + delta, duration: reduce ? 0 : 0.35, ease: 'power2.out', onUpdate: render });
  });

  // Ecken anpassen
  const editBtn = $<HTMLButtonElement>('[data-edit]');
  const resetBtn = $<HTMLButtonElement>('[data-reset]');
  let handleDrags: Draggable[] = [];
  function buildHandles() {
    handleDrags.forEach((d) => d.kill()); handleDrags = [];
    handlesG.replaceChildren();
    if (!editing) return;
    const u = unit();
    S!.parcel.ring.forEach((p, i) => {
      const c = document.createElementNS(SVGNS, 'circle');
      c.setAttribute('cx', String(p[0])); c.setAttribute('cy', String(p[1])); c.setAttribute('r', String(7 * u));
      c.setAttribute('class', 'gc__handle'); c.setAttribute('tabindex', '0'); c.setAttribute('role', 'button'); c.setAttribute('aria-label', `Ecke ${i + 1} verschieben`);
      handlesG.append(c);
      let s0: Pt = [0, 0];
      const px = document.createElement('div'); px.className = 'gc__proxy'; root.append(px);
      const d = Draggable.create(px, {
        trigger: c, type: 'x,y', minimumMovement: 2,
        onPress() { gsap.set(px, { x: 0, y: 0 }); this.update(); s0 = [...S!.parcel.ring[i]] as Pt; },
        onDrag() {
          const q: Pt = [s0[0] + this.x * k(), s0[1] + this.y * k()];
          S!.parcel.ring[i] = q; c.setAttribute('cx', String(q[0])); c.setAttribute('cy', String(q[1]));
          S!.parcel.area = G.area(S!.parcel.ring); render();
        },
      })[0];
      handleDrags.push(d);
      c.addEventListener('keydown', (e) => {
        const m: Record<string, Pt> = { ArrowLeft: [-0.25, 0], ArrowRight: [0.25, 0], ArrowUp: [0, -0.25], ArrowDown: [0, 0.25] };
        if (!m[e.key]) return; e.preventDefault();
        const q = S!.parcel.ring[i]; q[0] += m[e.key][0]; q[1] += m[e.key][1];
        c.setAttribute('cx', String(q[0])); c.setAttribute('cy', String(q[1])); S!.parcel.area = G.area(S!.parcel.ring); render();
      });
    });
  }
  editBtn.addEventListener('click', () => {
    editing = !editing; editBtn.setAttribute('aria-pressed', String(editing));
    resetBtn.hidden = !editing; houseG.style.pointerEvents = editing ? 'none' : '';
    $('[data-hint]').textContent = editing ? 'Punkte ziehen, dann Ecken-Knopf erneut tippen' : 'Haus ziehen';
    buildHandles();
  });
  resetBtn.addEventListener('click', () => {
    S!.parcel.ring = S!.original.map((q) => [...q] as Pt); S!.parcel.area = S!.source === 'kataster' ? S!.parcel.area : G.area(S!.parcel.ring);
    S!.parcel.area = G.area(S!.parcel.ring);
    buildHandles(); render();
  });

  root.querySelectorAll<HTMLInputElement>('input[name=typ]').forEach((r) => r.addEventListener('change', () => {
    S!.typ = r.value; const t = typ();
    S!.fl = t.fl; if (!S!.sized) { S!.w = t.w; S!.d = t.d; }
    if (!S!.wohnManual) S!.wohn = wohnEst();
    $<HTMLInputElement>('[data-wohn]').value = String(S!.wohn);
    placeFree(); render();
  }));
  root.querySelectorAll<HTMLInputElement>('input[name=art]').forEach((r) => r.addEventListener('change', () => { S!.art = r.value; costs(); save(); }));
  $<HTMLInputElement>('[data-wohn]').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v >= 20 && v <= 900) { S!.wohn = v; S!.wohnManual = true; costs(); save(); } });
  $<HTMLInputElement>('[data-bw]').addEventListener('input', (e) => { S!.w = Number((e.target as HTMLInputElement).value); sizeChanged(); });
  $<HTMLInputElement>('[data-bd]').addEventListener('input', (e) => { S!.d = Number((e.target as HTMLInputElement).value); sizeChanged(); });
  root.querySelectorAll<HTMLInputElement>('input[name=fl]').forEach((r) => r.addEventListener('change', () => { S!.fl = Number(r.value); sizeChanged(); }));
  $<HTMLSelectElement>('[data-aus]').addEventListener('change', (e) => { S!.aus = (e.target as HTMLSelectElement).value; costs(); save(); });
  $<HTMLInputElement>('[data-keller]').addEventListener('change', (e) => { S!.keller = (e.target as HTMLInputElement).checked; costs(); save(); });

  // Für die Anfrage: kurze Zusammenfassung ablegen
  $('[data-send]').addEventListener('click', () => {
    if (!S) return;
    const t = typ();
    const sum = $('[data-sum]').textContent;
    // Plan als eigenständiges SVG: berechnete Farben als Attribute übernehmen (CSP-sicher, ohne style="")
    const plan = svg.cloneNode(true) as SVGSVGElement;
    const src = [svg, ...svg.querySelectorAll('*')], dst = [plan, ...plan.querySelectorAll('*')];
    src.forEach((el, i) => {
      const cs = getComputedStyle(el as Element), d = dst[i] as Element;
      ['fill', 'stroke', 'stroke-width', 'stroke-dasharray', 'fill-opacity', 'font-family'].forEach((p) => { const v = cs.getPropertyValue(p); if (v && v !== 'none' && v !== 'normal') d.setAttribute(p, v); });
      if ((el as SVGElement).style?.display === 'none') d.setAttribute('display', 'none');
      d.setAttribute('vector-effect', 'non-scaling-stroke');
      d.removeAttribute('class'); d.removeAttribute('tabindex'); d.removeAttribute('role'); d.removeAttribute('style');
      const drop = (el as Element).hasAttribute('data-handles');
      [...d.attributes].filter((a) => a.name.startsWith('data-')).forEach((a) => d.removeAttribute(a.name));
      if (drop) d.setAttribute('data-drop', '');
    });
    plan.querySelectorAll('title,[data-drop]').forEach((n) => n.remove());
    plan.setAttribute('aria-hidden', 'true');
    try {
      sessionStorage.setItem('rf:grundstueck-summary', JSON.stringify({
        ort: $('[data-meta]').textContent,
        flaeche: $('[data-f-area]').textContent,
        haus: `${t.name}, ${$('[data-f-house]').textContent}${S.hasBestand ? (S.bestand === 'abriss' ? ', Bestand wird abgerissen' : ', Bestand bleibt') : ''}`,
        abstand: $('[data-f-gap]').textContent,
        ergebnis: $('[data-verdict]').textContent,
        kosten: T.preiseZeigen ? `${S.art === 'rohbau' ? 'Rohbau' : 'Schlüsselfertig'}, ${S.wohn} m² Wohnfläche${S.keller ? ', mit Keller' : ''}: ${sum}` : `${S.wohn} m² Wohnfläche (geschätzt), Kostenrahmen nach Anfrage`,
        typ: t.id,
        svg: plan.outerHTML,
      }));
    } catch {}
  });

  window.addEventListener('resize', () => { if (S && !work.hidden) { fitView(); render(); if (editing) buildHandles(); } });

  // Einstieg von der Startseite (?q=Adresse, ?bsp=1, ?manuell=1) oder Wiederherstellen (z. B. nach Zurück aus der Anfrage)
  const qs = new URLSearchParams(location.search);
  const qAddr = (qs.get('q') || '').slice(0, 200), qBsp = qs.get('bsp'), qMan = qs.get('manuell');
  const fromHome = !!(qAddr || qBsp || qMan);
  if (qAddr) { qs.delete('q'); history.replaceState(null, '', location.pathname + (qs.toString() ? '?' + qs : '')); } // Adresse nicht in der URL stehen lassen
  const old = fromHome ? null : restore();
  if (old && old.parcel) {
    S = old;
    const t0 = typ(); S.w ??= t0.w; S.d ??= t0.d; S.fl ??= t0.fl; S.sized ??= false; S.wohnManual ??= false; S.hasBestand ??= false; S.bestand ??= null;
    if (S.hasBestand && !S.bestand) showAsk(); else open(false);
  } else {
    const pre = qs.get('typ');
    if (pre) { const r = root.querySelector<HTMLInputElement>(`input[name=typ][value="${pre}"]`); if (r) r.checked = true; }
  }
  if (fromHome) {
    try { sessionStorage.removeItem(KEY); } catch {}
    if (qAddr) { $<HTMLInputElement>('#gc-addr').value = qAddr; form.requestSubmit(); }
    else if (qBsp) $('[data-example]').click();
    else if (qMan) $('[data-manual-open]').click();
  }
</script>
