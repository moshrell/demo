---
import Base from '../layouts/Base.astro';
import Bauablauf from '../components/Bauablauf.astro';
import HeroFirma from '../components/HeroFirma.astro';
import CheckTeaser from '../components/CheckTeaser.astro';
import PlzCheck from '../components/PlzCheck.astro';
import OrderForm from '../components/OrderForm.astro';
import site from '../data/site.json';
import lst from '../data/leistungen.json';
import refs from '../data/referenzen.json';
import faq from '../data/faq.json';
const base = import.meta.env.BASE_URL;
import { has, src, srcset } from '../lib/img';
---
<Base title="Thielking Bau · Bauunternehmen in Gehrden · Neubau, Anbau, Sanierung" description="Bauunternehmen im Calenberger Land: Einfamilienhäuser schlüsselfertig oder als Rohbau, Anbau, Aufstockung und Sanierung. Zahlung nach Baufortschritt, ein Ansprechpartner bis zum Schlüssel." faq={faq} current="start" image="img/phase-6-tag.webp">
  <HeroFirma />

  <section class="section planen" id="planen" aria-labelledby="planen-h">
    <div class="wrap">
      <h2 id="planen-h">Was planen Sie?</h2>
      <ul class="planen__grid">
        {lst.einstieg.map((e, i) => (
          <li>
            <a class="planen__card reveal" href={base + e.href}>
              <span class="mono planen__nr">0{i + 1}</span>
              <span class="planen__t">{e.title}</span>
              <span class="planen__s">{e.sub}</span>
              <span class="planen__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CheckTeaser />

  <Bauablauf />

  <section class="section" id="warum" aria-labelledby="why-h">
    <div class="wrap why">
      <h2 id="why-h">Drei Dinge, die bei uns feststehen</h2>
      <ol class="why__list">
        <li class="sheet reveal">
          <p class="sheet__hd mono"><span>§ 1</span><span>Zahlung</span></p>
          <div class="sheet__bd stack"><h3>Sie zahlen nach Baufortschritt</h3><p>Nie im Voraus. Vor der Abnahme nie mehr als 80 % der Bausumme. Bei Vertragsschluss bekommen Sie 5 % Sicherheit.</p></div>
        </li>
        <li class="sheet reveal">
          <p class="sheet__hd mono"><span>§ 2</span><span>Leute</span></p>
          <div class="sheet__bd stack"><h3>Eigene Kolonnen im Rohbau</h3><p>{site.crews} feste Maurerkolonnen, {site.team} Leute insgesamt. Wer bei Ihnen die Bodenplatte macht, setzt auch den letzten Stein.</p></div>
        </li>
        <li class="sheet reveal">
          <p class="sheet__hd mono"><span>§ 3</span><span>Termine</span></p>
          <div class="sheet__bd stack"><h3>Bauzeitenplan schriftlich</h3><p>Vor Baubeginn wissen Sie, welche Woche was passiert. Ändert sich etwas, ruft Polier {site.polier.name} Sie an, nicht umgekehrt.</p></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ref-h">
    <div class="wrap">
      <div class="head-row">
        <h2 id="ref-h">Zuletzt gebaut</h2>
        <a class="link-arrow" href={`${base}referenzen/`}>Alle Referenzen</a>
      </div>
      <ul class="refs">
        {refs.filter((r) => has(r.img)).slice(0, 3).map((r) => (
          <li class="ref reveal">
            <figure class="ref__img"><img src={src(r.img)} srcset={srcset(r.img, false)} sizes="(min-width: 48rem) 33vw, 100vw" alt={r.alt} width="1200" height="896" loading="lazy" decoding="async" /></figure>
            <p class="mono ref__meta"><span>{r.typeLabel}</span><span>{r.place} · {r.year}</span></p>
            <h3>{r.title}</h3>
            <p class="muted">{r.size} · Bauzeit {r.time}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="rev-h">
    <div class="wrap rev">
      <h2 id="rev-h">Was Bauherren sagen</h2>
      <p class="rev__ph">Hier stehen Ihre echten Google-Bewertungen. In der Demo zeigen wir keine erfundenen.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="stack">
        <h2 id="faq-h">Was Bauherren uns zuerst fragen</h2>
        <div class="sheet"><div class="sheet__bd"><PlzCheck id="plz-home" /></div></div>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ruf-h" id="rueckruf">
    <div class="wrap contact">
      <div class="stack">
        <h2 id="ruf-h">Lieber erst sprechen?</h2>
        <p class="lead">Rufen Sie an oder lassen Sie sich zurückrufen. {site.office.name} vergibt einen Termin mit {site.owner}, meist innerhalb von zwei Werktagen.</p>
        <p><a class="btn btn--ink" href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p class="mono"><span class="status" data-status>{site.hoursText}</span></p>
      </div>
      <div class="sheet contact__form">
        <OrderForm id="rueckruf-form" title="Rückruf anfordern" options={['Vormittags', 'Nachmittags', 'Egal']} optionsLabel="Wann passt es Ihnen?" submitLabel="Rückruf anfordern" purpose="meines Rückrufwunsches" />
      </div>
    </div>
  </section>
</Base>

<style>
  .planen { padding-block: var(--space-xl) var(--space-lg); }
  .planen__grid { list-style: none; padding: 0; margin: var(--space-md) 0 0; display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 22.5rem) { .planen__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .planen__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 47.99rem) { .planen__s { display: none; } .planen__card { padding: var(--space-md); } .planen__t { font-size: 1.1rem; } }
  .planen__card { position: relative; display: grid; gap: var(--space-xs); height: 100%; padding: var(--space-md) var(--space-md) var(--space-lg); background: var(--color-chalk); border: 1px solid var(--color-rule); border-top: 4px solid var(--color-ink); border-radius: var(--radius); text-decoration: none; }
  .planen__nr { color: var(--color-accent); }
  .planen__t { font-family: var(--font-display); font-variation-settings: 'wdth' 125; font-weight: 750; font-size: 1.35rem; line-height: 1.1; padding-right: 2rem; }
  .planen__s { color: var(--color-ink-2); }
  .planen__go { position: absolute; right: var(--space-md); top: var(--space-md); font-size: 1.3rem; }
  @media (hover: hover) { .planen__card:hover { border-top-color: var(--color-accent); } }


  .why__list { list-style: none; padding: 0; margin: var(--space-lg) 0 0; display: grid; gap: var(--space-md); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) { .why__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .rev h2 { font-size: var(--text-xl); }
  .rev__ph { margin: var(--space-md) 0 0; padding: var(--space-lg); border: 2px dashed var(--color-rule); border-radius: var(--radius); color: var(--color-ink-2); max-width: var(--measure); }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); flex-wrap: wrap; }
  .refs { list-style: none; padding: 0 0 var(--space-sm); margin: var(--space-lg) 0 0; display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: var(--space-md); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
  .refs > li { scroll-snap-align: start; }
  @media (min-width: 48rem) { .refs { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); overflow: visible; } }
  .ref { display: grid; gap: var(--space-xs); align-content: start; }
  .ref__img { margin: 0 0 var(--space-sm); aspect-ratio: 4 / 3; background: var(--color-paper-3); border-radius: var(--radius); overflow: hidden; }
  .ref__img img { width: 100%; height: 100%; object-fit: cover; }
  .ref__meta { display: flex; justify-content: space-between; gap: var(--space-sm); color: var(--color-ink-2); }
  .ref h3 { font-size: 1.2rem; }

  .faq-grid { display: grid; gap: var(--space-xl); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) { .faq-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: start; } }
  .faq details { border-top: 1px solid var(--color-rule); }
  .faq details:last-child { border-bottom: 1px solid var(--color-rule); }
  .faq summary { cursor: pointer; list-style: none; padding: var(--space-md) 2.25rem var(--space-md) 0; position: relative; font-weight: 650; min-height: 2.75rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: var(--space-md); font-family: var(--font-mono); color: var(--color-accent); }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { padding: 0 0 var(--space-md); max-width: var(--measure); }

  .contact { display: grid; gap: var(--space-xl); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 56rem) { .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .contact__form :global(.of) { padding: var(--space-lg) var(--space-md); }
</style>
