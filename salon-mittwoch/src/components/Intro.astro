---
import site from '../data/site.json';
const i = site.intro;
---
<section class="intro" id="intro" aria-label={site.legalName} data-variant={(i as any).variant ?? 'classic'} data-v={(i as any).variant === 'sit' ? 'sit' : 'classic'}>
  <div class="pin" id="pin">
    <canvas id="stage" aria-hidden="true"></canvas>
    <div class="veil"></div>

    <p class="hint">Scrollen</p>
    <p class="line">{i.line}</p>

    <div class="emerge"><div class="field" id="field" aria-hidden="true"><div class="field-bg"></div></div></div>
    <svg class="art" id="art" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="gp-clip" clipPathUnits="userSpaceOnUse">
          <text id="glyph" x="0" y="0">{i.word}</text>
        </clipPath>
      </defs>
    </svg>
    <p class="sub">{site.type}</p>

    <div class="paper" aria-hidden="true"></div>

    <div class="welcome">
      <p class="eyebrow">{i.eyebrow}</p>
      <h1 set:html={i.headline.replace('\n', '<br />')} />
      <a class="btn btn--solid" href="#termin">{i.cta} <span class="arr">→</span></a>
    </div>

    <p class="brand" aria-hidden="true">{site.name}</p>

    <button class="skip" type="button" id="skip">Intro überspringen</button>
    <div class="loader"><span>Laden</span><i></i></div>
  </div>
</section>

<style>
  .intro { --hint: 1; --line: 0; --veil: 0; --word: 0; --sub: 0; --reveal: 0; position: relative; height: 900vh; height: 900svh; background: var(--bg); color: var(--cream); }
  .pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: clip; }
  #stage { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .veil { position: absolute; inset: 0; background: #0d0a08; opacity: var(--veil); pointer-events: none; }

  .hint, .line, .sub { position: absolute; left: 0; right: 0; margin: 0; text-align: center; pointer-events: none; text-transform: uppercase; letter-spacing: .42em; padding-left: .42em; }
  .hint { bottom: calc(30px + env(safe-area-inset-bottom)); font-size: .7rem; font-weight: 600; opacity: var(--hint); }
  .hint::after { content: ""; display: block; width: 1px; height: 38px; margin: 12px auto 0; background: currentColor; opacity: .6; animation: drop 1.8s ease-in-out infinite; transform-origin: top; }
  @keyframes drop { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .line { bottom: 9vh; font-family: var(--serif); letter-spacing: .3em; font-size: clamp(1rem, 2.4vw, 1.45rem); color: #fbf4e8; text-shadow: 0 1px 2px rgba(0,0,0,.9), 0 0 24px rgba(0,0,0,.85); opacity: var(--line); transform: translateY(calc((1 - var(--line)) * 14px)); }
  .line::before { content: ""; position: absolute; left: 50%; top: 50%; width: min(760px, 120vw); height: 220px; transform: translate(-50%, -50%); z-index: -1; background: radial-gradient(closest-side, rgba(8,6,5,.75), rgba(8,6,5,0)); }
  .sub { top: calc(var(--word-bottom, 60%) + 22px); font-size: clamp(.68rem, 1.5vw, .95rem); font-weight: 600; color: var(--paper); opacity: var(--sub); }

  .emerge { position: absolute; inset: 0; pointer-events: none; filter: var(--em-filter, none); transform: translateY(var(--em-y, 0)) scale(var(--em-scale, 1)); }
  .field { position: absolute; inset: 0; opacity: var(--word); pointer-events: none; }
  .field-bg { position: absolute; inset: 0; background: radial-gradient(circle at 22% 10%, rgba(255,248,236,.9), transparent 42%), linear-gradient(180deg, #f5ede1 0%, var(--paper) 100%); }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  #glyph { font-family: "Playfair Display", Georgia, serif; font-weight: 900; font-size: 100px; font-kerning: none; font-variant-ligatures: none; letter-spacing: 0; }

  .welcome { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 26px; padding: 24px; text-align: center; color: var(--ink); opacity: var(--reveal); transform: translateY(calc((1 - var(--reveal)) * 24px)); pointer-events: none; }
  :global(body.entered) .welcome { pointer-events: auto; }
  .welcome .eyebrow { margin: 0; }
  .welcome h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(2.3rem, 6vw, 5rem); line-height: 1.05; letter-spacing: -.02em; }

  .skip { position: absolute; right: 16px; top: calc(16px + env(safe-area-inset-top)); z-index: 3; border: 1px solid rgba(246,239,228,.25); background: rgba(11,8,7,.4); border-radius: 999px; padding: 8px 14px; font-size: .68rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; cursor: pointer; opacity: calc(1 - var(--word)); transition: background .3s; }
  .skip:hover { background: rgba(11,8,7,.8); }

  .loader { position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 14px; letter-spacing: .4em; text-transform: uppercase; font-size: .75rem; background: var(--bg); transition: opacity .6s ease; }
  .loader i { width: 90px; height: 1px; background: currentColor; opacity: .5; transform-origin: left; animation: load 1.4s ease-in-out infinite; }
  @keyframes load { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
  :global(body.ready) .loader { opacity: 0; pointer-events: none; }

  /* ===== Вариант «sit»: садимся в кресло, название улетает в шапку ===== */
  .paper, .brand { display: none; }
  .intro[data-v="sit"] { height: 600vh; height: 600svh; }
  .intro[data-v="sit"] :is(.emerge, .art, .sub) { display: none; }
  .intro[data-v="sit"] .veil { background: #000; }
  .intro[data-v="sit"] .paper { display: block; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .7s ease;
    background: radial-gradient(circle at 22% 10%, rgba(255,250,242,.9), transparent 42%), linear-gradient(180deg, #fbf8f3 0%, var(--paper) 100%); }
  :global(body.landed) .intro[data-v="sit"] .paper { opacity: 1; transition: opacity .8s ease .35s; }
  .intro[data-v="sit"] .welcome { opacity: 0; transform: translateY(24px); transition: opacity .5s ease, transform .5s ease; }
  :global(body.landed) .intro[data-v="sit"] .welcome { opacity: 1; transform: none; transition: opacity .9s ease .8s, transform 1s var(--ease) .8s; }

  .intro[data-v="sit"] .brand {
    display: block; position: absolute; left: 50%; top: 50%; z-index: 4; margin: 0; pointer-events: none;
    font-family: var(--serif); font-weight: 900; font-size: clamp(3.4rem, 13vw, 11rem); line-height: 1; letter-spacing: .02em; white-space: nowrap;
    color: var(--cream); opacity: 0; transform: translate(-50%, -50%) scale(.94);
    transition: opacity 1s ease, transform 1.15s cubic-bezier(.7, 0, .2, 1), color .8s ease .2s;
  }
  :global(body.blackout) .intro[data-v="sit"] .brand { opacity: 1; transform: translate(-50%, -50%); }
  :global(body.landed) .intro[data-v="sit"] .brand { transform: translate(-50%, -50%) translate(var(--fx, 0px), var(--fy, 0px)) scale(var(--fs, 1)); color: var(--ink); }
  :global(body.landed-done) .intro[data-v="sit"] .brand { opacity: 0; transition: opacity .12s; }
  :global(body.sit-flying #nav .logo) { opacity: 0; }
  :global(body.blackout) .skip { opacity: 0; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .hint::after, .loader i { animation: none; }
    .intro[data-v="sit"] .brand, .intro[data-v="sit"] .paper, .intro[data-v="sit"] .welcome { transition-duration: .01s !important; transition-delay: 0s !important; }
  }
</style>

<script>
  // Вариант интро: ?intro=sit или ?intro=classic в адресе, иначе — из site.json (intro.variant)
  const el = document.getElementById('intro')!;
  const v = new URLSearchParams(location.search).get('intro') || el.dataset.variant;
  el.dataset.v = v === 'sit' ? 'sit' : 'classic';
  if (v === 'sit') import('../scripts/intro-sit.js');
  else import('../scripts/intro.js');
</script>
