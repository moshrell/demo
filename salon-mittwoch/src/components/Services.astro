---
import site from '../data/site.json';
const s = site.services;
const arr = (v: number | number[]) => (Array.isArray(v) ? v : [v, v, v]);
---
<section class="section section--dark services" id="leistungen">
  <div class="wrap">
    <header class="top">
      <div>
        <p class="eyebrow reveal">{s.eyebrow}</p>
        <h2 class="h2 reveal" style="--d:.08s">{s.title}</h2>
      </div>
      <p class="lead reveal" style="--d:.16s">{s.note}</p>
    </header>

    <div class="controls reveal" style="--d:.2s">
      <div class="tabs" role="tablist" aria-label="Kategorie">
        {s.categories.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.label}</button>
        ))}
      </div>
      <div class="lengths" role="radiogroup" aria-label="Haarlänge">
        <span class="lbl">Haarlänge</span>
        {s.lengths.map((l, i) => (
          <button type="button" role="radio" data-len={i} aria-checked={i === 1 ? 'true' : 'false'}><span>{l.label}</span><small>{l.hint}</small></button>
        ))}
      </div>
    </div>

    <div class="layout">
      <div class="panels">
        {s.categories.map((c, ci) => (
          <ul class="list" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={ci !== 0}>
            {c.items.map((it, ii) => (
              <li class="item" data-key={`${c.id}-${ii}`} data-name={it.name} data-consult={(it as any).consult ? '1' : undefined} data-price={JSON.stringify(arr(it.price))} data-min={JSON.stringify(arr(it.min))}>
                <div class="txt">
                  <h3>{it.name}{(it as any).consult && <span class="badge">mit Beratung</span>}</h3>
                  <p>{it.desc}</p>
                </div>
                <span class="dur"></span>
                <span class="price"></span>
                <button type="button" class="add" aria-pressed="false" aria-label={`${it.name} zur Auswahl hinzufügen`}><span aria-hidden="true">+</span></button>
              </li>
            ))}
          </ul>
        ))}
      </div>

      <aside class="summary" aria-live="polite">
        <p class="eyebrow">Ihre Auswahl <span>· unverbindlich</span></p>
        <ul class="picked"><li class="empty">Noch nichts gewählt. Tippen Sie auf +.</li></ul>
        <div class="totals">
          <span><small>Dauer</small><b class="t-min">0 Min.</b></span>
          <span><small>Preis</small><b class="t-price">0 €</b></span>
        </div>
        <p class="hint-consult" hidden>Mit Beratung: Sie nennen Wunschtage, wir rufen zurück und schlagen einen Termin vor.</p>
        <a class="btn btn--light go" href="#termin" aria-disabled="true"><span class="go-label">Mit Auswahl buchen</span> <span class="arr">→</span></a>
      </aside>
    </div>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: end; margin-bottom: 56px; }
  .top .lead { margin: 0; }
  .controls { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18px; margin-bottom: 28px; }
  .tabs, .lengths { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .lengths button { display: grid; justify-items: center; gap: 1px; line-height: 1.15; padding: 8px 16px; }
  .lengths button small { font-size: .62rem; font-weight: 500; letter-spacing: .04em; text-transform: none; opacity: .65; }
  .tabs button, .lengths button { border: 1px solid rgba(246,239,228,.18); background: none; border-radius: 999px; padding: 10px 18px; min-height: 44px; font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: background .3s, color .3s, border-color .3s; }
  .tabs button[aria-selected="true"], .lengths button[aria-checked="true"] { background: var(--cream); color: var(--ink); border-color: var(--cream); }
  .lengths .lbl { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; opacity: .55; margin-right: 6px; }

  .layout { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: start; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(246,239,228,.14); }
  .item { display: grid; grid-template-columns: 1fr auto auto 48px; align-items: center; gap: 20px; padding: 22px 0; border-bottom: 1px solid rgba(246,239,228,.14); }
  .item h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.2; }
  .item p { margin: 4px 0 0; font-size: .9rem; opacity: .6; }
  .dur { font-size: .82rem; opacity: .55; white-space: nowrap; }
  .price { font-family: var(--serif); font-size: 1.45rem; color: var(--brass); white-space: nowrap; min-width: 4ch; text-align: right; font-variant-numeric: lining-nums tabular-nums; }
  .add { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(246,239,228,.3); background: none; cursor: pointer; font-size: 1.3rem; line-height: 1; display: grid; place-items: center; transition: background .3s, color .3s, transform .4s var(--ease); }
  .add:hover { border-color: var(--brass); }
  .add[aria-pressed="true"] { background: var(--brass); border-color: var(--brass); color: var(--ink); transform: rotate(45deg); }

  .summary { position: sticky; top: 100px; background: rgba(246,239,228,.05); border: 1px solid rgba(246,239,228,.14); border-radius: var(--radius); padding: 26px; }
  .summary .eyebrow { margin-bottom: 14px; }
  .picked { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 8px; font-size: .92rem; }
  .picked :global(li) { display: flex; justify-content: space-between; gap: 16px; }
  .picked :global(li span:last-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .picked :global(.empty) { opacity: .5; }
  .summary .eyebrow span { opacity: .6; letter-spacing: .14em; }
  .badge { display: inline-block; vertical-align: middle; margin-left: 10px; padding: 3px 8px; border-radius: 999px; border: 1px solid rgba(224,103,92,.5); color: var(--brass); font-family: var(--sans); font-size: .6rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .hint-consult { margin: 0 0 16px; font-size: .82rem; line-height: 1.45; color: var(--brass); }
  .totals { display: flex; justify-content: space-between; padding: 16px 0; border-top: 1px solid rgba(246,239,228,.14); margin-bottom: 18px; }
  .totals span { display: grid; }
  .totals small { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; opacity: .55; }
  .totals b { font-family: var(--serif); font-weight: 400; font-size: 1.6rem; }
  .go { width: 100%; }
  .go[aria-disabled="true"] { opacity: .35; pointer-events: none; }

  @media (max-width: 960px) {
    .top { grid-template-columns: 1fr; }
    .layout { grid-template-columns: 1fr; }
    .summary { position: sticky; top: auto; bottom: calc(10px + env(safe-area-inset-bottom)); background: rgba(20,16,13,.94); backdrop-filter: blur(12px); padding: 16px 18px; display: grid; grid-template-columns: 1fr auto; gap: 10px 16px; align-items: center; }
    .summary .eyebrow, .picked { display: none; }
    .totals { border: 0; padding: 0; margin: 0; gap: 22px; justify-content: start; }
    .totals b { font-size: 1.25rem; }
    .go { width: auto; min-height: 46px; padding: 0 18px; font-size: .7rem; }
    .hint-consult { grid-column: 1 / -1; margin: 0; font-size: .75rem; }
  }
  @media (max-width: 560px) {
    .item { grid-template-columns: 1fr auto 44px; gap: 6px 14px; }
    .dur { grid-column: 1; grid-row: 2; }
    .price { grid-column: 2; grid-row: 1 / span 2; }
    .add { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>

<script>
  const root = document.getElementById('leistungen')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const lens = [...root.querySelectorAll<HTMLButtonElement>('[data-len]')];
  const items = [...root.querySelectorAll<HTMLLIElement>('.item')];
  const picked = root.querySelector('.picked')!, tMin = root.querySelector('.t-min')!, tPrice = root.querySelector('.t-price')!;
  const go = root.querySelector<HTMLAnchorElement>('.go')!;
  let len = 1;
  const chosen = new Set<string>();
  const eur = (n: number) => `${n} €`;
  const mins = (n: number) => (n >= 60 ? `${Math.floor(n / 60)} Std.${n % 60 ? ` ${n % 60} Min.` : ''}` : `${n} Min.`);
  const val = (li: HTMLElement, k: 'price' | 'min') => (JSON.parse(li.dataset[k]!) as number[])[len];

  // Вкладки (с клавиатурой: стрелки)
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      (document.getElementById(t.getAttribute('aria-controls')!) as HTMLElement).hidden = !on;
    });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
      if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
    });
  });

  const render = () => {
    for (const li of items) {
      li.querySelector('.price')!.textContent = eur(val(li, 'price'));
      li.querySelector('.dur')!.textContent = mins(val(li, 'min'));
      li.querySelector('.add')!.setAttribute('aria-pressed', String(chosen.has(li.dataset.key!)));
    }
    const list = items.filter((li) => chosen.has(li.dataset.key!));
    const sel = list.map((li) => ({ name: li.dataset.name!, price: val(li, 'price'), min: val(li, 'min'), consult: !!li.dataset.consult }));
    picked.innerHTML = sel.length ? '' : '<li class="empty">Noch nichts gewählt. Tippen Sie auf +.</li>';
    for (const s of sel) { const el = document.createElement('li'); el.innerHTML = `<span></span><span>${eur(s.price)}</span>`; el.firstElementChild!.textContent = s.name; picked.append(el); }
    const total = sel.reduce((a, s) => a + s.price, 0), dur = sel.reduce((a, s) => a + s.min, 0);
    tMin.textContent = mins(dur); tPrice.textContent = eur(total);
    go.setAttribute('aria-disabled', String(!sel.length));
    const request = sel.some((s) => s.consult) || dur > 180;
    (root.querySelector('.hint-consult') as HTMLElement).hidden = !request;
    root.querySelector('.go-label')!.textContent = request ? 'Termin anfragen' : 'Mit Auswahl buchen';
    (window as any).__mittwochSelection = { items: sel, total, dur };
    window.dispatchEvent(new CustomEvent('mittwoch:selection', { detail: { items: sel, total, dur } }));
  };

  lens.forEach((b, i) => b.addEventListener('click', () => { len = i; lens.forEach((x, j) => x.setAttribute('aria-checked', String(i === j))); render(); }));
  items.forEach((li) => li.querySelector('.add')!.addEventListener('click', () => {
    const k = li.dataset.key!; chosen.has(k) ? chosen.delete(k) : chosen.add(k); render();
  }));
  render();
</script>
