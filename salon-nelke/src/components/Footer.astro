---
import site from '../data/site.json';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="footer">
  <div class="wrap">
    <p class="big" aria-hidden="true"><span>Nelke</span><b>✿</b></p>
    <div class="cols">
      <p>{site.contact.street}<br />{site.contact.zip} {site.contact.city}-{site.district}</p>
      <p>Di – Fr 9 – 19 Uhr<br />Do bis 20 Uhr · Sa 9 – 15 Uhr</p>
      <nav aria-label="Rechtliches"><a href={`${base}impressum/`} target="_blank" rel="noopener">Impressum</a><a href={`${base}datenschutz/`} target="_blank" rel="noopener">Datenschutz</a></nav>
    </div>
    <div class="base">
      <span>© {year} {site.legalName} · {site.demoNotice}</span>
      <a href={site.credit.url} target="_blank" rel="noopener">{site.credit.label}</a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: var(--cream); padding: clamp(56px, 9vh, 110px) 0 calc(84px + env(safe-area-inset-bottom)); overflow: hidden; }
  .big { display: flex; align-items: center; gap: .1em; margin: 0 0 36px; font-family: var(--serif); font-weight: 700; font-size: clamp(5rem, 24vw, 22rem); line-height: .85; letter-spacing: -.04em; color: var(--coral); font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144; }
  .big b { color: var(--butter); font-weight: 400; display: inline-block; animation: turn 14s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding-bottom: 34px; border-bottom: 1px dashed rgba(251, 247, 238, .3); }
  .cols p { margin: 0; opacity: .8; }
  .cols nav { display: grid; justify-items: start; gap: 4px; }
  .cols a, .base a { text-decoration: none; opacity: .8; } .cols a:hover, .base a:hover { opacity: 1; color: var(--butter); }
  .base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 22px; font-size: .8rem; opacity: .7; }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .big b { animation: none; } }
</style>
