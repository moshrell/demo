---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Odometer from '../components/Odometer.astro';
import AnmeldungForm from '../components/AnmeldungForm.astro';
import i18n from '../data/i18n.json';
import site from '../data/site.json';
import { calc, defaults, euro, retryCosts, PAPIERE } from '../scripts/calc.js';

const base = import.meta.env.BASE_URL;
const T = (k: string) => (i18n as Record<string, Record<string, string>>)[k].de;
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const state = defaults(site);
const res = calc(site.prices, state);
const e = (n: number) => euro(n, 'de');
const rc = retryCosts(site.prices, state);
const hours = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 }).format(state.fahrten * 0.75);
const fahrtenCfg = site.fahrten;
const frac = (v: number) => ((v - fahrtenCfg.min) / (fahrtenCfg.max - fahrtenCfg.min)).toFixed(4);
const stationNote = fill(T('s1_note_schalt'), {});
const langNames: Record<string, string> = { de: 'lg_de', en: 'lg_en', uk: 'lg_uk', tr: 'lg_tr' };
const tel = site.phoneHref;
---
<Base>
  <header class="mast">
    <a class="brand" href={base} aria-label={`${site.short}, ${T('brand_tag')}`}>
      <Logo />
      <span class="brand__text"><span class="brand__name">{site.short}</span><span class="brand__tag" data-i="brand_tag">{T('brand_tag')}</span></span>
    </a>
    <div class="lang" role="group" aria-label={T('lang_aria')} data-i-aria="lang_aria" data-lang-switch>
      <button type="button" data-lang="de" lang="de" aria-pressed="true">DE</button>
      <button type="button" data-lang="en" lang="en" aria-pressed="false">EN</button>
      <button type="button" data-lang="uk" lang="uk" aria-pressed="false">UA</button>
    </div>
  </header>

  <div class="layout">
    <main class="route" id="inhalt" data-route>
      <svg class="route__svg" translate="no" aria-hidden="true" focusable="false" data-road></svg>

      <!-- Start -->
      <section class="stop stop--hero" data-hero aria-labelledby="hero-h">
        <p class="stop__eyebrow" data-i="hero_eyebrow">{T('hero_eyebrow')}</p>
        <h1 class="hero__h" id="hero-h"><span data-i="hero_h1_a">{T('hero_h1_a')}</span><span data-i="hero_h1_b">{T('hero_h1_b')}</span></h1>
        <p class="hero__lead" data-i="hero_lead">{T('hero_lead')}</p>
        <div class="hero__cta">
          <a class="btn" href="#station-1"><span data-i="hero_go">{T('hero_go')}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6" /></svg></a>
          <a class="btn btn--ghost" href={`tel:${tel}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" /></svg><span data-i="hero_call">{T('hero_call')}</span></a>
        </div>
        <p class="hero__langs" data-i="hero_langs">{T('hero_langs')}</p>
      </section>

      <!-- Station 1: Anmeldung -->
      <section class="stop" id="station-1" data-stop="1" aria-labelledby="h-1">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="1">{fill(T('st_eyebrow'), { n: 1 })}</p>
        <h2 class="stop__h" id="h-1" data-i="s1_t">{T('s1_t')}</h2>
        <p class="stop__lead" data-i="s1_lead">{T('s1_lead')}</p>
        <div class="stop__body">
          <fieldset class="grp">
            <legend class="stop__q" data-i="s1_q_alter">{T('s1_q_alter')}</legend>
            <div class="opts opts--one">
              <label class="opt"><input type="radio" name="alter" value="17" /><span data-i="s1_a17">{T('s1_a17')}</span></label>
              <label class="opt"><input type="radio" name="alter" value="18" checked /><span data-i="s1_a18">{T('s1_a18')}</span></label>
            </div>
            <p class="stop__note" data-i="s1_alter_note">{T('s1_alter_note')}</p>
          </fieldset>
          <fieldset class="grp">
            <legend class="stop__q" data-i="s1_q_getriebe">{T('s1_q_getriebe')}</legend>
            <div class="opts">
              <label class="opt"><input type="radio" name="getriebe" value="schaltung" checked /><span data-i="s1_schalt">{T('s1_schalt')}</span></label>
              <label class="opt"><input type="radio" name="getriebe" value="automatik" /><span data-i="s1_auto">{T('s1_auto')}</span></label>
            </div>
            <p class="stop__note" data-getriebe-note data-i="s1_note_schalt">{stationNote}</p>
          </fieldset>
          <fieldset class="grp">
            <legend class="stop__q" data-i="s1_q_sprache">{T('s1_q_sprache')}</legend>
            <div class="opts">
              <label class="opt"><input type="radio" name="sprache" value="de" checked /><span lang="de">Deutsch</span></label>
              <label class="opt"><input type="radio" name="sprache" value="en" /><span lang="en">English</span></label>
              <label class="opt"><input type="radio" name="sprache" value="uk" /><span lang="uk">Українська</span></label>
            </div>
            <p class="stop__note" data-i="s1_sprache_note">{T('s1_sprache_note')}</p>
          </fieldset>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="1">{e(res.perStop[1])}</strong></p>
      </section>

      <!-- Station 2: Papiere -->
      <section class="stop" id="station-2" data-stop="2" aria-labelledby="h-2">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="2">{fill(T('st_eyebrow'), { n: 2 })}</p>
        <h2 class="stop__h" id="h-2" data-i="s2_t">{T('s2_t')}</h2>
        <p class="stop__lead" data-i="s2_lead">{T('s2_lead')}</p>
        <div class="stop__body">
          <div class="sws">
            {PAPIERE.map((k) => (
              <label class="sw">
                <input class="sw__input" type="checkbox" role="switch" name={`p_${k}`} data-paper={k} checked />
                <span class="sw__text">
                  <strong data-i={`p_${k}_t`}>{T(`p_${k}_t`)}</strong>
                  <small data-i={`p_${k}_d`}>{T(`p_${k}_d`)}</small>
                  <span class="sw__tag sw__tag--on" data-i="s2_extern">{T('s2_extern')}</span>
                  <span class="sw__tag sw__tag--off" data-i="s2_have">{T('s2_have')}</span>
                </span>
                <span class="sw__side"><span class="sw__price num">{e(site.prices.papiere[k as keyof typeof site.prices.papiere])}</span><span class="sw__track" aria-hidden="true"></span></span>
              </label>
            ))}
          </div>
          <p class="stop__note" data-i="s2_note">{T('s2_note')}</p>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="2">{e(res.perStop[2])}</strong></p>
      </section>

      <!-- Station 3: Theorie -->
      <section class="stop" id="station-3" data-stop="3" aria-labelledby="h-3">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="3">{fill(T('st_eyebrow'), { n: 3 })}</p>
        <h2 class="stop__h" id="h-3" data-i="s3_t">{T('s3_t')}</h2>
        <p class="stop__lead" data-i="s3_lead">{T('s3_lead')}</p>
        <div class="stop__body">
          <figure class="fig fig--43"><img src={`${base}img/theorieraum.webp`} alt={T('img_theorie')} data-i-alt="img_theorie" width="896" height="1200" loading="lazy" decoding="async" /></figure>
          <div>
            <h3 class="stop__q" data-i="s3_plan_h">{T('s3_plan_h')}</h3>
            <p data-i="s3_plan">{T('s3_plan')}</p>
          </div>
          <div class="sws">
            <label class="sw">
              <input class="sw__input" type="checkbox" role="switch" name="lern" data-lern checked />
              <span class="sw__text">
                <strong data-i="s3_lern_t">{T('s3_lern_t')}</strong>
                <small data-i="s3_lern_d">{T('s3_lern_d')}</small>
              </span>
              <span class="sw__side"><span class="sw__price num">{e(site.prices.lernpaket)}</span><span class="sw__track" aria-hidden="true"></span></span>
            </label>
          </div>
          <div class="quiz" data-quiz>
            <p class="quiz__h" data-i="q_h">{T('q_h')}</p>
            <p class="quiz__q" data-i="q1_q">{T('q1_q')}</p>
            <div class="quiz__opts">
              <button type="button" data-ok="0" data-i="q1_a">{T('q1_a')}</button>
              <button type="button" data-ok="1" data-i="q1_b">{T('q1_b')}</button>
              <button type="button" data-ok="0" data-i="q1_c">{T('q1_c')}</button>
            </div>
            <div class="quiz__slot" data-q-slot>
              <div class="quiz__res" role="status" aria-live="polite" hidden>
                <strong data-q-title>{T('q_ok')}</strong>
                <span data-i="q1_why">{T('q1_why')}</span>
              </div>
              <button type="button" class="quiz__again" data-q-again data-i="q_again" hidden>{T('q_again')}</button>
            </div>
          </div>
          <p class="stop__note" data-i="s3_pruef">{T('s3_pruef')}</p>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="3">{e(res.perStop[3])}</strong></p>
      </section>

      <!-- Station 4: Fahrstunden -->
      <section class="stop" id="station-4" data-stop="4" aria-labelledby="h-4">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="4">{fill(T('st_eyebrow'), { n: 4 })}</p>
        <h2 class="stop__h" id="h-4" data-i="s4_t">{T('s4_t')}</h2>
        <p class="stop__lead" data-i="s4_lead">{T('s4_lead')}</p>
        <div class="stop__body">
          <div class="rng" data-rng>
            <div class="rng__top">
              <output class="rng__val num" for="fahrten" data-fahrten-val>{state.fahrten}</output>
              <p class="rng__unit" data-i="s4_q">{T('s4_q')}</p>
            </div>
            <div class="rng__row">
              <button type="button" class="rng__btn" data-step="-1" aria-label={T('s4_minus')} data-i-aria="s4_minus">−</button>
              <input type="range" id="fahrten" name="fahrten" min={fahrtenCfg.min} max={fahrtenCfg.max} step="1" value={state.fahrten} aria-describedby="fahrten-hours" aria-label={T('s4_q')} data-i-aria="s4_q" />
              <button type="button" class="rng__btn" data-step="1" aria-label={T('s4_plus')} data-i-aria="s4_plus">+</button>
            </div>
            <div class="rng__band" style={`--from:${frac(fahrtenCfg.bandFrom)};--to:${frac(fahrtenCfg.bandTo)}`} aria-hidden="true"><i></i></div>
            <div class="rng__facts">
              <p class="rng__adac" data-i="s4_band">{T('s4_band')}</p>
              <p id="fahrten-hours" data-hours data-i="s4_hours" data-v-n={state.fahrten} data-v-h={hours}>{fill(T('s4_hours'), { n: state.fahrten, h: hours })}</p>
              <p data-fahrt-price data-i="s4_price" data-v-p={e(res.fahrt)}>{fill(T('s4_price'), { p: e(res.fahrt) })}</p>
            </div>
          </div>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="4">{e(res.perStop[4])}</strong></p>
      </section>

      <!-- Station 5: Sonderfahrten -->
      <section class="stop" id="station-5" data-stop="5" aria-labelledby="h-5">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="5">{fill(T('st_eyebrow'), { n: 5 })}</p>
        <h2 class="stop__h" id="h-5" data-i="s5_t">{T('s5_t')}</h2>
        <p class="stop__lead" data-i="s5_lead">{T('s5_lead')}</p>
        <div class="stop__body">
          <div class="sd">
            <div class="sd__row sd__row--ueber">
              <svg class="sd__ico" viewBox="0 0 34 34" aria-hidden="true"><path d="M9 32C9 20 22 20 22 2" /><path d="M17 32C17 24 30 24 30 2" /></svg>
              <p class="sd__label"><span data-i="s5_ueber">{T('s5_ueber')}</span> · 5</p>
              <div class="sd__dash" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <i></i>)}</div>
            </div>
            <div class="sd__row sd__row--bahn">
              <svg class="sd__ico" viewBox="0 0 34 34" aria-hidden="true"><rect x="3" y="7" width="28" height="20" rx="4" /><path d="M10 22L17 11L24 22" /></svg>
              <p class="sd__label"><span data-i="s5_bahn">{T('s5_bahn')}</span> · 4</p>
              <div class="sd__dash" aria-hidden="true">{[1, 2, 3, 4].map(() => <i></i>)}</div>
            </div>
            <div class="sd__row sd__row--nacht">
              <svg class="sd__ico" viewBox="0 0 34 34" aria-hidden="true"><path d="M26 22A12 12 0 1 1 14 4A10 10 0 0 0 26 22z" /></svg>
              <p class="sd__label"><span data-i="s5_nacht">{T('s5_nacht')}</span> · 3</p>
              <div class="sd__dash" aria-hidden="true">{[1, 2, 3].map(() => <i></i>)}</div>
            </div>
          </div>
          <p class="stop__note" data-i="s5_tip">{T('s5_tip')}</p>
          <p class="stop__note" data-sonder-each data-i="s5_each" data-v-p={e(res.sonder)}>{fill(T('s5_each'), { p: e(res.sonder) })}</p>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="5">{e(res.perStop[5])}</strong></p>
      </section>

      <!-- Station 6: Prüfung -->
      <section class="stop" id="station-6" data-stop="6" aria-labelledby="h-6">
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="6">{fill(T('st_eyebrow'), { n: 6 })}</p>
        <h2 class="stop__h" id="h-6" data-i="s6_t">{T('s6_t')}</h2>
        <p class="stop__lead" data-i="s6_lead">{T('s6_lead')}</p>
        <div class="stop__body">
          <ul class="facts">
            <li data-i="s6_f_theorie">{T('s6_f_theorie')}</li>
            <li data-i="s6_f_praxis">{T('s6_f_praxis')}</li>
          </ul>
          <div>
            <h3 class="stop__q" data-i="s6_plan_h">{T('s6_plan_h')}</h3>
            <div class="sws">
              <label class="sw">
                <input class="sw__input" type="checkbox" role="switch" name="retryT" data-retry="T" />
                <span class="sw__text"><strong data-i="s6_rt">{T('s6_rt')}</strong></span>
                <span class="sw__side"><span class="sw__price num" data-retry-price="T">{e(rc.t)}</span><span class="sw__track" aria-hidden="true"></span></span>
              </label>
              <label class="sw">
                <input class="sw__input" type="checkbox" role="switch" name="retryP" data-retry="P" />
                <span class="sw__text"><strong data-i="s6_rp">{T('s6_rp')}</strong></span>
                <span class="sw__side"><span class="sw__price num" data-retry-price="P">{e(rc.p)}</span><span class="sw__track" aria-hidden="true"></span></span>
              </label>
            </div>
          </div>
          <p class="stop__note" data-i="s6_note">{T('s6_note')}</p>
        </div>
        <p class="stop__sum"><span data-i="st_sum">{T('st_sum')}</span><strong class="num" data-sum="6">{e(res.perStop[6])}</strong></p>
      </section>

      <!-- Station 7: Ziel -->
      <section class="stop" id="station-7" data-stop="7" aria-labelledby="h-7">
        <div class="finish" aria-hidden="true"></div>
        <p class="stop__eyebrow" data-i="st_eyebrow" data-v-n="7">{fill(T('st_eyebrow'), { n: 7 })}</p>
        <h2 class="stop__h" id="h-7" data-i="s7_t">{T('s7_t')}</h2>
        <p class="stop__lead" data-i="s7_lead">{T('s7_lead')}</p>
        <div class="stop__body">
          <AnmeldungForm />
        </div>
      </section>
    </main>

    <aside class="slip-col" aria-labelledby="slip-h">
      <div class="slip">
        <div class="slip__head">
          <p class="slip__label" id="slip-h" data-i="ctr_label">{T('ctr_label')}</p>
          <Odometer value={res.total} name="slip" />
          <p class="slip__hint" data-i="ctr_hint">{T('ctr_hint')}</p>
        </div>
        <div class="beleg" data-beleg></div>
        <a class="btn slip__cta" href="#station-7" data-i="sheet_cta">{T('sheet_cta')}</a>
      </div>
    </aside>
  </div>

  <!-- Rastplatz -->
  <section class="rest" id="rastplatz" aria-labelledby="rest-h">
    <div class="rest__head">
      <svg class="rest__p" viewBox="0 0 56 56" aria-hidden="true"><rect x="2" y="2" width="52" height="52" rx="10" /><text x="28" y="41" text-anchor="middle">P</text></svg>
      <h2 class="rest__h" id="rest-h" data-i="rest_t">{T('rest_t')}</h2>
      <p class="rest__lead" data-i="rest_lead">{T('rest_lead')}</p>
    </div>

    <section class="sec" aria-labelledby="team-h">
      <h3 class="sec__h" id="team-h" data-i="team_h">{T('team_h')}</h3>
      <div class="team">
        {site.team.map((m) => (
          <article class="mate">
            <figure class="fig"><img src={`${base}img/${m.img}`} alt={T(`img_${m.id}`)} data-i-alt={`img_${m.id}`} style={`object-position:${m.pos}% 50%`} width="800" height="597" loading="lazy" decoding="async" /></figure>
            <h4 class="mate__name">{m.name}</h4>
            <p class="mate__role" data-i={`team_${m.id}_role`}>{T(`team_${m.id}_role`)}</p>
            <p class="mate__q" data-i={`team_${m.id}_q`}>{T(`team_${m.id}_q`)}</p>
            <ul class="chips">{m.langs.map((l) => <li data-i={langNames[l]}>{T(langNames[l])}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="cars-h">
      <h3 class="sec__h" id="cars-h" data-i="cars_h">{T('cars_h')}</h3>
      <div class="fleet">
        {site.cars.map((c) => (
          <article class="car-card">
            <figure class="fig fig--45"><img src={`${base}img/${c.img}`} alt={T(`img_${c.id}`)} data-i-alt={`img_${c.id}`} width="896" height="1200" loading="lazy" decoding="async" /></figure>
            <h3 data-i={`car_${c.id}`}>{T(`car_${c.id}`)}</h3>
            <p data-i={`car_d_${c.id}`}>{T(`car_d_${c.id}`)}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sec" aria-labelledby="visit-h">
      <h3 class="sec__h" id="visit-h" data-i="visit_h">{T('visit_h')}</h3>
      <div class="visit">
        <figure class="fig fig--43"><img src={`${base}img/haus.webp`} alt={T('img_haus')} data-i-alt="img_haus" width="896" height="1200" loading="lazy" decoding="async" /></figure>
        <dl>
          <div><dt data-i="visit_addr">{T('visit_addr')}</dt><dd>{site.name}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</dd></div>
          <div>
            <dt data-i="visit_hours">{T('visit_hours')}</dt>
            <dd><span data-i="visit_hours_t">{T('visit_hours_t')}</span><br /><span class="visit__state" data-open-state></span></dd>
          </div>
          <div><dt data-i="visit_phone">{T('visit_phone')}</dt><dd><a href={`tel:${tel}`}>{site.phone}</a></dd></div>
          <div><dt data-i="visit_mail">{T('visit_mail')}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
      </div>
    </section>

    <section class="sec" aria-labelledby="faq-h">
      <h3 class="sec__h" id="faq-h" data-i="faq_h">{T('faq_h')}</h3>
      <div class="faq">
        {[1, 2, 3, 4, 5].map((n) => (
          <details>
            <summary data-i={`faq${n}_q`}>{T(`faq${n}_q`)}</summary>
            <p data-i={`faq${n}_a`}>{T(`faq${n}_a`)}</p>
          </details>
        ))}
      </div>
    </section>
  </section>

  <footer class="foot">
    <p class="foot__name">{site.short}</p>
    <p class="foot__addr">{site.address.street}, {site.address.zip} {site.address.city}</p>
    <div class="foot__links">
      <a href={`${base}impressum/`} target="_blank" rel="noopener" data-i="ft_imp">{T('ft_imp')}</a>
      <a href={`${base}datenschutz/`} target="_blank" rel="noopener" data-i="ft_dat">{T('ft_dat')}</a>
    </div>
    <p class="foot__row" data-i="ft_note">{T('ft_note')}</p>
  </footer>

  <!-- Leiste (Handy) und Blatt -->
  <div class="bar" role="region" aria-label={T('ctr_label')} data-i-aria="ctr_label">
    <div class="bar__sum">
      <span class="bar__meta" data-bar-meta>{fill(T('bar_meta'), { n: 1 })}</span>
      <Odometer value={res.total} name="bar" />
    </div>
    <button class="bar__icon" type="button" aria-label={T('bar_beleg')} data-i-aria="bar_beleg" data-sheet-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6" /></svg>
    </button>
    <a class="btn" href="#station-7" data-i="bar_cta">{T('bar_cta')}</a>
  </div>

  <dialog class="sheet" id="sheet" aria-labelledby="sheet-h" data-sheet>
    <div class="sheet__head">
      <h2 id="sheet-h" data-i="beleg_title">{T('beleg_title')}</h2>
      <button class="sheet__x" type="button" data-sheet-close aria-label={T('sheet_close')} data-i-aria="sheet_close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      </button>
    </div>
    <div class="sheet__body"><div class="beleg" data-beleg></div></div>
    <div class="sheet__foot"><a class="btn" href="#station-7" data-sheet-cta data-i="sheet_cta">{T('sheet_cta')}</a></div>
  </dialog>

  <p class="sr-only" role="status" aria-live="polite" data-live></p>

  <script>
    import '../scripts/app.js';
  </script>
</Base>
