{%- comment -%} Flow: großes Szenenfoto mit Text darunter (Handy: hochkant, PC: breit) {%- endcomment -%}
<div class="kf-stage color-{{ section.settings.color_scheme }} gradient" data-tint-follow>
  <div class="page-width kf-stage__in">
    <figure class="kf-stage__media" data-reveal>
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_wide != blank -%}
            <source media="(min-width: 750px)" srcset="{{ section.settings.image_wide | image_url: width: 1600 }}">
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: widths: '450, 700, 900', sizes: '100vw', loading: 'lazy', alt: section.settings.alt
          }}
        </picture>
      {%- endif -%}
    </figure>
    <div class="kf-stage__text" data-reveal>
      <p class="k-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="k-h2">{{ section.settings.heading }}</h2>
      <p class="k-lead">{{ section.settings.text }}</p>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Flow Szene",
  "tag": "section",
  "class": "section k-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto hochkant (Handy)" },
    { "type": "image_picker", "id": "image_wide", "label": "Foto breit (PC)" },
    { "type": "text", "id": "alt", "label": "Bildbeschreibung", "default": "Frau läuft mit Kaffee durch die Stadt, das Handy hängt am Umhängeband" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Dein Tag" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Tag läuft. Das Handy läuft mit." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Kaffee in der einen Hand, Tasche in der anderen. Das Handy hängt griffbereit am Körper." },
    { "type": "select", "id": "color_scheme", "label": "Farbschema", "options": [
      { "value": "scheme-1", "label": "Schema 1" }, { "value": "scheme-2", "label": "Schema 2" },
      { "value": "scheme-3", "label": "Schema 3" }, { "value": "scheme-4", "label": "Schema 4" }, { "value": "scheme-5", "label": "Schema 5" }
    ], "default": "scheme-1" }
  ],
  "presets": [{ "name": "Flow Szene" }]
}
{% endschema %}
