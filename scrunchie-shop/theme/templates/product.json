{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "subtitle": {
          "type": "text",
          "settings": {
            "text": "Scrunchie-Band mit Tab. Passt zu jedem Handy mit Hülle.",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "total": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'knuell-buy-total', product: product %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "assurances": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Versand in 1–3 Werktagen",
            "icon_2": "return",
            "heading_2": "14 Tage Rückgabe",
            "icon_3": "lock",
            "heading_3": "Sicher bezahlen"
          }
        },
        "description": {
          "type": "description"
        },
        "tab_fit": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Passt das zu meinem Handy?",
            "icon": "none",
            "content": "<p>Ja, zu fast jedem Handy mit Hülle. Der flache Tab wird zwischen Handy und Hülle geschoben und hält dort an der Rückseite. Du brauchst keine Spezialhülle und kein Loch im Gehäuse.</p><p>Am besten hält er unter einer fest anliegenden Hülle (Silikon, Hartschale, Klarsicht). Sehr weiche oder lose Hüllen halten weniger gut.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Material und Pflege",
            "icon": "none",
            "content": "<p>Außen weicher Satin, innen elastisches Band. Umfang ca. 20 cm, dehnbar.</p><p>Von Hand bei 30 °C waschen, nicht in den Trockner.</p>"
          }
        },
        "tab_ship": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Versand und Rückgabe",
            "icon": "none",
            "content": "<p>Versand innerhalb Deutschlands in 1–3 Werktagen, ab 40 € kostenlos. 14 Tage Widerrufsrecht.</p><p><a href=\"/pages/versand-und-zahlung\">Alle Details zu Versand und Zahlung</a></p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "subtitle",
        "price",
        "variant_picker",
        "quantity_selector",
        "total",
        "buy_buttons",
        "assurances",
        "description",
        "tab_fit",
        "tab_care",
        "tab_ship"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 0,
        "padding_bottom": 24
      }
    },
    "how": {
      "type": "knuell-how",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Tab einlegen",
            "text": "Schiebe den flachen Tab zwischen Handy und Hülle."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Band einhaken",
            "text": "Hake das Scrunchie-Band am Tab ein."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Los geht's",
            "text": "Band ums Handgelenk, Hände frei."
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ],
      "settings": {
        "eyebrow": "So funktioniert's",
        "heading": "In 10 Sekunden angebracht",
        "text": "",
        "note": "",
        "color_scheme": "scheme-2"
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Dazu passt",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "how",
    "related-products",
    "disclosures"
  ]
}