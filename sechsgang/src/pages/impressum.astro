---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<Base title="Impressum · Sechsgang (Demo)" description="Impressum der Demo-Seite Sechsgang.">
  <div class="doc__top"><a href={base}>Sechsgang</a></div>
  <main class="doc">
    <h1>Impressum</h1>
    <p><strong>Demo-Hinweis:</strong> Diese Seite ist eine Beispielseite von Kravets Webdesign. Der Betrieb „Sechsgang“ ist erfunden. Die folgenden Angaben sind Platzhalter und keine echten Firmendaten.</p>
    <h2>Angaben nach § 5 DDG (Digitale-Dienste-Gesetz)</h2>
    <p>{site.legalName}<br />{site.address.street}<br />{site.address.zip} {site.address.city}</p>
    <h2>Kontakt</h2>
    <p>Telefon: {site.phone} (nicht erreichbar, erfunden)<br />E-Mail: {site.email} (nicht erreichbar, erfunden)</p>
    <h2>Weitere Pflichtangaben</h2>
    <!-- TODO vom Kunden: Vertretungsberechtigte, Handelsregister und Registernummer, USt-IdNr., ggf. Erlaubnis nach Güterkraftverkehrs- oder Personenbeförderungsrecht, Berufshaftpflicht, zuständige Kammer -->
    <p>Handelsregister, Umsatzsteuer-Identifikationsnummer und weitere Angaben: TODO vom Kunden.</p>
    <h2>Gestaltung und Umsetzung</h2>
    <p>Kravets Webdesign, Gehrden. Bilder teils KI-erzeugt, Betrieb und Personen erfunden.</p>
    <p><a href={base}>← Zurück zur Startseite</a></p>
  </main>
</Base>
