---
import '@fontsource-variable/onest';
import '../styles/global.css';
import site from '../data/site.json';
const { title = `${site.name} · ${site.tagline}`, description = 'Fahrzeugaufbereitung in Gehrden: Politur, Innenraum, Ozon, Folie. Demo-Seite von Kravets Webdesign.', game = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0c24" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class={game ? 'is-game' : 'is-doc'}>
    <slot />
    {!game && (
      <footer class="doc-foot">
        <a href={base}>Zur Box</a>
        <a href={`${base}impressum/`}>Impressum</a>
        <a href={`${base}datenschutz/`}>Datenschutz</a>
        <p>Demo-Seite von Kravets Webdesign: Betrieb und Personen sind erfunden.</p>
      </footer>
    )}
  </body>
</html>
