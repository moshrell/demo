---
/** Hero: 3D-Haus im Schnitt (Three.js). Scroll schaltet die Räume nacheinander an, Tippen fliegt die Kamera in den Raum.
 *  Ohne JS / WebGL: Titel + Link zu den Leistungen (der Rest der Seite trägt alle Inhalte). */
import site from '../data/site.json';
import leistungen from '../data/leistungen.json';
const svc = Object.fromEntries(leistungen.map((l, i) => [l.slug, { f: `F${i + 1}`, nav: l.nav }]));
const base = import.meta.env.BASE_URL;
---
<section class="h3 night" data-h3 data-svc={JSON.stringify(svc)} aria-label="Haus im Schnitt: Räume gehen nacheinander an">
  <div class="h3__pin">
    <div class="h3__stage"><canvas data-c aria-hidden="true"></canvas></div>
    <canvas class="h3__spark" data-spark aria-hidden="true"></canvas>
    <div class="h3__top">
      <p class="h3__kicker"><span class="strip">{site.name}</span></p>
      <h1>Ihr Haus.<br />Unter Strom.</h1>
      <p class="h3__sub">Elektromeister und fünf Monteure in Gehrden: Altbau, Wallbox, PV, E-Check.</p>
    </div>
    <p class="h3__tip" data-tip aria-hidden="true"><span data-tip-t>Leuchtenden Raum antippen</span></p>
    <div class="h3__foot">
      <p class="h3__hint" data-hint aria-live="polite">Nach unten wischen</p>
      <a class="h3__skip" href="#leistungen">Zu den Leistungen <span aria-hidden="true">↓</span></a>
    </div>
    <aside class="h3__card" data-card hidden>
      <span class="strip" data-f></span>
      <h2 data-n></h2>
      <p data-l></p>
      <div class="h3__btns">
        <a class="btn btn--amber" data-go href={base}>Leistung ansehen</a>
        <button class="btn btn--line" type="button" data-back>Zurück</button>
      </div>
    </aside>
  </div>
</section>
<noscript><style>.h3{height:auto;min-height:70svh}</style></noscript>
<div class="dawn" aria-hidden="true"></div>

<style>
  .h3 { position: relative; height: 420svh; background: radial-gradient(120% 80% at 50% 0%, #1a2540 0%, #0b0f1a 60%, #06080e 100%); color: var(--color-ink); }
  .h3[data-fail] { height: auto; min-height: 70svh; }
  .h3__pin { position: sticky; top: var(--head-h); height: calc(100svh - var(--head-h) - var(--bar-h) - env(safe-area-inset-bottom)); min-height: 26rem; overflow: hidden; }
  .h3__stage, .h3__stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .h3__spark { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .h3__top { transition: opacity 0.4s, transform 0.4s; position: absolute; inset: 0 0 auto 0; padding: var(--space-md) var(--gutter) 0; pointer-events: none; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.75); display: grid; gap: var(--space-sm); justify-items: start; transition: opacity 0.4s; }
  .h3__top h1 { font-size: clamp(2.1rem, 7.5vw, 4.6rem); font-weight: 600; line-height: 0.98; letter-spacing: -0.012em; }
  .h3__sub { max-width: 26rem; font-size: var(--text-sm); color: var(--color-ink-2); }
  .h3__pin[data-room] .h3__top, .h3__pin[data-room] .h3__foot { opacity: 0; pointer-events: none; }
  .h3__pin.is-scrolled .h3__top { opacity: 0; transform: translateY(-0.5rem); }
  .h3__tip { position: absolute; top: var(--space-lg); left: 0; right: 0; z-index: 2; margin: 0; padding: 0 var(--gutter); text-align: center; font: 500 clamp(1.05rem, 5.2vw, 1.5rem) / 1.25 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: oklch(92% 0.09 80); text-shadow: 0 0 0.6rem oklch(80% 0.17 70 / 0.85), 0 0 1.6rem oklch(75% 0.18 60 / 0.55); opacity: 0; transform: translateY(-0.5rem); pointer-events: none; transition: opacity 0.4s, transform 0.4s; }
  .h3__pin.is-scrolled:not([data-room]) .h3__tip { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) { .h3__pin.is-scrolled:not([data-room]) .h3__tip { animation: h3-glow 2.6s ease-in-out infinite; } }
  @keyframes h3-glow { 0%, 100% { text-shadow: 0 0 0.5rem oklch(80% 0.17 70 / 0.7), 0 0 1.2rem oklch(75% 0.18 60 / 0.4); opacity: 0.88; } 45% { text-shadow: 0 0 0.8rem oklch(85% 0.17 75 / 1), 0 0 2.2rem oklch(75% 0.18 60 / 0.75); opacity: 1; } 52% { opacity: 0.8; } 58% { opacity: 1; } }
  .h3__foot { position: absolute; left: var(--gutter); right: var(--gutter); bottom: var(--space-sm); z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); transition: opacity 0.4s; }
  .h3__hint { margin: 0; font: 500 var(--text-xs) / 1.2 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-2); }
  .h3__skip { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding: 0 var(--space-md); border: 1px solid var(--color-rule); border-radius: 999px; background: oklch(14% 0.01 260 / 0.7); color: var(--color-ink); font-size: var(--text-sm); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .h3__skip:hover { border-color: var(--color-amber); }
  .h3__card { position: absolute; left: var(--gutter); right: var(--gutter); bottom: var(--space-sm); background: oklch(14% 0.01 260 / 0.88); backdrop-filter: blur(8px); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-md); display: grid; gap: var(--space-sm); justify-items: start; }
  .h3__card[hidden] { display: none; }
  .h3__card h2 { font-size: var(--text-2xl); }
  .h3__card p { color: var(--color-ink-2); }
  .h3__btns { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
  .dawn { height: 26svh; background: linear-gradient(to bottom, #06080e 0%, #2a2430 28%, #b98a5e 62%, var(--color-paper) 100%); }
  @media (min-width: 60rem) {
    .h3__pin { height: calc(100svh - var(--head-h)); }
    .h3__foot { bottom: var(--space-md); }
  }
  @media (min-width: 48rem) {
    .h3__card { left: var(--space-xl); right: auto; bottom: auto; top: 50%; transform: translateY(-50%); width: 22rem; }
    .h3__top { padding-left: var(--space-xl); }
    .h3__foot { left: var(--space-xl); right: var(--space-xl); }
  }
</style>

<script>
  import { createHero, ROOMS } from '../scripts/haus3d';
  const base = import.meta.env.BASE_URL;
  const q = <T extends Element>(s: string) => document.querySelector(s) as T;
  const sec = q<HTMLElement>('[data-h3]'), cv = q<HTMLCanvasElement>('[data-c]'), card = q<HTMLElement>('[data-card]'), hint = q<HTMLElement>('[data-hint]'), pin = q<HTMLElement>('.h3__pin');
  const svcMap = JSON.parse(sec.dataset.svc || '{}') as Record<string, { f: string; nav: string }>;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const order = ['bad', 'garage', 'dach', 'keller', 'buero', 'kueche', 'garten', 'schlaf', 'wohnen'] as const;
  const service: Record<string, string> = { keller: 'altbau', bad: 'altbau', kueche: 'smart-home', wohnen: 'smart-home', schlaf: 'smart-home', garage: 'wallbox', buero: 'e-check', dach: 'pv-speicher', garten: 'beleuchtung' };
  // Neuer Aufruf oder Neuladen: oben starten (Zurück-Navigation darf Position behalten)
  const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  if (navType !== 'back_forward' && !location.hash) { history.scrollRestoration = 'manual'; scrollTo(0, 0); }
  addEventListener('pageshow', (e) => { if (!e.persisted && !location.hash && navType !== 'back_forward') scrollTo(0, 0); });
  (async () => {
    let hero: Awaited<ReturnType<typeof createHero>>;
    try { hero = await createHero(cv, base, [...order]); } catch (e) { console.error(e); hint.textContent = ''; sec.setAttribute('data-fail', ''); return; }
    sec.setAttribute('data-ready', ''); hero.resize();
    (window as any).__hero = hero;
    const prog = () => { const r = sec.getBoundingClientRect(); const max = sec.offsetHeight - pin.offsetHeight; return Math.min(1, Math.max(0, -r.top / max)); };
    let inRoom = false;
    const upd = () => {
      const p = reduce ? 1 : prog(); if (!inRoom) hero.setProgress(p);
      const n = hero.litIds().length;
      hint.textContent = inRoom ? '' : p < 0.04 ? 'Nach unten wischen' : `${n} von ${order.length} an`;
      q('[data-tip-t]').textContent = n >= order.length ? 'Raum antippen' : 'Leuchtenden Raum antippen';
      pin.classList.toggle('is-scrolled', p > 0.03 && !reduce);
    };
    addEventListener('scroll', upd, { passive: true }); addEventListener('resize', () => { hero.resize(); upd(); }); upd();
    const open = (id: string) => {
      const r = ROOMS.find((x) => x.id === id)!; inRoom = true; hero.flyTo(id as any); if (reduce) hero.skip();
      const sv = svcMap[service[id]]; q('[data-f]').textContent = sv ? `${sv.f} · ${sv.nav}` : r.name; q('[data-n]').textContent = r.name; q('[data-l]').textContent = r.line;
      q<HTMLAnchorElement>('[data-go]').href = `${base}${service[id]}/`; card.hidden = false; hint.textContent = '';
      pin.setAttribute('data-room', ''); document.documentElement.style.overflow = 'hidden';
    };
    const close = () => { inRoom = false; hero.flyTo(null); if (reduce) hero.skip(); card.hidden = true; pin.removeAttribute('data-room'); document.documentElement.style.overflow = ''; upd(); };
    hero.onPick((id) => { if (inRoom) return; if (id) { if (hero.litIds().includes(id)) open(id); else { hero.light(id, true); upd(); } } });
    q('[data-back]').addEventListener('click', close); addEventListener('keydown', (e) => { if (e.key === 'Escape' && inRoom) close(); });
    matchMedia('(pointer: fine)').matches && !reduce && cv.addEventListener('pointermove', (e) => { const r = cv.getBoundingClientRect(); hero.setPointer(((e.clientX - r.left) / r.width - 0.5) * 2, ((e.clientY - r.top) / r.height - 0.5) * 2); });
    // Funken unter dem Finger (nur Touch, selten, klein)
    const sp = q<HTMLCanvasElement>('[data-spark]'); const g = sp.getContext('2d')!; const parts: { x: number; y: number; vx: number; vy: number; t: number }[] = [];
    const fit = () => { sp.width = sp.clientWidth * devicePixelRatio; sp.height = sp.clientHeight * devicePixelRatio; }; fit(); addEventListener('resize', fit);
    let lastSpawn = 0; let ticking = false; let lt = 0;
    const tick = (now: number) => { const dt = Math.min(0.04, (now - (lt || now)) / 1000); lt = now; g.clearRect(0, 0, sp.width, sp.height);
      for (let i = parts.length - 1; i >= 0; i--) { const p = parts[i]; p.t += dt; if (p.t > 0.4) { parts.splice(i, 1); continue; } p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 260 * dt; const a = 1 - p.t / 0.4; g.strokeStyle = `rgba(255,${180 + 50 * a | 0},90,${a})`; g.lineWidth = 1.6 * devicePixelRatio; g.beginPath(); g.moveTo(p.x * devicePixelRatio, p.y * devicePixelRatio); g.lineTo((p.x - p.vx * 0.04) * devicePixelRatio, (p.y - p.vy * 0.04) * devicePixelRatio); g.stroke(); }
      if (parts.length) requestAnimationFrame(tick); else { ticking = false; lt = 0; g.clearRect(0, 0, sp.width, sp.height); } };
    const spawn = (x: number, y: number) => { for (let i = 0; i < 3; i++) parts.push({ x, y, vx: (Math.random() - 0.5) * 160, vy: (Math.random() - 0.7) * 160, t: 0 }); if (!ticking) { ticking = true; requestAnimationFrame(tick); } };
    if (!reduce) addEventListener('touchmove', (e) => { const t = e.touches[0]; const r = sp.getBoundingClientRect(); if (inRoom || r.bottom < 0 || r.top > innerHeight) return; const now = performance.now(); if (now - lastSpawn > 220 && Math.random() < 0.6) { lastSpawn = now; spawn(t.clientX, t.clientY - r.top); } }, { passive: true });
  })();
</script>
