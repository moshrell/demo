---
// SEO + KI-Sichtbarkeit (AIO). Demos: noindex (index = false). Beim Kundenstart: index = true.
import '@fontsource-variable/sofia-sans-condensed';
import '@fontsource-variable/sofia-sans';
import '@fontsource-variable/martian-mono';
import '../styles/global.css';
import site from '../data/site.json';
import leistungen from '../data/leistungen.json';
const {
  title = `${site.name} · Elektromeister in Gehrden`,
  description = 'Elektro Brakhage (Demo): Altbau-Elektrik, Zählerschrank, Wallbox, PV und Speicher, E-Check nach DGUV V3 in Gehrden, Ronnenberg und Barsinghausen.',
  index = false,
  type = 'Electrician',
  faq = [],
  image = '',
  prices = [],
  bar = true,
  bodyClass = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(base + image.replace(/^\//, ''), Astro.site).href : undefined;
const graph = [
  ...(index ? [{
    '@type': type,
    '@id': new URL(base, Astro.site).href + '#business',
    name: site.name, url: new URL(base, Astro.site).href, description,
    telephone: site.phone, email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressCountry: 'DE' },
    openingHours: site.openingHours, areaServed: site.areaServed,
    ...(prices.length ? { makesOffer: prices.map((p) => ({ '@type': 'Offer', priceCurrency: 'EUR', price: p.price, itemOffered: { '@type': 'Service', name: p.name } })) } : {}),
  }] : []),
  ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
const ld = { '@context': 'https://schema.org', '@graph': graph };
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#141210" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="head">
      <a class="head__mark" href={base} aria-label={`${site.name}, Startseite`}>
        <span class="head__name">Brakhage</span><span class="head__sub">Elektro</span>
      </a>
      <p class="status" data-status aria-live="polite">
        <span class="status__dot" aria-hidden="true"></span>
        <span data-status-text>{site.hoursText}</span>
      </p>
      <button class="menu" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="vz" data-vz-open>Menü</button>
    </header>

    <div class="vz" id="vz" role="dialog" aria-modal="true" aria-label="Menü: Stromkreisverzeichnis" hidden>
      <div class="vz__in">
        <header class="vz__top">
          <p class="vz__title">Stromkreisverzeichnis</p>
          <button class="vz__x" type="button" data-vz-close aria-label="Menü schließen">Schließen</button>
        </header>
        <nav aria-label="Hauptmenü">
          <ol class="vz__list">
            {leistungen.map((l, i) => (
              <li style={`--i:${i}`}><a href={`${base}${l.slug}/`}><span class="vz__f">F{i + 1}</span><span class="vz__n">{l.nav}</span></a></li>
            ))}
            <li style={`--i:${leistungen.length}`}><a class="vz__nd" href={`${base}notdienst/`}><span class="vz__f">F{leistungen.length + 1}</span><span class="vz__n">Notdienst</span><span class="vz__p">24 h</span></a></li>
          </ol>
          <ul class="vz__more">
            <li><a href={`${base}team/`}>Über uns</a></li>
            <li><a href={`${base}anfrage/`}>Anfrage</a></li>
            <li><a href={`${base}#preise`}>Preise</a></li>
          </ul>
        </nav>
        <p class="vz__tel"><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a class="vz__nd2" href={`tel:${site.notdienstHref}`}>Notdienst {site.notdienst}</a></p>
      </div>
    </div>

    <slot />

    <footer class="foot">
      <div class="foot__in">
        <p class="foot__name">{site.name} · {site.title}</p>
        <p>{site.address.street}, {site.address.zip} {site.address.city} · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p>{site.hoursText} · Notdienst: <a href={`tel:${site.notdienstHref}`}>{site.notdienst}</a></p>
        <p class="foot__links"><a href={`${base}impressum/`}>Impressum</a> <a href={`${base}datenschutz/`}>Datenschutz</a> <a href={`${base}team/`}>Über uns</a></p>
        {!index && <p class="foot__demo">Demo-Seite, alle Angaben fiktiv. <a href="https://kravets-webdesign.de/kontakt/">Eine solche Website für Ihren Betrieb? Jetzt anfragen</a></p>}
      </div>
    </footer>

    {bar && (
      <p class="bar" aria-hidden="true"><span class="bar__l">Zählerstand</span><span class="bar__d" data-zaehler>00000</span><span class="bar__u">kWh</span></p>
    )}

    <script type="application/json" id="hours-data" set:html={JSON.stringify(site.hours)} />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: var(--space-sm); top: -4rem; z-index: 100; background: var(--color-cream); color: var(--color-cream-ink); padding: var(--space-sm) var(--space-md); border-radius: var(--radius); }
  .skip:focus { top: var(--space-sm); }

  .head {
    position: sticky; top: 0; z-index: 40; height: var(--head-h);
    display: flex; align-items: center; gap: var(--space-smd);
    padding: 0 var(--gutter);
    background: oklch(16% 0.006 70);
    border-bottom: 1px solid var(--color-rule);
  }
  .head__mark { display: inline-flex; align-items: center; min-height: 2.75rem; gap: var(--space-xs); text-decoration: none; color: var(--color-ink); flex: none; }
  .head__name { font: 800 1.35rem/1 var(--font-display); letter-spacing: 0.01em; text-transform: uppercase; }
  .head__sub { font: 500 0.75rem/1 var(--font-mono); color: var(--color-amber); text-transform: uppercase; letter-spacing: 0.06em; }
  .status { display: inline-flex; align-items: center; gap: var(--space-xs); margin: 0 0 0 auto; min-width: 0; font: 500 0.75rem/1.2 var(--font-mono); font-stretch: 87.5%; color: var(--color-ink-2); }
  .status [data-status-text] { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .status__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-led-off); flex: none; }
  .status.is-open .status__dot { background: var(--color-amber); box-shadow: 0 0 0.5rem var(--color-amber-glow); }
  .status.is-open { color: var(--color-ink); }

  @media (max-width: 30rem) { .head { gap: var(--space-sm); } .head__sub { display: none; } .status { font-size: 0.75rem; gap: 0.3rem; line-height: 1.15; } .status [data-status-text] { white-space: normal; overflow: visible; text-overflow: clip; } }
  .menu { flex: none; cursor: pointer; min-height: 2.75rem; display: inline-flex; align-items: center; padding: 0 0.75rem; background: transparent; border: 1px solid var(--color-rule); border-radius: var(--radius); font: 600 var(--text-sm)/1 var(--font-body); color: var(--color-ink); }
  .menu:hover { background: var(--color-paper-3); }

  /* Menü = Stromkreisverzeichnis (wie der Zettel im Sicherungskasten) */
  .vz { position: fixed; inset: 0; z-index: 70; background: var(--color-paper); color: var(--color-ink); overflow-y: auto; overscroll-behavior: contain; }
  .vz[hidden] { display: none; }
  .vz__in { width: min(100% - 2 * var(--gutter), 40rem); margin-inline: auto; padding: var(--space-md) 0 var(--space-xl); display: grid; gap: var(--space-lg); }
  .vz__top { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }
  .vz__title { margin: 0; font: 500 var(--text-xs)/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-2); flex: 1 1 auto; }
  .vz__x { min-height: 2.75rem; padding: 0 var(--space-smd); background: transparent; border: 1px solid var(--color-rule); border-radius: var(--radius); color: var(--color-ink); font: 600 var(--text-sm)/1 var(--font-body); cursor: pointer; }
  .vz__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .vz__list li { border-bottom: 1px solid var(--color-rule); }
  .vz__list a { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) auto; align-items: center; gap: var(--space-smd); min-height: 4rem; padding: var(--space-md) 0; color: var(--color-ink); text-decoration: none; position: relative; }
  .vz__list a::before { content: ''; position: absolute; left: -0.75rem; top: 50%; width: 0.4rem; height: 0.4rem; margin-top: -0.2rem; border-radius: 50%; background: var(--color-led-off); }
  .vz__list a:hover::before, .vz__list a:focus-visible::before { background: var(--color-amber); box-shadow: 0 0 0.6rem var(--color-amber-glow); }
  .vz__f { font: 600 var(--text-xs)/1 var(--font-mono); color: var(--color-amber-hi); }
  .vz__n { font: 750 clamp(1.3rem, 5vw, 1.9rem)/1.05 var(--font-display); text-transform: uppercase; letter-spacing: 0.01em; }
  .vz__p { font: 500 var(--text-xs)/1.2 var(--font-mono); font-stretch: 87.5%; color: var(--color-ink-2); text-align: right; white-space: nowrap; }
  .vz__nd .vz__f, .vz__nd .vz__p { color: var(--color-alert); }
  .vz__more { list-style: none; margin: var(--space-lg) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); }
  .vz__more a { display: inline-block; padding: var(--space-sm) 0; color: var(--color-ink); font-weight: 600; }
  .vz__tel { margin: 0; display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); flex-wrap: wrap; color: var(--color-ink-2); font-size: var(--text-sm); }
  .vz__tel .vz__nd2 { color: var(--color-alert); font-size: var(--text-sm); }
  .vz__tel a { min-height: 2.75rem; display: inline-flex; align-items: center; color: var(--color-amber-hi); font: 600 var(--text-md)/1.2 var(--font-mono); text-decoration: none; }
  @media (prefers-reduced-motion: no-preference) {
    .vz:not([hidden]) .vz__list li { animation: vz-in 420ms var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
    .vz:not([hidden]) .vz__list a::before { animation: vz-led 600ms ease-out both; animation-delay: calc(var(--i) * 45ms + 120ms); }
  }
  @keyframes vz-in { from { opacity: 0; transform: translateY(0.6rem); } }
  @keyframes vz-led { 0% { background: var(--color-amber); box-shadow: 0 0 0.8rem var(--color-amber-glow); } 100% { background: var(--color-led-off); box-shadow: none; } }
  html.vz-open { overflow: hidden; }

  .foot { border-top: 1px solid var(--color-rule); background: var(--color-paper-2); color: var(--color-ink-2); font-size: var(--text-sm); }
  .foot__in { width: min(100% - 2 * var(--gutter), 46rem); margin-inline: auto; padding: var(--space-xl) 0 calc(var(--space-xl) + var(--bar-h) + env(safe-area-inset-bottom)); display: grid; gap: var(--space-sm); }
  .foot a[href^='tel'] { white-space: nowrap; }
  .foot__name { color: var(--color-ink); font-weight: 700; }
  .foot__links { display: flex; flex-wrap: wrap; gap: 0 var(--space-lg); }
  .foot__links a { display: inline-flex; align-items: center; min-height: 2.75rem; white-space: nowrap; }
  .foot__demo { font-size: var(--text-xs); }

  .bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; margin: 0; pointer-events: none;
    display: flex; align-items: center; justify-content: center; gap: var(--space-smd);
    height: calc(var(--bar-h) + env(safe-area-inset-bottom)); padding: 0 var(--gutter) env(safe-area-inset-bottom);
    background: oklch(13% 0.006 70 / 0.96); border-top: 1px solid var(--color-rule);
    font: 500 var(--text-xs)/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-2);
  }
  .bar__d { padding: 0.25rem 0.5rem; background: var(--strip-bg); color: var(--strip-ink); border-radius: 2px; letter-spacing: 0.22em; font-weight: 600; font-variant-numeric: tabular-nums; }
  @media (min-width: 60rem) {
    .bar { left: auto; right: var(--gutter); bottom: var(--space-md); width: auto; padding: 0 var(--space-md); border: 1px solid var(--color-rule); border-radius: var(--radius-lg); height: var(--bar-h); }
  }
</style>

<script>
  // Status "jetzt geöffnet" nach Zeit in Europe/Berlin
  import { berlinStatus } from '../scripts/hours';
  const el = document.querySelector<HTMLElement>('[data-status]');
  const data = document.getElementById('hours-data');
  if (el && data) {
    const hours = JSON.parse(data.textContent || '[]');
    const run = () => {
      const s = berlinStatus(hours);
      el.classList.toggle('is-open', s.open);
      el.querySelector('[data-status-text]')!.textContent = s.text;
      document.querySelectorAll<HTMLElement>('[data-status-long]').forEach((n) => (n.textContent = s.long));
      document.documentElement.dataset.open = s.open ? '1' : '0';
    };
    run();
    setInterval(run, 60000);
  }
  // Logo auf der Startseite: nach ganz oben, nicht zur gemerkten Scrollposition
  document.querySelector<HTMLAnchorElement>('.head__mark')?.addEventListener('click', (e) => { const a = e.currentTarget as HTMLAnchorElement; if (new URL(a.href).pathname === location.pathname) { e.preventDefault(); scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior }); history.replaceState(null, '', location.pathname); } });
  // Menü = Stromkreisverzeichnis
  const vz = document.getElementById('vz') as HTMLElement;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-vz-open]')!;
  const zaehler = document.querySelector<HTMLElement>('[data-zaehler]');
  const setZ = () => { if (!zaehler) return; const max = document.documentElement.scrollHeight - innerHeight; const p = max > 0 ? Math.min(1, scrollY / max) : 0; zaehler.textContent = String(Math.round(p * 99999)).padStart(5, '0'); };
  let zq = false; addEventListener('scroll', () => { if (zq) return; zq = true; requestAnimationFrame(() => { zq = false; setZ(); }); }, { passive: true }); addEventListener('resize', setZ); setZ();
  const openVz = () => { vz.hidden = false; document.documentElement.classList.add('vz-open'); openBtn.setAttribute('aria-expanded', 'true'); vz.querySelector<HTMLElement>('.vz__list a')?.focus(); };
  const closeVz = () => { vz.hidden = true; document.documentElement.classList.remove('vz-open'); openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); };
  openBtn.addEventListener('click', openVz);
  vz.querySelector('[data-vz-close]')!.addEventListener('click', closeVz);
  vz.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest('a'); if (a) { vz.hidden = true; document.documentElement.classList.remove('vz-open'); openBtn.setAttribute('aria-expanded', 'false'); } });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !vz.hidden) closeVz(); });
</script>
