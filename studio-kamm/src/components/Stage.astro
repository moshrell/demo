---
// Левая панель: фото, которое меняется вслед за выбором (категория, мастер), статус «открыто», отзывы и меню.
import Photo from './Photo.astro';
import site from '../data/site.json';
const layers = [
  { key: 'salon', file: 'salon.jpg', alt: 'Das Studio: zwei Stühle vor runden Spiegeln, Tageslicht', cap: `${site.legalName} · ${site.contact.street}` },
  ...site.categories.map((c) => ({ key: c.id, file: c.photo, alt: c.label, cap: `${c.label} · ${c.sub}` })),
  ...site.team.map((t) => ({ key: t.id, file: t.photo, alt: `${t.name}, ${t.role}`, cap: `${t.name} · ${t.focus}` })),
];
const menu = [['arbeiten', 'Arbeiten'], ['team', 'Team'], ['salon', 'Anfahrt & Kontakt']];
---
<aside class="stage" data-stage aria-label="Über den Salon">
  <div class="layers">
    {layers.map((l, i) => (
      <figure class={`layer${i === 0 ? ' on' : ''}`} data-key={l.key} data-cap={l.cap}>
        <Photo file={l.file} alt={l.alt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 45vw" loading="eager" />
      </figure>
    ))}
  </div>
  <div class="shade" aria-hidden="true"></div>

  <header class="top">
    <a class="logo" href="#" aria-label={site.legalName}>Kamm<span>.</span></a>
    <button type="button" class="status" data-sheet="salon" data-hours={JSON.stringify(site.hours)} aria-label="Öffnungszeiten und Anfahrt"><i></i><span>…</span></button>
  </header>

  <div class="bottom">
    <p class="cap" aria-live="polite"><span class="cap-text">{layers[0].cap}</span></p>
    <figure class="quote" aria-label="Stimmen von Gästen">
      {site.reviews.map((r, i) => (
        <blockquote class={i === 0 ? 'on' : ''}><p>„{r.text}“</p><footer>{r.name} · Beispieltext</footer></blockquote>
      ))}
    </figure>
    <nav class="menu" aria-label="Infos">
      {menu.map(([id, label]) => <button type="button" data-sheet={id}>{label}</button>)}
    </nav>
    <a class="demo" href={site.credit.portfolio}>← Portfolio · {site.demoNotice}</a>
  </div>
</aside>

<style>
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; color: var(--white); background: #2a2926; isolation: isolate; }
  .layers, .layer { position: absolute; inset: 0; margin: 0; }
  .layer { opacity: 0; transition: opacity .9s var(--ease); }
  .layer.on { opacity: 1; }
  .layer :global(img), .layer :global(.ph) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 8s linear; }
  .layer.on :global(img), .layer.on :global(.ph) { transform: scale(1); }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.42) 0%, rgba(0,0,0,0) 26%, rgba(0,0,0,0) 46%, rgba(0,0,0,.7) 100%); pointer-events: none; }

  .top { position: absolute; inset: 0 0 auto 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: clamp(18px, 3vw, 32px); }
  .logo { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; letter-spacing: -.06em; text-decoration: none; line-height: 1; }
  .logo span { color: #8d9bff; }
  .status { border: 0; color: inherit; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 999px; background: rgba(18, 18, 18, .45); backdrop-filter: blur(10px); font-size: .78rem; font-weight: 550; }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: #c9c6be; }
  .status.open i { background: #52d27e; box-shadow: 0 0 0 0 rgba(82,210,126,.6); animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px rgba(82,210,126,0); } 100% { box-shadow: 0 0 0 0 rgba(82,210,126,0); } }

  .bottom { position: absolute; inset: auto 0 0 0; padding: clamp(18px, 3vw, 32px); display: grid; gap: 18px; }
  .cap { margin: 0; font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; opacity: .8; overflow: hidden; }
  .cap-text { display: inline-block; transition: transform .45s var(--ease), opacity .3s; }
  .cap-text.out { transform: translateY(100%); opacity: 0; }
  .quote { display: grid; margin: 0; max-width: 34ch; }
  .quote blockquote { grid-area: 1 / 1; margin: 0; opacity: 0; transform: translateY(10px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .quote blockquote.on { opacity: 1; transform: none; }
  .quote p { margin: 0 0 6px; font-size: clamp(1.05rem, 1.6vw, 1.35rem); line-height: 1.3; font-weight: 500; letter-spacing: -.015em; }
  .quote footer { font-size: .78rem; opacity: .7; }
  .menu { display: flex; flex-wrap: wrap; gap: 6px; }
  .menu button { padding: 9px 15px; border-radius: 999px; border: 0; background: rgba(251, 250, 247, .14); backdrop-filter: blur(10px); color: var(--white); font-size: .85rem; font-weight: 550; cursor: pointer; transition: background .2s, color .2s; }
  .menu button:hover { background: var(--white); color: var(--ink); }
  .demo { font-size: .7rem; opacity: .65; text-decoration: none; }
  .demo:hover { opacity: 1; }

  @media (max-width: 900px) {
    .stage { position: relative; height: 40svh; min-height: 280px; }
    .quote { display: none; }
    .bottom { gap: 12px; }
    .menu { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * clamp(18px, 3vw, 32px)); padding-inline: clamp(18px, 3vw, 32px); }
    .menu button { flex: none; }
  }
</style>

<script>
  import { openState } from '../scripts/open.js';
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const layers = [...stage.querySelectorAll<HTMLElement>('.layer')];
  const capText = stage.querySelector<HTMLElement>('.cap-text')!;
  let current = 'salon', timer = 0;
  // Показать слой по ключу (категория, мастер или «salon»). Вызывается из приложения записи.
  const show = (key: string) => {
    if (!layers.some((l) => l.dataset.key === key)) key = 'salon';
    if (key === current) return;
    current = key;
    layers.forEach((l) => l.classList.toggle('on', l.dataset.key === key));
    const cap = layers.find((l) => l.dataset.key === key)!.dataset.cap!;
    capText.classList.add('out');
    clearTimeout(timer);
    timer = window.setTimeout(() => { capText.textContent = cap; capText.classList.remove('out'); }, 250);
  };
  window.addEventListener('kamm:stage', (e) => show((e as CustomEvent).detail));

  // Отзывы сменяются каждые 6 секунд
  const qs = [...stage.querySelectorAll('.quote blockquote')];
  let qi = 0;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { qs[qi].classList.remove('on'); qi = (qi + 1) % qs.length; qs[qi].classList.add('on'); }, 6000);

  const st = stage.querySelector<HTMLElement>('.status')!;
  const s = openState(JSON.parse(st.dataset.hours!));
  st.classList.toggle('open', s.open);
  st.querySelector('span')!.textContent = s.open ? `Geöffnet · ${s.text}` : `Geschlossen · ${s.text}`;
</script>
