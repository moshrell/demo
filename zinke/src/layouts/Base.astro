---
// SEO + KI-Sichtbarkeit (AIO) by default. Demos: noindex (index = false). Beim Kundenstart: index = true setzen.
import '@fontsource/alegreya/latin-500.css';
import '@fontsource/alegreya/latin-700.css';
import '@fontsource/alegreya-sans/latin-400.css';
import '@fontsource/alegreya-sans/latin-400-italic.css';
import '@fontsource/alegreya-sans/latin-700.css';
import '@fontsource/caveat/latin-600.css';
import '../styles/global.css';
import site from '../data/site.json';
const {
  title = site.name,
  description = '',
  index = false,          // Demo = noindex. Echte Kundenseite: index
  type = 'HomeAndConstructionBusiness',
  faq = [],
  image = '',
  prices = [],
  bodyClass = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(base + image.replace(/^\//, ''), Astro.site).href : undefined;
const graph = [
  ...(index ? [{
    '@type': type,
    '@id': new URL(base, Astro.site).href + '#business',
    name: site.name,
    url: new URL(base, Astro.site).href,
    description,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: site.address.street, postalCode: site.address.zip, addressLocality: site.address.city, addressCountry: 'DE' },
    ...(site.openingHours ? { openingHours: site.openingHours } : {}),
    ...(site.areaServed ? { areaServed: site.areaServed } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    ...(prices.length ? { makesOffer: prices.map((p) => ({ '@type': 'Offer', priceCurrency: 'EUR', price: p.price, itemOffered: { '@type': 'Service', name: p.name } })) } : {}),
  }] : []),
  ...(faq.length ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5efe4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class={bodyClass}>
    <slot />
    <footer class="site-foot">
      <div class="site-foot__in">
        <slot name="foot" />
        <p><a href={`${base}impressum/`}>Impressum</a> · <a href={`${base}datenschutz/`}>Datenschutz</a></p>
        {!index && <p>Demo-Seite von Kravets Webdesign: Betrieb, Personen und Preise sind erfunden. <a href="https://kravets-webdesign.de/kontakt/">Eine solche Website für Ihren Betrieb? Jetzt anfragen</a></p>}
      </div>
    </footer>
  </body>
</html>
