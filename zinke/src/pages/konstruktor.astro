---
import Base from '../layouts/Base.astro';
import AnfrageForm from '../components/AnfrageForm.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<Base title={`Konstruktor: Möbel zusammenstellen | ${site.name}`} description="Stellen Sie Ihr Möbel selbst zusammen: Maße, Fächer, Türen, Holz. Mit Richtpreis und Skizze, die Sie der Werkstatt schicken können." bodyClass="kon">
  <div class="kon__root" data-base={base}>
    <ol class="kon__crumbs" aria-label="Schritte">
      <li data-crumb="1" aria-current="step">1 Bauen</li><li data-crumb="2" aria-current="false">2 Abnahme</li><li data-crumb="3" aria-current="false">3 Anfrage</li>
    </ol>

    <!-- Schritt 1: Bauen -->
    <section class="kon__app" data-step="1" aria-label="Konstruktor">
      <header class="kon__top">
        <a class="kon__back" href={base} aria-label="Zurück zur Startseite">←<span> Werkstatt</span></a>
        <details class="kon__price">
          <summary><span class="kon__plabel">Richtpreis</span> <strong data-price>–</strong></summary>
          <div class="kon__pop" data-price-detail></div>
        </details>
        <button type="button" class="kon__ib" data-share aria-label="Link teilen">Teilen</button>
        <button type="button" class="kon__ib" data-open-book aria-label="Werkbuch öffnen">Werkbuch <span data-count>0/7</span></button>
      </header>

      <div class="kon__stage" data-stage>
        <div class="kon__svg" data-svg></div>
        <canvas class="kon__canvas" data-canvas aria-label="3D-Ansicht Ihres Möbels"></canvas>
        <p class="kon__toast" data-toast role="status"></p>
      </div>

      <div class="kon__felder" data-felder hidden></div>
      <div class="kon__hints" data-hints hidden></div>

      <div class="kon__ctl">
        <div class="kon__tabs" role="tablist" aria-label="Bereiche" data-tabs></div>
        <div class="kon__panel" id="panel" role="tabpanel" data-panel></div>
      </div>

      <div class="kon__cta">
        <p class="kon__cta-p"><span>Richtwert inkl. MwSt.</span><span>Den Festpreis nennt der Meister nach dem Aufmaß.</span></p>
        <button type="button" class="btn btn--red" data-go="2">An die Werkstatt senden</button>
      </div>
    </section>

    <!-- Schritt 2: Abnahme -->
    <section class="kon__step" data-step="2" hidden>
      <h2 tabindex="-1">Abnahme durch den Meister</h2>
      <div class="kon__abn">
        <div class="kon__paper">
          <div data-sketch></div>
          <div data-stamp class="stamp"></div>
        </div>
        <div>
          <div data-abn-hints></div>
          <dl class="kon__list" data-abn-list></dl>
          <div data-abn-price class="kon__abn-price"></div>
          <div class="kon__acts">
            <button type="button" class="btn" data-go="1">← Weiter bauen</button>
            <button type="button" class="btn btn--red" data-go="3">Weiter zur Anfrage</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Schritt 3: Anfrage -->
    <section class="kon__step" data-step="3" hidden>
      <button type="button" class="btn btn--sm" data-go="2">← Zur Abnahme</button>
      <AnfrageForm id="kon-form" mode="konstruktor" title="An die Werkstatt senden" />
    </section>

    <dialog class="kon__dialog" data-dialog aria-labelledby="book-h">
      <h2 id="book-h">Werkbuch</h2>
      <p class="kt">Kleine Meilensteine auf Ihrem Weg zum Möbel. Nur für Sie, ohne Bedeutung für den Preis.</p>
      <ul class="kon__book" data-book></ul>
      <button type="button" class="btn btn--sm" data-close-book>Schließen</button>
    </dialog>
  </div>
</Base>

<style is:global>
  body.kon { background: var(--paper); }
  .kon__root { max-width: 80rem; margin: 0 auto; }
  .kon__crumbs { list-style: none; margin: 0; padding: 0.4rem var(--gutter); display: flex; gap: var(--space-md); font-size: var(--text-xs); color: var(--muted); border-bottom: 1px solid var(--rule); }
  .kon__crumbs [aria-current='step'] { color: var(--ink); font-weight: 700; border-bottom: 2px solid var(--accent); }
  /* App-Raster: Handy = Spalte, ab 60rem = Bühne links, Bedienung rechts */
  .kon__app { display: grid; grid-template-rows: auto minmax(34dvh, 1fr) auto auto auto auto; height: calc(100dvh - 30px); min-height: 34rem; }
  .kon__top { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-xs) var(--gutter); border-bottom: 1px solid var(--rule); background: var(--paper); }
  .kon__back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; text-decoration: none; padding-right: var(--space-xs); }
  .kon__back span { display: none; }
  .kon__price { position: relative; margin-right: auto; }
  .kon__price summary { list-style: none; display: inline-flex; align-items: baseline; gap: var(--space-xs); min-height: 44px; padding: 0 var(--space-sm); border: 1.5px solid var(--ink); border-radius: var(--radius); background: var(--sk-fill); cursor: pointer; align-items: center; }
  .kon__price summary::-webkit-details-marker { display: none; }
  .kon__plabel { font-size: var(--text-xs); color: var(--muted); }
  .kon__price strong { font-family: var(--font-display); font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .kon__pop { position: absolute; z-index: 30; top: calc(100% + 6px); left: 0; width: min(22rem, calc(100vw - 2 * var(--gutter))); padding: var(--space-md); background: var(--paper); border: 1.5px solid var(--ink); border-radius: var(--radius); box-shadow: 0 8px 24px oklch(25% 0.02 255 / 0.18); }
  .kon__pop dl, .kon__abn-price dl { margin: 0 0 var(--space-xs); display: grid; }
  .kon__pop dl > div, .kon__abn-price dl > div { display: flex; justify-content: space-between; gap: var(--space-md); padding: 0.3rem 0; border-bottom: 1px solid var(--rule); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .kon__pop dd, .kon__abn-price dd { margin: 0; }
  .kon__ib { min-height: 44px; padding: 0 var(--space-sm); border: 1.5px solid var(--ink); border-radius: var(--radius); background: transparent; font-weight: 700; font-size: var(--text-sm); cursor: pointer; white-space: nowrap; }
  .kon__ib:hover { background: var(--paper-2); }
  .kon__stage { position: relative; min-height: 0; background: linear-gradient(var(--paper-2), var(--paper)); overflow: hidden; }
  .kon__svg { position: absolute; inset: 0; padding: var(--space-md) var(--space-lg); display: grid; place-items: center; }
  .kon__svg .sk { max-height: 100%; }
  .kon__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; touch-action: pan-y; }
  .kon__stage:not(.is-gl) .kon__canvas { display: none; }
  .kon__stage.is-gl .kon__canvas { opacity: 1; transition: opacity var(--dur-slow) var(--ease-out); }
  .kon__stage.is-gl .kon__svg { visibility: hidden; }
  .kon__toast { position: absolute; left: 50%; bottom: var(--space-sm); transform: translate(-50%, 12px); max-width: calc(100% - 2rem); padding: 0.45rem 0.9rem; background: var(--ink); color: var(--paper); border-radius: 999px; font-size: var(--text-sm); font-weight: 700; opacity: 0; pointer-events: none; transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out); text-align: center; }
  .kon__toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  .kon__felder { display: flex; gap: var(--space-xs); padding: var(--space-xs) var(--gutter); overflow-x: auto; border-top: 1px solid var(--rule); background: var(--paper); scrollbar-width: thin; }
  .kon__felder[hidden], .kon__hints[hidden] { display: none; }
  .kf { flex: 0 0 auto; min-width: 64px; min-height: 48px; padding: 0.2rem 0.6rem; border: 1.5px solid var(--ink); border-radius: var(--radius); background: transparent; display: grid; text-align: center; cursor: pointer; }
  .kf span { font-weight: 700; line-height: 1.1; }
  .kf small { font-size: 0.7rem; color: var(--muted); white-space: nowrap; }
  .kf.is-sel { background: var(--ink); color: var(--paper); }
  .kf.is-sel small { color: oklch(85% 0.01 82); }
  .kon__hints { padding: var(--space-xs) var(--gutter); background: oklch(95% 0.05 80); border-top: 1.5px solid var(--accent); max-height: 30dvh; overflow-y: auto; display: grid; gap: var(--space-xs); }
  .kh { display: flex; flex-wrap: wrap; gap: var(--space-xs); align-items: center; font-size: var(--text-sm); }
  .kh p { flex: 1 1 14rem; }
  .kh--info { color: var(--ink-2); }
  .kon__ctl { border-top: 1.5px solid var(--ink); background: var(--paper); }
  .kon__tabs { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; }
  .kon__tabs button { min-height: 44px; border: 0; border-bottom: 2px solid var(--rule); background: transparent; font-weight: 700; cursor: pointer; }
  .kon__tabs button[aria-selected='true'] { border-bottom-color: var(--accent); background: var(--paper-2); }
  .kon__panel { padding: var(--space-xs) var(--gutter) var(--space-sm); max-height: 30dvh; overflow-y: auto; display: grid; gap: 0.15rem; align-content: start; }
  .ks, .kr { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); min-height: 48px; flex-wrap: wrap; }
  .ks__l { font-weight: 700; font-size: var(--text-sm); }
  .ks__c { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .ks__b { width: 48px; height: 44px; border: 1.5px solid var(--ink); border-radius: var(--radius); background: var(--sk-fill); font-size: 1.35rem; line-height: 1; cursor: pointer; }
  .ks__b:active:not(:disabled) { transform: translateY(1px); background: var(--paper-3); }
  .ks__b:disabled { opacity: 0.35; cursor: not-allowed; }
  .ks__v { min-width: 4.2rem; text-align: center; font-variant-numeric: tabular-nums; font-weight: 700; }
  .kcs { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .kcs--tools { padding: 0.3rem 0; }
  .kc { min-height: 44px; padding: 0.3rem 0.75rem; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; font-weight: 700; font-size: var(--text-sm); cursor: pointer; }
  .kc.is-on { background: var(--ink); color: var(--paper); }
  .kc:disabled { opacity: 0.4; cursor: not-allowed; }
  .kc--tex { display: inline-flex; align-items: center; gap: 0.4rem; padding-left: 0.35rem; }
  .kc--tex i { width: 30px; height: 30px; border-radius: 50%; background: var(--tex) center/cover; border: 1px solid oklch(30% 0.02 60 / 0.4); }
  .kc--col { display: inline-flex; align-items: center; gap: 0.4rem; padding-left: 0.35rem; }
  .kc--col i { width: 24px; height: 24px; border-radius: 50%; border: 1px solid oklch(30% 0.02 60 / 0.4); }
  .kt { font-size: var(--text-xs); color: var(--ink-2); padding: 0.15rem 0; }
  .kt--feld { font-weight: 700; color: var(--ink); font-size: var(--text-sm); }
  .kcheck { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); font-size: var(--text-sm); align-items: start; padding: 0.3rem 0; }
  .kcheck input { width: 1.3rem; height: 1.3rem; accent-color: var(--accent); }
  .kr--acts { gap: var(--space-xs); justify-content: flex-start; }
  .kon__cta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding: var(--space-xs) var(--gutter); padding-bottom: max(var(--space-xs), env(safe-area-inset-bottom)); background: var(--paper); border-top: 1.5px solid var(--ink); }
  .kon__cta-p { display: grid; font-size: var(--text-xs); color: var(--muted); }
  .kon__step { padding: var(--space-lg) var(--gutter) var(--space-2xl); display: grid; gap: var(--space-lg); }
  .kon__step[hidden], .kon__app[hidden] { display: none; }
  .kon__abn { display: grid; gap: var(--space-lg); }
  .kon__paper { position: relative; padding: var(--space-lg); background: var(--sk-fill); border: 1px solid var(--rule); box-shadow: 0 1px 0 var(--rule), 0 10px 24px oklch(25% 0.02 255 / 0.08); }
  .kon__list { margin: 0 0 var(--space-md); display: grid; }
  .kon__list > div { display: grid; grid-template-columns: minmax(0, 6rem) minmax(0, 1fr); gap: var(--space-sm); padding: 0.35rem 0; border-bottom: 1px solid var(--rule); font-size: var(--text-sm); }
  .kon__list dt { color: var(--muted); } .kon__list dd { margin: 0; }
  .kon__acts { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
  .stamp { position: absolute; right: var(--space-md); bottom: var(--space-md); padding: 0.35rem 0.9rem; border: 3px solid var(--accent); border-radius: var(--radius); color: var(--accent); font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.06em; text-align: center; transform: rotate(-8deg); background: oklch(97% 0.012 82 / 0.7); }
  .stamp small { display: block; font-family: var(--font-hand); font-size: 1rem; text-transform: none; letter-spacing: 0; font-weight: 600; }
  .stamp.is-no { color: var(--ink-2); border-color: var(--ink-2); }
  @media (prefers-reduced-motion: no-preference) { .stamp.is-in { animation: stempel 380ms var(--ease-out) both; } }
  @keyframes stempel { from { transform: rotate(-8deg) scale(1.9); opacity: 0; } to { transform: rotate(-8deg) scale(1); opacity: 1; } }
  .kon__dialog { max-width: 28rem; width: calc(100vw - 2rem); border: 1.5px solid var(--ink); border-radius: var(--radius); background: var(--paper); color: var(--ink); padding: var(--space-lg); }
  .kon__dialog::backdrop { background: oklch(25% 0.02 255 / 0.5); }
  .kon__book { list-style: none; margin: var(--space-md) 0; padding: 0; display: grid; gap: 0.25rem; }
  .kon__book li { display: grid; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); opacity: 0.55; }
  .kon__book li.is-got { opacity: 1; } .kon__book li.is-got strong::before { content: '✓ '; color: var(--ok); }
  .kon__book span { font-size: var(--text-sm); color: var(--ink-2); }
  @media (min-width: 60rem) {
    .kon__back span { display: inline; }
    .kon__app { grid-template-columns: minmax(0, 1fr) 26rem; grid-template-rows: auto minmax(0, 1fr) auto auto; grid-template-areas: 'top top' 'stage ctl' 'felder hints' 'cta cta'; }
    .kon__top { grid-area: top; } .kon__stage { grid-area: stage; } .kon__ctl { grid-area: ctl; border-top: 0; border-left: 1.5px solid var(--ink); overflow: auto; }
    .kon__hints { grid-area: hints; border-left: 1.5px solid var(--ink); } .kon__felder { grid-area: felder; } .kon__cta { grid-area: cta; }
    .kon__panel { max-height: none; }
    .kon__abn { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  }
  @media (min-height: 800px) and (max-width: 59.99rem) { .kon__panel { max-height: 34dvh; } }
</style>

<script>
  import '../lib/konstruktor';
</script>
