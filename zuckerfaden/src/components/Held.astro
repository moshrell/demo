---
/** Главный экран: тёмная сцена, по верхнему краю — слой мёда с каплями (готовая текстура, капли падают CSS-анимацией).
 *  На телефоне фото лица — приглушённый фон, на ПК — арка рядом с текстом. Без WebGL. prefers-reduced-motion: капли стоят. */
import site from '../data/site.json';
import Foto from './Foto.astro';
const base = import.meta.env.BASE_URL;
---
<section class="held dunkel" data-held>
  <div class="held__bild" aria-hidden="true"><Foto name="gesicht-3x4" alt="" sizes="(min-width: 64rem) 30rem, 100vw" eager class="held__foto" /></div>
  <div class="held__band" aria-hidden="true">
    <i class="tr" style="--x:96px;--y:131px;--d:9s;--w:0s"></i>
    <i class="tr" style="--x:790px;--y:207px;--d:12s;--w:2.4s"></i>
    <i class="tr" style="--x:905px;--y:221px;--d:14s;--w:5s"></i>
    <i class="tr" style="--x:1235px;--y:177px;--d:10.5s;--w:7s"></i>
  </div>
  <div class="wrap held__in">
    <div class="held__text">
      <p class="held__ort">Kosmetik Zuckerfaden · seit {site.since}</p>
      <h1>Sugaring und Gesichts&shy;pflege in {site.address.city}</h1>
      <p class="lede held__lede">Warme Zuckerpaste statt Wachs, Gesichtspflege mit den Händen statt mit Geräten. Ein Raum, eine Kosmetikerin, viel Zeit.</p>
      <div class="btn-row held__btns">
        <a class="btn" href="#zonen">Preis für meine Zonen berechnen</a>
        <a class="btn btn--ghost" href={`${base}termin/`}>Termin anfragen</a>
      </div>
      <p class="held__abend">Dienstag und Donnerstag bis 22 Uhr geöffnet</p>
    </div>
  </div>
</section>

<style is:global define:vars={{ bandBild: `url(${import.meta.env.BASE_URL}img/honig-band.webp)`, tropfenBild: `url(${import.meta.env.BASE_URL}img/honig-tropfen.webp)` }}>
  .held { position: relative; overflow: hidden; min-height: calc(100svh - 4.6rem); display: grid; align-items: end; isolation: isolate; background: radial-gradient(80% 60% at 78% 8%, rgba(227, 162, 31, 0.2), transparent 60%), var(--nacht); }
  .held__bild { position: absolute; inset: 0; z-index: -2; }
  .held__bild picture, .held__bild img { width: 100%; height: 100%; }
  .held__foto { object-fit: cover; object-position: 62% 30%; border-radius: 0; opacity: 0.55; filter: saturate(0.8) sepia(0.2); }
  .held__bild::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(27, 17, 11, 0.7) 0%, rgba(27, 17, 11, 0.5) 35%, rgba(27, 17, 11, 0.92) 78%, var(--nacht) 100%); }
  .held__band { position: absolute; left: 0; right: 0; top: 0; height: 320px; z-index: -1; background: var(--bandBild) 0 0 / 1600px 320px repeat-x; pointer-events: none; filter: drop-shadow(0 10px 12px rgba(0, 0, 0, 0.45)); }
  .tr { position: absolute; left: var(--x); top: var(--y); width: 30px; height: 46px; margin-left: -15px; background: var(--tropfenBild) center / 100% 100% no-repeat; opacity: 0; transform-origin: 50% 0; animation: tropf var(--d) cubic-bezier(0.55, 0, 0.9, 0.6) var(--w) infinite; }
  @keyframes tropf {
    0%, 12% { opacity: 0; transform: translateY(0) scale(0.25); }
    22% { opacity: 1; transform: translateY(0) scale(1); animation-timing-function: ease-in; }
    34% { opacity: 1; transform: translateY(2px) scale(0.95, 1.12); animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.5); }
    80% { opacity: 1; transform: translateY(min(66svh, 560px)) scale(0.9, 1.25); }
    86%, 100% { opacity: 0; transform: translateY(min(68svh, 580px)) scale(0.9, 1.25); }
  }
  @media (prefers-reduced-motion: reduce) { .tr { display: none; } }
  .held__in { position: relative; display: grid; width: 100%; padding-top: 11.5rem; padding-bottom: calc(var(--bar-h) + 4.5rem); }
  .held__text { display: grid; gap: var(--space-md); max-width: 40rem; }
  .held__ort { color: var(--licht-2); font-size: var(--text-sm); }
  .held h1 { font-size: clamp(2.6rem, 1.2rem + 6vw, 6.2rem); line-height: 1; max-width: 13ch; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5); }
  .held__lede { color: var(--licht); max-width: 34rem; }
  .held__btns { margin-top: 0.6rem; }
  .held__abend { color: var(--licht); font-size: var(--text-sm); margin-top: 0.4rem; }
  @media (min-width: 64rem) {
    .held { min-height: min(90svh, 58rem); align-items: center; }
    .held__bild { left: auto; right: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); top: 19rem; bottom: 4rem; width: min(24rem, 26vw); inset-block: 19rem 4rem; border-radius: 999px 999px 28px 28px; overflow: hidden; box-shadow: 0 30px 60px -30px #000, 0 0 0 1px rgba(255, 210, 122, 0.25); z-index: -1; }
    .held__foto { opacity: 1; filter: none; object-position: 55% 40%; }
    .held__bild::after { background: linear-gradient(180deg, transparent 70%, rgba(27, 17, 11, 0.55)); }
    .held__in { padding-top: 7rem; padding-bottom: 5rem; }
    .held h1 { max-width: 12ch; font-size: clamp(3.4rem, 1rem + 4.2vw, 5.4rem); }
    .held__text { max-width: 36rem; }
  }
</style>
