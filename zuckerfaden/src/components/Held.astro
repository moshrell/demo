---
/** Главный экран: тёмная сцена, по верхнему краю — слой мёда, из него медленно тянутся и отрываются капли (WebGL).
 *  При прокрутке капли тянутся сильнее. Без WebGL: CSS-капли (статичные). prefers-reduced-motion: один неподвижный кадр. */
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<section class="held dunkel" data-held>
  <canvas class="held__gl" data-held-gl aria-hidden="true"></canvas>
  <div class="held__fallback" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap held__in">
    <p class="held__ort">Kosmetik Zuckerfaden · seit {site.since}</p>
    <h1>Sugaring und Gesichts&shy;pflege in {site.address.city}</h1>
    <p class="lede held__lede">Warme Zuckerpaste statt Wachs, Gesichtspflege mit den Händen statt mit Geräten. Ein Raum, eine Kosmetikerin, viel Zeit.</p>
    <div class="btn-row held__btns">
      <a class="btn" href="#zonen">Preis für meine Zonen berechnen</a>
      <a class="btn btn--ghost" href={`${base}termin/`}>Termin anfragen</a>
    </div>
    <p class="held__abend"><span class="held__tropfen" aria-hidden="true"></span>Dienstag und Donnerstag bis 22 Uhr geöffnet</p>
  </div>
</section>

<style>
  .held { position: relative; overflow: hidden; min-height: calc(100svh - 7.5rem); display: grid; align-items: end; isolation: isolate; background: radial-gradient(80% 60% at 78% 8%, rgba(227, 162, 31, 0.22), transparent 60%), radial-gradient(60% 40% at 10% 100%, rgba(120, 60, 10, 0.25), transparent 70%), var(--nacht); }
  .held__gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .held__fallback { display: none; position: absolute; inset: 0 0 auto 0; height: 34px; z-index: -1; background: linear-gradient(180deg, #F1B23E, #C77F17); border-radius: 0 0 24px 24px; }
  :global(.no-gl) .held__fallback { display: block; }
  .held__fallback i { position: absolute; top: 20px; width: 22px; height: 70px; border-radius: 0 0 11px 11px; background: linear-gradient(90deg, #C77F17, #F1B23E 40%, #C77F17); }
  .held__fallback i:nth-child(1) { left: 62%; height: 90px; } .held__fallback i:nth-child(2) { left: 80%; } .held__fallback i:nth-child(3) { left: 92%; height: 50px; }
  .held__in { position: relative; display: grid; gap: var(--space-md); padding-top: 9rem; padding-bottom: calc(var(--bar-h) + 4.5rem); }
  .held__ort { color: var(--licht-2); font-size: var(--text-sm); }
  .held h1 { font-size: clamp(2.6rem, 1.2rem + 6vw, 6.2rem); line-height: 1; max-width: 13ch; }
  .held__lede { color: var(--licht-2); max-width: 34rem; }
  .held__btns { margin-top: 0.6rem; }
  .held__abend { display: flex; align-items: center; gap: 0.6rem; color: var(--licht); font-size: var(--text-sm); margin-top: 0.4rem; }
  .held__tropfen { width: 12px; height: 16px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: radial-gradient(circle at 35% 35%, #FFE6A8, #E3A21F 55%, #9A5A0C); transform: rotate(180deg); flex: none; }
  @media (min-width: 64rem) {
    .held { min-height: min(92svh, 60rem); align-items: center; }
    .held__in { padding-top: 6rem; padding-bottom: 6rem; }
    .held h1 { max-width: 14ch; font-size: clamp(3.4rem, 1rem + 4.2vw, 5.4rem); }
  }
</style>

<script>
  import { HonigGL, type Cap, type RRect } from '../scripts/honig-gl';
  const sec = document.querySelector<HTMLElement>('[data-held]');
  const cv = document.querySelector<HTMLCanvasElement>('[data-held-gl]');
  if (sec && cv) {
    const gl = new HonigGL(cv, 1.5);
    if (!gl.ok) document.documentElement.classList.add('no-gl');
    else {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      type Drip = { fx: number; P: number; ph: number; r: number; L: number };
      let drips: Drip[] = [];
      let W = 0, H = 0, band = 30;
      function layout() {
        W = sec!.clientWidth; H = sec!.clientHeight;
        const desk = W >= 1024;
        band = desk ? 40 : 28;
        drips = desk
          ? [{ fx: 0.56, P: 9.5, ph: 0.15, r: 15, L: 0.42 }, { fx: 0.71, P: 7.2, ph: 0.62, r: 19, L: 0.58 }, { fx: 0.84, P: 11, ph: 0.35, r: 13, L: 0.34 }, { fx: 0.94, P: 8.4, ph: 0.85, r: 16, L: 0.5 }]
          : [{ fx: 0.6, P: 8.2, ph: 0.2, r: 14, L: 0.3 }, { fx: 0.82, P: 6.8, ph: 0.66, r: 17, L: 0.38 }, { fx: 0.27, P: 10.5, ph: 0.9, r: 11, L: 0.16 }];
      }
      function scene(t: number, pull: number) {
        const rects: RRect[] = [{ x: -60, y: -120, w: W + 120, h: 120 + band, r: 30 }];
        const caps: Cap[] = [];
        // провисания по нижнему краю слоя
        for (let i = 0; i < 9; i++) {
          const x = ((i + 0.5) / 9) * W + Math.sin(i * 2.1) * 18, r = 9 + ((i * 37) % 11);
          caps.push({ x0: x - r, y0: band - 2, r0: r * 0.7, x1: x + r, y1: band - 2 + Math.sin(i) * 3, r1: r * 0.75 });
        }
        for (const d of drips) {
          const x = d.fx * W, Lmax = d.L * H + pull;
          const u = reduce.matches ? 0.68 : (t / d.P + d.ph) % 1;
          if (u < 0.5) {
            const g = ease(u / 0.5), r = lerp(5, d.r, g);
            caps.push({ x0: x, y0: band - 4, r0: r * 0.9, x1: x, y1: band + r * 0.6 + 16 * g, r1: r });
          } else if (u < 0.8) {
            const s = (u - 0.5) / 0.3, se = Math.pow(s, 1.8);
            const yD = band + d.r * 0.6 + 16 + Lmax * se, rD = d.r * (1 - 0.18 * s);
            const mid = band + (yD - band) * 0.55, rM = Math.max(1.3, lerp(d.r * 0.55, 1.3, Math.pow(s, 0.8)));
            caps.push({ x0: x, y0: band - 4, r0: d.r * 0.85, x1: x, y1: mid, r1: rM });
            caps.push({ x0: x, y0: mid, r0: rM, x1: x, y1: yD - rD * 0.4, r1: rD * 0.82 });
            caps.push({ x0: x, y0: yD - rD * 0.5, r0: rD * 0.8, x1: x, y1: yD + rD * 0.25, r1: rD });
          } else {
            const f = (u - 0.8) / 0.2;
            const nub = (1 - ease(f)) * 26;
            if (nub > 1) caps.push({ x0: x, y0: band - 4, r0: d.r * lerp(0.85, 0.5, f), x1: x, y1: band + nub, r1: lerp(3, 1, f) });
            const y0 = band + d.r * 0.6 + 16 + Lmax, yD = y0 + 1400 * f * f;
            if (yD < H + 40) caps.push({ x0: x, y0: yD - d.r * 0.9, r0: d.r * 0.55, x1: x, y1: yD, r1: d.r * 0.82 });
          }
        }
        return { rects, caps, k: 18, shadow: 0.0, bright: 1.22 };
      }
      let raf = 0, visible = true, t0 = performance.now();
      const pullNow = () => Math.min(Math.max(scrollY, 0), 400) * 0.35;
      function loop(now: number) {
        raf = 0;
        gl.draw(scene((now - t0) / 1000, pullNow()));
        if (visible && !reduce.matches && !document.hidden) raf = requestAnimationFrame(loop);
      }
      const go = () => { if (!raf) raf = requestAnimationFrame(loop); };
      layout();
      new ResizeObserver(() => { layout(); go(); }).observe(sec);
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) go(); }).observe(sec);
      document.addEventListener('visibilitychange', go);
      addEventListener('scroll', go, { passive: true });
      reduce.addEventListener?.('change', go);
      sec.dataset.live = '1';
      go();
    }
  }
</script>
