---
/** Тёмная полоса-заголовок подстраниц (продолжает шапку). */
const { titel, lede = '' } = Astro.props;
---
<section class="seitenkopf dunkel">
  <div class="wrap">
    <h1>{titel}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
<style>
  .seitenkopf { background: radial-gradient(70% 120% at 85% 0%, rgba(227, 162, 31, 0.16), transparent 60%), var(--nacht); }
  .seitenkopf h1 { font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4.6rem); max-width: 22ch; hyphens: manual; }
</style>
