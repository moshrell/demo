---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import site from '../data/site.json';
import beh from '../data/behandlungen.json';
import zusatz from '../data/zusatz.json';
import { euro } from '../lib/fmt.mjs';
const base = import.meta.env.BASE_URL;
const betraege = [25, 50, 75, 100];
const optionen = [...beh.behandlungen.map((b) => ({ id: b.id, name: b.name, preis: b.preis })), ...zusatz.gruppen.flatMap((g) => g.items).filter((x) => !x.ab).map((x) => ({ id: x.id, name: x.name, preis: x.preis }))];
---
<Base title="Gutschein verschenken | Kosmetik Zuckerfaden Ronnenberg" description="Gutschein für eine Behandlung oder einen Betrag Ihrer Wahl. Abholen im Studio in Ronnenberg oder per Post, bezahlt wird bei Abholung." aktiv="gutschein">
  <section class="wrap gp">
    <div class="gp__kopf">
      <h1>Gutschein verschenken</h1>
      <p class="lede">Für eine Behandlung oder einen Betrag. Sie fragen hier an, ich bereite den Gutschein vor. Bezahlt wird bei der Abholung oder per Überweisung, wenn ich ihn schicke.</p>
    </div>
    <Foto name="gutschein-1x1" alt="Gutscheinkarte im Umschlag mit Schleife" sizes="(min-width: 64rem) 22rem, 70vw" class="gp__foto" eager />

    <form class="form gp__form" id="gutschein" novalidate data-gs-form>
      <fieldset class="gruppe">
        <legend>Was soll es sein?</legend>
        <div class="chips" role="radiogroup" aria-label="Art des Gutscheins">
          <label class="chip"><input type="radio" name="art" value="betrag" checked /><span>Ein Betrag</span></label>
          <label class="chip"><input type="radio" name="art" value="behandlung" /><span>Eine Behandlung</span></label>
        </div>
        <div data-teil="betrag">
          <div class="chips" role="radiogroup" aria-label="Betrag">
            {betraege.map((b, i) => <label class="chip"><input type="radio" name="betrag" value={String(b)} checked={i === 1} /><span>{euro(b)}</span></label>)}
            <label class="chip"><input type="radio" name="betrag" value="frei" /><span>Anderer Betrag</span></label>
          </div>
          <div class="feld gp__frei" data-frei hidden>
            <label for="g-frei">Betrag in Euro</label>
            <input id="g-frei" name="frei" type="number" inputmode="numeric" min="10" max="500" step="5" placeholder="z. B. 40" aria-describedby="err-frei" />
            <p class="err" id="err-frei" hidden>Bitte einen Betrag zwischen 10 und 500 € eingeben.</p>
          </div>
        </div>
        <div class="feld" data-teil="behandlung" hidden>
          <label for="g-beh">Behandlung</label>
          <select id="g-beh" name="behandlung">
            {optionen.map((o) => <option value={o.id} data-preis={o.preis}>{o.name} · {euro(o.preis)}</option>)}
          </select>
        </div>
        <p class="gp__summe" aria-live="polite">Gutschein über <strong class="num" data-gs-summe>50 €</strong></p>
      </fieldset>

      <fieldset class="gruppe">
        <legend>Ihre Angaben</legend>
        <div class="feld">
          <label for="g-name">Ihr Name</label>
          <input id="g-name" name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" required aria-describedby="err-gname" />
          <p class="err" id="err-gname" hidden>Bitte geben Sie Ihren Namen an.</p>
        </div>
        <div class="feld">
          <label for="g-tel">Telefon</label>
          <input id="g-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 0151 23456789" required aria-describedby="err-gtel" />
          <p class="err" id="err-gtel" hidden>Bitte geben Sie eine Telefonnummer an.</p>
        </div>
        <div class="feld">
          <label for="g-fuer">Für wen <span class="opt">(optional, steht auf dem Gutschein)</span></label>
          <input id="g-fuer" name="fuer" type="text" autocomplete="off" placeholder="z. B. Für Mama" />
        </div>
        <div>
          <p class="label tf__label" id="weg-l">Wie bekommen Sie den Gutschein?</p>
          <div class="chips" role="radiogroup" aria-labelledby="weg-l">
            <label class="chip"><input type="radio" name="weg" value="abholen" checked /><span>Ich hole ihn ab</span></label>
            <label class="chip"><input type="radio" name="weg" value="post" /><span>Per Post</span></label>
          </div>
        </div>
        <div class="feld" data-adresse hidden>
          <label for="g-adr">Adresse für den Versand</label>
          <textarea id="g-adr" name="adresse" rows="3" autocomplete="street-address" placeholder="Straße und Hausnummer, PLZ und Ort" aria-describedby="err-gadr"></textarea>
          <p class="err" id="err-gadr" hidden>Bitte geben Sie die Adresse für den Versand an.</p>
        </div>
      </fieldset>

      <div class="gruppe">
        <label class="check">
          <input type="checkbox" name="privacy" required aria-describedby="err-gpriv" />
          <span>Ich bin einverstanden, dass {site.name} meine Angaben (Name, Telefon, Empfänger, Adresse) zur Bearbeitung meiner Gutschein-Anfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
        </label>
        <p class="err" id="err-gpriv" hidden>Bitte stimmen Sie zu, sonst kann ich Ihre Anfrage nicht bearbeiten.</p>
        <button class="btn senden" type="submit">Gutschein anfragen</button>
        <p class="small muted">Demo: Es wird nichts gesendet oder gespeichert.</p>
      </div>
    </form>

    <div class="terminkarte" data-karte hidden tabindex="-1" aria-live="polite">
      <h2>Gutschein angefragt</h2>
      <p class="lede">Ich melde mich, sobald er fertig ist.</p>
      <dl data-karte-liste></dl>
      <p class="demo-hinweis">Demo: Diese Anfrage wurde nicht gesendet und nicht gespeichert.</p>
    </div>
  </section>
</Base>

<style>
  .gp { max-width: 44rem; padding-top: var(--space-lg); display: grid; gap: var(--space-xl); }
  .gp__kopf { display: grid; gap: var(--space-md); }
  .gp :global(.gp__foto) { border-radius: 22px; max-width: 20rem; }
  [data-teil][hidden], .gp__frei[hidden], [data-adresse][hidden] { display: none; }
  .gp__frei { margin-top: var(--space-md); max-width: 14rem; }
  .gp__summe { font-size: var(--text-lg); padding: 0.9rem 1.1rem; background: var(--weiss); border-radius: 16px; }
  .gp__summe strong { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 1.8rem; margin-left: 0.3rem; }
  .tf__label { margin-bottom: 0.6rem; font-weight: var(--strong-weight); }
</style>

<script>
  import { setupForm, telOk } from '../lib/formular';
  import { euro } from '../lib/cart';
  const form = document.querySelector<HTMLFormElement>('[data-gs-form]')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => form.parentElement!.querySelector<T>(s)!;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const val = (n: string) => (form.querySelector<HTMLInputElement>(`input[name=${n}]:checked`)?.value ?? '');
  function wert(): { text: string; preis: number | null } {
    if (val('art') === 'behandlung') { const s = form.querySelector<HTMLSelectElement>('#g-beh')!; const o = s.selectedOptions[0]; return { text: o.textContent!.split(' · ')[0], preis: Number(o.dataset.preis) }; }
    if (val('betrag') === 'frei') { const n = Number(f('frei').value); return { text: 'Betrag', preis: n >= 10 && n <= 500 ? n : null }; }
    return { text: 'Betrag', preis: Number(val('betrag')) };
  }
  function render() {
    const art = val('art');
    form.querySelector<HTMLElement>('[data-teil="betrag"]')!.hidden = art !== 'betrag';
    form.querySelector<HTMLElement>('[data-teil="behandlung"]')!.hidden = art !== 'behandlung';
    form.querySelector<HTMLElement>('[data-frei]')!.hidden = !(art === 'betrag' && val('betrag') === 'frei');
    form.querySelector<HTMLElement>('[data-adresse]')!.hidden = val('weg') !== 'post';
    const w = wert();
    q('[data-gs-summe]').textContent = w.preis ? euro(w.preis) + (art === 'behandlung' ? ` (${w.text})` : '') : '–';
  }
  form.addEventListener('input', render); form.addEventListener('change', render);
  const ctrl = setupForm(form, {
    checks: () => [
      ...(val('art') === 'betrag' && val('betrag') === 'frei' ? [[f('frei'), () => wert().preis !== null] as [HTMLInputElement, () => boolean]] : []),
      [f('name'), () => f('name').value.trim().length > 1],
      [f('tel'), () => telOk(f('tel').value)],
      ...(val('weg') === 'post' ? [[form.querySelector<HTMLTextAreaElement>('#g-adr')!, () => form.querySelector<HTMLTextAreaElement>('#g-adr')!.value.trim().length > 8] as [HTMLTextAreaElement, () => boolean]] : []),
      [f('privacy'), () => f('privacy').checked],
    ],
    onSubmit: () => {
      const w = wert();
      const rows: [string, string, string?][] = [];
      rows.push([val('art') === 'behandlung' ? w.text : 'Gutschein über', euro(w.preis!), 'summe']);
      if (f('fuer').value.trim()) rows.push(['Für', f('fuer').value.trim()]);
      rows.push(['Übergabe', val('weg') === 'post' ? 'per Post' : 'Abholung im Studio'], ['Name', f('name').value.trim()], ['Telefon', f('tel').value.trim()]);
      q('[data-karte-liste]').replaceChildren(...rows.map(([k, v, cls]) => {
        const d = document.createElement('div'); if (cls) d.className = cls;
        const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v; d.append(dt, dd); return d;
      }));
      form.hidden = true; const k = q('[data-karte]'); k.hidden = false; k.focus(); k.scrollIntoView({ block: 'start' });
      ctrl.reset();
    },
  });
  render();
</script>
