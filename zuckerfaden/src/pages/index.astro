---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Held from '../components/Held.astro';
import Zonenrechner from '../components/Zonenrechner.astro';
import Finder from '../components/Finder.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
const jahre = new Date().getFullYear() - site.since;
const schritte = [
  { t: 'Anfrage', d: 'Über das Formular, per WhatsApp oder am Telefon. Sagen Sie mir, was Sie möchten und wann es Ihnen passt.' },
  { t: 'Rückruf', d: 'Ich melde mich, meist am selben Abend, und wir machen die Uhrzeit fest.' },
  { t: 'Hautgespräch und Behandlung', d: 'Wir schauen zuerst gemeinsam auf Ihre Haut. Dann beginnt die Behandlung, in Ruhe und ohne Geräte.' },
  { t: 'Pflege für zu Hause', d: 'Sie bekommen zwei, drei Hinweise mit, die wirklich zu Ihrer Haut passen.' },
];
---
<Base title="Kosmetik Zuckerfaden: Sugaring und Gesichtspflege in Ronnenberg" description="Sugaring mit warmer Zuckerpaste und Gesichtspflege ohne Geräte in Ronnenberg. Preise für Ihre Zonen sofort berechnen, Termin anfragen. Dienstag und Donnerstag bis 22 Uhr." aktiv="start">
  <Held />
  <Zonenrechner />
  <Finder foto="gesicht-3x4" />

  <section class="ablauf section" aria-labelledby="ablauf-h">
    <div class="wrap ablauf__grid">
      <div>
        <h2 id="ablauf-h">So läuft Ihr erster Termin</h2>
        <ol class="faden">
          {schritte.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
        </ol>
      </div>
      <aside class="vorher honig" data-honig aria-labelledby="vorher-h">
        <h3 id="vorher-h">Vor dem Sugaring</h3>
        <ul>
          <li>Haare 3 bis 5 mm lang wachsen lassen, etwa eine Woche nach dem Rasieren.</li>
          <li>24 Stunden vorher kein Peeling.</li>
          <li>Am Tag selbst keine Bodylotion auf die Zonen.</li>
        </ul>
        <a href={`${base}sugaring/#vorbereitung`}>Mehr zu Vorher und Nachher</a>
      </aside>
    </div>
  </section>

  <section class="ich section" aria-labelledby="ich-h">
    <div class="wrap ich__grid">
      <Foto name="kosmetikerin-arbeit-3x4" fallback="kosmetikerin-3x4" alt={`${site.owner} in ihrem Behandlungsraum`} sizes="(min-width: 64rem) 34vw, 92vw" class="ich__foto" />
      <div class="ich__text">
        <p class="muted">Seit {jahre} Jahren im eigenen Raum</p>
        <h2 id="ich-h">Ich bin {site.owner.split(' ')[0]}</h2>
        <p class="lede">Davor habe ich als Drogistin und Kosmetikerin gearbeitet. Ich behandle mit den Händen, nicht mit Geräten, und nehme mir für jede Haut die Zeit, die sie braucht.</p>
        <blockquote class="ich__satz">„Behandle andere so, wie du behandelt werden möchtest.“</blockquote>
        <p><a href={`${base}ueber-mich/`}>Mehr über mich und meine Ausbildung</a></p>
      </div>
    </div>
  </section>

  <section class="raum dunkel" aria-labelledby="raum-h">
    <Foto name="raum-4x3" alt="Heller Behandlungsraum mit Liege, Pflanze und Fenster" sizes="100vw" class="raum__bild" />
    <div class="wrap raum__text">
      <h2 id="raum-h">Ein Raum. Nur Sie und ich.</h2>
      <ul class="fakten">
        <li>Keine Wartezone, keine Kabinen nebenan.</li>
        <li>Parkplatz vor dem Haus, ebenerdiger Eingang.</li>
        <li>{site.address.street}, {site.address.zip} {site.address.city} · <a href={site.mapUrl} target="_blank" rel="noopener">Weg auf der Karte</a></li>
      </ul>
    </div>
  </section>

  {site.gutscheinBlock && (
    <section class="gs section" aria-labelledby="gs-h">
      <div class="wrap gs__grid">
        <Foto name="gutschein-1x1" alt="Gutscheinkarte im Umschlag mit Schleife" sizes="(min-width: 48rem) 26rem, 88vw" class="gs__foto" />
        <div class="gs__text honig" data-honig>
          <h2 id="gs-h">Ein Gutschein zum Verschenken</h2>
          <p>Für eine Behandlung oder einen Betrag Ihrer Wahl. Abholen bei mir oder per Post.</p>
          <a class="btn" href={`${base}gutschein/`}>Gutschein anfragen</a>
        </div>
      </div>
    </section>
  )}

  <section class="meinung section" aria-labelledby="meinung-h">
    <div class="wrap meinung__wrap">
      <h2 id="meinung-h">Sagen Sie mir, was Ihnen gefällt</h2>
      <p class="lede">Und was ich besser machen kann. Ihre Rückmeldung nach der Behandlung ist mir wichtig, persönlich oder als Bewertung.</p>
      {site.googleReviewsUrl === 'TODO'
        ? <p class="meinung__demo"><span class="btn btn--ghost is-aus" aria-disabled="true">Bewertungen auf Google lesen</span><span class="small muted">Demo: Beim echten Studio führt dieser Knopf zum Google-Profil.</span></p>
        : <p><a class="btn btn--ghost" href={site.googleReviewsUrl} target="_blank" rel="noopener">Bewertungen auf Google lesen</a></p>}
    </div>
  </section>
</Base>

<style>
  .ablauf__grid { display: grid; gap: var(--space-xl); }
  .faden { list-style: none; margin: var(--space-xl) 0 0; padding: 0; counter-reset: s; display: grid; }
  .faden li { position: relative; counter-increment: s; padding: 0 0 var(--space-lg) 3.6rem; }
  .faden li::before { content: counter(s); position: absolute; left: 0; top: -0.1rem; width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--tinte); font-family: var(--font-display); font-size: 1.15rem; }
  .faden li::after { content: ''; position: absolute; left: 1.15rem; top: 2.6rem; bottom: 0.3rem; width: 1.5px; background: var(--linie); }
  .faden li:last-child::after { display: none; }
  .faden h3 { margin-bottom: 0.3rem; }
  .faden p { color: var(--tinte-2); max-width: 34rem; }
  .vorher { padding: 1.5rem 1.6rem; border-radius: 26px; align-self: start; }
  .vorher ul { margin: 0.7rem 0 1rem; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .vorher a { font-weight: 600; }
  @media (min-width: 64rem) { .ablauf__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); align-items: end; gap: var(--space-2xl); } }

  .ich { background: var(--grau); }
  .ich__grid { display: grid; gap: var(--space-xl); }
  .ich__grid :global(.ich__foto) { border-radius: 26px; max-width: 30rem; }
  .ich__text { display: grid; gap: 0.9rem; align-content: start; }
  .ich__satz { margin: 0.6rem 0; font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem); line-height: 1.15; letter-spacing: var(--display-tracking); max-width: 28rem; }
  @media (min-width: 64rem) { .ich__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: var(--space-3xl); } }

  .raum { position: relative; display: grid; }
  .raum :global(.raum__bild) { width: 100%; height: min(70vh, 44rem); object-fit: cover; border-radius: 0; }
  .raum__text { position: relative; padding-block: var(--space-xl) var(--space-2xl); display: grid; gap: var(--space-md); }
  .fakten { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; color: var(--licht-2); }
  .fakten li { padding-left: 1.4rem; position: relative; }
  .fakten li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--honig); }
  @media (min-width: 64rem) {
    .raum { grid-template-columns: 1fr; }
    .raum :global(picture), .raum__text { grid-area: 1 / 1; }
    .raum__text { align-self: end; justify-self: start; margin: 0 0 var(--space-2xl) max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); max-width: 32rem; padding: 2rem 2.2rem; border-radius: 24px; background: rgba(27, 17, 11, 0.86); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
    .raum :global(.raum__bild) { height: min(86vh, 52rem); }
  }

  .gs__grid { display: grid; gap: var(--space-lg); }
  .gs__grid :global(.gs__foto) { border-radius: 26px; max-width: 26rem; }
  .gs__text { display: grid; gap: var(--space-md); align-content: center; padding: clamp(1.4rem, 4vw, 2.6rem); border-radius: 28px; }
  .gs__text .btn { justify-self: start; }
  @media (min-width: 48rem) { .gs__grid { grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); align-items: center; gap: var(--space-xl); } }

  .meinung__wrap { max-width: 46rem; display: grid; gap: var(--space-md); }
  .meinung__demo { display: grid; gap: 0.5rem; justify-items: start; }
  .is-aus { opacity: 0.45; cursor: default; pointer-events: none; }
</style>
