---
import Base from '../layouts/Base.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
const tage = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
---
<Base title="Termin anfragen | Kosmetik Zuckerfaden Ronnenberg" description="Termin für Sugaring oder Gesichtsbehandlung in Ronnenberg anfragen. Auswahl, Wunschzeiten und Rückruf, meist am selben Abend." leiste="termin">
  <Seitenkopf titel="Termin anfragen" lede="Sie schlagen Tage und Tageszeit vor, ich rufe zurück und wir machen die Uhrzeit fest. Meist am selben Abend." />
  <section class="wrap tf section">

    <form class="form" id="termin" novalidate data-termin-form>
      <fieldset class="gruppe">
        <legend>Ihre Auswahl</legend>
        <div class="tf__auswahl" data-tf-auswahl data-pille-weg>
          <ul class="auswahl" data-tf-liste></ul>
          <p class="auswahl__summe"><span>Summe <strong class="num" data-tf-summe></strong></span><span class="muted num" data-tf-dauer></span></p>
          <p class="small muted">Richtwert. Abgerechnet wird nach Zeit und Material.</p>
        </div>
        <div class="tf__leer" data-tf-leer hidden>
          <p>Sie haben noch nichts ausgewählt. Das ist kein Problem.</p>
          <div class="btn-row">
            <a class="btn btn--ghost" href={`${base}sugaring/#zonen`}>Sugaring-Zonen wählen</a>
            <a class="btn btn--ghost" href={`${base}gesicht/`}>Gesichtsbehandlung wählen</a>
            <button type="button" class="btn btn--ghost" data-weissnicht>Ich weiß es noch nicht</button>
          </div>
        </div>
        <p class="err" id="err-auswahl" hidden>Bitte wählen Sie etwas aus oder schreiben Sie unten kurz, worum es geht.</p>
      </fieldset>

      <fieldset class="gruppe">
        <legend>Wann passt es Ihnen?</legend>
        <div>
          <p class="label tf__label" id="tage-l">Tage <span class="opt">(mehrere möglich)</span></p>
          <div class="chips" role="group" aria-labelledby="tage-l">
            {tage.map((t) => <label class="chip"><input type="checkbox" name="tage" value={t} /><span>{t}{t === 'Sa' ? ' nach Vereinbarung' : ''}</span></label>)}
          </div>
        </div>
        <div>
          <p class="label tf__label" id="zeit-l">Tageszeit</p>
          <div class="chips" role="group" aria-labelledby="zeit-l">
            <label class="chip"><input type="checkbox" name="zeit" value="Vormittag" /><span>Vormittag 9–13</span></label>
            <label class="chip"><input type="checkbox" name="zeit" value="Nachmittag" /><span>Nachmittag 15–18</span></label>
            <label class="chip"><input type="checkbox" name="zeit" value="Abend" data-abend /><span>Abend bis 22 (Di, Do)</span></label>
          </div>
          <p class="small muted tf__abend" data-abend-hinweis hidden>Abends bin ich nur dienstags und donnerstags da.</p>
        </div>
      </fieldset>

      <fieldset class="gruppe">
        <legend>Ihre Angaben</legend>
        <div class="feld">
          <label for="t-name">Name</label>
          <input id="t-name" name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" required aria-describedby="err-name" />
          <p class="err" id="err-name" hidden>Bitte geben Sie Ihren Namen an.</p>
        </div>
        <div class="feld">
          <label for="t-tel">Telefon</label>
          <input id="t-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" placeholder="z. B. 0151 23456789" required aria-describedby="err-tel" />
          <p class="err" id="err-tel" hidden>Bitte geben Sie eine Telefonnummer an, unter der ich Sie erreiche.</p>
        </div>
        <div class="feld">
          <label for="t-mail">E-Mail <span class="opt">(optional)</span></label>
          <input id="t-mail" name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@example.com" aria-describedby="err-mail" />
          <p class="err" id="err-mail" hidden>Bitte prüfen Sie die E-Mail-Adresse, z. B. name@example.com.</p>
        </div>
        <div class="feld">
          <label for="t-note">Nachricht <span class="opt">(optional)</span></label>
          <textarea id="t-note" name="note" rows="3" autocomplete="off" placeholder="z. B. erstes Mal Sugaring, empfindliche Haut, Fragen"></textarea>
        </div>
        <label class="check"><input type="checkbox" name="whatsapp" value="ja" /><span>Lieber per WhatsApp antworten als anrufen</span></label>
      </fieldset>

      <div class="gruppe">
        <label class="check">
          <input type="checkbox" name="privacy" required aria-describedby="err-privacy" />
          <span>Ich bin einverstanden, dass {site.name} meine Angaben (Name, Telefon, E-Mail, Nachricht, Auswahl und Wunschzeiten) zur Bearbeitung meiner Terminanfrage verwendet. <a href={`${base}datenschutz/`} target="_blank" rel="noopener">Hinweise zum Datenschutz</a></span>
        </label>
        <p class="err" id="err-privacy" hidden>Bitte stimmen Sie zu, sonst kann ich Ihre Anfrage nicht bearbeiten.</p>
        <button class="btn senden" type="submit">Anfrage senden</button>
        <p class="small muted">Demo: Es wird nichts gesendet oder gespeichert.</p>
      </div>
    </form>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><radialGradient id="danke-honig" cx="35%" cy="28%" r="85%"><stop offset="0" stop-color="#FFE9AE" /><stop offset="0.5" stop-color="#F0AE34" /><stop offset="1" stop-color="#C77F17" /></radialGradient></defs></svg>
    <div class="terminkarte danke" data-karte hidden tabindex="-1" aria-live="polite">
      <div class="danke__siegel" aria-hidden="true">
        <i class="danke__tropf"></i>
        <svg viewBox="0 0 88 88"><circle class="danke__kreis" cx="44" cy="44" r="40" /><path class="danke__haken" d="M27 45l12 12 23-26" /></svg>
      </div>
      <h2>Anfrage angekommen</h2>
      <p class="lede" data-danke-hallo>Ich melde mich in der Regel am selben Abend.</p>
      <dl data-karte-liste></dl>
      <ol class="danke__weg">
        <li><b>Heute Abend</b><span>Ich rufe Sie an (oder schreibe per WhatsApp) und wir legen die Uhrzeit fest.</span></li>
        <li><b>Vor dem Termin</b><span>Sie bekommen eine kurze Erinnerung. Bitte Haare 3 bis 5 mm lang lassen.</span></li>
        <li><b>Bei mir</b><span>Wir schauen zuerst auf Ihre Haut, dann beginnt die Behandlung.</span></li>
      </ol>
      <div class="btn-row danke__aktion">
        <a class="btn" href={base}>Zur Startseite</a>
        <a class="btn btn--ghost" href={`${base}sugaring/#vorbereitung`}>So bereiten Sie sich vor</a>
      </div>
      <p class="demo-hinweis">Demo: Diese Anfrage wurde nicht gesendet und nicht gespeichert.</p>
    </div>

    <aside class="tf__direkt" aria-labelledby="direkt-h">
      <h2 id="direkt-h">Lieber direkt?</h2>
      <p class="muted">Während einer Behandlung kann ich nicht ans Telefon. Ich rufe zurück, sobald ich frei bin.</p>
      <div class="btn-row">
        <a class="btn" href={`tel:${site.phoneHref}`}>Anrufen: {site.phone}</a>
        <a class="btn btn--ghost" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" data-wa>WhatsApp schreiben</a>
      </div>
    </aside>
  </section>
</Base>

<style is:global define:vars={{ tropfenBild: `url(${base}img/honig-tropfen.webp)` }}>
  .tf { max-width: 44rem; padding-top: var(--space-xl); display: grid; gap: var(--space-xl); }
  .tf__kopf { display: grid; gap: var(--space-md); }
  .tf__auswahl { background: var(--weiss); border-radius: 20px; padding: 0.6rem 1.2rem 1.1rem; }
  .tf__auswahl[hidden], .tf__leer[hidden], .tf__abend[hidden] { display: none; }
  .tf__leer { display: grid; gap: var(--space-md); }
  .tf__label { margin-bottom: 0.6rem; font-weight: var(--strong-weight); }
  .tf__abend { margin-top: 0.5rem; }
  .tf__direkt { display: grid; gap: var(--space-md); padding-top: var(--space-xl); border-top: 1px solid var(--linie); }
  .tf__direkt h2 { font-size: 1.7rem; }
  .danke { display: grid; gap: 0.2rem; justify-items: start; }
  .danke__siegel { position: relative; width: 5.5rem; height: 5.5rem; margin-bottom: 0.8rem; }
  .danke__siegel svg { width: 100%; height: 100%; overflow: visible; }
  .danke__kreis { fill: url(#danke-honig); stroke: #C98410; stroke-width: 2; transform-origin: 44px 44px; animation: siegel 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) 0.45s both; filter: drop-shadow(0 8px 12px rgba(160, 90, 0, 0.35)); }
  .danke__haken { fill: none; stroke: var(--tinte); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 60; stroke-dashoffset: 60; animation: haken 0.45s ease-out 0.95s forwards; }
  .danke__tropf { position: absolute; left: 50%; top: -3.2rem; width: 22px; height: 34px; margin-left: -11px; background: var(--tropfenBild) center / 100% 100% no-repeat; animation: fall 0.5s cubic-bezier(0.55, 0, 0.9, 0.6) both; }
  @keyframes fall { 0% { transform: translateY(-1rem) scale(0.4); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(3.4rem) scale(1, 1.2); opacity: 1; } 100% { opacity: 0; } }
  @keyframes siegel { from { transform: scale(0.2); opacity: 0; } }
  @keyframes haken { to { stroke-dashoffset: 0; } }
  .danke dl { width: 100%; }
  .danke__weg { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; gap: 0.9rem; width: 100%; counter-reset: w; }
  .danke__weg li { position: relative; display: grid; gap: 0.1rem; padding-left: 2.4rem; counter-increment: w; }
  .danke__weg li::before { content: counter(w); position: absolute; left: 0; top: 0.05rem; width: 1.7rem; height: 1.7rem; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--honig-tief); font-size: 0.9rem; font-weight: 600; }
  .danke__weg span { color: var(--tinte-2); }
  .danke__aktion { margin-top: 1.4rem; }
</style>

<script>
  import * as cart from '../lib/cart';
  import { setupForm, telOk, mailOk } from '../lib/formular';
  import site from '../data/site.json';
  const form = document.querySelector<HTMLFormElement>('[data-termin-form]')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  let weissNicht = false;

  function render() {
    const c = cart.get();
    q('[data-tf-auswahl]').hidden = !c.lines.length; q('[data-tf-leer]').hidden = !!c.lines.length;
    q('[data-tf-liste]').replaceChildren(...c.lines.map((l) => {
      const li = document.createElement('li');
      const n = document.createElement('span'); n.textContent = l.name + (l.g === 'herren' ? ' (Herren)' : '');
      const p = document.createElement('span'); p.className = 'preis'; p.textContent = l.gratis ? 'inklusive' : (l.ab ? 'ab ' : '') + cart.euro(l.preis);
      const b = document.createElement('button'); b.type = 'button'; b.textContent = '×'; b.setAttribute('aria-label', `${l.name} entfernen`);
      b.addEventListener('click', () => cart.remove(l.id));
      li.append(n, p, b); return li;
    }));
    q('[data-tf-summe]').textContent = (c.ab ? 'ab ' : '') + cart.euro(c.summe);
    q('[data-tf-dauer]').textContent = c.min ? 'ca. ' + cart.dauer(c.min) : '';
    if (c.lines.length) q('#err-auswahl').hidden = true;
    const text = c.lines.length ? `Hallo, ich möchte einen Termin anfragen: ${c.lines.map((l) => l.name).join(', ')} (ca. ${cart.euro(c.summe)}).` : 'Hallo, ich möchte einen Termin anfragen.';
    q<HTMLAnchorElement>('[data-wa]').href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`;
  }
  addEventListener('zf:cart', render); render();

  q('[data-weissnicht]').addEventListener('click', () => { weissNicht = true; q('#err-auswahl').hidden = true; const n = f('note'); if (!n.value) n.value = 'Ich weiß noch nicht genau, was ich brauche. Bitte beraten Sie mich.'; n.dispatchEvent(new Event('input', { bubbles: true })); n.focus(); });

  // Abend nur Di/Do
  const abend = form.querySelector<HTMLInputElement>('[data-abend]')!;
  function abendCheck() {
    const tage = [...form.querySelectorAll<HTMLInputElement>('input[name=tage]:checked')].map((i) => i.value);
    const ok = !tage.length || tage.includes('Di') || tage.includes('Do');
    abend.disabled = !ok; if (!ok) abend.checked = false;
    q('[data-abend-hinweis]').hidden = ok;
  }
  form.addEventListener('change', abendCheck);

  const ctrl = setupForm(form, {
    extraValid: () => {
      const leer = !cart.get().lines.length && !weissNicht && !f('note').value.trim();
      q('#err-auswahl').hidden = !leer;
      return leer ? q('[data-tf-leer] .btn') : null;
    },
    checks: () => [
      [f('name'), () => f('name').value.trim().length > 1],
      [f('tel'), () => telOk(f('tel').value)],
      [f('email'), () => mailOk(f('email'))],
      [f('privacy'), () => f('privacy').checked],
    ],
    onSubmit: () => {
      const c = cart.get();
      const rows: [string, string, string?][] = c.lines.map((l) => [l.name, l.gratis ? 'inklusive' : (l.ab ? 'ab ' : '') + cart.euro(l.preis)]);
      if (c.lines.length) rows.push(['Summe', (c.ab ? 'ab ' : '') + cart.euro(c.summe), 'summe'], ['Dauer', 'ca. ' + cart.dauer(c.min)]);
      const tage = [...form.querySelectorAll<HTMLInputElement>('input[name=tage]:checked')].map((i) => i.value).join(', ');
      const zeit = [...form.querySelectorAll<HTMLInputElement>('input[name=zeit]:checked')].map((i) => i.value).join(', ');
      if (tage || zeit) rows.push(['Wunschzeit', [tage, zeit].filter(Boolean).join(' · ')]);
      rows.push(['Name', f('name').value.trim()], ['Telefon', f('tel').value.trim()]);
      if (form.querySelector<HTMLInputElement>('input[name=whatsapp]')!.checked) rows.push(['Antwort', 'per WhatsApp']);
      q('[data-karte-liste]').replaceChildren(...rows.map(([k, v, cls]) => {
        const d = document.createElement('div'); if (cls) d.className = cls;
        const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v;
        d.append(dt, dd); return d;
      }));
      const vorname = f('name').value.trim().split(/\s+/)[0];
      q('[data-danke-hallo]').textContent = `Danke, ${vorname}. Ich melde mich in der Regel am selben Abend.`;
      form.hidden = true; const k = q('[data-karte]'); k.hidden = false; k.focus(); k.scrollIntoView({ block: 'start' });
      ctrl.reset(); cart.clear();
    },
  });
  abendCheck();
</script>
